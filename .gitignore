# Никогда не коммитим
.env
.env.*
!.env.example
# Ключи установщика (install.sh --secrets): пример в git, заполненный — никогда
secrets.env
secrets*.env
!secrets.example.env
*.secret
*.key
*.pem
restic-password
*-password
*.bak.*
*.swp
.DS_Store

# Логи и runtime
*.log
logs/
.tmp/

# Кэши
node_modules/
__pycache__/
*.pyc
*.pyo
.cache/
.venv/
venv/

# Локальная разработка
.vscode/
.idea/
*.local
memory/
notes/

# Если кто-то случайно положил рядом install-state
/var/lib/claude-code-server-kit/

# Архивы готовой сборки T3 (t3-patches/package.sh) — раздаются отдельно, не через git
t3-patches/dist/
# Собранные APK (раздаются отдельно), кеши и служебные отчёты набора патчей T3
t3-patches/apk/
t3-patches/i18n/__pycache__/
t3-patches/i18n/catalog.json
t3-patches/mobile/rejected/
