{
  "_comment": "Минимальный settings.json — генерируется core install. После установки модулей будет расширен.",
  "defaultModel": "claude-sonnet-4-6",
  "alwaysThinkingEnabled": true,
  "user": {
    "name": "__USER_NAME__",
    "email": "__USER_EMAIL__"
  },
  "permissions": {
    "allowedTools": []
  },
  "hooks": {},
  "agentSubpaths": [
    "__HOME__/.claude/agents",
    "__ECC_DIR__/agents"
  ],
  "skillSubpaths": [
    "__HOME__/.claude/skills",
    "__ECC_DIR__/skills"
  ],
  "rulesSubpaths": [
    "__HOME__/.claude/rules",
    "__ECC_DIR__/rules"
  ]
}
