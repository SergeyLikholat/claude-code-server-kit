# Пример .env для claude-code-server-kit.
# Скопируйте в .env (cd kit; cp examples/.env.example .env) и заполните то что нужно.
#
# ВСЕ переменные ОПЦИОНАЛЬНЫ. Core install не требует ничего.
# Модули спросят значения интерактивно или возьмут из .env если есть.

# ============================================================
# CORE — базовые настройки
# ============================================================
USER_NAME=""           # Ваше имя для git/claude config (Иван Петров)
USER_EMAIL=""          # ivan@example.com

# ============================================================
# tg-bot — Telegram-бот
# ============================================================
# Получить токен: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=""

# ID Telegram-чата куда бот пишет (для группы: -100xxxxx)
# Узнать: @username_to_id_bot или из логов бота при первом сообщении
TELEGRAM_CHAT_ID=""

# Использовать форум-режим с топиками (y/n)
TG_FORUM_MODE="n"

# ============================================================
# backup — Бэкап на Яндекс.Диск
# ============================================================
# Создайте OAuth-приложение: https://oauth.yandex.com/client/new
# - Platforms: Web services, redirect URI: https://oauth.yandex.ru/verification_code
# - Data access: cloud_api:disk.* (read, write, info, app_folder)
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Authorization code (получается ОДИН РАЗ через браузер):
# https://oauth.yandex.ru/authorize?response_type=code&client_id=ВАШ_ID
# Скопировать code= из URL и вставить ниже
YANDEX_AUTH_CODE=""

# Папка на Я.Диске для бэкапа
BACKUP_TARGET_PATH="/server-backups/restic-main"

# Restic-пароль (если пусто — будет сгенерирован и показан один раз)
# Должен быть >= 25 символов. Лучше всего: openssl rand -base64 32
BACKUP_RESTIC_PASSWORD=""

# ============================================================
# parakeet — Транскрипция голоса
# ============================================================
# HuggingFace токен для скачивания модели (read scope)
# Получить: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=""

# Какую модель использовать: "parakeet" (англ.+мульти) или "gigaam" (русский лучше)
PARAKEET_VARIANT="parakeet"

# ============================================================
# helpers — Полезные мелочи
# ============================================================
# Gemini API key для nanobanana (картинки) и gemini-tts (озвучка)
# Получить бесплатно: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ============================================================
# claude-mem — Кросс-сессионная память
# ============================================================
# Никаких ключей не требует. Можно отключить через --skip-claude-mem.
