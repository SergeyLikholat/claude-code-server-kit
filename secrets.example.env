# secrets.example.env — все ключи и настройки, которые понимает установщик.
#
# Как пользоваться:
#   1. cp secrets.example.env secrets.env      (secrets.env в git не попадает)
#   2. Заполнить нужное. Пустое значение = «нет», модуль просто не ставится.
#   3. sudo bash install.sh --full --secrets secrets.env
#
# Формат: КЛЮЧ=значение, по строке на ключ. Кавычки не нужны; если в значении есть
# пробелы или JSON — в одинарные кавычки: КЛЮЧ='{"a":"b"}'. Подстановки $(...) и $VAR
# не выполняются: файл читается как данные, а не как скрипт.
#
# Установщик проверяет каждый заполненный ключ вживую. Неверный ключ — установка
# останавливается с объяснением, ничего не сломав. После установки ключи лежат в
# ~/.config/kit/secrets.env (права 600), этот файл удалите сами или флагом --delete-secrets.

# ── 1. Claude — ОБЯЗАТЕЛЬНО ───────────────────────────────────────────────────
# Токен подписки Claude (Pro/Max) на год. Где взять: на любом компьютере с Claude Code
# выполнить `claude setup-token`, войти на claude.ai по ссылке, скопировать sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN=

# Имя и почта для git и настроек Claude. Не обязательно: по умолчанию имя пользователя сервера.
USER_NAME=
USER_EMAIL=

# ── 2. T3 — окно к Claude из браузера и с телефона (обязательно для модуля t3) ─
# Домен или поддомен, чья A-запись уже смотрит на IP этого сервера. Например: t3.example.ru
T3_DOMAIN=
# Почта для Let's Encrypt: на неё придёт письмо, если сертификат не продлится.
ACME_EMAIL=
# Готовая сборка T3 с нашими патчами: путь к .tar.gz на сервере или https-ссылка.
# Собирается у администратора командой t3-patches/package.sh (см. docs/FULL-STACK.md).
T3_TARBALL=
# Контрольная сумма архива (sha256). Не обязательно: если рядом с архивом лежит
# файл .sha256, он проверяется сам.
T3_TARBALL_SHA256=
# Android-приложение: путь к .apk или https-ссылка. Не обязательно; если задано,
# файл раздаётся по адресу https://<T3_DOMAIN>/t3-apk/ и печатается QR-кодом.
T3_APK=
# Порт T3 на 127.0.0.1 (наружу его открывает только Caddy). Менять не нужно.
T3_PORT=7373

# ── 3. Telegram — по желанию ─────────────────────────────────────────────────
# Токен бота от @BotFather (/newbot). Если задан — ставится модуль tg-bot.
TELEGRAM_BOT_TOKEN=
# ID чата или группы для уведомлений (число, у групп начинается с -100).
# Узнать: написать боту, открыть https://api.telegram.org/bot<токен>/getUpdates.
TELEGRAM_CHAT_ID=

# ── 4. Gemini — по желанию ───────────────────────────────────────────────────
# Ключ Google AI Studio: генерация картинок и озвучка (модуль helpers).
# Где взять: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 5. Бэкап на Яндекс.Диск — по желанию ─────────────────────────────────────
# Токен rclone для Я.Диска. Где взять: на компьютере с браузером установить rclone и
# выполнить `rclone authorize "yandex"`, войти в Яндекс, скопировать JSON целиком
# в одинарных кавычках. Если задан — ставится модуль backup.
RCLONE_YANDEX_TOKEN=
# Пароль шифрования бэкапа (от 12 символов). Пусто — сгенерируется и будет показан один раз.
# Без него бэкап не восстановить: сохраните в менеджер паролей.
RESTIC_PASSWORD=
# Папка на Я.Диске для бэкапа. Менять не обязательно.
BACKUP_TARGET_PATH=/server-backups/restic-main

# ── 6. Распознавание голоса Parakeet — по желанию ────────────────────────────
# Поставить модуль parakeet (модель ~600 МБ, нужен 2+ ГБ свободной памяти): 1 — да.
KIT_WITH_PARAKEET=
# Токен Hugging Face (тип read). Модель публичная, токен нужен, только если скачивание
# упирается в лимиты. Где взять: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── 7. Память (llm-memory-kit) — менять не обязательно ──────────────────────
# Откуда ставить память и какую версию. По умолчанию — публичный репозиторий, ветка main.
MEMORY_KIT_REPO=https://github.com/SergeyLikholat/llm-memory-kit.git
MEMORY_KIT_REF=main
# Папка Obsidian-хранилища, если нужна вики поверх памяти. Пусто — без Obsidian.
MEMORY_KIT_OBSIDIAN_DIR=
