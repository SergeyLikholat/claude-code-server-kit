[Unit]
Description=claude-mem worker (cross-session memory backend)
Documentation=https://github.com/thedotmack/claude-mem
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME_DIR__
Environment=HOME=__HOME_DIR__
Environment=NODE_ENV=production
ExecStart=/opt/claude-mem/run-worker.sh
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
