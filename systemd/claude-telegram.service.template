[Unit]
Description=Claude Code Telegram bot daemon
Documentation=https://github.com/SergeyLikholat/claude-code-server-kit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=__SECRETS_ENV_FILE__
ExecStart=/usr/bin/node __WORKDIR__/index.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/claude-telegram.log
StandardError=append:/var/log/claude-telegram.log

[Install]
WantedBy=multi-user.target
