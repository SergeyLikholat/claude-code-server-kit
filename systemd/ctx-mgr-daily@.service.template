[Unit]
Description=context-mgr daily snapshot (user %i)
Documentation=https://github.com/SergeyLikholat/claude-code-server-kit

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/home/%i/_infra/context-mgr
ExecStart=/usr/bin/node /home/%i/_infra/context-mgr/cli.js daily
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
