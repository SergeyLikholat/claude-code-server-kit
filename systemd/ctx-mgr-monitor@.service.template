[Unit]
Description=context-mgr monitor tick (user %i)
Documentation=https://github.com/SergeyLikholat/cc-multiuser-kit

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/home/%i/_infra/context-mgr
ExecStart=/usr/bin/node /home/%i/_infra/context-mgr/cli.js monitor
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
