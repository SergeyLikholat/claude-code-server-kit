diff --git a/apps/mobile/src/sergey/officePreview.ts b/apps/mobile/src/sergey/officePreview.ts
new file mode 100644
index 0000000000..e7ba5c2801
--- /dev/null
+++ b/apps/mobile/src/sergey/officePreview.ts
@@ -0,0 +1,35 @@
+/**
+ * t3-patch: просмотр xlsx/xls/ods и docx/doc/rtf/odt в приложении.
+ *
+ * Сервер (патч 0009) выдаёт на офисные файлы штатную подписанную ссылку /api/assets,
+ * а рядом с клиентом лежит страница просмотра t3patch-vendor/office-view.html — та же
+ * сетка листов и тот же вид документа, что в браузере. Приложение открывает эту страницу
+ * в своём встроенном браузере, передавая ссылку на файл в адресе после #.
+ */
+const OFFICE_EXTENSIONS = [
+  ".xlsx",
+  ".xlsm",
+  ".xlsb",
+  ".xls",
+  ".ods",
+  ".docx",
+  ".doc",
+  ".rtf",
+  ".odt",
+];
+
+export function isT3patchOfficePreviewPath(path: string): boolean {
+  const lower = path.toLowerCase();
+  return OFFICE_EXTENSIONS.some((extension) => lower.endsWith(extension));
+}
+
+export function t3patchOfficeViewUri(assetUri: string | null): string | null {
+  if (assetUri === null) return null;
+  let url: URL;
+  try {
+    url = new URL(assetUri);
+  } catch {
+    return null;
+  }
+  return `${url.origin}/t3patch-vendor/office-view.html#src=${encodeURIComponent(url.pathname + url.search)}`;
+}
diff --git a/apps/mobile/src/sergey/pathActions.ts b/apps/mobile/src/sergey/pathActions.ts
new file mode 100644
index 0000000000..97bf39e9e5
--- /dev/null
+++ b/apps/mobile/src/sergey/pathActions.ts
@@ -0,0 +1,28 @@
+/**
+ * t3-patch: пути к файлам в приложении — как «Копировать путь» / «Копировать полный путь»
+ * в браузерной версии (патч 0002).
+ *
+ * Полный путь раскрывает окно `!Obsidian` в настоящий путь базы: в каждом кабинете это
+ * bind-монтирование `/root/Obsidian` только для чтения. Веб-версия узнаёт настоящий путь у
+ * сервера; приложению тот маршрут недоступен (другой способ входа), поэтому правило задано здесь.
+ */
+import { Alert } from "react-native";
+
+import { copyTextWithHaptic } from "../lib/copyTextWithHaptic";
+import { t3patchFullPath } from "./paths";
+
+export function t3patchShowPathMenu(cwd: string | null, relativePath: string): void {
+  const name = relativePath.split("/").pop() ?? relativePath;
+  Alert.alert(name, undefined, [
+    { text: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
+    ...(cwd
+      ? [
+          {
+            text: "Копировать полный путь",
+            onPress: () => copyTextWithHaptic(t3patchFullPath(cwd, relativePath)),
+          },
+        ]
+      : []),
+    { text: "Отмена", style: "cancel" as const },
+  ]);
+}
diff --git a/apps/mobile/src/sergey/paths.ts b/apps/mobile/src/sergey/paths.ts
new file mode 100644
index 0000000000..8172790120
--- /dev/null
+++ b/apps/mobile/src/sergey/paths.ts
@@ -0,0 +1,13 @@
+/**
+ * t3-patch: полный путь к файлу проекта. Окно `!Obsidian` (bind-монтирование `/root/Obsidian`
+ * только для чтения в каждом кабинете) раскрывается в настоящий путь базы. Веб-версия узнаёт
+ * настоящий путь у сервера; приложению тот маршрут недоступен, поэтому правило задано здесь.
+ */
+const OBSIDIAN_WINDOW = "/!Obsidian/";
+const OBSIDIAN_ROOT = "/root/Obsidian/";
+
+export function t3patchFullPath(cwd: string, relativePath: string): string {
+  const joined = `${cwd.replace(/\/+$/, "")}/${relativePath.replace(/^\/+/, "")}`;
+  const window = joined.indexOf(OBSIDIAN_WINDOW);
+  return window >= 0 ? OBSIDIAN_ROOT + joined.slice(window + OBSIDIAN_WINDOW.length) : joined;
+}
diff --git a/apps/mobile/src/sergey/sergey.test.ts b/apps/mobile/src/sergey/sergey.test.ts
new file mode 100644
index 0000000000..05bcf58a5a
--- /dev/null
+++ b/apps/mobile/src/sergey/sergey.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { isT3patchOfficePreviewPath, t3patchOfficeViewUri } from "./officePreview";
+import { t3patchFullPath } from "./paths";
+
+describe("t3patchFullPath", () => {
+  it("склеивает корень проекта и относительный путь", () => {
+    expect(t3patchFullPath("/root/projects/tk-vector/", "docs/a.xlsx")).toBe(
+      "/root/projects/tk-vector/docs/a.xlsx",
+    );
+  });
+
+  it("раскрывает окно !Obsidian в настоящий путь базы", () => {
+    expect(t3patchFullPath("/root/projects/tk-vector", "!Obsidian/3. Проекты/план.md")).toBe(
+      "/root/Obsidian/3. Проекты/план.md",
+    );
+  });
+});
+
+describe("просмотр офисных файлов", () => {
+  it("узнаёт офисные форматы", () => {
+    expect(isT3patchOfficePreviewPath("a/Смета.XLSX")).toBe(true);
+    expect(isT3patchOfficePreviewPath("b.doc")).toBe(true);
+    expect(isT3patchOfficePreviewPath("c.pdf")).toBe(false);
+  });
+
+  it("строит адрес страницы просмотра на том же сервере", () => {
+    expect(t3patchOfficeViewUri("https://t3.example.com/api/assets/tok.sig/a%20b.xlsx")).toBe(
+      "https://t3.example.com/t3patch-vendor/office-view.html#src=%2Fapi%2Fassets%2Ftok.sig%2Fa%2520b.xlsx",
+    );
+    expect(t3patchOfficeViewUri(null)).toBeNull();
+    expect(t3patchOfficeViewUri("не адрес")).toBeNull();
+  });
+});
