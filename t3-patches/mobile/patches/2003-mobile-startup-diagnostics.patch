--- /dev/null
+++ b/apps/mobile/src/sergey/startupDiagnostics.tsx
@@ -0,0 +1,174 @@
+/**
+ * t3-patch: диагностика запуска приложения.
+ *
+ * Если при старте падает JS, заставка не убирается и приложение висит: нативного сбоя нет,
+ * Android ничего не показывает, а logcat с телефона не достать. Этот модуль ловит ошибки
+ * (глобальный обработчик, границу React и `console.error`), убирает заставку и печатает
+ * причину прямо на экране — её видно на скриншоте.
+ *
+ * Сторож: если через 15 секунд приложение так и не сообщило о готовности, экран тоже
+ * показывается — так видно зависание без исключения.
+ */
+import * as SplashScreen from "expo-splash-screen";
+import { Component, type ComponentType, type ReactNode } from "react";
+import { ScrollView, Text, View } from "react-native";
+
+const READY_TIMEOUT_MS = 15_000;
+const MAX_RECORDS = 30;
+
+interface Record {
+  readonly kind: string;
+  readonly text: string;
+}
+
+const records: Record[] = [];
+const listeners = new Set<() => void>();
+
+function add(kind: string, text: string): void {
+  if (records.length >= MAX_RECORDS) return;
+  records.push({ kind, text: text.slice(0, 2000) });
+  for (const listener of listeners) listener();
+}
+
+const describe = (value: unknown): string => {
+  if (value instanceof Error) {
+    return `${value.name}: ${value.message}\n${(value.stack ?? "").split("\n").slice(0, 12).join("\n")}`;
+  }
+  if (typeof value === "string") return value;
+  try {
+    return JSON.stringify(value);
+  } catch {
+    return String(value);
+  }
+};
+
+/** Приложение дошло до первого экрана — сторожу срабатывать не нужно. */
+export function t3patchMarkReady(): void {
+  (globalThis as { __t3patchReady?: boolean }).__t3patchReady = true;
+}
+
+export function installT3patchStartupDiagnostics(): void {
+  const errorUtils = (
+    globalThis as {
+      ErrorUtils?: { getGlobalHandler?: () => unknown; setGlobalHandler?: (h: unknown) => void };
+    }
+  ).ErrorUtils;
+  const previous = errorUtils?.getGlobalHandler?.();
+  errorUtils?.setGlobalHandler?.((error: unknown, isFatal?: boolean) => {
+    add(isFatal ? "Фатальная ошибка" : "Ошибка", describe(error));
+    if (typeof previous === "function")
+      (previous as (e: unknown, f?: boolean) => void)(error, isFatal);
+  });
+
+  const consoleError = console.error.bind(console);
+  console.error = (...args: unknown[]) => {
+    add("console.error", args.map(describe).join(" "));
+    consoleError(...args);
+  };
+}
+
+function DiagnosticsScreen(props: { readonly reason: string }) {
+  return (
+    <View style={{ flex: 1, backgroundColor: "#140000", paddingTop: 56, paddingHorizontal: 16 }}>
+      <Text
+        selectable
+        style={{ color: "#ff8a80", fontSize: 16, fontWeight: "700", marginBottom: 8 }}
+      >
+        T3 · диагностика запуска
+      </Text>
+      <Text selectable style={{ color: "#ffd0c8", fontSize: 13, marginBottom: 12 }}>
+        {props.reason}
+      </Text>
+      <ScrollView style={{ flex: 1 }}>
+        {records.length === 0 ? (
+          <Text selectable style={{ color: "#ffd0c8", fontSize: 12 }}>
+            Ошибок не поймано — приложение не дошло до первого экрана и не сообщило о готовности.
+          </Text>
+        ) : (
+          records.map((record, index) => (
+            <View key={index} style={{ marginBottom: 14 }}>
+              <Text selectable style={{ color: "#ff8a80", fontSize: 12, fontWeight: "700" }}>
+                {index + 1}. {record.kind}
+              </Text>
+              <Text selectable style={{ color: "#ffece8", fontSize: 11, fontFamily: "monospace" }}>
+                {record.text}
+              </Text>
+            </View>
+          ))
+        )}
+      </ScrollView>
+    </View>
+  );
+}
+
+const hideSplash = () => {
+  try {
+    SplashScreen.hide();
+  } catch {
+    // Модуль заставки может быть недоступен — диагностику это не отменяет.
+  }
+};
+
+class StartupBoundary extends Component<
+  { readonly children: ReactNode },
+  { reason: string | null }
+> {
+  private timer: ReturnType<typeof setTimeout> | null = null;
+
+  override state = { reason: null as string | null };
+
+  static getDerivedStateFromError(error: unknown) {
+    add("Ошибка при отрисовке", describe(error));
+    return { reason: "Приложение упало при отрисовке первого экрана." };
+  }
+
+  override componentDidMount() {
+    listeners.add(this.onRecord);
+    this.timer = setTimeout(() => {
+      if ((globalThis as { __t3patchReady?: boolean }).__t3patchReady) return;
+      hideSplash();
+      this.setState({ reason: "За 15 секунд приложение не дошло до первого экрана." });
+    }, READY_TIMEOUT_MS);
+  }
+
+  override componentDidUpdate() {
+    if (this.state.reason !== null) hideSplash();
+  }
+
+  override componentWillUnmount() {
+    listeners.delete(this.onRecord);
+    if (this.timer !== null) clearTimeout(this.timer);
+  }
+
+  private onRecord = () => {
+    this.forceUpdate();
+  };
+
+  override render() {
+    if (this.state.reason !== null) return <DiagnosticsScreen reason={this.state.reason} />;
+    return this.props.children;
+  }
+}
+
+/** Оборачивает корневой компонент; при сбое импорта самого приложения показывает причину. */
+export function t3patchWrapRoot(load: () => ComponentType): ComponentType {
+  let App: ComponentType | null = null;
+  let importError: string | null = null;
+  try {
+    App = load();
+  } catch (error) {
+    add("Ошибка загрузки приложения", describe(error));
+    importError = "Код приложения не загрузился.";
+  }
+  return function T3patchRoot() {
+    if (App === null) {
+      hideSplash();
+      return <DiagnosticsScreen reason={importError ?? "Код приложения не загрузился."} />;
+    }
+    return (
+      <StartupBoundary>
+        <App />
+      </StartupBoundary>
+    );
+  };
+}
