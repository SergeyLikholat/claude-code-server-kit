+/**
+ * t3-patch: сортировка тредов по последнему сообщению — чистые функции без нативных модулей
+ * (их можно проверять тестами). Выбор порядка хранится в threadOrder.ts.
+ */
+const toMs = (value: string | null | undefined): number | null => {
+  if (!value) return null;
+  const ms = Date.parse(value);
+  return Number.isNaN(ms) ? null : ms;
+};
+
+/** Время для сортировки: последнее сообщение пользователя, иначе обновление, иначе создание. */
+export function t3patchLatestActivityMs(thread: {
+  readonly latestUserMessageAt?: string | null | undefined;
+  readonly updatedAt?: string | null | undefined;
+  readonly createdAt: string;
+}): number {
+  return (
+    toMs(thread.latestUserMessageAt) ??
+    toMs(thread.updatedAt) ??
+    toMs(thread.createdAt) ??
+    Number.NEGATIVE_INFINITY
+  );
+}
+
+/** Свежие сверху; при равенстве — стабильно по id, чтобы строки не прыгали. */
+export function t3patchSortThreadsByLatest<
+  T extends {
+    readonly id: string;
+    readonly latestUserMessageAt?: string | null | undefined;
+    readonly updatedAt?: string | null | undefined;
+    readonly createdAt: string;
+  },
+>(threads: readonly T[]): T[] {
+  return [...threads].sort((left, right) => {
+    const diff = t3patchLatestActivityMs(right) - t3patchLatestActivityMs(left);
+    return diff !== 0 ? diff : left.id.localeCompare(right.id);
+  });
+}
