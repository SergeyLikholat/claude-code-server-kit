+ * t3-patch: порядок тредов в списке — «по последнему сообщению» или штатный ручной.
+ *
+ * Новый список тредов (v2) штатно держит ручной порядок: активность тред не двигает, а меню
+ * сортировки для него скрыто. Здесь — та же альтернатива, что в браузерной версии (патч 0001):
+ * свежие наверху. Выбор хранится на устройстве (expo-secure-store) под своим ключом, чтобы
+ * не трогать общую схему настроек приложения. По умолчанию — по последнему сообщению.
+ */
+import * as SecureStore from "expo-secure-store";
+import { useSyncExternalStore } from "react";
+
+export { t3patchLatestActivityMs, t3patchSortThreadsByLatest } from "./threadOrderSort";
+
+export type T3patchThreadOrder = "manual" | "latest";
+
+const STORAGE_KEY = "t3patch.threadOrder";
+const listeners = new Set<() => void>();
+
+function readOrder(): T3patchThreadOrder {
+  try {
+    return SecureStore.getItem(STORAGE_KEY) === "manual" ? "manual" : "latest";
+  } catch {
+    return "latest";
+  }
+}
+
+let cached: T3patchThreadOrder | null = null;
+
+function current(): T3patchThreadOrder {
+  if (cached === null) cached = readOrder();
+  return cached;
+}
+
+export function setT3patchThreadOrder(order: T3patchThreadOrder): void {
+  cached = order;
+  try {
+    SecureStore.setItem(STORAGE_KEY, order);
+  } catch {
+    // хранилище недоступно — порядок действует до перезапуска приложения
+  }
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function useT3patchThreadOrder(): T3patchThreadOrder {
+  return useSyncExternalStore(subscribe, current, current);
+}
+
+export const T3PATCH_THREAD_ORDER_OPTIONS: ReadonlyArray<{
+  readonly value: T3patchThreadOrder;
+  readonly label: string;
+}> = [
+  { value: "latest", label: "По последнему сообщению" },
+  { value: "manual", label: "Ручной порядок" },
+];
