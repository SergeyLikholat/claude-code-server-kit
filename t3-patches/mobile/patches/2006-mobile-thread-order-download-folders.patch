 });
+
+describe("порядок тредов по последнему сообщению", () => {
+  const thread = (
+    id: string,
+    latest: string | null,
+    updated: string,
+    created = "2026-01-01T00:00:00Z",
+  ) => ({
+    id,
+    latestUserMessageAt: latest,
+    updatedAt: updated,
+    createdAt: created,
+  });
+
+  it("свежее сообщение — выше; без сообщений — по обновлению", () => {
+    const sorted = t3patchSortThreadsByLatest([
+      thread("old", "2026-09-20T10:00:00Z", "2026-09-20T10:00:00Z"),
+      thread("fresh", "2026-09-25T11:00:00Z", "2026-09-25T11:00:00Z"),
+      thread("no-msg", null, "2026-09-24T09:00:00Z"),
+    ]);
+    expect(sorted.map((item) => item.id)).toEqual(["fresh", "no-msg", "old"]);
+  });
+
+  it("равное время — стабильно по id", () => {
+    const same = "2026-09-25T11:00:00Z";
+    expect(
+      t3patchSortThreadsByLatest([thread("b", same, same), thread("a", same, same)]).map(
+        (t) => t.id,
+      ),
+    ).toEqual(["a", "b"]);
+  });
+});
