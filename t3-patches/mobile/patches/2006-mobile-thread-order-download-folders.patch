diff --git a/apps/mobile/src/sergey/FileUnavailable.tsx b/apps/mobile/src/sergey/FileUnavailable.tsx
new file mode 100644
index 0000000000..4784cbe182
--- /dev/null
+++ b/apps/mobile/src/sergey/FileUnavailable.tsx
@@ -0,0 +1,128 @@
+/**
+ * t3-patch: экран файла, который приложение не показывает, — как карточка в браузерной версии.
+ *
+ * Штатно вместо содержимого выводилась ошибка чтения. Теперь:
+ * - если по пути лежит папка (ссылка из чата на каталог), предлагаем открыть её в проводнике;
+ * - иначе — имя файла, объяснение и действия: «Скачать» (подписанная ссылка сервера, патч 0011,
+ *   открывается во внешнем браузере — он и скачивает), «Копировать путь», «Копировать полный путь».
+ */
+import type { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { useEffect } from "react";
+import { ActivityIndicator, Pressable, View } from "react-native";
+
+import { AppText as Text } from "../components/AppText";
+import { useWorkspaceFileAssetUrlState } from "../features/files/workspaceFileAssetUrl";
+import { copyTextWithHaptic } from "../lib/copyTextWithHaptic";
+import { tryOpenExternalUrl } from "../lib/openExternalUrl";
+import { projectEnvironment } from "../state/projects";
+import { useEnvironmentQuery } from "../state/query";
+import { t3patchFullPath } from "./paths";
+
+const basename = (path: string) => path.replace(/\/+$/, "").split("/").pop() || path;
+
+export function t3patchDescribeUnreadable(error: string | null): string {
+  if (error && /binary/i.test(error)) {
+    return "Это двоичный файл. В приложении открываются текст, таблицы, документы, картинки, PDF, аудио и видео — остальное можно скачать и открыть на телефоне.";
+  }
+  return "Этот тип файла приложение не показывает. Его можно скачать и открыть на телефоне.";
+}
+
+function ActionButton(props: {
+  readonly label: string;
+  readonly primary?: boolean;
+  readonly disabled?: boolean;
+  readonly onPress: () => void;
+}) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      disabled={props.disabled}
+      onPress={props.onPress}
+      className={
+        props.primary
+          ? "min-w-44 items-center rounded-full bg-primary px-5 py-3 active:opacity-70"
+          : "min-w-44 items-center rounded-full border border-border px-5 py-3 active:opacity-70"
+      }
+      style={props.disabled ? { opacity: 0.5 } : undefined}
+    >
+      <Text
+        className={
+          props.primary
+            ? "text-sm font-t3-bold text-primary-foreground"
+            : "text-sm font-t3-medium text-foreground"
+        }
+      >
+        {props.label}
+      </Text>
+    </Pressable>
+  );
+}
+
+export function T3patchFileUnavailable(props: {
+  readonly environmentId: EnvironmentId;
+  readonly cwd: string;
+  readonly threadId: ThreadId | null;
+  readonly relativePath: string;
+  readonly error: string | null;
+  /** Путь оказался папкой — показать её в проводнике. */
+  readonly onOpenFolder: (relativePath: string) => void;
+}) {
+  const { environmentId, cwd, relativePath, onOpenFolder } = props;
+  // Папка ли это: у папки сервер отдаёт список содержимого, у файла — ошибку.
+  const directory = useEnvironmentQuery(
+    projectEnvironment.listEntries({
+      environmentId,
+      input: { cwd, directoryPath: relativePath.replace(/\/+$/, "") },
+    }),
+  );
+  const isDirectory = directory.data !== null;
+  useEffect(() => {
+    if (isDirectory) onOpenFolder(relativePath.replace(/\/+$/, ""));
+  }, [isDirectory, onOpenFolder, relativePath]);
+
+  const asset = useWorkspaceFileAssetUrlState({
+    cwd,
+    environmentId,
+    relativePath: isDirectory || directory.isPending ? null : relativePath,
+    threadId: props.threadId,
+    draftCwd: props.threadId === null ? cwd : null,
+  });
+  const downloadUrl = asset._tag === "Success" ? asset.url : null;
+
+  if (directory.isPending || isDirectory) {
+    return (
+      <View className="flex-1 items-center justify-center bg-sheet">
+        <ActivityIndicator />
+      </View>
+    );
+  }
+
+  return (
+    <View className="flex-1 items-center justify-center gap-3 bg-sheet px-8">
+      <Text className="text-center text-lg font-t3-bold text-foreground">
+        {basename(relativePath)}
+      </Text>
+      <Text className="text-center text-sm leading-relaxed text-foreground-muted">
+        {t3patchDescribeUnreadable(props.error)}
+      </Text>
+      <Text selectable className="text-center font-mono text-xs text-foreground-muted">
+        {t3patchFullPath(cwd, relativePath)}
+      </Text>
+      <View className="mt-3 items-center gap-2">
+        <ActionButton
+          primary
+          label={downloadUrl ? "Скачать" : "Готовлю ссылку…"}
+          disabled={downloadUrl === null}
+          onPress={() => {
+            if (downloadUrl) void tryOpenExternalUrl(downloadUrl, "file-preview");
+          }}
+        />
+        <ActionButton label="Копировать путь" onPress={() => copyTextWithHaptic(relativePath)} />
+        <ActionButton
+          label="Копировать полный путь"
+          onPress={() => copyTextWithHaptic(t3patchFullPath(cwd, relativePath))}
+        />
+      </View>
+    </View>
+  );
+}
