 });
+
+describe("путь из ссылки в путь проекта", () => {
+  it("/root/Obsidian/... — через окно !Obsidian кабинета", () => {
+    expect(t3patchWorkspacePath("/root/projects/tk-vector", "/root/Obsidian/ОБМЕН/T3.apk")).toBe(
+      "!Obsidian/ОБМЕН/T3.apk",
+    );
+  });
+
+  it("полный путь внутри кабинета — относительный; в самой базе окна нет", () => {
+    expect(
+      t3patchWorkspacePath("/root/projects/tk-vector", "/root/projects/tk-vector/docs/a.md"),
+    ).toBe("docs/a.md");
+    expect(t3patchWorkspacePath("/root/Obsidian", "/root/Obsidian/ОБМЕН/a.md")).toBe("ОБМЕН/a.md");
+    expect(t3patchWorkspacePath("/root/projects/tk-vector", "/etc/hosts")).toBe("/etc/hosts");
+    expect(t3patchWorkspacePath("/root/projects/tk-vector", "docs/a.md")).toBe("docs/a.md");
+  });
+
+  it("полный путь не склеивается с папкой кабинета", () => {
+    expect(t3patchFullPath("/root/projects/tk-vector", "/root/Obsidian/a.md")).toBe(
+      "/root/Obsidian/a.md",
+    );
+  });
+});
