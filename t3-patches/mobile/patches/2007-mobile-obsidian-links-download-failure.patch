diff --git a/apps/mobile/src/sergey/paths.ts b/apps/mobile/src/sergey/paths.ts
index 8172790120..eda6eb9587 100644
--- a/apps/mobile/src/sergey/paths.ts
+++ b/apps/mobile/src/sergey/paths.ts
@@ -7,7 +7,23 @@ const OBSIDIAN_WINDOW = "/!Obsidian/";
 const OBSIDIAN_ROOT = "/root/Obsidian/";
 
 export function t3patchFullPath(cwd: string, relativePath: string): string {
+  if (relativePath.startsWith("/")) return relativePath; // уже полный путь (ссылка из чата)
   const joined = `${cwd.replace(/\/+$/, "")}/${relativePath.replace(/^\/+/, "")}`;
   const window = joined.indexOf(OBSIDIAN_WINDOW);
   return window >= 0 ? OBSIDIAN_ROOT + joined.slice(window + OBSIDIAN_WINDOW.length) : joined;
 }
+
+/**
+ * Путь из ссылки — в путь внутри проекта. Абсолютный путь внутри кабинета — относительным,
+ * `/root/Obsidian/...` — через окно `!Obsidian/...` (оно есть в каждом кабинете, кроме самой базы).
+ * Иначе приложение просит у сервера файл вне проекта, и тот отказывает.
+ */
+export function t3patchWorkspacePath(cwd: string | null, path: string): string {
+  if (!path.startsWith("/") || cwd === null) return path;
+  const root = cwd.replace(/\/+$/, "");
+  if (path.startsWith(`${root}/`)) return path.slice(root.length + 1);
+  if (root !== "/root/Obsidian" && path.startsWith(OBSIDIAN_ROOT)) {
+    return `!Obsidian/${path.slice(OBSIDIAN_ROOT.length)}`;
+  }
+  return path;
+}
diff --git a/apps/mobile/src/sergey/sergey.test.ts b/apps/mobile/src/sergey/sergey.test.ts
