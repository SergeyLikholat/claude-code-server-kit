Удалённый файл (ссылка из старого сообщения), нет связи с сервером или файл
вне проекта — теперь это разные пояснения, а не одно общее.
---
 apps/mobile/src/sergey/FileUnavailable.tsx | 25 +++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/apps/mobile/src/sergey/FileUnavailable.tsx b/apps/mobile/src/sergey/FileUnavailable.tsx
index 34bec5079f..41ae7f2bf4 100644
--- a/apps/mobile/src/sergey/FileUnavailable.tsx
+++ b/apps/mobile/src/sergey/FileUnavailable.tsx
@@ -88,8 +88,26 @@ export function T3patchFileUnavailable(props: {
     draftCwd: props.threadId === null ? cwd : null,
   });
   const downloadUrl = asset._tag === "Success" ? asset.url : null;
-  // Сервер отказал в ссылке (файл вне проекта, скрытый файл, сервер без патча 0011).
+  // Сервер отказал в ссылке (файл удалён, вне проекта, скрытый, сервер без патча 0011).
   const downloadFailed = asset._tag === "Failure";
+  const disconnected = asset._tag === "Failure" && asset.reason === "disconnected";
+  // Есть ли файл на месте: смотрим список соседей в его папке.
+  const trimmedPath = relativePath.replace(/\/+$/, "");
+  const parentPath = trimmedPath.includes("/")
+    ? trimmedPath.slice(0, trimmedPath.lastIndexOf("/"))
+    : "";
+  const siblings = useEnvironmentQuery(
+    downloadFailed && !disconnected
+      ? projectEnvironment.listEntries({ environmentId, input: { cwd, directoryPath: parentPath } })
+      : null,
+  );
+  const missing =
+    siblings.data !== null && !siblings.data.entries.some((entry) => entry.path === trimmedPath);
+  const failureText = disconnected
+    ? "Нет связи с сервером — ссылку на скачивание получить не удалось. Проверь подключение и открой файл заново."
+    : missing
+      ? "Файла нет на месте: его удалили или переименовали после того, как появилась ссылка."
+      : "Сервер не выдал ссылку на этот файл: он вне проекта или скрытый. Скопируй путь и забери файл другим способом.";
 
   if (directory.isPending || isDirectory) {
     return (
@@ -111,10 +129,7 @@ export function T3patchFileUnavailable(props: {
         {t3patchFullPath(cwd, relativePath)}
       </Text>
       {downloadFailed ? (
-        <Text className="text-center text-xs text-foreground-muted">
-          Сервер не выдал ссылку на этот файл: он вне проекта или скрытый. Скопируй путь и забери
-          файл другим способом.
-        </Text>
+        <Text className="text-center text-xs text-foreground-muted">{failureText}</Text>
       ) : null}
       <View className="mt-3 items-center gap-2">
         <ActionButton
