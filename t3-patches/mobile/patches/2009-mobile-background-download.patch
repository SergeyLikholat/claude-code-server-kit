@@ -0,0 +1,35 @@
+/**
+ * t3-patch: скачать файл в фоне — системным «Диспетчером загрузок» Android
+ * (модуль modules/t3patch-download). Файл уходит в «Загрузки», ход виден в шторке,
+ * приложением можно пользоваться дальше. Если модуля нет (iOS, старая сборка) —
+ * ссылка открывается во внешнем браузере, как раньше.
+ */
+import { requireOptionalNativeModule } from "expo";
+import { Platform } from "react-native";
+
+import { tryOpenExternalUrl } from "../lib/openExternalUrl";
+
+interface T3patchDownloadModule {
+  enqueue(url: string, fileName: string): number;
+}
+
+export type T3patchDownloadResult = "background" | "browser" | "failed";
+
+export async function t3patchDownloadFile(
+  url: string,
+  fileName: string,
+): Promise<T3patchDownloadResult> {
+  const native =
+    Platform.OS === "android"
+      ? requireOptionalNativeModule<T3patchDownloadModule>("T3patchDownload")
+      : null;
+  if (native) {
+    try {
+      native.enqueue(url, fileName);
+      return "background";
+    } catch (error) {
+      console.error("t3patch: системная загрузка не запустилась", error);
+    }
+  }
+  return (await tryOpenExternalUrl(url, "file-preview")) ? "browser" : "failed";
+}
