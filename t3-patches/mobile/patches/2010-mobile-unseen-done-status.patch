index 0000000000..d450a3bb41
--- /dev/null
+++ b/apps/mobile/src/sergey/threadVisits.ts
@@ -0,0 +1,70 @@
+/**
+ * t3-patch: журнал открытий тредов на телефоне — для статуса «Готово».
+ *
+ * Браузер хранит время последнего открытия у себя (uiStateStore), на сервер оно не уходит,
+ * поэтому у приложения свой журнал: локальное хранилище expo-sqlite/kv-store. Открытие и уход
+ * с треда отмечаются; завершение работы, случившееся при открытом треде, тоже считается увиденным.
+ */
+import Storage from "expo-sqlite/kv-store";
+import { useEffect, useSyncExternalStore } from "react";
+
+export { t3patchHasUnseenCompletion, t3patchThreadVisitKey } from "./threadVisitsLogic";
+
+const STORAGE_KEY = "t3patch.threadVisits";
+const MAX_ENTRIES = 500;
+const listeners = new Set<() => void>();
+let visits: Readonly<Record<string, string>> | null = null;
+
+function load(): Readonly<Record<string, string>> {
+  if (visits !== null) return visits;
+  try {
+    const raw = Storage.getItemSync(STORAGE_KEY);
+    visits = raw ? (JSON.parse(raw) as Record<string, string>) : {};
+  } catch {
+    visits = {};
+  }
+  return visits;
+}
+
+export function t3patchMarkThreadVisited(key: string, at = new Date().toISOString()): void {
+  const next: Record<string, string> = { ...load(), [key]: at };
+  const keys = Object.keys(next);
+  if (keys.length > MAX_ENTRIES) {
+    // Старые записи — прочь: журнал не должен расти бесконечно.
+    for (const old of keys
+      .sort((a, b) => next[a]!.localeCompare(next[b]!))
+      .slice(0, keys.length - MAX_ENTRIES)) {
+      delete next[old];
+    }
+  }
+  visits = next;
+  try {
+    Storage.setItemSync(STORAGE_KEY, JSON.stringify(next));
+  } catch {
+    // хранилище недоступно — журнал живёт до перезапуска приложения
+  }
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function useT3patchThreadVisits(): Readonly<Record<string, string>> {
+  return useSyncExternalStore(subscribe, load, load);
+}
+
+/** Отмечать тред увиденным, пока он открыт: при входе, при завершении работы и при уходе. */
+export function useT3patchMarkThreadVisited(
+  key: string | null,
+  completedAt: string | null | undefined,
+): void {
+  useEffect(() => {
+    if (key === null) return;
+    t3patchMarkThreadVisited(key);
+    return () => t3patchMarkThreadVisited(key);
+  }, [key, completedAt]);
+}
diff --git a/apps/mobile/src/sergey/threadVisitsLogic.ts b/apps/mobile/src/sergey/threadVisitsLogic.ts
new file mode 100644
index 0000000000..cc32ffd88f
--- /dev/null
+++ b/apps/mobile/src/sergey/threadVisitsLogic.ts
@@ -0,0 +1,30 @@
+/**
+ * t3-patch: «Готово» — агент закончил работу после того, как тред открывали последний раз.
+ * Та же логика, что статус «Завершено» в браузере (hasUnseenCompletion в Sidebar.logic.ts).
+ * Чистые функции без нативных модулей — их проверяют тесты.
+ */
+
+/** Ключ треда в журнале открытий: окружение + тред. */
+export const t3patchThreadVisitKey = (environmentId: string, threadId: string) =>
+  `${environmentId}:${threadId}`;
+
+/**
+ * Тред закончил работу, а открывали его раньше. Тред, который ни разу не открывали на этом
+ * устройстве, не помечается — как в браузере: иначе после установки «Готово» висело бы на всех.
+ */
+export function t3patchHasUnseenCompletion(
+  completedAt: string | null | undefined,
+  lastVisitedAt: string | undefined,
+): boolean {
+  if (!completedAt || !lastVisitedAt) return false;
+  const completed = Date.parse(completedAt);
+  const visited = Date.parse(lastVisitedAt);
+  if (Number.isNaN(completed)) return false;
+  if (Number.isNaN(visited)) return true;
+  return completed > visited;
+}
+
+export const T3PATCH_DONE_STATUS = {
+  label: "Готово",
+  className: "text-adaptive-emerald-600-400",
+} as const;
