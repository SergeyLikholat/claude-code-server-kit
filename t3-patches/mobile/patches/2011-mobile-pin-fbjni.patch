+++ b/apps/mobile/plugins/withT3patchPinFbjni.cjs
@@ -0,0 +1,38 @@
+// t3-patch: закрепить fbjni на версии, с которой собран React Native.
+//
+// react-native-shiki-engine объявляет `com.facebook.fbjni:fbjni:+`. Когда вышла fbjni 0.8.1,
+// Gradle выбрал её вместо 0.7.0 из React Native: libfbjni.so от 0.8.1 несовместима с
+// остальными нативными библиотеками, и приложение падало на старте
+// («couldn't find DSO to load: libfbjni.so»). Версию берём из libs.versions.toml самого
+// React Native, чтобы при его обновлении закрепление шло следом.
+const fs = require("node:fs");
+const path = require("node:path");
+const { withProjectBuildGradle } = require("expo/config-plugins");
+
+const MARKER = "t3patch-pin-fbjni";
+
+function reactNativeFbjniVersion(projectRoot) {
+  const rnDir = path.dirname(
+    require.resolve("react-native/package.json", { paths: [projectRoot] }),
+  );
+  const toml = fs.readFileSync(path.join(rnDir, "gradle", "libs.versions.toml"), "utf8");
+  const match = toml.match(/^fbjni\s*=\s*"([^"]+)"/m);
+  if (!match) throw new Error("t3patch: версия fbjni не найдена в libs.versions.toml React Native");
+  return match[1];
+}
+
+module.exports = function withT3patchPinFbjni(config) {
+  return withProjectBuildGradle(config, (nextConfig) => {
+    if (nextConfig.modResults.contents.includes(MARKER)) return nextConfig;
+    const version = reactNativeFbjniVersion(nextConfig.modRequest.projectRoot);
+    nextConfig.modResults.contents += `
+// ${MARKER}: fbjni как в React Native, а не свежая из-за «fbjni:+» у зависимостей
+allprojects {
+  configurations.configureEach {
+    resolutionStrategy.force "com.facebook.fbjni:fbjni:${version}"
+  }
+}
+`;
+    return nextConfig;
+  });
+};
