@@ -0,0 +1,73 @@
+/**
+ * t3-patch: статусы треда, которые браузер показывает, а приложение — нет.
+ *
+ * Штатный список в приложении знает только «ждёт подтверждения», «ввод», «работает» и «сбой».
+ * Браузер (resolveThreadStatusPill в Sidebar.logic.ts) после завершения хода показывает ещё:
+ * «План готов» (режим плана, есть план к исполнению), «Работает» для фоновых субагентов,
+ * «Наблюдение» (агент следит за чем-то в фоне — Monitor, цикл проверки) и «Завершено».
+ * Здесь тот же порядок приоритетов. Чистая функция без нативных модулей — её проверяют тесты.
+ */
+import { t3patchHasUnseenCompletion } from "./threadVisitsLogic";
+
+export interface T3patchStatusLabel {
+  readonly label: string;
+  readonly className: string;
+}
+
+export interface T3patchStatusThread {
+  readonly interactionMode?: string | null | undefined;
+  readonly hasActionableProposedPlan?: boolean | undefined;
+  readonly backgroundLiveness?: "working" | "monitoring" | null | undefined;
+  readonly session?: { readonly status: string } | null | undefined;
+  readonly latestTurn?: {
+    readonly startedAt?: string | null | undefined;
+    readonly completedAt?: string | null | undefined;
+  } | null;
+}
+
+export const T3PATCH_PLAN_READY_STATUS: T3patchStatusLabel = {
+  label: "План готов",
+  className: "text-adaptive-violet-600-400",
+};
+export const T3PATCH_BACKGROUND_WORKING_STATUS: T3patchStatusLabel = {
+  label: "Работает",
+  className: "text-adaptive-sky-600-400",
+};
+export const T3PATCH_MONITORING_STATUS: T3patchStatusLabel = {
+  label: "Наблюдение",
+  className: "text-adaptive-sky-600-400",
+};
+export const T3PATCH_DONE_STATUS: T3patchStatusLabel = {
+  label: "Готово",
+  className: "text-adaptive-emerald-600-400",
+};
+
+/** Ход закончен и сессия не занята — как isLatestTurnSettled в браузере. */
+function latestTurnSettled(thread: T3patchStatusThread): boolean {
+  const turn = thread.latestTurn;
+  if (!turn?.startedAt || !turn.completedAt) return false;
+  return thread.session?.status !== "running";
+}
+
+/**
+ * Статус для треда, который штатная логика считает «готовым» (без подтверждений, ввода,
+ * работы и сбоя). null — подписи нет, в строке остаётся время.
+ */
+export function t3patchSettledThreadStatus(
+  thread: T3patchStatusThread,
+  lastVisitedAt: string | undefined,
+): T3patchStatusLabel | null {
+  if (
+    thread.interactionMode === "plan" &&
+    thread.hasActionableProposedPlan === true &&
+    latestTurnSettled(thread)
+  ) {
+    return T3PATCH_PLAN_READY_STATUS;
+  }
+  if (thread.backgroundLiveness === "working") return T3PATCH_BACKGROUND_WORKING_STATUS;
+  if (thread.backgroundLiveness === "monitoring") return T3PATCH_MONITORING_STATUS;
+  if (t3patchHasUnseenCompletion(thread.latestTurn?.completedAt, lastVisitedAt)) {
+    return T3PATCH_DONE_STATUS;
+  }
+  return null;
+}
