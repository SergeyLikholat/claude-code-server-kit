+    const merge = t3patchMergeServerVisits({
+      local: { "env:a": "2026-09-27T10:00:00.000Z" },
+      environmentId: "env",
+      server: { a: completedAt },
+      firstSnapshot: false,
+    });
+    expect(t3patchHasUnseenCompletion(completedAt, merge.local?.["env:a"])).toBe(false);
+  });
+});
