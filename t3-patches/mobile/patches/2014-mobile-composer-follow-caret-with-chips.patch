     emitContentSizeIfNeeded()
+    followCaretWithChips() // t3-patch
+  }
+
+  /**
+   * t3-patch: докрутка к курсору, когда в тексте есть плашки (вставленный скрин, файл).
+   * Замер на телефоне: без плашек Android сам держит курсор на виду (текст 134, поле 64,
+   * прокрутка 70), а с плашкой прокрутка остаётся 0 (текст 180) — набор уходит под край.
+   * Поэтому только при плашках, после раскладки: курсор ниже края — докрутить вниз, выше
+   * верха — вверх. Обычный набор без плашек не затрагивается.
+   */
+  private fun followCaretWithChips() {
+    if (tokens.isEmpty()) return
+    editor.post {
+      val layout = editor.layout ?: return@post
+      val caret = editor.selectionEnd
+      if (caret < 0 || !editor.hasFocus()) return@post
+      val line = layout.getLineForOffset(caret)
+      val visible = editor.height - editor.totalPaddingTop - editor.totalPaddingBottom
+      if (visible <= 0) return@post
+      val maxScroll = max(0, layout.height - visible)
+      val lineTop = layout.getLineTop(line)
+      val lineBottom = layout.getLineBottom(line)
+      val target = when {
+        lineBottom > editor.scrollY + visible -> lineBottom - visible
+        lineTop < editor.scrollY -> lineTop
+        else -> return@post
+      }.coerceIn(0, maxScroll)
+      editor.scrollTo(editor.scrollX, target)
+    }
   }
 
