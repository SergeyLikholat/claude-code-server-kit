diff --git a/apps/mobile/src/sergey/NewTaskFilesScreen.tsx b/apps/mobile/src/sergey/NewTaskFilesScreen.tsx
new file mode 100644
index 0000000000..61364fc274
--- /dev/null
+++ b/apps/mobile/src/sergey/NewTaskFilesScreen.tsx
@@ -0,0 +1,101 @@
+/**
+ * t3-patch: проводник в новом треде — до первого сообщения.
+ *
+ * Штатный проводник (ThreadFiles) открывается для созданного треда, а у нового его ещё нет.
+ * Здесь то же дерево файлов проекта по пути `cwd`: нажатие открывает файл (штатный экран
+ * NewTaskFile), долгое нажатие — «Вставить в сообщение» (ссылка в поле ввода нового треда)
+ * и «Копировать путь».
+ */
+import { StackActions, useNavigation, type StaticScreenProps } from "@react-navigation/native";
+import { EnvironmentId } from "@t3tools/contracts";
+import { useCallback, useLayoutEffect, useMemo, useState } from "react";
+import { View } from "react-native";
+
+import { SymbolView } from "../components/AppSymbol";
+import { AppTextInput as TextInput } from "../components/AppText";
+import { FileTreeBrowser } from "../features/files/FileTreeBrowser";
+import { useFileTreeEntries } from "../features/files/useFileTreeEntries";
+import { t3patchInsertFileLink } from "./fileLinkInsert";
+
+type Props = StaticScreenProps<{
+  readonly environmentId: string;
+  readonly cwd: string;
+  readonly projectName?: string;
+  /** Черновик нового треда, куда вставлять ссылки. */
+  readonly draftKey?: string;
+}>;
+
+export function T3patchNewTaskFilesScreen(props: Props) {
+  const navigation = useNavigation();
+  const { cwd, projectName, draftKey } = props.route.params;
+  const environmentId = useMemo(
+    () => EnvironmentId.make(props.route.params.environmentId),
+    [props.route.params.environmentId],
+  );
+  const [searchQuery, setSearchQuery] = useState("");
+  const entriesQuery = useFileTreeEntries({ cwd, environmentId, searchQuery });
+
+  useLayoutEffect(() => {
+    navigation.setOptions({ title: projectName ?? "Файлы" });
+  }, [navigation, projectName]);
+
+  const handleSelectFile = useCallback(
+    (path: string) => {
+      navigation.dispatch(
+        StackActions.push("NewTaskFile", {
+          environmentId: String(environmentId),
+          cwd,
+          ...(projectName ? { projectName } : {}),
+          path: path.split("/").filter((segment) => segment.length > 0),
+        }),
+      );
+    },
+    [cwd, environmentId, navigation, projectName],
+  );
+
+  const handleInsertPath = useCallback(
+    (path: string) => {
+      if (!draftKey) return;
+      t3patchInsertFileLink(draftKey, path);
+      if (navigation.canGoBack()) navigation.goBack();
+    },
+    [draftKey, navigation],
+  );
+
+  return (
+    <View className="flex-1 bg-screen">
+      <View className="mx-4 my-2 min-h-12 flex-row items-center gap-2 rounded-full border border-input-border bg-input px-3.5">
+        <SymbolView
+          name="magnifyingglass"
+          size={17}
+          tintColorClassName="accent-icon-muted"
+          type="monochrome"
+        />
+        <TextInput
+          accessibilityLabel="Поиск файлов"
+          autoCapitalize="none"
+          autoCorrect={false}
+          className="min-h-10 flex-1 py-2 text-sm text-foreground"
+          placeholder="Поиск файлов"
+          value={searchQuery}
+          onChangeText={setSearchQuery}
+        />
+      </View>
+      <FileTreeBrowser
+        key={JSON.stringify([environmentId, cwd])}
+        cwd={cwd}
+        entries={entriesQuery.entries}
+        loadedDirectories={entriesQuery.loadedDirectories}
+        onLoadDirectory={entriesQuery.loadDirectory}
+        error={entriesQuery.error}
+        isPending={entriesQuery.isPending}
+        searchQuery={searchQuery}
+        searchTruncated={entriesQuery.searchTruncated}
+        selectedPath={null}
+        onRefresh={entriesQuery.refresh}
+        onSelectFile={handleSelectFile}
+        {...(draftKey ? { t3patchOnInsertPath: handleInsertPath } : {})}
+      />
+    </View>
+  );
+}
diff --git a/apps/mobile/src/sergey/fileLinkInsert.ts b/apps/mobile/src/sergey/fileLinkInsert.ts
new file mode 100644
index 0000000000..87f51adac0
--- /dev/null
+++ b/apps/mobile/src/sergey/fileLinkInsert.ts
@@ -0,0 +1,17 @@
+/**
+ * t3-patch: «Вставить в сообщение» из проводника — ссылка на файл в конец черновика,
+ * та же, что ставит поиск по «@» (serializeComposerFileLink), с пробелом после неё.
+ */
+import { serializeComposerFileLink } from "@t3tools/shared/composerTrigger";
+
+import { appendComposerDraftText, getComposerDraftSnapshot } from "../state/use-composer-drafts";
+
+export function t3patchFileLinkText(existing: string, relativePath: string): string {
+  const needsSpace = existing.length > 0 && !/\s$/.test(existing);
+  return `${needsSpace ? " " : ""}${serializeComposerFileLink(relativePath)} `;
+}
+
+export function t3patchInsertFileLink(draftKey: string, relativePath: string): void {
+  const existing = getComposerDraftSnapshot(draftKey).text;
+  appendComposerDraftText(draftKey, t3patchFileLinkText(existing, relativePath));
+}
