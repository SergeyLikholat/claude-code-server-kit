-export function t3patchShowPathMenu(cwd: string | null, relativePath: string): void {
+/**
+ * Меню долгого нажатия на файл или папку. С `onInsert` первым пунктом идёт «Вставить в
+ * сообщение» (ссылка на файл в поле ввода). На Android у диалога не больше трёх кнопок,
+ * поэтому тогда вместо «Отмены» — закрытие нажатием мимо диалога.
+ */
+export function t3patchShowPathMenu(
+  cwd: string | null,
+  relativePath: string,
+  onInsert?: (relativePath: string) => void,
+): void {
   const name = relativePath.split("/").pop() ?? relativePath;
+  const copyFull = cwd
+    ? [
+        {
+          text: "Копировать полный путь",
+          onPress: () => copyTextWithHaptic(t3patchFullPath(cwd, relativePath)),
+        },
+      ]
+    : [];
+  if (onInsert) {
+    Alert.alert(
+      name,
+      undefined,
+      [
+        { text: "Вставить в сообщение", onPress: () => onInsert(relativePath) },
+        { text: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
+        ...copyFull,
+      ],
+      { cancelable: true },
+    );
+    return;
+  }
   Alert.alert(name, undefined, [
     { text: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
-    ...(cwd
-      ? [
-          {
-            text: "Копировать полный путь",
-            onPress: () => copyTextWithHaptic(t3patchFullPath(cwd, relativePath)),
-          },
-        ]
-      : []),
+    ...copyFull,
     { text: "Отмена", style: "cancel" as const },
   ]);
 }
