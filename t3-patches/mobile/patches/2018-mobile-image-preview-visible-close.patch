+++ b/apps/mobile/src/sergey/ImageViewer.tsx
@@ -0,0 +1,132 @@
+/**
+ * t3-patch: своё окно просмотра картинки вместо react-native-image-viewing.
+ *
+ * Библиотека на Android показывала чёрный экран (картинка не рисовалась, и `headers: {}` не
+ * помог), а её крестик уходил под строку состояния. Здесь: expo-image во весь экран
+ * (contain), увеличение двумя пальцами и двойным касанием, перетаскивание увеличенной
+ * картинки, шапка ниже строки состояния. Не открылась картинка — причина видна текстом.
+ */
+import { Image } from "expo-image";
+import { type ReactNode, useState } from "react";
+import { Modal, Pressable, View } from "react-native";
+import { Gesture, GestureDetector, GestureHandlerRootView } from "react-native-gesture-handler";
+import Animated, { useAnimatedStyle, useSharedValue, withTiming } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { SymbolView } from "../components/AppSymbol";
+import { AppText as Text } from "../components/AppText";
+
+const MAX_SCALE = 6;
+const DOUBLE_TAP_SCALE = 2.5;
+
+export function T3patchCloseButton(props: { readonly onClose: () => void }) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel="Закрыть"
+      hitSlop={12}
+      onPress={props.onClose}
+      className="size-12 items-center justify-center rounded-full bg-black/50 active:opacity-70"
+    >
+      <SymbolView name="xmark" size={20} tintColor="#ffffff" type="monochrome" />
+    </Pressable>
+  );
+}
+
+export function T3patchImageViewer(props: {
+  readonly uri: string;
+  readonly onClose: () => void;
+  /** Своя шапка (название, меню) — отступ под строку состояния делает сама; по умолчанию — крестик. */
+  readonly header?: ReactNode;
+}) {
+  const insets = useSafeAreaInsets();
+  const [error, setError] = useState<string | null>(null);
+  const scale = useSharedValue(1);
+  const savedScale = useSharedValue(1);
+  const x = useSharedValue(0);
+  const y = useSharedValue(0);
+  const savedX = useSharedValue(0);
+  const savedY = useSharedValue(0);
+
+  const pinch = Gesture.Pinch()
+    .onUpdate((event) => {
+      scale.value = Math.min(MAX_SCALE, Math.max(1, savedScale.value * event.scale));
+    })
+    .onEnd(() => {
+      savedScale.value = scale.value;
+      if (scale.value <= 1) {
+        x.value = withTiming(0);
+        y.value = withTiming(0);
+        savedX.value = 0;
+        savedY.value = 0;
+      }
+    });
+  const pan = Gesture.Pan()
+    .averageTouches(true)
+    .onUpdate((event) => {
+      if (scale.value <= 1) return;
+      x.value = savedX.value + event.translationX;
+      y.value = savedY.value + event.translationY;
+    })
+    .onEnd(() => {
+      savedX.value = x.value;
+      savedY.value = y.value;
+    });
+  const doubleTap = Gesture.Tap()
+    .numberOfTaps(2)
+    .onEnd(() => {
+      const zoomIn = scale.value <= 1;
+      const target = zoomIn ? DOUBLE_TAP_SCALE : 1;
+      scale.value = withTiming(target);
+      savedScale.value = target;
+      if (!zoomIn) {
+        x.value = withTiming(0);
+        y.value = withTiming(0);
+        savedX.value = 0;
+        savedY.value = 0;
+      }
+    });
+  const gesture = Gesture.Simultaneous(pinch, pan, doubleTap);
+  const imageStyle = useAnimatedStyle(() => ({
+    transform: [{ translateX: x.value }, { translateY: y.value }, { scale: scale.value }],
+  }));
+
+  return (
+    <Modal
+      visible
+      animationType="fade"
+      statusBarTranslucent
+      navigationBarTranslucent
+      onRequestClose={props.onClose}
+    >
+      <GestureHandlerRootView style={{ flex: 1, backgroundColor: "#000000" }}>
+        <GestureDetector gesture={gesture}>
+          <Animated.View style={[{ flex: 1 }, imageStyle]}>
+            <Image
+              source={{ uri: props.uri }}
+              style={{ flex: 1 }}
+              contentFit="contain"
+              onError={(event) => setError(event.error)}
+            />
+          </Animated.View>
+        </GestureDetector>
+        {error ? (
+          <View className="absolute inset-x-6 top-1/2 items-center">
+            <Text className="text-center text-sm text-white">Картинка не открылась: {error}</Text>
+          </View>
+        ) : null}
+        <View className="absolute inset-x-0 top-0" pointerEvents="box-none">
+          {props.header ?? (
+            <View
+              className="flex-row justify-end px-2"
+              style={{ paddingTop: insets.top + 4 }}
+              pointerEvents="box-none"
+            >
+              <T3patchCloseButton onClose={props.onClose} />
+            </View>
+          )}
+        </View>
+      </GestureHandlerRootView>
+    </Modal>
+  );
+}
