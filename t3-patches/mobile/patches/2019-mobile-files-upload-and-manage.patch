diff --git a/apps/mobile/src/sergey/ActionSheet.tsx b/apps/mobile/src/sergey/ActionSheet.tsx
new file mode 100644
index 0000000000..26897b6272
--- /dev/null
+++ b/apps/mobile/src/sergey/ActionSheet.tsx
@@ -0,0 +1,147 @@
+/**
+ * t3-patch: панель действий снизу и окно ввода имени.
+ *
+ * Системный диалог Android вмещает не больше трёх кнопок, а ввода текста в нём нет (Alert.prompt —
+ * только iOS). У проводника теперь до семи действий и нужен ввод имени папки, поэтому — своя
+ * панель. Вызывается из любого места (`t3patchShowActions`, `t3patchPromptText`), рисуется
+ * одним хостом `T3patchActionSheetHost` в корне приложения.
+ */
+import { useEffect, useState, useSyncExternalStore } from "react";
+import { Modal, Pressable, TextInput, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { AppText as Text } from "../components/AppText";
+
+export interface T3patchAction {
+  readonly label: string;
+  readonly destructive?: boolean;
+  readonly onPress: () => void;
+}
+
+type SheetState =
+  | {
+      readonly kind: "actions";
+      readonly title: string;
+      readonly actions: ReadonlyArray<T3patchAction>;
+    }
+  | {
+      readonly kind: "prompt";
+      readonly title: string;
+      readonly initial: string;
+      readonly confirmLabel: string;
+      readonly resolve: (value: string | null) => void;
+    }
+  | null;
+
+let state: SheetState = null;
+const listeners = new Set<() => void>();
+const set = (next: SheetState) => {
+  state = next;
+  for (const listener of listeners) listener();
+};
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+export function t3patchShowActions(title: string, actions: ReadonlyArray<T3patchAction>): void {
+  set({ kind: "actions", title, actions });
+}
+
+export function t3patchPromptText(
+  title: string,
+  initial = "",
+  confirmLabel = "Готово",
+): Promise<string | null> {
+  return new Promise((resolve) => set({ kind: "prompt", title, initial, confirmLabel, resolve }));
+}
+
+function PromptBody(props: Extract<NonNullable<SheetState>, { kind: "prompt" }>) {
+  const [value, setValue] = useState(props.initial);
+  useEffect(() => setValue(props.initial), [props.initial]);
+  const finish = (result: string | null) => {
+    set(null);
+    props.resolve(result);
+  };
+  return (
+    <View className="gap-4">
+      <Text className="text-base font-t3-bold text-foreground">{props.title}</Text>
+      <TextInput
+        autoFocus
+        selectTextOnFocus
+        value={value}
+        onChangeText={setValue}
+        onSubmitEditing={() => finish(value.trim() || null)}
+        className="rounded-xl border border-border bg-input px-3 py-2.5 text-base text-foreground"
+      />
+      <View className="flex-row justify-end gap-2">
+        <Pressable
+          className="rounded-full px-4 py-2.5 active:opacity-70"
+          onPress={() => finish(null)}
+        >
+          <Text className="text-sm font-t3-medium text-foreground-muted">Отмена</Text>
+        </Pressable>
+        <Pressable
+          className="rounded-full bg-primary px-4 py-2.5 active:opacity-70"
+          onPress={() => finish(value.trim() || null)}
+        >
+          <Text className="text-sm font-t3-bold text-primary-foreground">{props.confirmLabel}</Text>
+        </Pressable>
+      </View>
+    </View>
+  );
+}
+
+export function T3patchActionSheetHost() {
+  const current = useSyncExternalStore(subscribe, () => state);
+  const insets = useSafeAreaInsets();
+  if (!current) return null;
+  const close = () => {
+    if (current.kind === "prompt") current.resolve(null);
+    set(null);
+  };
+  return (
+    <Modal visible transparent animationType="fade" statusBarTranslucent onRequestClose={close}>
+      <Pressable className="flex-1 justify-end bg-black/40" onPress={close}>
+        <Pressable
+          // нажатие внутри панели не закрывает её
+          onPress={() => undefined}
+          className="rounded-t-3xl bg-sheet px-5 pt-4"
+          style={{ paddingBottom: insets.bottom + 12 }}
+        >
+          {current.kind === "prompt" ? (
+            <PromptBody {...current} />
+          ) : (
+            <View>
+              <Text className="mb-2 text-sm text-foreground-muted" numberOfLines={2}>
+                {current.title}
+              </Text>
+              {current.actions.map((action) => (
+                <Pressable
+                  key={action.label}
+                  className="rounded-xl px-2 py-3.5 active:bg-subtle"
+                  onPress={() => {
+                    set(null);
+                    action.onPress();
+                  }}
+                >
+                  <Text
+                    className={
+                      action.destructive
+                        ? "text-base text-danger-foreground"
+                        : "text-base text-foreground"
+                    }
+                  >
+                    {action.label}
+                  </Text>
+                </Pressable>
+              ))}
+            </View>
+          )}
+        </Pressable>
+      </Pressable>
+    </Modal>
+  );
+}
