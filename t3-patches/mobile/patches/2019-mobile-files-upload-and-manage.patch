diff --git a/apps/mobile/src/sergey/pathActions.ts b/apps/mobile/src/sergey/pathActions.ts
index 26dee48907..023c30abf3 100644
--- a/apps/mobile/src/sergey/pathActions.ts
+++ b/apps/mobile/src/sergey/pathActions.ts
@@ -1,51 +1,170 @@
 /**
- * t3-patch: пути к файлам в приложении — как «Копировать путь» / «Копировать полный путь»
- * в браузерной версии (патч 0002).
+ * t3-patch: меню долгого нажатия на файл или папку в проводнике приложения.
  *
+ * Пути — как «Копировать путь» / «Копировать полный путь» в браузерной версии (патч 0002).
  * Полный путь раскрывает окно `!Obsidian` в настоящий путь базы: в каждом кабинете это
- * bind-монтирование `/root/Obsidian` только для чтения. Веб-версия узнаёт настоящий путь у
- * сервера; приложению тот маршрут недоступен (другой способ входа), поэтому правило задано здесь.
+ * bind-монтирование `/root/Obsidian` только для чтения.
+ *
+ * Файловые операции (патч сервера 0018): «Загрузить сюда», «Новая папка», «Переименовать»,
+ * «Удалить» (в корзину, с кнопкой «Вернуть»). Меню — своя панель снизу (ActionSheet.tsx):
+ * системный диалог Android вмещает не больше трёх кнопок.
  */
+import type { EnvironmentId } from "@t3tools/contracts";
 import { Alert } from "react-native";
 
 import { copyTextWithHaptic } from "../lib/copyTextWithHaptic";
+import { type T3patchAction, t3patchPromptText, t3patchShowActions } from "./ActionSheet";
 import { t3patchFullPath } from "./paths";
+import { t3patchEnqueueUploads, t3patchPickFiles, t3patchWorkspace } from "./workspaceUploads";
+
+export interface T3patchPathMenuWorkspace {
+  readonly environmentId: EnvironmentId;
+  /** Обновить дерево после изменения. */
+  readonly onChanged: () => void;
+}
+
+const parentOf = (path: string) => (path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "");
+const baseName = (path: string) => path.split("/").pop() ?? path;
+
+function reportError(title: string, error: unknown) {
+  Alert.alert(title, error instanceof Error ? error.message : String(error));
+}
+
+function workspaceActions(
+  cwd: string,
+  relativePath: string,
+  isDirectory: boolean,
+  workspace: T3patchPathMenuWorkspace,
+): T3patchAction[] {
+  const { environmentId, onChanged } = workspace;
+  const directoryActions: T3patchAction[] = isDirectory
+    ? [
+        {
+          label: "Загрузить сюда",
+          onPress: () => {
+            void t3patchPickFiles().then((files) => {
+              if (files.length === 0) return;
+              t3patchEnqueueUploads({
+                environmentId,
+                cwd,
+                directory: relativePath,
+                files,
+                onUploaded: onChanged,
+              });
+            });
+          },
+        },
+        {
+          label: "Новая папка",
+          onPress: () => {
+            void t3patchPromptText("Название новой папки", "Новая папка", "Создать").then(
+              async (name) => {
+                if (!name) return;
+                try {
+                  await t3patchWorkspace.mkdir(
+                    environmentId,
+                    cwd,
+                    [relativePath, name].filter(Boolean).join("/"),
+                  );
+                  onChanged();
+                } catch (error) {
+                  reportError("Не удалось создать папку", error);
+                }
+              },
+            );
+          },
+        },
+      ]
+    : [];
+  // корень проекта не переименовывается и не удаляется
+  if (relativePath === "") return directoryActions;
+  return [
+    ...directoryActions,
+    {
+      label: "Переименовать",
+      onPress: () => {
+        void t3patchPromptText("Новое имя", baseName(relativePath), "Переименовать").then(
+          async (name) => {
+            if (!name || name === baseName(relativePath)) return;
+            try {
+              await t3patchWorkspace.move(
+                environmentId,
+                cwd,
+                relativePath,
+                [parentOf(relativePath), name].filter(Boolean).join("/"),
+              );
+              onChanged();
+            } catch (error) {
+              reportError("Не удалось переименовать", error);
+            }
+          },
+        );
+      },
+    },
+    {
+      label: "Удалить",
+      destructive: true,
+      onPress: () => {
+        Alert.alert(
+          `Удалить «${baseName(relativePath)}»?`,
+          "Уйдёт в корзину, вернуть можно 30 дней.",
+          [
+            { text: "Отмена", style: "cancel" },
+            {
+              text: "Удалить",
+              style: "destructive",
+              onPress: () => {
+                void t3patchWorkspace
+                  .trash(environmentId, cwd, relativePath)
+                  .then((item) => {
+                    onChanged();
+                    Alert.alert("Удалено в корзину", relativePath, [
+                      { text: "Готово", style: "cancel" },
+                      {
+                        text: "Вернуть",
+                        onPress: () => {
+                          void t3patchWorkspace
+                            .restore(environmentId, item.id)
+                            .then(onChanged)
+                            .catch((error: unknown) => reportError("Не удалось вернуть", error));
+                        },
+                      },
+                    ]);
+                  })
+                  .catch((error: unknown) => reportError("Не удалось удалить", error));
+              },
+            },
+          ],
+        );
+      },
+    },
+  ];
+}
 
 /**
- * Меню долгого нажатия на файл или папку. С `onInsert` первым пунктом идёт «Вставить в
- * сообщение» (ссылка на файл в поле ввода). На Android у диалога не больше трёх кнопок,
- * поэтому тогда вместо «Отмены» — закрытие нажатием мимо диалога.
+ * Меню долгого нажатия. `onInsert` — «Вставить в сообщение» первым пунктом; `workspace` —
+ * файловые операции (нужны окружение и обновление дерева).
  */
 export function t3patchShowPathMenu(
   cwd: string | null,
   relativePath: string,
   onInsert?: (relativePath: string) => void,
+  options?: { readonly isDirectory: boolean; readonly workspace?: T3patchPathMenuWorkspace },
 ): void {
-  const name = relativePath.split("/").pop() ?? relativePath;
-  const copyFull = cwd
-    ? [
-        {
-          text: "Копировать полный путь",
-          onPress: () => copyTextWithHaptic(t3patchFullPath(cwd, relativePath)),
-        },
-      ]
-    : [];
-  if (onInsert) {
-    Alert.alert(
-      name,
-      undefined,
-      [
-        { text: "Вставить в сообщение", onPress: () => onInsert(relativePath) },
-        { text: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
-        ...copyFull,
-      ],
-      { cancelable: true },
-    );
-    return;
-  }
-  Alert.alert(name, undefined, [
-    { text: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
-    ...copyFull,
-    { text: "Отмена", style: "cancel" as const },
-  ]);
+  const actions: T3patchAction[] = [
+    ...(onInsert ? [{ label: "Вставить в сообщение", onPress: () => onInsert(relativePath) }] : []),
+    ...(cwd && options?.workspace
+      ? workspaceActions(cwd, relativePath, options.isDirectory, options.workspace)
+      : []),
+    { label: "Копировать путь", onPress: () => copyTextWithHaptic(relativePath) },
+    ...(cwd
+      ? [
+          {
+            label: "Копировать полный путь",
+            onPress: () => copyTextWithHaptic(t3patchFullPath(cwd, relativePath)),
+          },
+        ]
+      : []),
+  ];
+  t3patchShowActions(relativePath === "" ? "Корень проекта" : baseName(relativePath), actions);
 }
diff --git a/apps/mobile/src/sergey/workspaceUploads.tsx b/apps/mobile/src/sergey/workspaceUploads.tsx
new file mode 100644
index 0000000000..fa3c618d98
--- /dev/null
+++ b/apps/mobile/src/sergey/workspaceUploads.tsx
@@ -0,0 +1,384 @@
+/**
+ * t3-patch: файловые операции проводника на телефоне и загрузка файлов в папку.
+ *
+ * Сервер — apps/server/src/sergey/workspaceOps.ts (патч 0018). Загрузка: подписанная ссылка →
+ * файл кусками по 4 МБ; обрыв связи — пауза, вопрос серверу «сколько дошло», продолжение.
+ * Прогресс — плашка внизу экрана проводника (`T3patchUploadStrip`).
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { resolveAssetUrl } from "@t3tools/client-runtime/state/assets";
+import {
+  type AtomCommand,
+  runAtomCommand,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import * as Option from "effect/Option";
+import { useEffect, useSyncExternalStore } from "react";
+import { Alert, Pressable, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { AppText as Text } from "../components/AppText";
+import { appAtomRegistry } from "../state/atom-registry";
+import { serverEnvironment } from "../state/server";
+import { beginForegroundHandoff } from "../lib/foreground-handoff";
+import { environmentSession } from "../state/session";
+
+function failureMessage(error: unknown): string {
+  if (error && typeof error === "object" && "message" in error) return String(error.message);
+  return String(error);
+}
+
+async function call<I, A>(
+  command: AtomCommand<{ environmentId: EnvironmentId; input: I }, A, unknown>,
+  environmentId: EnvironmentId,
+  input: I,
+): Promise<A> {
+  // Без ответа сервера загрузка не должна «крутиться» вечно — через 30 с понятная ошибка.
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(
+      () => reject(new Error("Сервер не ответил за 30 секунд — проверьте связь и повторите.")),
+      30_000,
+    );
+  });
+  const result = await Promise.race([
+    timeout,
+    runAtomCommand(
+      appAtomRegistry,
+      command,
+      { environmentId, input },
+      {
+        reportFailure: false,
+        reportDefect: false,
+      },
+    ),
+  ]).finally(() => clearTimeout(timer));
+  if (result._tag === "Success") return result.value;
+  throw new Error(failureMessage(squashAtomCommandFailure(result)));
+}
+
+export const t3patchWorkspace = {
+  mkdir: (environmentId: EnvironmentId, cwd: string, relativePath: string) =>
+    call(serverEnvironment.t3patchWorkspaceMkdir, environmentId, { cwd, relativePath }),
+  move: (environmentId: EnvironmentId, cwd: string, from: string, to: string) =>
+    call(serverEnvironment.t3patchWorkspaceMove, environmentId, { cwd, from, to }),
+  trash: (environmentId: EnvironmentId, cwd: string, relativePath: string) =>
+    call(serverEnvironment.t3patchWorkspaceTrash, environmentId, { cwd, relativePath }),
+  restore: (environmentId: EnvironmentId, id: string) =>
+    call(serverEnvironment.t3patchWorkspaceRestore, environmentId, { id }),
+};
+
+const CHUNK_BYTES = 4 * 1024 * 1024;
+const RETRY_DELAYS_MS = [1_000, 2_000, 5_000, 10_000, 20_000, 30_000];
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+function serverUrl(environmentId: EnvironmentId, relativeUrl: string): string {
+  const connection = appAtomRegistry.get(
+    environmentSession.preparedConnectionValueAtom(environmentId),
+  );
+  const url = Option.isNone(connection)
+    ? null
+    : resolveAssetUrl(connection.value.httpBaseUrl, relativeUrl);
+  if (!url) throw new Error("Нет связи с сервером.");
+  return url;
+}
+
+export interface T3patchPickedFile {
+  readonly uri: string;
+  readonly name: string;
+  readonly size: number;
+}
+
+interface UploadItem {
+  readonly id: number;
+  readonly name: string;
+  readonly size: number;
+  sent: number;
+  status: "waiting" | "preparing" | "uploading" | "done" | "error";
+  error?: string;
+}
+
+let items: UploadItem[] = [];
+let nextId = 1;
+let running = false;
+const queue: Array<() => Promise<void>> = [];
+const listeners = new Set<() => void>();
+const emit = () => {
+  items = [...items];
+  for (const listener of listeners) listener();
+};
+
+async function sendFile(
+  environmentId: EnvironmentId,
+  relativeUrl: string,
+  picked: T3patchPickedFile,
+  onProgress: (sent: number) => void,
+): Promise<void> {
+  const { File, Paths, UploadType } = await import("expo-file-system");
+  const file = new File(picked.uri);
+  let offset = 0;
+  let failures = 0;
+  for (;;) {
+    // Кусок — во временный файл и нативным загрузчиком (как вложения чата): без base64 в JS.
+    const piece = new File(Paths.cache, `t3patch-upload-${Date.now()}-${offset}`);
+    try {
+      const url = serverUrl(environmentId, relativeUrl);
+      const length = Math.min(CHUNK_BYTES, picked.size - offset);
+      const reader = file.open();
+      let chunk: Uint8Array;
+      try {
+        reader.offset = offset;
+        chunk = reader.readBytes(length);
+      } finally {
+        reader.close();
+      }
+      piece.create({ overwrite: true });
+      const writer = piece.open();
+      try {
+        writer.writeBytes(chunk);
+      } finally {
+        writer.close();
+      }
+      const response = await piece.upload(`${url}?offset=${offset}`, {
+        httpMethod: "POST",
+        uploadType: UploadType.BINARY_CONTENT,
+        headers: { "Content-Type": "application/octet-stream" },
+        // ход внутри куска — процент растёт плавно, а не скачками по 4 МБ
+        onProgress: ({ bytesSent }) => onProgress(offset + bytesSent),
+      });
+      let body: { offset?: number; done?: boolean; error?: string } = {};
+      try {
+        body = JSON.parse(response.body) as typeof body;
+      } catch {
+        // не JSON — ориентируемся на код ответа
+      }
+      const ok = response.status >= 200 && response.status < 300;
+      if (response.status === 409 && typeof body.offset === "number") {
+        if (piece.exists) piece.delete();
+        offset = body.offset;
+        continue;
+      }
+      if (!ok) {
+        throw Object.assign(new Error(body.error ?? `Сервер ответил ${response.status}`), {
+          fatal: response.status < 500,
+        });
+      }
+      failures = 0;
+      offset = body.offset ?? offset + length;
+      if (piece.exists) piece.delete();
+      onProgress(offset);
+      if (body.done) return;
+    } catch (error) {
+      if (piece.exists) piece.delete();
+      if ((error as { fatal?: boolean }).fatal) throw error;
+      await sleep(RETRY_DELAYS_MS[Math.min(failures, RETRY_DELAYS_MS.length - 1)]!);
+      failures += 1;
+      try {
+        const status = await fetch(serverUrl(environmentId, relativeUrl));
+        const body = (await status.json()) as { offset?: number };
+        if (status.ok && typeof body.offset === "number") {
+          offset = body.offset;
+          onProgress(offset);
+        }
+      } catch {
+        // связи всё ещё нет — следующая попытка после паузы
+      }
+    }
+  }
+}
+
+async function drain() {
+  if (running) return;
+  running = true;
+  while (queue.length > 0) await queue.shift()!();
+  running = false;
+}
+
+export function t3patchEnqueueUploads(input: {
+  readonly environmentId: EnvironmentId;
+  readonly cwd: string;
+  readonly directory: string;
+  readonly files: ReadonlyArray<T3patchPickedFile>;
+  readonly onUploaded: () => void;
+}): void {
+  for (const picked of input.files) {
+    const item: UploadItem = {
+      id: nextId++,
+      name: picked.name,
+      size: picked.size,
+      sent: 0,
+      status: "waiting",
+    };
+    items.push(item);
+    queue.push(async () => {
+      item.status = "preparing";
+      emit();
+      try {
+        const upload = await call(
+          serverEnvironment.t3patchWorkspaceCreateUpload,
+          input.environmentId,
+          {
+            cwd: input.cwd,
+            directory: input.directory,
+            name: picked.name,
+            sizeBytes: picked.size,
+          },
+        );
+        item.status = "uploading";
+        emit();
+        await sendFile(input.environmentId, upload.relativeUrl, picked, (sent) => {
+          item.sent = Math.min(sent, item.size);
+          emit();
+        });
+        item.sent = item.size;
+        item.status = "done";
+        input.onUploaded();
+      } catch (error) {
+        item.status = "error";
+        item.error = failureMessage(error);
+        Alert.alert(`Не загружено: ${item.name}`, item.error);
+      }
+      emit();
+    });
+  }
+  emit();
+  void drain();
+}
+
+/** Выбрать файлы на телефоне (файлы, фото из галереи — через системный выбор). */
+export async function t3patchPickFiles(): Promise<T3patchPickedFile[]> {
+  // Как штатное прикрепление в чате: окно выбора — «передача» другому приложению.
+  const endHandoff = beginForegroundHandoff();
+  try {
+    const DocumentPicker = await import("expo-document-picker");
+    const result = await DocumentPicker.getDocumentAsync({
+      multiple: true,
+      copyToCacheDirectory: true,
+    });
+    if (result.canceled) return [];
+    const { File } = await import("expo-file-system");
+    return result.assets.map((asset) => {
+      // окно выбора не всегда сообщает размер — берём у самого файла
+      let size = asset.size ?? 0;
+      if (!size) {
+        try {
+          size = new File(asset.uri).size ?? 0;
+        } catch {
+          size = 0;
+        }
+      }
+      return { uri: asset.uri, name: asset.name, size };
+    });
+  } catch (error) {
+    Alert.alert("Не удалось выбрать файлы", failureMessage(error));
+    return [];
+  } finally {
+    endHandoff();
+  }
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+const formatBytes = (bytes: number) =>
+  bytes === 0
+    ? "0 КБ"
+    : bytes >= 1024 ** 3
+      ? `${(bytes / 1024 ** 3).toFixed(1)} ГБ`
+      : bytes >= 1024 ** 2
+        ? `${(bytes / 1024 ** 2).toFixed(1)} МБ`
+        : `${Math.max(1, Math.round(bytes / 1024))} КБ`;
+
+/**
+ * Карточка загрузок поверх экрана, внизу: крупный процент, мегабайты, полоса, этап. Видна на
+ * любом экране, пока идёт загрузка; с ошибкой остаётся, пока её не закроют.
+ */
+export function T3patchUploadOverlay() {
+  const current = useSyncExternalStore(subscribe, () => items);
+  const insets = useSafeAreaInsets();
+  const active = current.some(
+    (item) =>
+      item.status === "waiting" || item.status === "preparing" || item.status === "uploading",
+  );
+  const failed = current.filter((item) => item.status === "error");
+  useEffect(() => {
+    if (current.length === 0 || active || failed.length > 0) return;
+    const timer = setTimeout(() => {
+      items = [];
+      emit();
+    }, 4_000);
+    return () => clearTimeout(timer);
+  }, [active, current.length, failed.length]);
+  if (current.length === 0) return null;
+
+  const totalBytes = current.reduce((sum, item) => sum + item.size, 0);
+  const sentBytes = current.reduce(
+    (sum, item) => sum + (item.status === "done" ? item.size : item.sent),
+    0,
+  );
+  const percent = totalBytes > 0 ? Math.floor((sentBytes / totalBytes) * 100) : active ? 0 : 100;
+  const currentItem = current.find(
+    (item) => item.status === "preparing" || item.status === "uploading",
+  );
+  const done = current.filter((item) => item.status === "done").length;
+  const title = active
+    ? currentItem?.status === "preparing"
+      ? "Готовлю загрузку…"
+      : `Загрузка ${done + 1} из ${current.length}`
+    : failed.length > 0
+      ? `Не загружено: ${failed.length} из ${current.length}`
+      : current.length === 1
+        ? "Загружено"
+        : `Загружено: ${current.length}`;
+
+  return (
+    <View
+      pointerEvents="box-none"
+      className="absolute inset-x-0 bottom-0"
+      style={{ paddingBottom: insets.bottom + 12 }}
+    >
+      <View className="mx-3 gap-2 rounded-2xl border border-border bg-sheet px-4 py-3 shadow-lg">
+        <View className="flex-row items-center justify-between gap-3">
+          <Text className="flex-1 text-sm font-t3-medium text-foreground" numberOfLines={1}>
+            {title}
+          </Text>
+          <Text className="text-xl font-t3-bold text-foreground">{percent}%</Text>
+          {active ? null : (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="Закрыть"
+              hitSlop={12}
+              onPress={() => {
+                items = [];
+                emit();
+              }}
+            >
+              <Text className="text-base text-foreground-muted">✕</Text>
+            </Pressable>
+          )}
+        </View>
+        <View className="h-1.5 overflow-hidden rounded-full bg-subtle">
+          <View
+            className={
+              failed.length > 0 && !active ? "h-full bg-danger-foreground" : "h-full bg-primary"
+            }
+            style={{ width: `${percent}%` }}
+          />
+        </View>
+        <Text className="text-xs text-foreground-muted" numberOfLines={1}>
+          {currentItem ? `${currentItem.name} · ` : ""}
+          {formatBytes(sentBytes)} из {formatBytes(totalBytes)}
+        </Text>
+        {failed.slice(0, 2).map((item) => (
+          <Text key={item.id} className="text-xs text-danger-foreground" numberOfLines={3}>
+            {item.name}: {item.error}
+          </Text>
+        ))}
+      </View>
+    </View>
+  );
+}
