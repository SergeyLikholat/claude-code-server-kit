+package expo.modules.t3patchupload
+
+import android.content.Intent
+import android.os.Build
+import expo.modules.kotlin.exception.Exceptions
+import expo.modules.kotlin.modules.Module
+import expo.modules.kotlin.modules.ModuleDefinition
+
+/**
+ * t3-patch: мост к службе фоновой загрузки (T3patchUploadService).
+ *   enqueue(jobJson) — поставить файл в очередь: {id, url, uri, name, size}
+ *   status()         — состояние всех задач JSON-строкой: {id: {sent, size, state, error, relativePath}}
+ *   forget(id)       — убрать завершённую задачу из списка
+ */
+class T3patchUploadModule : Module() {
+  override fun definition() = ModuleDefinition {
+    Name("T3patchUpload")
+
+    Function("enqueue") { jobJson: String ->
+      val context = appContext.reactContext ?: throw Exceptions.ReactContextLost()
+      val intent = Intent(context, T3patchUploadService::class.java).putExtra(T3patchUploadService.EXTRA_JOB, jobJson)
+      if (Build.VERSION.SDK_INT >= 26) context.startForegroundService(intent) else context.startService(intent)
+      Unit
+    }
+
+    // Тип результата — только из «прямого» списка Expo (Unit, Long, Any…). Для прочих (String,
+    // ComponentName, Job) Expo зовёт заглушку плагина компилятора pika, которого у наших
+    // модулей нет: NotImplementedError при регистрации модуля, приложение висит на заставке.
+    Function("status") { -> T3patchUploadService.statusJson() as Any }
+
+    Function("forget") { id: String ->
+      T3patchUploadService.jobs.remove(id)
+      Unit
+    }
+  }
+}
diff --git a/apps/mobile/modules/t3patch-upload/android/src/main/java/expo/modules/t3patchupload/T3patchUploadService.kt b/apps/mobile/modules/t3patch-upload/android/src/main/java/expo/modules/t3patchupload/T3patchUploadService.kt
new file mode 100644
index 0000000000..6bf3ef9a9d
--- /dev/null
+++ b/apps/mobile/modules/t3patch-upload/android/src/main/java/expo/modules/t3patchupload/T3patchUploadService.kt
@@ -0,0 +1,296 @@
+package expo.modules.t3patchupload
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.net.Uri
+import android.os.Build
+import android.os.IBinder
+import org.json.JSONObject
+import java.io.File
+import java.io.RandomAccessFile
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.LinkedBlockingQueue
+
+/**
+ * t3-patch: загрузка файлов на сервер T3 в фоне.
+ *
+ * Служба переднего плана (уведомление в шторке) — Android не останавливает её, когда приложение
+ * свёрнуто. Протокол сервера (патч 0018): GET <ссылка> → сколько уже получено; POST
+ * <ссылка>?offset=N, тело — следующий кусок. Обрыв связи — пауза и продолжение с того места, где
+ * сервер остановился. Состояние задач — в памяти процесса, приложение опрашивает его (status()).
+ */
+class T3patchUploadService : Service() {
+  data class Job(
+    val id: String,
+    val url: String,
+    val uri: String,
+    val name: String,
+    val size: Long,
+    @Volatile var sent: Long = 0,
+    @Volatile var state: String = "queued", // queued | uploading | done | error
+    @Volatile var error: String? = null,
+    @Volatile var relativePath: String? = null,
+  )
+
+  companion object {
+    const val EXTRA_JOB = "t3patch.job"
+    private const val CHANNEL = "t3patch_uploads"
+    private const val NOTIFICATION_ID = 7341
+    private const val CHUNK = 4L * 1024 * 1024
+    private val RETRY_MS = longArrayOf(1_000, 2_000, 5_000, 10_000, 20_000, 30_000)
+    private const val MAX_FAILURES = 80 // ~35 минут попыток при пропавшей связи
+
+    val jobs = ConcurrentHashMap<String, Job>()
+    private val queue = LinkedBlockingQueue<Job>()
+    @Volatile private var worker: Thread? = null
+
+    fun statusJson(): String {
+      val root = JSONObject()
+      for ((id, job) in jobs) {
+        root.put(
+          id,
+          JSONObject()
+            .put("sent", job.sent)
+            .put("size", job.size)
+            .put("state", job.state)
+            .put("error", job.error ?: JSONObject.NULL)
+            .put("relativePath", job.relativePath ?: JSONObject.NULL),
+        )
+      }
+      return root.toString()
+    }
+  }
+
+  private var lastNotify = 0L
+
+  override fun onBind(intent: Intent?): IBinder? = null
+
+  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+    ensureChannel()
+    startForegroundCompat(buildNotification("Готовлю загрузку…", 0, 0, true))
+    intent?.getStringExtra(EXTRA_JOB)?.let { raw ->
+      val json = JSONObject(raw)
+      val job =
+        Job(
+          id = json.getString("id"),
+          url = json.getString("url"),
+          uri = json.getString("uri"),
+          name = json.optString("name", "файл"),
+          size = json.optLong("size", 0),
+        )
+      jobs[job.id] = job
+      queue.offer(job)
+    }
+    if (worker?.isAlive != true) {
+      worker = Thread { runQueue() }.also { it.start() }
+    }
+    return START_NOT_STICKY
+  }
+
+  private fun runQueue() {
+    var doneCount = 0
+    var failedCount = 0
+    while (true) {
+      val job = queue.poll() ?: break
+      job.state = "uploading"
+      try {
+        upload(job)
+        job.state = "done"
+        doneCount += 1
+      } catch (error: Exception) {
+        job.state = "error"
+        job.error = error.message ?: error.toString()
+        failedCount += 1
+      }
+    }
+    val summary =
+      when {
+        failedCount > 0 && doneCount > 0 -> "Загружено: $doneCount, не загружено: $failedCount"
+        failedCount > 0 -> "Не загружено: $failedCount — откройте приложение"
+        else -> if (doneCount == 1) "Файл загружен" else "Загружено файлов: $doneCount"
+      }
+    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    if (Build.VERSION.SDK_INT >= 24) stopForeground(STOP_FOREGROUND_DETACH) else @Suppress("DEPRECATION") stopForeground(false)
+    manager.notify(NOTIFICATION_ID, buildNotification(summary, 0, 0, false, ongoing = false))
+    worker = null
+    stopSelf()
+  }
+
+  /** Локальный файл с произвольным доступом; content:// сначала копируется в кэш. */
+  private fun localFile(job: Job): File {
+    val uri = Uri.parse(job.uri)
+    if (uri.scheme == null || uri.scheme == "file") return File(uri.path ?: job.uri)
+    val copy = File(cacheDir, "t3patch-upload-${job.id}")
+    if (!copy.exists() || copy.length() != job.size) {
+      contentResolver.openInputStream(uri).use { input ->
+        requireNotNull(input) { "Не открыть файл" }
+        copy.outputStream().use { output -> input.copyTo(output) }
+      }
+    }
+    return copy
+  }
+
+  private fun upload(job: Job) {
+    val file = localFile(job)
+    if (!file.exists()) throw IllegalStateException("Файл больше недоступен на телефоне")
+    var offset = 0L
+    var failures = 0
+    var needStatus = true
+    RandomAccessFile(file, "r").use { source ->
+      while (true) {
+        try {
+          if (needStatus) {
+            offset = queryOffset(job.url)
+            job.sent = offset
+            needStatus = false
+          }
+          val length = minOf(CHUNK, job.size - offset)
+          val connection = (URL("${job.url}?offset=$offset").openConnection() as HttpURLConnection)
+          connection.requestMethod = "POST"
+          connection.doOutput = true
+          connection.connectTimeout = 20_000
+          connection.readTimeout = 60_000
+          connection.setRequestProperty("Content-Type", "application/octet-stream")
+          connection.setFixedLengthStreamingMode(length)
+          source.seek(offset)
+          connection.outputStream.use { output ->
+            val buffer = ByteArray(64 * 1024)
+            var remaining = length
+            while (remaining > 0) {
+              val read = source.read(buffer, 0, minOf(buffer.size.toLong(), remaining).toInt())
+              if (read < 0) break
+              output.write(buffer, 0, read)
+              remaining -= read
+              job.sent = offset + (length - remaining)
+              notifyProgress(job)
+            }
+          }
+          val code = connection.responseCode
+          val body =
+            (if (code >= 400) connection.errorStream else connection.inputStream)
+              ?.bufferedReader()
+              ?.use { it.readText() }
+              ?: ""
+          connection.disconnect()
+          val json = runCatching { JSONObject(body) }.getOrNull()
+          when {
+            code == 409 && json?.has("offset") == true -> offset = json.getLong("offset")
+            code in 200..299 -> {
+              failures = 0
+              offset = json?.optLong("offset", offset + length) ?: (offset + length)
+              job.sent = offset
+              if (json?.optBoolean("done") == true) {
+                job.relativePath = json.optString("relativePath")
+                return
+              }
+            }
+            code in 400..499 ->
+              throw IllegalStateException(json?.optString("error") ?: "Сервер ответил $code")
+            else -> throw java.io.IOException("Сервер ответил $code")
+          }
+        } catch (error: IllegalStateException) {
+          throw error
+        } catch (error: Exception) {
+          // нет связи или сервер временно недоступен — пауза и продолжение с места обрыва
+          failures += 1
+          if (failures > MAX_FAILURES) throw IllegalStateException("Нет связи с сервером слишком долго")
+          notifyText("${job.name}: жду связь…")
+          Thread.sleep(RETRY_MS[minOf(failures - 1, RETRY_MS.size - 1)])
+          needStatus = true
+        }
+      }
+    }
+  }
+
+  private fun queryOffset(url: String): Long {
+    val connection = (URL(url).openConnection() as HttpURLConnection)
+    connection.connectTimeout = 20_000
+    connection.readTimeout = 30_000
+    val code = connection.responseCode
+    val body =
+      (if (code >= 400) connection.errorStream else connection.inputStream)
+        ?.bufferedReader()
+        ?.use { it.readText() }
+        ?: ""
+    connection.disconnect()
+    val json = runCatching { JSONObject(body) }.getOrNull()
+    if (code == 404) {
+      throw IllegalStateException(json?.optString("error") ?: "Ссылка загрузки устарела")
+    }
+    if (code !in 200..299) throw java.io.IOException("Сервер ответил $code")
+    return json?.optLong("offset", 0) ?: 0
+  }
+
+  private fun notifyProgress(job: Job) {
+    val now = System.currentTimeMillis()
+    if (now - lastNotify < 500) return
+    lastNotify = now
+    val percent = if (job.size > 0) (job.sent * 100 / job.size).toInt() else 100
+    val waiting = queue.size
+    val title = if (waiting > 0) "${job.name} — $percent% (ещё $waiting)" else "${job.name} — $percent%"
+    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    manager.notify(NOTIFICATION_ID, buildNotification(title, 100, percent, false))
+  }
+
+  private fun notifyText(text: String) {
+    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    manager.notify(NOTIFICATION_ID, buildNotification(text, 0, 0, true))
+  }
+
+  private fun ensureChannel() {
+    if (Build.VERSION.SDK_INT < 26) return
+    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+    if (manager.getNotificationChannel(CHANNEL) == null) {
+      manager.createNotificationChannel(
+        NotificationChannel(CHANNEL, "Загрузка файлов", NotificationManager.IMPORTANCE_LOW),
+      )
+    }
+  }
+
+  private fun buildNotification(
+    text: String,
+    max: Int,
+    progress: Int,
+    indeterminate: Boolean,
+    ongoing: Boolean = true,
+  ): Notification {
+    val builder =
+      if (Build.VERSION.SDK_INT >= 26) Notification.Builder(this, CHANNEL)
+      else @Suppress("DEPRECATION") Notification.Builder(this)
+    val launch = packageManager.getLaunchIntentForPackage(packageName)
+    val pending =
+      launch?.let {
+        android.app.PendingIntent.getActivity(
+          this,
+          0,
+          it,
+          android.app.PendingIntent.FLAG_IMMUTABLE or android.app.PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+      }
+    builder
+      .setSmallIcon(android.R.drawable.stat_sys_upload)
+      .setContentTitle("T3 Code — загрузка")
+      .setContentText(text)
+      .setOngoing(ongoing)
+      .setOnlyAlertOnce(true)
+    if (pending != null) builder.setContentIntent(pending)
+    if (ongoing) builder.setProgress(max, progress, indeterminate)
+    if (!ongoing) builder.setSmallIcon(android.R.drawable.stat_sys_upload_done).setAutoCancel(true)
+    return builder.build()
+  }
+
+  private fun startForegroundCompat(notification: Notification) {
+    if (Build.VERSION.SDK_INT >= 29) {
+      startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC)
+    } else {
+      startForeground(NOTIFICATION_ID, notification)
+    }
+  }
+}
