+/** Вложения черновика (в том числе пришедшие через «Поделиться») — как файлы для загрузки. */
+export async function t3patchDraftFiles(draftKey: string): Promise<T3patchPickedFile[]> {
+  const { File, Paths } = await import("expo-file-system");
+  return getComposerDraftSnapshot(draftKey)
+    .attachments.filter(isFileBackedComposerAttachment)
+    .map((attachment) => {
+      const uri =
+        resolveOwnedComposerAttachmentFileUri(attachment.fileUri, Paths.document.uri) ??
+        attachment.fileUri;
+      let size = "sizeBytes" in attachment ? Number(attachment.sizeBytes) || 0 : 0;
+      if (!size) {
+        try {
+          size = new File(uri).size ?? 0;
+        } catch {
+          size = 0;
+        }
+      }
+      return {
+        uri,
+        name: attachment.name,
+        size,
+        afterUpload: () => removeComposerDraftAttachment(draftKey, attachment.id),
