diff --git a/apps/mobile/src/sergey/ActionSheet.tsx b/apps/mobile/src/sergey/ActionSheet.tsx
index 26897b6272..883511dd2e 100644
--- a/apps/mobile/src/sergey/ActionSheet.tsx
+++ b/apps/mobile/src/sergey/ActionSheet.tsx
@@ -7,7 +7,7 @@
  * одним хостом `T3patchActionSheetHost` в корне приложения.
  */
 import { useEffect, useState, useSyncExternalStore } from "react";
-import { Modal, Pressable, TextInput, View } from "react-native";
+import { Keyboard, Modal, Pressable, TextInput, View } from "react-native";
 import { useSafeAreaInsets } from "react-native-safe-area-context";
 
 import { AppText as Text } from "../components/AppText";
@@ -94,9 +94,29 @@ function PromptBody(props: Extract<NonNullable<SheetState>, { kind: "prompt" }>)
   );
 }
 
+/**
+ * Высота клавиатуры. Окно Modal на Android не сжимается под клавиатуру (приложение рисуется
+ * под системными панелями), поэтому панель с полем ввода оставалась внизу, под клавиатурой.
+ */
+function useKeyboardHeight(): number {
+  const [height, setHeight] = useState(0);
+  useEffect(() => {
+    const show = Keyboard.addListener("keyboardDidShow", (event) =>
+      setHeight(event.endCoordinates.height),
+    );
+    const hide = Keyboard.addListener("keyboardDidHide", () => setHeight(0));
+    return () => {
+      show.remove();
+      hide.remove();
+    };
+  }, []);
+  return height;
+}
+
 export function T3patchActionSheetHost() {
   const current = useSyncExternalStore(subscribe, () => state);
   const insets = useSafeAreaInsets();
+  const keyboardHeight = useKeyboardHeight();
   if (!current) return null;
   const close = () => {
     if (current.kind === "prompt") current.resolve(null);
@@ -109,7 +129,7 @@ export function T3patchActionSheetHost() {
           // нажатие внутри панели не закрывает её
           onPress={() => undefined}
           className="rounded-t-3xl bg-sheet px-5 pt-4"
-          style={{ paddingBottom: insets.bottom + 12 }}
+          style={{ paddingBottom: (keyboardHeight > 0 ? keyboardHeight : insets.bottom) + 12 }}
         >
           {current.kind === "prompt" ? (
             <PromptBody {...current} />
