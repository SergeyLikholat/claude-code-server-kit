+/**
+ * t3-patch: PDF в проводнике на Android — карточка вместо встроенного браузера.
+ *
+ * Штатно PDF открывался во WebView. Android WebView показывать PDF не умеет и отдаёт файл
+ * «Диспетчеру загрузок»: каждая новая загрузка WebView (вернулись в приложение — ссылка
+ * перевыпустилась, экран перерисовался) запускала ещё одно скачивание в «Загрузки».
+ *
+ * Теперь: при открытии экрана PDF один раз открывается системной программой (файл во временной
+ * папке приложения, «Загрузки» не засоряются). Возврат в приложение повторно его не открывает.
+ * На карточке — «Открыть ещё раз» и «Скачать в Загрузки» (по явному нажатию).
+ */
+import { useEffect, useRef, useState } from "react";
+import { ActivityIndicator, Pressable, View } from "react-native";
+
+import { AppText as Text } from "../components/AppText";
+import { openAttachmentInViewer } from "../lib/attachmentDownload";
+import { type T3patchDownloadResult, t3patchDownloadFile } from "./download";
+
+type OpenState = "opening" | "opened" | "failed";
+
+function CardButton(props: {
+  readonly label: string;
+  readonly primary?: boolean;
+  readonly disabled?: boolean;
+  readonly onPress: () => void;
+}) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      disabled={props.disabled}
+      onPress={props.onPress}
+      className={
+        props.primary
+          ? "min-w-48 items-center rounded-full bg-primary px-5 py-3 active:opacity-70"
+          : "min-w-48 items-center rounded-full border border-border px-5 py-3 active:opacity-70"
+      }
+      style={props.disabled ? { opacity: 0.5 } : undefined}
+    >
+      <Text
+        className={
+          props.primary
+            ? "text-sm font-t3-bold text-primary-foreground"
+            : "text-sm font-t3-medium text-foreground"
+        }
+      >
+        {props.label}
+      </Text>
+    </Pressable>
+  );
+}
+
+export function T3patchPdfCard(props: { readonly uri: string | null; readonly name: string }) {
+  const [openState, setOpenState] = useState<OpenState>("opening");
+  const [download, setDownload] = useState<T3patchDownloadResult | null>(null);
+  const autoOpened = useRef(false);
+  const controller = useRef<AbortController | null>(null);
+
+  const open = (uri: string) => {
+    controller.current?.abort();
+    const next = new AbortController();
+    controller.current = next;
+    setOpenState("opening");
+    void openAttachmentInViewer({
+      uri,
+      attachment: { name: props.name, mimeType: "application/pdf" },
+      signal: next.signal,
+    })
+      .then(() => {
+        if (!next.signal.aborted) setOpenState("opened");
+      })
+      .catch(() => {
+        if (!next.signal.aborted) setOpenState("failed");
+      });
+  };
+
+  // Только при первом появлении ссылки: перевыпуск ссылки при возврате в приложение
+  // меняет uri, но повторно файл не открывает.
+  useEffect(() => {
+    if (props.uri === null || autoOpened.current) return;
+    autoOpened.current = true;
+    open(props.uri);
+  }, [props.uri]);
+  useEffect(() => () => controller.current?.abort(), []);
+
+  return (
+    <View className="flex-1 items-center justify-center gap-3 bg-sheet px-8">
+      <Text className="text-center text-lg font-t3-bold text-foreground">{props.name}</Text>
+      {props.uri === null || openState === "opening" ? (
+        <View className="flex-row items-center gap-2">
+          <ActivityIndicator />
+          <Text className="text-sm text-foreground-muted">Открываю PDF…</Text>
+        </View>
+      ) : (
+        <Text className="text-center text-sm leading-relaxed text-foreground-muted">
+          {openState === "failed"
+            ? "Не удалось открыть PDF. Нужна программа для просмотра PDF на телефоне и связь с сервером."
+            : "PDF открывается программой просмотра на телефоне."}
+        </Text>
+      )}
+      {download === "background" ? (
+        <Text className="text-center text-xs text-foreground-muted">
+          Загрузка началась в фоне — ход виден в шторке, файл появится в «Загрузках».
+        </Text>
+      ) : download === "failed" ? (
+        <Text className="text-center text-xs text-foreground-muted">
+          Не удалось запустить загрузку.
+        </Text>
+      ) : null}
+      <View className="mt-3 items-center gap-2">
+        <CardButton
+          primary
+          label="Открыть ещё раз"
+          disabled={props.uri === null || openState === "opening"}
+          onPress={() => {
+            if (props.uri) open(props.uri);
+          }}
+        />
+        <CardButton
+          label="Скачать в Загрузки"
+          disabled={props.uri === null || download === "background"}
+          onPress={() => {
+            if (props.uri) void t3patchDownloadFile(props.uri, props.name).then(setDownload);
+          }}
+        />
+      </View>
+    </View>
+  );
+}
