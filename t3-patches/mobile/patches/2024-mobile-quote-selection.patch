+import { describe, expect, it } from "vite-plus/test";
+
+import { t3patchQuoteText } from "./quoteFormat";
+
+describe("t3patchQuoteText", () => {
+  it("в пустой черновик — блок цитаты и пустая строка после", () => {
+    expect(t3patchQuoteText("", "срок 10 дней")).toBe("> срок 10 дней\n\n");
+  });
+  it("многострочное выделение — «> » у каждой строки, пустые строки остаются в цитате", () => {
+    expect(t3patchQuoteText("", "первая\n\nвторая")).toBe("> первая\n>\n> вторая\n\n");
+  });
+  it("после текста отделяется пустой строкой", () => {
+    expect(t3patchQuoteText("Уточни", "цитата")).toBe("\n\n> цитата\n\n");
+    expect(t3patchQuoteText("Уточни\n", "цитата")).toBe("\n> цитата\n\n");
+    expect(t3patchQuoteText("> прошлая\n\n", "вторая")).toBe("> вторая\n\n");
+  });
+  it("пустое выделение — ничего не вставляет", () => {
+    expect(t3patchQuoteText("x", "   \n ")).toBe("");
+  });
+});
