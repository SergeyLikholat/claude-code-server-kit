+/**
+ * t3-patch: цитаты из сообщений треда в поле ввода.
+ *
+ * - Выделить текст в сообщении (своём или ответе Claude) → в меню выделения «Цитировать»
+ *   (нативный пункт, modules/t3-markdown-text) → выделенное встаёт в черновик блоком «> …».
+ * - Кнопка с кавычками рядом с «Копировать» — цитата сообщения целиком.
+ *
+ * Цитата добавляется в конец черновика текущего треда отдельным абзацем; можно набрать
+ * несколько цитат подряд. Куда вставлять, знает открытый тред (useT3patchQuoteTarget).
+ */
+import { requireOptionalNativeModule } from "expo";
+import * as Haptics from "expo-haptics";
+import { memo, useEffect } from "react";
+import { Platform, Pressable, type ColorValue } from "react-native";
+
+import { SymbolView } from "../components/AppSymbol";
+import { appendComposerDraftText, getComposerDraftSnapshot } from "../state/use-composer-drafts";
+import { t3patchQuoteText } from "./quoteFormat";
+
+let activeDraftKey: string | null = null;
+
+export function t3patchInsertQuote(selected: string): boolean {
+  if (!activeDraftKey) return false;
+  const value = t3patchQuoteText(getComposerDraftSnapshot(activeDraftKey).text, selected);
+  if (!value) return false;
+  appendComposerDraftText(activeDraftKey, value);
+  void Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light).catch(() => undefined);
+  return true;
+}
+
+interface QuoteSelectionModule {
+  addListener?: (
+    event: "onQuoteSelection",
+    listener: (payload: { readonly text: string }) => void,
+  ) => { remove(): void };
+}
+
+/** Открытый тред: сюда уходят цитаты из меню выделения и кнопки «Цитировать целиком». */
+export function useT3patchQuoteTarget(draftKey: string | null): void {
+  useEffect(() => {
+    if (!draftKey) return;
+    activeDraftKey = draftKey;
+    const module =
+      Platform.OS === "android"
+        ? requireOptionalNativeModule<QuoteSelectionModule>("T3MarkdownTextSelection")
+        : null;
+    const subscription = module?.addListener?.("onQuoteSelection", (payload) => {
+      t3patchInsertQuote(payload.text);
+    });
+    return () => {
+      subscription?.remove();
+      if (activeDraftKey === draftKey) activeDraftKey = null;
+    };
+  }, [draftKey]);
+}
+
+/** Кнопка рядом с «Копировать»: цитата всего сообщения. */
+export const T3patchQuoteMessageButton = memo(function T3patchQuoteMessageButton(props: {
+  readonly text: string;
+  readonly tintColor?: ColorValue;
+  readonly buttonSize?: number;
+  readonly iconSize?: number;
+}) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel="Цитировать сообщение"
+      disabled={props.text.trim().length === 0}
+      hitSlop={8}
+      onPress={() => {
+        t3patchInsertQuote(props.text);
+      }}
+      style={({ pressed }) => ({
+        width: props.buttonSize ?? 30,
+        height: props.buttonSize ?? 30,
+        alignItems: "center",
+        justifyContent: "center",
+        borderRadius: 9,
+        opacity: pressed ? 0.52 : 1,
+      })}
+    >
+      <SymbolView
+        name={{ ios: "quote.opening", android: "format_quote" }}
+        size={(props.iconSize ?? 13) + 2}
+        tintColor={props.tintColor}
+        tintColorClassName={props.tintColor ? undefined : "accent-foreground"}
+        type="monochrome"
+      />
+    </Pressable>
+  );
+});
