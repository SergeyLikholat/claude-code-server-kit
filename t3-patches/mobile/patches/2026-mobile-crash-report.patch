+/**
+ * t3-patch: причина прошлого вылета — окном при следующем запуске.
+ *
+ * С телефона журнал Android не достать, а вылет закрывает приложение без следа. Нативный
+ * обработчик (modules/t3patch-download) пишет стек падения в файл, фатальная ошибка JS
+ * записывается туда же из startupDiagnostics. При запуске текст показывается с кнопкой
+ * «Скопировать» — его можно прислать целиком.
+ */
+import { requireOptionalNativeModule } from "expo";
+import { Alert, Platform } from "react-native";
+
+import { tryCopyTextWithHaptic } from "../lib/copyTextWithHaptic";
+
+interface CrashModule {
+  recordCrash?: (text: string) => void;
+  takeLastCrash?: () => string;
+  heartbeat?: () => void;
+  breadcrumbs?: (text: string) => void;
+}
+
+const crashModule = (): CrashModule | null =>
+  Platform.OS === "android" ? requireOptionalNativeModule<CrashModule>("T3patchDownload") : null;
+
+export function t3patchRecordCrash(text: string): void {
+  try {
+    crashModule()?.recordCrash?.(text);
+  } catch {
+    // запись причины не должна мешать штатной обработке ошибки
+  }
+}
+
+let shown = false;
+
+export function t3patchShowLastCrash(): void {
+  if (shown) return;
+  shown = true;
+  let text = "";
+  try {
+    text = crashModule()?.takeLastCrash?.() ?? "";
+  } catch {
+    return;
+  }
+  if (!text.trim()) return;
+  Alert.alert("Прошлый запуск завершился ошибкой", text.slice(0, 1500), [
+    { text: "Скопировать", onPress: () => void tryCopyTextWithHaptic(text) },
+    { text: "Закрыть", style: "cancel" },
+  ]);
+}
+
+const trail: string[] = [];
+
+/** Событие в журнал: ошибки, открытие треда. Уходит в нативную часть сразу — переживёт зависание. */
+export function t3patchBreadcrumb(text: string): void {
+  const time = new Date().toISOString().slice(11, 19);
+  trail.push(`${time} ${text.slice(0, 400)}`);
+  if (trail.length > 30) trail.shift();
+  try {
+    crashModule()?.breadcrumbs?.(trail.join("\n"));
+  } catch {
+    // журнал не должен мешать работе
+  }
+}
+
+let heartbeatStarted = false;
+
+/** Пульс JS раз в 2 с: по его паузе нативный сторож узнаёт, что JS завис. */
+export function t3patchStartHeartbeat(): void {
+  if (heartbeatStarted) return;
+  heartbeatStarted = true;
+  const beat = () => {
+    try {
+      crashModule()?.heartbeat?.();
+    } catch {
+      // нет модуля — нет сторожа
+    }
+  };
+  beat();
+  setInterval(beat, 2_000);
+}
