+import android.os.Looper
+import java.io.File
+import java.util.concurrent.atomic.AtomicLong
+import java.io.PrintWriter
+import java.io.StringWriter
 
 /**
  * t3-patch: скачивание файла системным «Диспетчером загрузок» Android.
@@ -18,9 +26,98 @@ import expo.modules.kotlin.modules.ModuleDefinition
  * завершении открывает файл правильной программой (apk — установщиком).
  */
 class T3patchDownloadModule : Module() {
+  // t3-patch: журнал падения — причина вылета видна при следующем запуске (sergey/crashReport.ts)
+  private fun crashFile(): File? = appContext.reactContext?.filesDir?.let { File(it, "t3patch-last-crash.txt") }
+
+  private fun writeCrash(text: String) {
+    runCatching { crashFile()?.writeText(text.take(20_000)) }
+  }
+
+  /**
+   * Сторож зависаний: раз в 2 с ставит пустую задачу в главный поток. Если она не выполнилась
+   * за 5 с — интерфейс завис; пишем стеки всех потоков (главного, JS, рендера) в журнал падения.
+   * Один раз за запуск, чтобы не перезаписать первую, самую ценную картину.
+   */
+  @Volatile private var lastJsBeat = 0L
+  @Volatile private var breadcrumbs = ""
+
+  private fun inForeground(): Boolean {
+    val info = ActivityManager.RunningAppProcessInfo()
+    ActivityManager.getMyMemoryState(info)
+    return info.importance == ActivityManager.RunningAppProcessInfo.IMPORTANCE_FOREGROUND
+  }
+
+  private fun startFreezeWatchdog() {
+    val main = Handler(Looper.getMainLooper())
+    Thread({
+      val tick = AtomicLong(0)
+      var reported = false
+      while (!reported) {
+        val sent = tick.get()
+        main.post { tick.set(sent + 1) }
+        Thread.sleep(5_000)
+        val uiStuck = tick.get() == sent
+        val beat = lastJsBeat
+        val jsStuck = beat > 0 && SystemClock.uptimeMillis() - beat > 8_000 && inForeground()
+        if (uiStuck || jsStuck) {
+          val what = if (uiStuck) "Интерфейс (главный поток) завис" else "JS не отвечает больше 8 с"
+          val dump = StringBuilder("$what. Последние события:\n$breadcrumbs\nСтеки потоков:\n")
+          val all = Thread.getAllStackTraces().entries.sortedBy { (thread, _) ->
+            when {
+              thread == Looper.getMainLooper().thread -> 0
+              thread.name.contains("js", ignoreCase = true) -> 1
+              else -> 2
+            }
+          }
+          for ((thread, stack) in all.take(12)) {
+            if (stack.isEmpty()) continue
+            dump.append("\n--- ").append(thread.name).append(" (").append(thread.state).append(")\n")
+            stack.take(25).forEach { dump.append("  at ").append(it).append('\n') }
+          }
+          writeCrash(dump.toString())
+          reported = true
+        }
+      }
+    }, "t3patch-freeze-watchdog").apply { isDaemon = true }.start()
+  }
+
   override fun definition() = ModuleDefinition {
     Name("T3patchDownload")
 
+    OnCreate {
+      startFreezeWatchdog()
+      val previous = Thread.getDefaultUncaughtExceptionHandler()
+      Thread.setDefaultUncaughtExceptionHandler { thread, error ->
+        val trace = StringWriter().also { error.printStackTrace(PrintWriter(it)) }.toString()
+        writeCrash("Поток: ${thread.name}\n$trace")
+        previous?.uncaughtException(thread, error)
+      }
+    }
+
+    // JS отмечается раз в 2 с — по паузе сторож узнаёт зависший JS
+    Function("heartbeat") { ->
+      lastJsBeat = SystemClock.uptimeMillis()
+      Unit
+    }
+
+    // последние события JS (ошибки, переходы) — попадут в журнал зависания
+    Function("breadcrumbs") { text: String ->
+      breadcrumbs = text.takeLast(4_000)
+      Unit
+    }
+
+    Function("recordCrash") { text: String ->
+      writeCrash(text)
+      Unit
+    }
+
+    Function("takeLastCrash") { ->
+      val file = crashFile()
+      val text = runCatching { if (file?.exists() == true) file.readText() else "" }.getOrDefault("")
+      runCatching { file?.delete() }
+      text as Any
+    }
+
     Function("enqueue") { url: String, fileName: String ->
       val context = appContext.reactContext ?: throw Exceptions.ReactContextLost()
       val safeName = fileName.replace(Regex("[\\\\/:*?\"<>|]"), "_").ifBlank { "download" }
