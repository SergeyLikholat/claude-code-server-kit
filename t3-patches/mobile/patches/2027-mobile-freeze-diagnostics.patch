    * за 5 с — интерфейс завис; пишем стеки всех потоков (главного, JS, рендера) в журнал падения.
    * Один раз за запуск, чтобы не перезаписать первую, самую ценную картину.
    */
+  // Диагностика зависаний JS: профилировщик Hermes пишет, какая JS-функция выполняется, раз в
+  // несколько мс; при зависании запись выгружается в файл (каталог t3patch-diag), и JS при
+  // следующем запуске отправляет её на сервер (sergey/DiagUploader.tsx).
+  private var profilerStatus = "не включался"
+  private val profilerClass = "com.facebook.hermes.instrumentation.HermesSamplingProfiler"
+
+  private fun diagDir(): File? =
+    appContext.reactContext?.filesDir?.let { File(it, "t3patch-diag").apply { mkdirs() } }
+
+  private fun enableHermesProfiler() {
+    profilerStatus = runCatching {
+      Class.forName(profilerClass).getMethod("enable").invoke(null)
+      "включён"
+    }.getOrElse { "ошибка включения: ${it.cause?.message ?: it.message}" }
+  }
+
+  private fun dumpHermesTrace(stamp: Long): String {
+    val dir = diagDir() ?: return "нет каталога"
+    val file = File(dir, "hermes-trace-$stamp.json")
+    return runCatching {
+      Class.forName(profilerClass).getMethod("dumpSampledTraceToFile", String::class.java)
+        .invoke(null, file.absolutePath)
+      "записана ${file.name}, ${file.length()} байт"
+    }.getOrElse { "не записана: ${it.cause?.message ?: it.message}" }
+  }
+
   @Volatile private var lastJsBeat = 0L
   @Volatile private var breadcrumbs = ""
 
