+/**
+ * t3-patch: отправка диагностики зависаний на сервер — в /root/projects/_scratch/t3-diag/.
+ *
+ * Нативный сторож (modules/t3patch-download) при зависании JS кладёт отчёт и запись
+ * профилировщика Hermes в каталог t3patch-diag. При следующем запуске, как только есть
+ * подключённый сервер, файлы уходят штатной загрузкой проводника (ход виден в панели загрузок)
+ * и удаляются с телефона.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { requireOptionalNativeModule } from "expo";
+import { useEffect, useRef } from "react";
+import { Platform } from "react-native";
+
+import { useEnvironments } from "../state/environments";
+import { t3patchEnqueueUploads } from "./workspaceUploads";
+
+const DIAG_CWD = "/root/projects/_scratch";
+const DIAG_DIRECTORY = "t3-diag";
+
+interface DiagModule {
+  listDiagFiles?: () => string;
+  deleteDiagFile?: (name: string) => void;
+}
+
+const diagModule = (): DiagModule | null =>
+  Platform.OS === "android" ? requireOptionalNativeModule<DiagModule>("T3patchDownload") : null;
+
+export function T3patchDiagUploader() {
+  const { environments } = useEnvironments();
+  const environmentId: EnvironmentId | undefined = environments[0]?.environmentId;
+  const sent = useRef(false);
+  useEffect(() => {
+    if (sent.current || !environmentId) return;
+    const module = diagModule();
+    let files: Array<{ uri: string; name: string; size: number }> = [];
+    try {
+      files = JSON.parse(module?.listDiagFiles?.() ?? "[]");
+    } catch {
+      files = [];
+    }
+    if (files.length === 0) return;
+    sent.current = true;
+    t3patchEnqueueUploads({
+      environmentId,
+      cwd: DIAG_CWD,
+      directory: DIAG_DIRECTORY,
+      files: files.map((file) => ({
+        ...file,
+        afterUpload: () => module?.deleteDiagFile?.(file.name),
+      })),
+      onUploaded: () => undefined,
+    });
+  }, [environmentId]);
+  return null;
+}
diff --git a/apps/mobile/src/sergey/crashReport.ts b/apps/mobile/src/sergey/crashReport.ts
index 470cc93f3e..f01cd92b75 100644
--- a/apps/mobile/src/sergey/crashReport.ts
+++ b/apps/mobile/src/sergey/crashReport.ts
@@ -77,3 +77,12 @@ export function t3patchStartHeartbeat(): void {
   beat();
   setInterval(beat, 2_000);
 }
+
+const counts = new Map<string, number>();
+
+/** Счётчик отрисовок/вызовов: первые три и каждый 50-й — в журнал (виден зацикленный экран). */
+export function t3patchTrace(name: string): void {
+  const n = (counts.get(name) ?? 0) + 1;
+  counts.set(name, n);
+  if (n <= 3 || n % 50 === 0) t3patchBreadcrumb(`${name} ×${n}`);
+}
