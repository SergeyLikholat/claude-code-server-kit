+    // Файлы диагностики для отправки на сервер: JSON-массив {uri, name, size}
+    Function("listDiagFiles") { ->
+      val files = diagDir()?.listFiles()?.filter { it.isFile } ?: emptyList()
+      val array = JSONArray()
+      files.forEach {
+        array.put(JSONObject().put("uri", "file://${it.absolutePath}").put("name", it.name).put("size", it.length()))
+      }
+      array.toString() as Any
+    }
+
+    Function("deleteDiagFile") { name: String ->
+      diagDir()?.let { File(it, name).takeIf { file -> file.parentFile == it }?.delete() }
+      Unit
+    }
+
     Function("recordCrash") { text: String ->
       writeCrash(text)
       Unit
