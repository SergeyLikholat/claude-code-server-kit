@@ -69,6 +71,60 @@ class T3patchDownloadModule : Module() {
   @Volatile private var lastJsBeat = 0L
   @Volatile private var breadcrumbs = ""
 
+  private fun breadcrumbsFile(): File? =
+    appContext.reactContext?.filesDir?.let { File(it, "t3patch-breadcrumbs.txt") }
+
+  /**
+   * Причины прошлых завершений процесса (Android 11+). Нативное падение (SIGSEGV и т. п.) Java не
+   * перехватывает, но система хранит его причину и трассу (tombstone), а для ANR — стеки потоков.
+   * Каждое новое падение или ANR — в файл каталога t3patch-diag вместе с событиями JS прошлого
+   * запуска и журналом logcat своего процесса.
+   */
+  private fun collectExitReasons() {
+    if (Build.VERSION.SDK_INT < 30) return
+    val context = appContext.reactContext ?: return
+    val dir = diagDir() ?: return
+    val seenFile = File(context.filesDir, "t3patch-exit-seen.txt")
+    val seen = runCatching { seenFile.readText().trim().toLong() }.getOrDefault(0L)
+    val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+    val exits = runCatching { manager.getHistoricalProcessExitReasons(context.packageName, 0, 8) }
+      .getOrDefault(emptyList())
+    val fresh = exits.filter { it.timestamp > seen }
+    if (exits.isNotEmpty()) runCatching { seenFile.writeText(exits.maxOf { it.timestamp }.toString()) }
+    val crashed = fresh.filter {
+      it.reason == ApplicationExitInfo.REASON_CRASH || it.reason == ApplicationExitInfo.REASON_CRASH_NATIVE ||
+        it.reason == ApplicationExitInfo.REASON_ANR || it.reason == ApplicationExitInfo.REASON_LOW_MEMORY ||
+        it.reason == ApplicationExitInfo.REASON_SIGNALED || it.reason == ApplicationExitInfo.REASON_INITIALIZATION_FAILURE
+    }
+    if (crashed.isEmpty()) return
+    val previousCrumbs = runCatching { breadcrumbsFile()?.readText() }.getOrNull() ?: ""
+    val text = StringBuilder("Прошлые завершения процесса (новые сверху):\n")
+    for (exit in fresh) {
+      text.append("\n--- ").append(java.util.Date(exit.timestamp)).append(" причина=").append(exit.reason)
+        .append(" статус=").append(exit.status).append(" важность=").append(exit.importance)
+        .append(" pss=").append(exit.pss).append(" rss=").append(exit.rss)
+        .append("\n  ").append(exit.description ?: "").append('\n')
+    }
+    text.append("\nСобытия JS прошлого запуска:\n").append(previousCrumbs).append('\n')
+    val stamp = System.currentTimeMillis()
+    runCatching { File(dir, "exit-$stamp.txt").writeText(text.toString()) }
+    crashed.forEachIndexed { index, exit ->
+      runCatching {
+        exit.traceInputStream?.use { input ->
+          val kind = if (exit.reason == ApplicationExitInfo.REASON_ANR) "anr.txt" else "tombstone.pb"
+          File(dir, "exit-$stamp-$index-$kind").outputStream().use { input.copyTo(it) }
+        }
+      }
+    }
+    // журнал logcat своего приложения: строки прошлого процесса ещё в буфере
+    runCatching {
+      val process = ProcessBuilder("logcat", "-d", "-v", "threadtime", "-b", "main,system,crash", "-t", "6000")
+        .redirectErrorStream(true).start()
+      File(dir, "logcat-$stamp.txt").outputStream().use { process.inputStream.copyTo(it) }
+      process.waitFor()
+    }
+  }
+
   private fun inForeground(): Boolean {
     val info = ActivityManager.RunningAppProcessInfo()
     ActivityManager.getMyMemoryState(info)
@@ -103,11 +159,14 @@ class T3patchDownloadModule : Module() {
             stack.take(25).forEach { dump.append("  at ").append(it).append('\n') }
           }
           val stamp = System.currentTimeMillis()
+          // отчёт пишется до записи профилировщика: если запись сама уронит процесс, отчёт останется
+          writeCrash(dump.toString())
+          val report = diagDir()?.let { File(it, "report-$stamp.txt") }
+          runCatching { report?.writeText("Профилировщик Hermes: $profilerStatus\n$dump") }
           if (jsStuck) {
-            dump.insert(0, "Профилировщик Hermes: $profilerStatus; запись: ${dumpHermesTrace(stamp)}\n")
+            val traced = dumpHermesTrace(stamp)
+            runCatching { report?.appendText("\nЗапись профилировщика: $traced\n") }
           }
-          writeCrash(dump.toString())
-          runCatching { diagDir()?.let { File(it, "report-$stamp.txt").writeText(dump.toString()) } }
           reported = true
         }
       }
@@ -118,6 +177,7 @@ class T3patchDownloadModule : Module() {
     Name("T3patchDownload")
 
     OnCreate {
+      Thread({ runCatching { collectExitReasons() } }, "t3patch-exit-reasons").start()
       enableHermesProfiler()
       startFreezeWatchdog()
       val previous = Thread.getDefaultUncaughtExceptionHandler()
@@ -137,6 +197,7 @@ class T3patchDownloadModule : Module() {
     // последние события JS (ошибки, переходы) — попадут в журнал зависания
     Function("breadcrumbs") { text: String ->
       breadcrumbs = text.takeLast(4_000)
+      runCatching { breadcrumbsFile()?.writeText(breadcrumbs) }
       Unit
     }
 
