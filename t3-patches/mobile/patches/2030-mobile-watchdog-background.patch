diff --git a/apps/mobile/modules/t3patch-download/android/src/main/java/expo/modules/t3patchdownload/T3patchDownloadModule.kt b/apps/mobile/modules/t3patch-download/android/src/main/java/expo/modules/t3patchdownload/T3patchDownloadModule.kt
index c0dfd3d842..b71e4ca06a 100644
--- a/apps/mobile/modules/t3patch-download/android/src/main/java/expo/modules/t3patchdownload/T3patchDownloadModule.kt
+++ b/apps/mobile/modules/t3patch-download/android/src/main/java/expo/modules/t3patchdownload/T3patchDownloadModule.kt
@@ -136,13 +136,19 @@ class T3patchDownloadModule : Module() {
     Thread({
       val tick = AtomicLong(0)
       var reported = false
+      // Свёрнутое приложение не шлёт отметки: таймеры JS в фоне на паузе. Паузу считаем от
+      // возврата на экран, иначе сразу после возврата старая отметка выглядит как зависание.
+      var foregroundSince = 0L
       while (!reported) {
         val sent = tick.get()
         main.post { tick.set(sent + 1) }
         Thread.sleep(5_000)
-        val uiStuck = tick.get() == sent
+        val now = SystemClock.uptimeMillis()
+        val foreground = inForeground()
+        foregroundSince = if (!foreground) 0L else if (foregroundSince == 0L) now else foregroundSince
+        val uiStuck = foreground && tick.get() == sent
         val beat = lastJsBeat
-        val jsStuck = beat > 0 && SystemClock.uptimeMillis() - beat > 8_000 && inForeground()
+        val jsStuck = beat > 0 && foregroundSince > 0 && now - maxOf(beat, foregroundSince) > 8_000
         if (uiStuck || jsStuck) {
           val what = if (uiStuck) "Интерфейс (главный поток) завис" else "JS не отвечает больше 8 с"
           val dump = StringBuilder("$what. Последние события:\n$breadcrumbs\nСтеки потоков:\n")
