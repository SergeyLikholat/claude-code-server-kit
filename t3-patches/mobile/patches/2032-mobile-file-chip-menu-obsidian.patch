  * t3-patch: меню долгого нажатия на плашку файла в ответе модели (Android).
  *
  * Штатно у плашки есть только нажатие (открыть просмотр), а меню файла — лишь на iOS
- * (системное контекстное меню). Здесь долгое нажатие открывает свою панель (ActionSheet.tsx):
- * открыть, скачать в «Загрузки», показать в проводнике, поделиться, скопировать путь.
+ * (системное контекстное меню). Здесь долгое нажатие (с вибрацией, как принято в Android)
+ * открывает свою панель (ActionSheet.tsx): открыть, открыть в проводнике, вставить в
+ * сообщение, скачать в «Загрузки», поделиться, скопировать путь.
  * Вызывается из ThreadFeed через штатный обработчик меню файла (действие "t3patch-menu").
+ *
+ * Файл из базы (`/root/Obsidian/...`) лежит вне папки проекта, но в каждом кабинете виден через
+ * окно `!Obsidian` (paths.ts). Путь переводится в путь внутри проекта — тогда проводник может
+ * его показать, а сервер — отдать ссылку на скачивание (файл вне проекта он не отдаёт).
  */
 import { resolveAssetUrl } from "@t3tools/client-runtime/state/assets";
 import { fileBasename } from "@t3tools/client-runtime/markdown-links";
-import type { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import type { AssetResource, EnvironmentId, ThreadId } from "@t3tools/contracts";
 import { useNavigation } from "@react-navigation/native";
 import * as Option from "effect/Option";
+import * as Haptics from "expo-haptics";
 import { useCallback, useLayoutEffect, useRef } from "react";
 import { Alert } from "react-native";
 
 import { fileChipShareSource, type FileChipTarget } from "../features/threads/fileChipMenu";
 import { copyTextWithHaptic } from "../lib/copyTextWithHaptic";
+import { scopedThreadKey } from "../lib/scopedEntities";
 import { assetEnvironment } from "../state/assets";
 import { usePreparedConnection } from "../state/session";
 import { useAtomQueryRunner } from "../state/use-atom-query-runner";
 import { type T3patchAction, t3patchShowActions } from "./ActionSheet";
 import { t3patchDownloadFile } from "./download";
-import { t3patchFullPath } from "./paths";
+import { t3patchInsertFileLink } from "./fileLinkInsert";
+import { t3patchFullPath, t3patchWorkspacePath } from "./paths";
 
 export const T3PATCH_FILE_CHIP_MENU_ACTION = "t3patch-menu";
 
 const parentOf = (path: string) => (path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "");
 
+/** Путь файла внутри проекта (в том числе через окно `!Obsidian`); null — файл вне проекта. */
+export function t3patchChipWorkspacePath(
+  target: FileChipTarget,
+  workspaceRoot: string | null | undefined,
+): string | null {
+  if (target.relativePath) return target.relativePath;
+  if (!workspaceRoot || !target.fullPath) return null;
+  const inside = t3patchWorkspacePath(workspaceRoot, target.fullPath);
+  return inside.startsWith("/") ? null : inside;
+}
+
 /** Пункты меню — отдельно от React, чтобы их можно было проверить тестом. */
 export function t3patchFileChipActions(
   target: FileChipTarget,
@@ -35,18 +54,22 @@ export function t3patchFileChipActions(
     readonly open: () => void;
     readonly download: () => void;
     readonly reveal: ((folder: string) => void) | null;
+    readonly insert: ((relativePath: string) => void) | null;
     readonly share: (() => void) | null;
   },
 ): T3patchAction[] {
-  const relative = target.relativePath;
+  const relative = t3patchChipWorkspacePath(target, workspaceRoot);
   const full =
     workspaceRoot && relative ? t3patchFullPath(workspaceRoot, relative) : target.fullPath;
   return [
     { label: "Открыть", onPress: handlers.open },
-    { label: "Скачать", onPress: handlers.download },
-    ...(handlers.reveal && relative !== undefined
-      ? [{ label: "Показать в проводнике", onPress: () => handlers.reveal?.(parentOf(relative)) }]
+    ...(handlers.reveal && relative !== null
+      ? [{ label: "Открыть в проводнике", onPress: () => handlers.reveal?.(parentOf(relative)) }]
       : []),
+    ...(handlers.insert && relative !== null
+      ? [{ label: "Вставить в сообщение", onPress: () => handlers.insert?.(relative) }]
+      : []),
+    { label: "Скачать", onPress: handlers.download },
     ...(handlers.share ? [{ label: "Поделиться", onPress: handlers.share }] : []),
     ...(relative
       ? [{ label: "Копировать путь", onPress: () => copyTextWithHaptic(relative) }]
@@ -55,6 +78,21 @@ export function t3patchFileChipActions(
   ];
 }
 
+/** Что просить у сервера для скачивания: файл проекта — как файл проекта, иначе — как есть. */
+export function t3patchChipDownloadResource(
+  target: FileChipTarget,
+  workspaceRoot: string | null | undefined,
+  threadId: ThreadId,
+): AssetResource | null {
+  const relative = t3patchChipWorkspacePath(target, workspaceRoot);
+  if (workspaceRoot && relative !== null) {
+    const path = `${workspaceRoot.replace(/\/+$/, "")}/${relative}`;
+    return { _tag: "workspace-file", threadId, path };
+  }
+  const path = target.fullPath ?? target.relativePath;
+  return path ? { _tag: "media-file", threadId, path } : null;
+}
+
 export function useT3patchFileChipMenu(input: {
   readonly environmentId: EnvironmentId;
   readonly threadId: ThreadId;
@@ -77,29 +115,29 @@ export function useT3patchFileChipMenu(input: {
 
   const download = useCallback(
     (target: FileChipTarget) => {
-      const path = target.fullPath ?? target.relativePath;
-      if (!path) return;
+      const resource = t3patchChipDownloadResource(target, workspaceRoot, threadId);
+      if (!resource) return;
       void (async () => {
         const baseUrl = baseUrlRef.current;
         if (baseUrl === null) throw new Error("Нет связи с сервером. Подключитесь и повторите.");
-        const result = await createUrl({
-          environmentId,
-          input: { resource: { _tag: "media-file", threadId, path } },
-        });
+        const result = await createUrl({ environmentId, input: { resource } });
         const url =
           result._tag === "Success" ? resolveAssetUrl(baseUrl, result.value.relativeUrl) : null;
         if (url === null) throw new Error("Сервер не дал ссылку на файл.");
-        const outcome = await t3patchDownloadFile(url, fileBasename(path));
+        const name = fileBasename(target.fullPath ?? target.relativePath ?? "файл");
+        const outcome = await t3patchDownloadFile(url, name);
         if (outcome === "failed") throw new Error("Не удалось запустить загрузку.");
       })().catch((error: unknown) =>
         Alert.alert("Не скачано", error instanceof Error ? error.message : String(error)),
       );
     },
-    [createUrl, environmentId, threadId],
+    [createUrl, environmentId, threadId, workspaceRoot],
   );
 
   return useCallback(
     (href: string, target: FileChipTarget) => {
+      // долгое нажатие в Android отзывается вибрацией
+      void Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium).catch(() => undefined);
       const actions = t3patchFileChipActions(target, workspaceRoot, {
         open: () => open(href),
         download: () => download(target),
@@ -111,6 +149,8 @@ export function useT3patchFileChipMenu(input: {
                 t3patchReveal: folder,
               })
           : null,
+        insert: (relativePath) =>
+          t3patchInsertFileLink(scopedThreadKey(environmentId, threadId), relativePath),
         share: fileChipShareSource(target, threadId) ? () => share(target) : null,
       });
       const title = fileBasename(target.fullPath ?? target.relativePath ?? href);
