diff --git a/apps/mobile/src/features/files/FileTreeBrowser.tsx b/apps/mobile/src/features/files/FileTreeBrowser.tsx
index 562588e07d..92ce4986da 100644
--- a/apps/mobile/src/features/files/FileTreeBrowser.tsx
+++ b/apps/mobile/src/features/files/FileTreeBrowser.tsx
@@ -114,6 +114,9 @@ const FileTreeRow = memo(function FileTreeRow(props: {
   );
 });
 
+/** t3-patch: сколько держится подсветка строки после «Открыть в проводнике». */
+const T3PATCH_FLASH_MS = 4_000;
+
 export function FileTreeBrowser(props: {
   readonly entries: ReadonlyArray<ProjectEntry>;
   readonly error: string | null;
@@ -130,6 +133,8 @@ export function FileTreeBrowser(props: {
   readonly cwd?: string | null;
   /** t3-patch: раскрыть дерево до этой папки (переход по ссылке на папку). */
   readonly t3patchRevealPath?: string | null;
+  /** t3-patch: прокрутить к этому файлу и подсветить его («Открыть в проводнике»). */
+  readonly t3patchFocusPath?: string | null;
   /** t3-patch: пункт «Вставить в сообщение» в меню долгого нажатия. */
   readonly t3patchOnInsertPath?: (path: string) => void;
   /** t3-patch: файловые операции в меню (загрузка, папки, переименование, корзина). */
@@ -215,6 +220,28 @@ export function FileTreeBrowser(props: {
     });
   }, [t3patchRevealPath]);
 
+  // t3-patch: «Открыть в проводнике» — когда строка файла (или папки) появится в дереве (папки
+  // подгружаются по очереди), один раз прокрутить к ней и подсветить на несколько секунд
+  const t3patchFocusPath = props.t3patchFocusPath ?? t3patchRevealPath;
+  const t3patchListRef = useRef<FlatList<VisibleFileTreeNode> | null>(null);
+  const t3patchScrolledRef = useRef<string | null>(null);
+  const [t3patchFlashPath, setT3patchFlashPath] = useState<string | null>(null);
+  useEffect(() => {
+    if (!t3patchFocusPath || t3patchScrolledRef.current === t3patchFocusPath) return;
+    const index = visibleNodes.findIndex((item) => item.node.path === t3patchFocusPath);
+    if (index < 0) return;
+    t3patchScrolledRef.current = t3patchFocusPath;
+    setT3patchFlashPath(t3patchFocusPath);
+    requestAnimationFrame(() =>
+      t3patchListRef.current?.scrollToIndex({ index, animated: true, viewPosition: 0.35 }),
+    );
+  }, [t3patchFocusPath, visibleNodes]);
+  useEffect(() => {
+    if (!t3patchFlashPath) return;
+    const timer = setTimeout(() => setT3patchFlashPath(null), T3PATCH_FLASH_MS);
+    return () => clearTimeout(timer);
+  }, [t3patchFlashPath]);
+
   useEffect(
     () => () => {
       if (pendingSelectionTimeoutRef.current !== null) {
@@ -256,7 +283,10 @@ export function FileTreeBrowser(props: {
     ({ item }: { readonly item: VisibleFileTreeNode }) => (
       <FileTreeRow
         item={item}
-        selected={item.node.kind === "file" && item.node.path === selectedPath}
+        selected={
+          (item.node.kind === "file" && item.node.path === selectedPath) ||
+          item.node.path === t3patchFlashPath // t3-patch: подсветка после «Открыть в проводнике»
+        }
         expanded={expandedPaths.has(item.node.path)}
         loaded={loadedDirectories.has(item.node.path)}
         onPressDirectory={toggleDirectory}
@@ -272,6 +302,7 @@ export function FileTreeBrowser(props: {
       onPreviewFile,
       loadedDirectories,
       selectedPath,
+      t3patchFlashPath,
       toggleDirectory,
     ],
   );
@@ -283,6 +314,23 @@ export function FileTreeBrowser(props: {
   // flex-1 Views is ignored, which is why the tree rendered under the header with no blur.
   return (
     <FlatList
+      ref={t3patchListRef}
+      // t3-patch: строки разной высоты — если до строки ещё не доскроллить, сначала примерно
+      onScrollToIndexFailed={(info) => {
+        t3patchListRef.current?.scrollToOffset({
+          offset: info.averageItemLength * info.index,
+          animated: false,
+        });
+        setTimeout(
+          () =>
+            t3patchListRef.current?.scrollToIndex({
+              index: info.index,
+              animated: true,
+              viewPosition: 0.35,
+            }),
+          120,
+        );
+      }}
       alwaysBounceVertical
       className="flex-1"
       data={visibleNodes}
