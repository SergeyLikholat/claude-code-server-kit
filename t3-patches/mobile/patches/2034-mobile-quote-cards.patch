diff --git a/apps/mobile/src/sergey/quoteFormat.ts b/apps/mobile/src/sergey/quoteFormat.ts
index 0c77f1dfea..a2153f1b39 100644
--- a/apps/mobile/src/sergey/quoteFormat.ts
+++ b/apps/mobile/src/sergey/quoteFormat.ts
@@ -1,13 +1,114 @@
-/** t3-patch: оформление цитаты для поля ввода (quoteInsert.tsx). */
-/** Цитата markdown-блоком: «> » перед каждой строкой, отделена от текста пустой строкой. */
-export function t3patchQuoteText(existing: string, selected: string): string {
-  const cleaned = selected.replace(/\r\n?/g, "\n").trim();
-  if (cleaned.length === 0) return "";
-  const body = cleaned
-    .split("\n")
-    .map((line) => (line.trim().length > 0 ? `> ${line}` : ">"))
-    .join("\n");
-  const separator =
-    existing.length === 0 ? "" : existing.endsWith("\n\n") ? "" : existing.endsWith("\n") ? "\n" : "\n\n";
-  return `${separator}${body}\n\n`;
+/**
+ * t3-patch: цитаты из сообщений треда — чистая логика (без React), её проверяют тесты.
+ *
+ * Цитата живёт отдельно от текста черновика (карточка над полем ввода, quoteInsert.tsx) и при
+ * отправке уходит штатным форматом T3 — ссылкой AssistantCitation перед текстом сообщения.
+ * Сервер разворачивает такие ссылки для модели (expandAssistantCitationsForProvider), веб-версия
+ * показывает их цитатой, приложение — карточкой над текстом сообщения.
+ */
+import {
+  ASSISTANT_CITATION_CONTEXT_LENGTH,
+  ASSISTANT_CITATION_MAX_TEXT_LENGTH,
+  type AssistantCitation,
+  type EnvironmentId,
+  type MessageId,
+  type ThreadId,
+} from "@t3tools/contracts";
+import {
+  collectAssistantCitations,
+  serializeAssistantCitation,
+} from "@t3tools/shared/assistantCitations";
+
+export interface T3patchQuoteMessage {
+  readonly id: string;
+  readonly role: string;
+  readonly text: string;
+}
+
+export interface T3patchPendingQuote {
+  readonly id: string;
+  readonly text: string;
+  readonly messageId: string | null;
+  readonly role: string | null;
+}
+
+/** Текст без разметки и лишних пробелов — так выделение находится в исходном Markdown. */
+export function t3patchQuoteNormalize(text: string): string {
+  return text
+    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
+    .replace(/[*_`#>|~]/g, "")
+    .replace(/\s+/g, " ")
+    .trim()
+    .toLowerCase();
+}
+
+/** Сообщение, из которого выделен текст: последнее, где выделение встречается целиком. */
+export function t3patchFindQuoteSource(
+  messages: ReadonlyArray<T3patchQuoteMessage>,
+  selected: string,
+): T3patchQuoteMessage | null {
+  const needle = t3patchQuoteNormalize(selected);
+  if (!needle) return null;
+  for (let index = messages.length - 1; index >= 0; index -= 1) {
+    const message = messages[index]!;
+    if (t3patchQuoteNormalize(message.text).includes(needle)) return message;
+  }
+  return null;
+}
+
+/** Цитата штатного формата T3. Позиция — по исходному тексту сообщения, если нашлась. */
+export function t3patchCitationFor(input: {
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly quote: T3patchPendingQuote;
+  readonly sourceText: string | null;
+}): AssistantCitation {
+  const text = input.quote.text.slice(0, ASSISTANT_CITATION_MAX_TEXT_LENGTH);
+  const source = input.sourceText ?? text;
+  const found = source.indexOf(text);
+  const start = found >= 0 ? found : 0;
+  const end = start + text.length;
+  const context = ASSISTANT_CITATION_CONTEXT_LENGTH;
+  return {
+    version: 1,
+    environmentId: input.environmentId as EnvironmentId,
+    threadId: input.threadId as ThreadId,
+    messageId: (input.quote.messageId ?? "quote") as MessageId,
+    text,
+    start,
+    end,
+    prefix: found >= 0 ? source.slice(Math.max(0, start - context), start) : "",
+    suffix: found >= 0 ? source.slice(end, end + context) : "",
+  };
+}
+
+/** Текст сообщения с цитатами: ссылки-цитаты отдельными строками, затем текст пользователя. */
+export function t3patchMessageWithCitations(
+  text: string,
+  citations: ReadonlyArray<AssistantCitation>,
+): string {
+  if (citations.length === 0) return text;
+  const markers = citations.map(serializeAssistantCitation).join("\n");
+  const body = text.trim();
+  return body ? `${markers}\n\n${body}` : markers;
+}
+
+/** Для ленты: цитаты отдельно (карточками), остальной текст — как обычно. */
+export function t3patchSplitCitations(text: string): {
+  readonly citations: ReadonlyArray<AssistantCitation>;
+  readonly rest: string;
+} {
+  const matches = collectAssistantCitations(text);
+  if (matches.length === 0) return { citations: [], rest: text };
+  let rest = "";
+  let cursor = 0;
+  for (const match of matches) {
+    rest += text.slice(cursor, match.start);
+    cursor = match.end;
+  }
+  rest += text.slice(cursor);
+  return {
+    citations: matches.map((match) => match.citation),
+    rest: rest.replace(/^\s+/, "").replace(/\n{3,}/g, "\n\n"),
+  };
 }
