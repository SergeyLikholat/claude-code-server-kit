@@ -0,0 +1,39 @@
+import { ClockArrowDownIcon, GripVerticalIcon } from "lucide-react";
+import type { ComponentType, ReactNode } from "react";
+
+import { setFlatThreadOrder, useFlatThreadOrder } from "./flatThreadOrder";
+
+type HeaderIconButton = ComponentType<{
+  label: string;
+  tooltip?: ReactNode;
+  onClick?: () => void;
+  children: ReactNode;
+}>;
+
+/** Кнопка в шапке плоского сайдбара: ручной порядок ↔ по последнему сообщению.
+    Кнопку-иконку шапки получает параметром, чтобы не импортировать файл,
+    который сам подключает этот компонент. */
+export function FlatThreadOrderToggle({ Button }: { Button: HeaderIconButton }) {
+  const order = useFlatThreadOrder();
+  const latest = order === "latest";
+  return (
+    <Button
+      label={latest ? "Порядок: по последнему сообщению" : "Порядок: ручной"}
+      tooltip={
+        <span className="flex flex-col gap-0.5">
+          <span>
+            {latest ? "Сверху — треды с последним сообщением" : "Ручной порядок (перетаскивание)"}
+          </span>
+          <span className="text-muted-foreground">
+            {latest
+              ? "Нажми, чтобы вернуть ручной порядок"
+              : "Нажми, чтобы сортировать по последнему сообщению"}
+          </span>
+        </span>
+      }
+      onClick={() => setFlatThreadOrder(latest ? "manual" : "latest")}
+    >
+      {latest ? <ClockArrowDownIcon /> : <GripVerticalIcon />}
+    </Button>
+  );
+}
diff --git a/apps/web/src/components/sergey/flatThreadOrder.test.ts b/apps/web/src/components/sergey/flatThreadOrder.test.ts
