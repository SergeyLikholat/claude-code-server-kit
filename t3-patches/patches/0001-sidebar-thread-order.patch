@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { latestActivityMs, sortThreadsByLatestMessage } from "./flatThreadOrder";
+
+const thread = (
+  id: string,
+  createdAt: string,
+  updatedAt: string,
+  latestUserMessageAt: string | null,
+) => ({ id, createdAt, updatedAt, latestUserMessageAt });
+
+describe("sortThreadsByLatestMessage", () => {
+  it("поднимает тред с самым свежим сообщением, даже если он создан раньше всех", () => {
+    const old = thread(
+      "old",
+      "2026-09-20T10:00:00Z",
+      "2026-09-20T10:00:00Z",
+      "2026-09-24T12:00:00Z",
+    );
+    const fresh = thread(
+      "fresh",
+      "2026-09-24T09:00:00Z",
+      "2026-09-24T09:00:00Z",
+      "2026-09-24T09:05:00Z",
+    );
+    expect(sortThreadsByLatestMessage([fresh, old]).map((t) => t.id)).toEqual(["old", "fresh"]);
+  });
+
+  it("без сообщений берёт время обновления, затем создания", () => {
+    const a = thread("a", "2026-09-20T10:00:00Z", "2026-09-23T10:00:00Z", null);
+    const b = thread("b", "2026-09-22T10:00:00Z", "not-a-date", null);
+    expect(latestActivityMs(b)).toBe(Date.parse("2026-09-22T10:00:00Z"));
+    expect(sortThreadsByLatestMessage([b, a]).map((t) => t.id)).toEqual(["a", "b"]);
+  });
+
+  it("при равном времени порядок стабилен по id", () => {
+    const x = thread("x", "2026-09-24T10:00:00Z", "2026-09-24T10:00:00Z", null);
+    const y = thread("y", "2026-09-24T10:00:00Z", "2026-09-24T10:00:00Z", null);
+    expect(sortThreadsByLatestMessage([y, x]).map((t) => t.id)).toEqual(["x", "y"]);
+  });
+
+  it("не мутирует входной массив", () => {
+    const input = [
+      thread("a", "2026-09-20T10:00:00Z", "2026-09-20T10:00:00Z", null),
+      thread("b", "2026-09-21T10:00:00Z", "2026-09-21T10:00:00Z", null),
+    ];
+    const copy = [...input];
+    sortThreadsByLatestMessage(input);
+    expect(input).toEqual(copy);
+  });
+});
diff --git a/apps/web/src/components/sergey/flatThreadOrder.ts b/apps/web/src/components/sergey/flatThreadOrder.ts
new file mode 100644
index 0000000000..d75cd8e4e4
--- /dev/null
+++ b/apps/web/src/components/sergey/flatThreadOrder.ts
@@ -0,0 +1,95 @@
+/**
+ * Порядок тредов в плоском сайдбаре: штатный «ручной» или по последнему
+ * сообщению пользователя (как «Last user message» в LegacySidebar).
+ *
+ * Штатно активные треды стоят в порядке создания и ручного перетаскивания —
+ * активность их не двигает (см. sortActiveThreadsByOrderKey). Этот режим
+ * добавляет альтернативу, не трогая штатную логику.
+ *
+ * Выбор хранится в localStorage устройства, как остальные клиентские
+ * настройки, но под своим ключом: так патч не меняет общую схему настроек.
+ */
+import { useSyncExternalStore } from "react";
+
+export type FlatThreadOrder = "manual" | "latest";
+
+const STORAGE_KEY = "t3patch.flatThreadOrder";
+const listeners = new Set<() => void>();
+
+function readOrder(): FlatThreadOrder {
+  try {
+    return globalThis.localStorage?.getItem(STORAGE_KEY) === "latest" ? "latest" : "manual";
+  } catch {
+    return "manual";
+  }
+}
+
+export function setFlatThreadOrder(order: FlatThreadOrder): void {
+  try {
+    globalThis.localStorage?.setItem(STORAGE_KEY, order);
+  } catch {
+    // приватный режим или переполненное хранилище: режим действует до перезагрузки
+  }
+  cachedOrder = order;
+  for (const listener of listeners) listener();
+}
+
+let cachedOrder: FlatThreadOrder = readOrder();
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  const onStorage = (event: StorageEvent) => {
+    if (event.key !== STORAGE_KEY) return;
+    cachedOrder = readOrder();
+    listener();
+  };
+  globalThis.addEventListener?.("storage", onStorage);
+  return () => {
+    listeners.delete(listener);
+    globalThis.removeEventListener?.("storage", onStorage);
+  };
+}
+
+export function useFlatThreadOrder(): FlatThreadOrder {
+  return useSyncExternalStore(
+    subscribe,
+    () => cachedOrder,
+    () => "manual",
+  );
+}
+
+function toMs(value: string | null | undefined): number | null {
+  if (!value) return null;
+  const ms = Date.parse(value);
+  return Number.isNaN(ms) ? null : ms;
+}
+
+/** Время для сортировки: последнее сообщение пользователя, иначе последнее
+    обновление, иначе создание — тот же запасной порядок, что у legacy. */
+export function latestActivityMs(thread: {
+  readonly latestUserMessageAt?: string | null | undefined;
+  readonly updatedAt: string;
+  readonly createdAt: string;
+}): number {
+  return (
+    toMs(thread.latestUserMessageAt) ??
+    toMs(thread.updatedAt) ??
+    toMs(thread.createdAt) ??
+    Number.NEGATIVE_INFINITY
+  );
+}
+
+/** Новые сверху; при равенстве — стабильно по id, чтобы строки не прыгали. */
+export function sortThreadsByLatestMessage<
+  T extends {
+    readonly id: string;
+    readonly latestUserMessageAt?: string | null | undefined;
+    readonly updatedAt: string;
+    readonly createdAt: string;
+  },
+>(threads: readonly T[]): T[] {
+  const stamps = new Map(threads.map((thread) => [thread, latestActivityMs(thread)]));
+  return [...threads].sort(
+    (left, right) => stamps.get(right)! - stamps.get(left)! || left.id.localeCompare(right.id),
+  );
+}
