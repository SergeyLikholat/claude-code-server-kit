diff --git a/apps/web/src/components/sergey/fileActions.ts b/apps/web/src/components/sergey/fileActions.ts
new file mode 100644
index 0000000000..275011851b
--- /dev/null
+++ b/apps/web/src/components/sergey/fileActions.ts
@@ -0,0 +1,112 @@
+/**
+ * t3-patch: пункты контекстного меню дерева файлов — копировать путь,
+ * копировать полный (настоящий) путь, скачать.
+ *
+ * Полный путь и ссылку на скачивание даёт серверный маршрут t3-patch
+ * /api/t3patch/file-info (apps/server/src/sergey/fileAccess.ts). Окна вроде
+ * `!Obsidian/...` сервер раскрывает в настоящий путь `/root/Obsidian/...`.
+ */
+import { toastManager } from "~/components/ui/toast";
+import { resolvePrimaryEnvironmentHttpUrl } from "~/environments/primary/target";
+import { writeTextToClipboard } from "~/hooks/useCopyToClipboard";
+
+export interface T3PatchFileInfo {
+  readonly absolutePath: string;
+  readonly realPath: string;
+  readonly relativePath: string;
+  readonly isDirectory: boolean;
+  readonly size: number;
+  readonly mtimeMs: number;
+  readonly downloadUrl: string | null;
+}
+
+const MENU_COPY_PATH = "t3patch-copy-path";
+const MENU_COPY_REAL_PATH = "t3patch-copy-real-path";
+const MENU_DOWNLOAD = "t3patch-download";
+
+/** Пункты, которые патч добавляет в меню дерева. `path` — как в дереве, у папок со слешем в конце. */
+export function t3patchFileMenuItems(treePath: string): Array<{ id: string; label: string }> {
+  const isDirectory = treePath.endsWith("/");
+  return [
+    { id: MENU_COPY_PATH, label: "Копировать путь" },
+    { id: MENU_COPY_REAL_PATH, label: "Копировать полный путь" },
+    ...(isDirectory ? [] : [{ id: MENU_DOWNLOAD, label: "Скачать" }]),
+  ];
+}
+
+export async function fetchT3PatchFileInfo(
+  cwd: string,
+  relativePath: string,
+): Promise<T3PatchFileInfo> {
+  const response = await fetch(resolvePrimaryEnvironmentHttpUrl("/api/t3patch/file-info"), {
+    method: "POST",
+    credentials: "include",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ cwd, relativePath }),
+  });
+  const body = (await response.json().catch(() => null)) as
+    | (T3PatchFileInfo & { error?: string })
+    | null;
+  if (!response.ok || !body || body.error) {
+    throw new Error(body?.error ?? `Сервер ответил ${response.status}`);
+  }
+  return body;
+}
+
+async function copyWithToast(text: string, title: string) {
+  try {
+    await writeTextToClipboard(text);
+    toastManager.add({ type: "success", title, description: text });
+  } catch {
+    // Буфер обмена недоступен (нет фокуса, запрет браузера) — показать путь, чтобы скопировать руками.
+    toastManager.add({
+      type: "warning",
+      title: "Не удалось скопировать — путь ниже",
+      description: text,
+    });
+  }
+}
+
+function startDownload(url: string) {
+  const link = document.createElement("a");
+  link.href = resolvePrimaryEnvironmentHttpUrl(url);
+  link.rel = "noopener";
+  link.download = "";
+  document.body.append(link);
+  link.click();
+  link.remove();
+}
+
+/** Обработать пункт меню патча. Возвращает false, если пункт не наш. */
+export async function handleT3PatchFileMenu(
+  clicked: string | null | undefined,
+  input: { readonly cwd: string; readonly relativePath: string },
+): Promise<boolean> {
+  if (clicked !== MENU_COPY_PATH && clicked !== MENU_COPY_REAL_PATH && clicked !== MENU_DOWNLOAD) {
+    return false;
+  }
+  if (clicked === MENU_COPY_PATH) {
+    await copyWithToast(input.relativePath, "Путь скопирован");
+    return true;
+  }
+  try {
+    const info = await fetchT3PatchFileInfo(input.cwd, input.relativePath);
+    if (clicked === MENU_COPY_REAL_PATH) {
+      await copyWithToast(info.realPath, "Полный путь скопирован");
+    } else if (info.downloadUrl) {
+      startDownload(info.downloadUrl);
+      toastManager.add({
+        type: "success",
+        title: "Скачивание началось",
+        description: info.realPath,
+      });
+    }
+  } catch (error) {
+    toastManager.add({
+      type: "error",
+      title: clicked === MENU_DOWNLOAD ? "Не удалось скачать" : "Не удалось получить путь",
+      description: error instanceof Error ? error.message : String(error),
+    });
+  }
+  return true;
+}
