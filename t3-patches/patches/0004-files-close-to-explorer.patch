+++ b/apps/web/src/components/sergey/CloseFileAction.tsx
@@ -0,0 +1,27 @@
+/**
+ * t3-patch: кнопка «Закрыть файл» в шапке открытого документа.
+ *
+ * Штатно каждый открытый файл — вкладка правой панели, а вкладку «только
+ * дерево» (`files`) openFile удаляет при открытии первого файла. Вернуться
+ * к дереву без документа можно было только закрыв панель целиком. Кнопка
+ * закрывает вкладку файла и открывает вместо неё дерево.
+ */
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { XIcon } from "lucide-react";
+
+import { FileSurfaceAction } from "~/components/files/fileSurfaceChrome";
+import { closeFileToExplorer } from "./closeFile";
+
+export function CloseFileAction(props: {
+  readonly threadRef: ScopedThreadRef;
+  readonly relativePath: string;
+}) {
+  return (
+    <FileSurfaceAction
+      label="Закрыть файл"
+      onPress={() => closeFileToExplorer(props.threadRef, props.relativePath)}
+    >
+      <XIcon className="size-3.5" />
+    </FileSurfaceAction>
+  );
+}
diff --git a/apps/web/src/components/sergey/closeFile.test.ts b/apps/web/src/components/sergey/closeFile.test.ts
new file mode 100644
index 0000000000..ae3c1d8172
--- /dev/null
+++ b/apps/web/src/components/sergey/closeFile.test.ts
@@ -0,0 +1,35 @@
+import { scopeThreadRef } from "@t3tools/client-runtime/environment";
+import { type EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { selectThreadRightPanelState, useRightPanelStore } from "~/rightPanelStore";
+
+import { closeFileToExplorer } from "./closeFile";
+
+const ref = scopeThreadRef("env-1" as EnvironmentId, ThreadId.make("thread-close"));
+const panel = () => selectThreadRightPanelState(useRightPanelStore.getState().byThreadKey, ref);
+
+describe("closeFileToExplorer", () => {
+  it("после закрытия файла остаётся дерево проекта, панель открыта", () => {
+    useRightPanelStore.getState().open(ref, "files");
+    useRightPanelStore.getState().openFile(ref, "notes/a.md");
+    expect(panel().surfaces.map((s) => s.id)).toEqual(["file:notes/a.md"]);
+
+    closeFileToExplorer(ref, "notes/a.md");
+
+    expect(panel().surfaces.map((s) => s.id)).toEqual(["files"]);
+    expect(panel().activeSurfaceId).toBe("files");
+    expect(panel().isOpen).toBe(true);
+  });
+
+  it("другие открытые файлы остаются вкладками", () => {
+    useRightPanelStore.getState().openFile(ref, "a.md");
+    useRightPanelStore.getState().openFile(ref, "b.md");
+    closeFileToExplorer(ref, "b.md");
+    const ids = panel().surfaces.map((s) => s.id);
+    expect(ids).toContain("file:a.md");
+    expect(ids).toContain("files");
+    expect(ids).not.toContain("file:b.md");
+    expect(panel().activeSurfaceId).toBe("files");
+  });
+});
diff --git a/apps/web/src/components/sergey/closeFile.ts b/apps/web/src/components/sergey/closeFile.ts
new file mode 100644
index 0000000000..3bb45dd20a
--- /dev/null
+++ b/apps/web/src/components/sergey/closeFile.ts
@@ -0,0 +1,14 @@
+import type { ScopedThreadRef } from "@t3tools/contracts";
+
+import { useRightPanelStore } from "~/rightPanelStore";
+
+/**
+ * t3-patch: закрыть вкладку файла и показать на её месте дерево проекта.
+ * Штатно openFile удаляет вкладку «только дерево» (`files`), поэтому после
+ * закрытия документа вернуться к дереву было нельзя.
+ */
+export function closeFileToExplorer(threadRef: ScopedThreadRef, relativePath: string): void {
+  const store = useRightPanelStore.getState();
+  store.closeSurface(threadRef, `file:${relativePath}`);
+  store.open(threadRef, "files");
+}
