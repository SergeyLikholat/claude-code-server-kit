@@ -62,3 +68,33 @@ describe("настоящий путь через bind-монтирования",
     expect(resolveBindMounts("/root/projects/x/docs/f.pdf", mounts)).toBe("/root/My Docs/f.pdf");
   });
 });
+
+describe("конвертация старых форматов в docx", () => {
+  it("распознаёт форматы", () => {
+    expect(isConvertibleToDocx("/a/Письмо.DOC")).toBe(true);
+    expect(isConvertibleToDocx("/a/b.rtf")).toBe(true);
+    expect(isConvertibleToDocx("/a/b.docx")).toBe(false);
+    expect(isConvertibleToDocx("/a/b.xls")).toBe(false);
+  });
+
+  const sample = (() => {
+    const dir = "/root/Obsidian/4. Ресурсы/Почитать/Сергей Лукьяненко/Публицистика";
+    if (!existsSync(dir)) return null;
+    const name = readdirSync(dir).find((file) => file.toLowerCase().endsWith(".doc"));
+    return name ? `${dir}/${name}` : null;
+  })();
+
+  it.skipIf(sample === null)(
+    "настоящий .doc превращается в docx, повторный вызов берёт кэш",
+    async () => {
+      const first = await convertToDocxCached(sample!);
+      expect(first.endsWith(".docx")).toBe(true);
+      expect(existsSync(first)).toBe(true);
+      const started = performance.now();
+      const second = await convertToDocxCached(sample!);
+      expect(second).toBe(first);
+      expect(performance.now() - started).toBeLessThan(500);
+    },
+    120_000,
+  );
+});
