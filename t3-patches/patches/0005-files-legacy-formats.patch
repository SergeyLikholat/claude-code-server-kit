 );
+
+/**
+ * Старые форматы Word (.doc), а также .rtf и .odt браузер прочитать не может —
+ * их конвертирует в .docx LibreOffice на сервере, дальше работает тот же
+ * просмотрщик docx. Результат кэшируется по пути, размеру и дате изменения.
+ */
+const CONVERTIBLE_TO_DOCX = new Set([".doc", ".rtf", ".odt"]);
+const CONVERT_TIMEOUT_MS = 90_000;
+const CONVERT_CACHE_MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;
+
+export const isConvertibleToDocx = (filePath: string) =>
+  CONVERTIBLE_TO_DOCX.has(NodePath.extname(filePath).toLowerCase());
+
+const convertCacheDir = () => NodePath.join(NodeOs.homedir(), ".cache", "t3patch-convert");
+
+// Один профиль LibreOffice на все конвертации — поэтому строго по очереди.
+let conversionQueue: Promise<unknown> = Promise.resolve();
+
+function runSoffice(args: readonly string[]): Promise<void> {
+  return new Promise((resolve, reject) => {
+    execFile("soffice", [...args], { timeout: CONVERT_TIMEOUT_MS }, (error) =>
+      error ? reject(error) : resolve(),
+    );
+  });
+}
+
+async function pruneConvertCache(dir: string, now: number): Promise<void> {
+  for (const name of await readdir(dir).catch(() => [] as string[])) {
+    if (!name.endsWith(".docx")) continue;
+    const file = NodePath.join(dir, name);
+    const info = await stat(file).catch(() => null);
+    if (info && now - info.mtimeMs > CONVERT_CACHE_MAX_AGE_MS) await rm(file, { force: true });
+  }
+}
+
+export async function convertToDocxCached(sourcePath: string): Promise<string> {
+  const source = await stat(sourcePath);
+  const dir = convertCacheDir();
+  const key = createHash("sha256")
+    .update(`${sourcePath}\0${source.size}\0${source.mtimeMs}`)
+    .digest("hex")
+    .slice(0, 32);
+  const target = NodePath.join(dir, `${key}.docx`);
+  const cached = await stat(target).catch(() => null);
+  if (cached?.isFile()) {
+    const now = new Date();
+    await utimes(target, now, now).catch(() => undefined); // свежее использование — не чистить
+    return target;
+  }
+  const job = conversionQueue.then(async () => {
+    await mkdir(dir, { recursive: true });
+    const outDir = await mkdtemp(NodePath.join(dir, "out-"));
+    try {
+      await runSoffice([
+        `-env:UserInstallation=file://${NodePath.join(dir, "lo-profile")}`,
+        "--headless",
+        "--norestore",
+        "--nologo",
+        "--convert-to",
+        "docx",
+        "--outdir",
+        outDir,
+        sourcePath,
+      ]);
+      const produced = (await readdir(outDir)).find((name) => name.endsWith(".docx"));
+      if (!produced) throw new Error("LibreOffice не создал docx");
+      await rename(NodePath.join(outDir, produced), target);
+      await pruneConvertCache(dir, Date.now());
+      return target;
+    } finally {
+      await rm(outDir, { recursive: true, force: true });
+    }
+  });
+  conversionQueue = job.catch(() => undefined);
+  return job;
+}
+
+export const t3patchConvertRouteLayer = HttpRouter.add(
+  "GET",
+  `${T3PATCH_CONVERT_ROUTE_PREFIX}/*`,
+  Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const url = HttpServerRequest.toURL(request);
+    if (Option.isNone(url)) return HttpServerResponse.text("Bad Request", { status: 400 });
+    const suffix = url.value.pathname.slice(`${T3PATCH_CONVERT_ROUTE_PREFIX}/`.length);
+    const filePath = verifyFileToken(suffix.split("/")[0] ?? "");
+    if (!filePath || !isConvertibleToDocx(filePath)) {
+      return HttpServerResponse.text("Ссылка устарела или неверна.", { status: 404 });
+    }
+    const converted = yield* Effect.tryPromise(() => convertToDocxCached(filePath)).pipe(
+      Effect.orElseSucceed(() => null),
+    );
+    if (!converted) {
+      return HttpServerResponse.text("Не удалось сконвертировать документ.", { status: 500 });
+    }
+    return yield* assetFileResponse({
+      path: converted,
+      download: true,
+      fileName: `${NodePath.parse(filePath).name}.docx`,
+    }).pipe(
+      Effect.orElseSucceed(() => HttpServerResponse.text("Internal Server Error", { status: 500 })),
+    );
+  }),
+);
