--- /dev/null
+++ b/apps/web/src/components/sergey/ResizableExplorerPane.tsx
@@ -0,0 +1,136 @@
+/**
+ * t3-patch: дерево файлов рядом с открытым документом можно растягивать.
+ *
+ * Штатно ширина дерева зашита классом `w-[min(22rem,46%)]`. Здесь её задаёт
+ * перетаскиваемый разделитель. Хранится доля ширины панели, а не пиксели:
+ * одна и та же настройка разумно выглядит и на телефоне, и на компьютере.
+ * Двойное нажатие на разделитель возвращает штатную ширину.
+ */
+import {
+  type PointerEvent as ReactPointerEvent,
+  type ReactNode,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from "react";
+
+const STORAGE_KEY = "t3patch.fileExplorerFraction";
+const DEFAULT_FRACTION = 0.46;
+const DEFAULT_MAX_PX = 352; // 22rem — как в штатной вёрстке
+const MIN_TREE_PX = 120;
+const MIN_DOCUMENT_PX = 140;
+
+function readFraction(): number | null {
+  try {
+    const value = Number(globalThis.localStorage?.getItem(STORAGE_KEY));
+    return Number.isFinite(value) && value > 0 && value < 1 ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function saveFraction(value: number | null) {
+  try {
+    if (value === null) globalThis.localStorage?.removeItem(STORAGE_KEY);
+    else globalThis.localStorage?.setItem(STORAGE_KEY, value.toFixed(4));
+  } catch {
+    // хранилище недоступно — ширина действует до перезагрузки
+  }
+}
+
+/** Ширина дерева в пикселях для ширины панели `total`. */
+export function explorerWidthPx(total: number, fraction: number | null): number {
+  const wanted =
+    fraction === null ? Math.min(DEFAULT_MAX_PX, total * DEFAULT_FRACTION) : total * fraction;
+  const max = Math.max(MIN_TREE_PX, total - MIN_DOCUMENT_PX);
+  return Math.round(Math.max(MIN_TREE_PX, Math.min(max, wanted)));
+}
+
+export function ResizableExplorerPane(props: {
+  readonly fileOpen: boolean;
+  readonly children: ReactNode;
+}) {
+  const paneRef = useRef<HTMLElement>(null);
+  const [total, setTotal] = useState(0);
+  const [fraction, setFraction] = useState<number | null>(readFraction);
+  const drag = useRef<{ pointerId: number; startX: number; startWidth: number } | null>(null);
+
+  useLayoutEffect(() => {
+    const parent = paneRef.current?.parentElement;
+    if (!parent) return;
+    const update = () => setTotal(parent.getBoundingClientRect().width);
+    update();
+    const observer = new ResizeObserver(update);
+    observer.observe(parent);
+    return () => observer.disconnect();
+  }, [props.fileOpen]);
+
+  if (!props.fileOpen) {
+    return (
+      <aside ref={paneRef} className="flex min-h-0 min-w-0 flex-1 bg-background">
+        {props.children}
+      </aside>
+    );
+  }
+
+  const width = total > 0 ? explorerWidthPx(total, fraction) : undefined;
+
+  const onPointerDown = (event: ReactPointerEvent<HTMLDivElement>) => {
+    if (!total || width === undefined) return;
+    event.preventDefault();
+    event.currentTarget.setPointerCapture(event.pointerId);
+    drag.current = { pointerId: event.pointerId, startX: event.clientX, startWidth: width };
+  };
+  const onPointerMove = (event: ReactPointerEvent<HTMLDivElement>) => {
+    const state = drag.current;
+    if (!state || state.pointerId !== event.pointerId || !total) return;
+    // Разделитель на левом краю дерева: тянем влево — дерево шире.
+    const next = state.startWidth + (state.startX - event.clientX);
+    setFraction(explorerWidthPx(total, next / total) / total);
+  };
+  const endDrag = (event: ReactPointerEvent<HTMLDivElement>) => {
+    if (drag.current?.pointerId !== event.pointerId) return;
+    drag.current = null;
+    setFraction((current) => {
+      saveFraction(current);
+      return current;
+    });
+  };
+
+  return (
+    <aside
+      ref={paneRef}
+      className={`relative flex min-h-0 shrink-0 border-l border-border/60 bg-background ${
+        width === undefined ? "w-[min(22rem,46%)]" : ""
+      }`}
+      style={width === undefined ? undefined : { width }}
+    >
+      <div
+        role="separator"
+        aria-orientation="vertical"
+        aria-label="Ширина дерева файлов"
+        title="Потяни, чтобы изменить ширину. Двойное нажатие — вернуть исходную"
+        className="group absolute inset-y-0 -left-2 z-20 w-4 cursor-col-resize touch-none select-none"
+        onPointerDown={onPointerDown}
+        onPointerMove={onPointerMove}
+        onPointerUp={endDrag}
+        onPointerCancel={endDrag}
+        onLostPointerCapture={endDrag}
+        onDoubleClick={() => {
+          setFraction(null);
+          saveFraction(null);
+        }}
+      >
+        <span
+          aria-hidden
+          className="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-transparent transition-colors duration-150 group-hover:bg-border group-active:bg-primary/60"
+        />
+        <span
+          aria-hidden
+          className="pointer-events-none absolute top-1/2 left-1/2 h-10 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-border/80 group-active:bg-primary/70"
+        />
+      </div>
+      {props.children}
+    </aside>
+  );
+}
