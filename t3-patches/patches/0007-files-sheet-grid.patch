@@ -0,0 +1,36 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { explorerWidthPx } from "./ResizableExplorerPane";
+import { columnLetter } from "./SheetGrid";
+
+describe("буквы столбцов как в Excel", () => {
+  it("A…Z, затем AA, AZ, BA, ZZ, AAA", () => {
+    expect([0, 1, 25, 26, 51, 52, 701, 702].map(columnLetter)).toEqual([
+      "A",
+      "B",
+      "Z",
+      "AA",
+      "AZ",
+      "BA",
+      "ZZ",
+      "AAA",
+    ]);
+  });
+});
+
+describe("ширина дерева файлов", () => {
+  it("по умолчанию — штатные 46%, но не больше 22rem", () => {
+    expect(explorerWidthPx(390, null)).toBe(179);
+    expect(explorerWidthPx(1200, null)).toBe(352);
+  });
+
+  it("документу всегда остаётся не меньше 140 px, дереву не меньше 120", () => {
+    expect(explorerWidthPx(390, 0.99)).toBe(250);
+    expect(explorerWidthPx(390, 0.01)).toBe(120);
+  });
+
+  it("доля сохраняется между разными ширинами экрана", () => {
+    expect(explorerWidthPx(400, 0.5)).toBe(200);
+    expect(explorerWidthPx(1000, 0.5)).toBe(500);
+  });
+});
