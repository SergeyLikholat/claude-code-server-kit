diff --git a/apps/web/src/components/sergey/SheetGrid.tsx b/apps/web/src/components/sergey/SheetGrid.tsx
new file mode 100644
index 0000000000..8494445f58
--- /dev/null
+++ b/apps/web/src/components/sergey/SheetGrid.tsx
@@ -0,0 +1,119 @@
+/* oxlint-disable react/no-array-index-key -- строки и столбцы листа имеют постоянные позиции */
+/**
+ * t3-patch: лист Excel в виде сетки — буквы столбцов и номера строк как в Excel,
+ * закреплённые заголовки, без штатного лимита 100×30. Длинный текст не растягивает
+ * строку: нажатие на ячейку показывает её целиком в строке сверху (как строка
+ * формул). Строки подгружаются порциями, чтобы телефон не тормозил.
+ */
+import { useMemo, useState } from "react";
+
+import type { SheetPreview } from "./officeFiles";
+
+const ROWS_STEP = 300;
+const MAX_COLUMNS = 200;
+
+export function columnLetter(index: number): string {
+  let n = index + 1;
+  let out = "";
+  while (n > 0) {
+    const rest = (n - 1) % 26;
+    out = String.fromCharCode(65 + rest) + out;
+    n = Math.floor((n - 1) / 26);
+  }
+  return out;
+}
+
+export function SheetGrid(props: { readonly sheet: SheetPreview }) {
+  const { sheet } = props;
+  const [visible, setVisible] = useState(ROWS_STEP);
+  const [selected, setSelected] = useState<{ row: number; column: number } | null>(null);
+  const columnCount = useMemo(
+    () =>
+      Math.min(
+        MAX_COLUMNS,
+        sheet.rows.reduce((max, row) => Math.max(max, row.length), 0),
+      ),
+    [sheet.rows],
+  );
+  const shownRows = sheet.rows.slice(0, visible);
+  const address = selected
+    ? `${columnLetter(sheet.firstColumn + selected.column)}${sheet.firstRow + selected.row + 1}`
+    : null;
+  const selectedText = selected ? (sheet.rows[selected.row]?.[selected.column] ?? "") : "";
+
+  return (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <div className="flex min-h-8 shrink-0 items-start gap-2 border-b border-border/60 px-2 py-1 text-xs">
+        <span className="w-14 shrink-0 rounded bg-muted/60 px-1.5 py-0.5 text-center font-mono text-muted-foreground">
+          {address ?? "—"}
+        </span>
+        <span className="max-h-24 min-w-0 flex-1 overflow-auto break-words whitespace-pre-wrap select-text">
+          {address ? (
+            selectedText || <span className="text-muted-foreground">пусто</span>
+          ) : (
+            <span className="text-muted-foreground">
+              Нажми на ячейку, чтобы увидеть текст целиком
+            </span>
+          )}
+        </span>
+      </div>
+      <div className="min-h-0 flex-1 overflow-auto">
+        <table className="border-separate border-spacing-0 text-xs">
+          <thead className="sticky top-0 z-20">
+            <tr>
+              <th className="sticky left-0 z-30 border-r border-b border-border bg-muted px-1.5 py-1" />
+              {Array.from({ length: columnCount }, (_, column) => (
+                <th
+                  key={column}
+                  scope="col"
+                  className="min-w-12 border-r border-b border-border bg-muted px-2 py-1 text-center font-medium text-muted-foreground"
+                >
+                  {columnLetter(sheet.firstColumn + column)}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {shownRows.map((row, rowIndex) => (
+              <tr key={rowIndex}>
+                <th
+                  scope="row"
+                  className="sticky left-0 z-10 border-r border-b border-border bg-muted px-1.5 py-1 text-right font-normal text-muted-foreground tabular-nums"
+                >
+                  {sheet.firstRow + rowIndex + 1}
+                </th>
+                {Array.from({ length: columnCount }, (_, column) => {
+                  const text = row[column] ?? "";
+                  const isSelected = selected?.row === rowIndex && selected.column === column;
+                  return (
+                    <td
+                      key={column}
+                      onClick={() => setSelected({ row: rowIndex, column })}
+                      className={`max-w-64 cursor-cell overflow-hidden border-r border-b border-border/50 px-2 py-1 text-ellipsis whitespace-nowrap tabular-nums ${
+                        isSelected
+                          ? "bg-primary/15 outline outline-1 -outline-offset-1 outline-primary"
+                          : ""
+                      }`}
+                    >
+                      {text}
+                    </td>
+                  );
+                })}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+        {sheet.rows.length > visible ? (
+          <button
+            type="button"
+            onClick={() => setVisible((count) => count + ROWS_STEP)}
+            className="m-2 rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
+          >
+            Показать ещё {Math.min(ROWS_STEP, sheet.rows.length - visible)} строк (показано{" "}
+            {visible} из {sheet.rows.length})
+          </button>
+        ) : null}
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/sergey/layout.test.ts b/apps/web/src/components/sergey/layout.test.ts
