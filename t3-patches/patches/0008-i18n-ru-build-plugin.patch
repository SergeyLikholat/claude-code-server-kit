Одна строка в vite.config.ts подключает Babel-плагин русификации в уже
существующий вызов @rolldown/plugin-babel. Плагин и словарь лежат вне
исходников — в t3-patches/i18n/, путь передаёт build.sh через
T3PATCH_I18N_DIR. Без переменной и в тестах (VITEST) сборка штатная.
---
 apps/web/t3patch-i18n/index.mjs | 17 +++++++++++++++++
 apps/web/vite.config.ts         |  4 ++++
 2 files changed, 21 insertions(+)
 create mode 100644 apps/web/t3patch-i18n/index.mjs

diff --git a/apps/web/t3patch-i18n/index.mjs b/apps/web/t3patch-i18n/index.mjs
new file mode 100644
index 0000000000..e66dbefd28
--- /dev/null
+++ b/apps/web/t3patch-i18n/index.mjs
@@ -0,0 +1,17 @@
+// t3-patch: подключение русификации к сборке веб-клиента.
+//
+// Плагин и словарь живут вне исходников T3 — в каталоге патчей
+// (T3PATCH_I18N_DIR, его выставляет build.sh). Без переменной, в тестах
+// (VITEST — тесты разработчиков проверяют английские надписи) и при сборке
+// с --no-i18n плагин не подключается, и сборка остаётся штатной.
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+export async function t3patchRuBabelPlugins() {
+  const dir = process.env.T3PATCH_I18N_DIR;
+  if (!dir || process.env.VITEST || !existsSync(join(dir, "plugin.mjs"))) return [];
+  const { default: plugin } = await import(pathToFileURL(join(dir, "plugin.mjs")).href);
+  const dict = JSON.parse(readFileSync(join(dir, "ru.json"), "utf8"));
+  return [[plugin, { dict }]];
+}
diff --git a/apps/web/vite.config.ts b/apps/web/vite.config.ts
index 1d710f273c..fa6c9b5e59 100644
--- a/apps/web/vite.config.ts
+++ b/apps/web/vite.config.ts
@@ -2,6 +2,7 @@ import * as NodeZlib from "node:zlib";
 
 import react, { reactCompilerPreset } from "@vitejs/plugin-react";
 import babel from "@rolldown/plugin-babel";
+import { t3patchRuBabelPlugins } from "./t3patch-i18n/index.mjs"; // t3-patch: русификация
 import { tanstackRouter } from "@tanstack/router-plugin/vite";
 import compression from "compression";
 import { defineProject, type TestProjectInlineConfiguration } from "vite-plus/test/config";
@@ -153,6 +154,8 @@ const configuredAllowedHosts = (process.env.T3CODE_DEV_ALLOWED_HOSTS ?? "")
   .filter((entry) => entry.length > 0);
 const allowedHosts = [".ts.net", ...configuredAllowedHosts];
 
+const t3patchRuPlugins = await t3patchRuBabelPlugins(); // t3-patch
+
 export default defineConfig(() => {
   return {
     assetsInclude: ["**/*.wasm"],
@@ -179,6 +182,7 @@ export default defineConfig(() => {
         // This is causing our packages/ directory to fail to parse, as they are not relative to the CWD.
         parserOpts: { plugins: ["typescript", "jsx"] },
         presets: [reactCompilerPreset()],
+        plugins: t3patchRuPlugins, // t3-patch
       }),
       tailwindPlugins(bundledDev),
     ],
