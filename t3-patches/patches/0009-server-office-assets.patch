--- /dev/null
+++ b/apps/server/src/sergey/officeAssets.ts
@@ -0,0 +1,24 @@
+/**
+ * t3-patch: офисные файлы по штатным подписанным ссылкам /api/assets.
+ *
+ * Штатно сервер выдаёт такие ссылки только на картинки, pdf и html. Android-приложение
+ * открывает файлы именно через них, поэтому xlsx/docx/doc там недоступны. Этот список
+ * расширяет допустимые типы — файл отдаётся как есть, по точному пути (без соседних
+ * файлов, как у картинок). Просмотр делает страница t3patch-vendor/office-view.html.
+ */
+const OFFICE_ASSET_EXTENSIONS = new Set([
+  ".xlsx",
+  ".xlsm",
+  ".xlsb",
+  ".xls",
+  ".ods",
+  ".docx",
+  ".doc",
+  ".rtf",
+  ".odt",
+]);
+
+export function isT3patchOfficeAssetPath(relativePath: string): boolean {
+  const dot = relativePath.lastIndexOf(".");
+  return dot >= 0 && OFFICE_ASSET_EXTENSIONS.has(relativePath.slice(dot).toLowerCase());
+}
