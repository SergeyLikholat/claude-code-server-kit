+import { describe, expect, it } from "vitest";
+
+import { isT3patchOfficeAssetPath } from "./officeAssets.ts";
+
+describe("isT3patchOfficeAssetPath", () => {
+  it("пускает офисные форматы в любом регистре", () => {
+    for (const path of [
+      "a.xlsx",
+      "b/c.XLS",
+      "d.ods",
+      "e.docx",
+      "f.DOC",
+      "g.rtf",
+      "h.odt",
+      "i.xlsm",
+      "j.xlsb",
+    ]) {
+      expect(isT3patchOfficeAssetPath(path)).toBe(true);
+    }
+  });
+
+  it("не пускает прочие файлы", () => {
+    for (const path of ["a.txt", "b.env", "c.xlsx.bak", "Makefile", ".xlsx/secret", "d.docx.sh"]) {
+      expect(isT3patchOfficeAssetPath(path)).toBe(false);
+    }
+  });
+});
