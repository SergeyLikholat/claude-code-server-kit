@@ -39,12 +39,16 @@ import * as Effect from "effect/Effect";
 import * as Option from "effect/Option";
 import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/unstable/http";
 
+import { resolveAsset } from "../assets/AssetAccess.ts";
 import { assetFileResponse, authenticateRawRouteWithScope } from "../http.ts";
 import * as WorkspacePaths from "../workspace/WorkspacePaths.ts";
 
 export const T3PATCH_FILE_INFO_PATH = "/api/t3patch/file-info";
 export const T3PATCH_FILE_ROUTE_PREFIX = "/api/t3patch/file";
 export const T3PATCH_CONVERT_ROUTE_PREFIX = "/api/t3patch/convert";
+// Конвертация по штатной подписанной ссылке /api/assets — для Android-приложения,
+// которое получает файлы только такими ссылками (см. officeAssets.ts).
+export const T3PATCH_ASSET_DOCX_ROUTE_PREFIX = "/api/t3patch/asset-docx";
 const TOKEN_TTL_MS = 60 * 60 * 1000;
 // Ключ живёт до перезапуска сервера: ссылки на скачивание короткоживущие, хранить его незачем.
 const SIGNING_KEY = randomBytes(32);
@@ -318,3 +322,30 @@ export const t3patchConvertRouteLayer = HttpRouter.add(
     );
   }),
 );
+
+/** GET /api/t3patch/asset-docx/<токен /api/assets>/<имя> → docx из .doc/.rtf/.odt. */
+export const t3patchAssetDocxRouteLayer = HttpRouter.add(
+  "GET",
+  `${T3PATCH_ASSET_DOCX_ROUTE_PREFIX}/*`,
+  Effect.gen(function* () {
+    const request = yield* HttpServerRequest.HttpServerRequest;
+    const url = HttpServerRequest.toURL(request);
+    if (Option.isNone(url)) return HttpServerResponse.text("Bad Request", { status: 400 });
+    const suffix = url.value.pathname.slice(`${T3PATCH_ASSET_DOCX_ROUTE_PREFIX}/`.length);
+    const separator = suffix.indexOf("/");
+    if (separator <= 0) return HttpServerResponse.text("Not Found", { status: 404 });
+    const asset = yield* resolveAsset(suffix.slice(0, separator), suffix.slice(separator + 1));
+    if (!asset || !isConvertibleToDocx(asset.path)) {
+      return HttpServerResponse.text("Ссылка устарела или неверна.", { status: 404 });
+    }
+    const converted = yield* Effect.tryPromise(() => convertToDocxCached(asset.path)).pipe(
+      Effect.orElseSucceed(() => null),
+    );
+    if (!converted) {
+      return HttpServerResponse.text("Не удалось сконвертировать документ.", { status: 500 });
+    }
+    return yield* assetFileResponse({ path: converted }).pipe(
+      Effect.orElseSucceed(() => HttpServerResponse.text("Internal Server Error", { status: 500 })),
+    );
+  }),
+);
