+++ b/apps/web/src/components/sergey/reopenOnClick.ts
@@ -0,0 +1,61 @@
+/**
+ * t3-patch: повторный клик по уже выделенному файлу в дереве снова открывает его.
+ *
+ * Штатно файл открывается по событию «выделение изменилось». После «Закрыть файл»
+ * строка остаётся выделенной, клик по ней выделение не меняет — события нет, и
+ * файл не открывается, пока не кликнешь куда-то ещё. Здесь запоминаем, была ли
+ * строка выделена ещё до нажатия, и если да — открываем файл по клику сами.
+ */
+import { type RefObject, useEffect } from "react";
+
+interface SelectionModel {
+  getSelectedPaths(): readonly string[];
+}
+
+/** Путь строки дерева из события: строки лежат в открытом shadow DOM с атрибутом data-item-path. */
+export function t3patchRowPathFromEvent(event: Event): string | null {
+  for (const node of event.composedPath()) {
+    const element = node as { getAttribute?: (name: string) => string | null };
+    const path =
+      typeof element.getAttribute === "function" ? element.getAttribute("data-item-path") : null;
+    if (path) return path.replace(/\/$/, "");
+  }
+  return null;
+}
+
+export function useT3patchReopenOnClick(
+  panelRef: RefObject<HTMLElement | null>,
+  model: SelectionModel,
+  isFile: (path: string) => boolean,
+  open: (path: string) => void,
+): void {
+  useEffect(() => {
+    const panel = panelRef.current;
+    if (panel === null) return;
+    let pending: string | null = null;
+    const onPointerDown = (event: PointerEvent) => {
+      pending = null;
+      // Только обычный клик: правая кнопка — меню, модификаторы — множественное выделение.
+      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
+        return;
+      const path = t3patchRowPathFromEvent(event);
+      if (!path || !isFile(path)) return;
+      const alreadySelected = model
+        .getSelectedPaths()
+        .some((selected) => selected.replace(/\/$/, "") === path);
+      if (alreadySelected) pending = path;
+    };
+    const onClick = (event: MouseEvent) => {
+      const path = pending;
+      pending = null;
+      if (path && t3patchRowPathFromEvent(event) === path) open(path);
+    };
+    // capture: состояние выделения нужно снять до того, как дерево обработает нажатие
+    panel.addEventListener("pointerdown", onPointerDown, true);
+    panel.addEventListener("click", onClick);
+    return () => {
+      panel.removeEventListener("pointerdown", onPointerDown, true);
+      panel.removeEventListener("click", onClick);
+    };
+  }, [isFile, model, open, panelRef]);
+}
