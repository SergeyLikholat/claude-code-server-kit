new file mode 100644
index 0000000000..03a11f5697
--- /dev/null
+++ b/apps/web/src/components/sergey/FileUnavailableCard.tsx
@@ -0,0 +1,187 @@
+/**
+ * t3-patch: вместо красной строки «Failed to read workspace file…» — понятная карточка.
+ *
+ * Панель файла штатно показывает только текст, таблицы, документы, картинки, PDF,
+ * аудио и видео. Для остального (apk, zip, exe…) она выводила сырую ошибку чтения.
+ * Такие файлы и не нужно открывать — нужно понятно сказать, что это за файл, и дать
+ * действия: скачать, скопировать путь, показать в проводнике.
+ *
+ * Заодно два случая, когда «файл» на деле не файл:
+ * - папка (ссылка из чата на каталог) — открываем её в проводнике;
+ * - абсолютный путь снаружи проекта (`/root/Obsidian/...`) — сервер находит окно
+ *   (`!Obsidian/...`) и файл открывается через него, как обычный файл проекта.
+ */
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { DownloadIcon, FileIcon, FolderOpenIcon, LinkIcon } from "lucide-react";
+import { useEffect, useState } from "react";
+
+import { Button } from "~/components/ui/button";
+import { Empty, EmptyDescription, EmptyMedia, EmptyTitle } from "~/components/ui/empty";
+import { Spinner } from "~/components/ui/spinner";
+import { useRightPanelStore } from "~/rightPanelStore";
+import {
+  copyWithToast,
+  fetchT3PatchFileInfo,
+  startDownload,
+  type T3PatchFileInfo,
+} from "./fileActions";
+import { t3patchOpenFolder } from "./explorerReveal";
+
+type State =
+  | { readonly kind: "loading" }
+  | { readonly kind: "file"; readonly info: T3PatchFileInfo }
+  | { readonly kind: "missing"; readonly reason: string }
+  | { readonly kind: "redirected" };
+
+const basename = (path: string) => path.replace(/\/+$/, "").split("/").pop() || path;
+const parentOf = (path: string) => path.replace(/\/+$/, "").split("/").slice(0, -1).join("/");
+
+export function formatT3patchFileSize(bytes: number): string {
+  if (bytes < 1024) return `${bytes} Б`;
+  const units = ["КБ", "МБ", "ГБ"];
+  let value = bytes / 1024;
+  let unit = 0;
+  while (value >= 1024 && unit < units.length - 1) {
+    value /= 1024;
+    unit++;
+  }
+  return `${value.toFixed(value < 10 ? 1 : 0).replace(".", ",")} ${units[unit]}`;
+}
+
+/** Почему файл не показан — по тексту ошибки чтения, по-человечески. */
+export function describeT3patchUnreadable(error: string): string {
+  if (/binary/i.test(error)) {
+    return "Это двоичный файл. В T3 открываются текст, таблицы, документы, картинки, PDF, аудио и видео — остальное можно скачать и открыть на устройстве.";
+  }
+  return "Этот тип файла T3 не показывает. Его можно скачать и открыть на устройстве.";
+}
+
+export function FileUnavailableCard(props: {
+  readonly threadRef: ScopedThreadRef;
+  readonly cwd: string;
+  readonly relativePath: string;
+  readonly error: string;
+}) {
+  const { threadRef, cwd, relativePath, error } = props;
+  const [state, setState] = useState<State>({ kind: "loading" });
+
+  useEffect(() => {
+    let cancelled = false;
+    const surfaceId = `file:${relativePath}` as const;
+    fetchT3PatchFileInfo(cwd, relativePath).then(
+      (info) => {
+        if (cancelled) return;
+        if (info.isDirectory) {
+          setState({ kind: "redirected" });
+          void t3patchOpenFolder(threadRef, cwd, info.relativePath, surfaceId);
+          return;
+        }
+        // Абсолютный путь снаружи проекта, найденный через окно, — открыть как файл проекта.
+        if (relativePath.startsWith("/") && info.relativePath !== relativePath) {
+          setState({ kind: "redirected" });
+          const store = useRightPanelStore.getState();
+          store.openFile(threadRef, info.relativePath);
+          store.closeSurface(threadRef, surfaceId);
+          return;
+        }
+        setState({ kind: "file", info });
+      },
+      (failure: unknown) => {
+        if (cancelled) return;
+        setState({
+          kind: "missing",
+          reason: failure instanceof Error ? failure.message : String(failure),
+        });
+      },
+    );
+    return () => {
+      cancelled = true;
+    };
+  }, [cwd, relativePath, threadRef]);
+
+  if (state.kind === "loading" || state.kind === "redirected") {
+    return (
+      <div className="flex min-h-0 flex-1 items-center justify-center text-muted-foreground">
+        <Spinner className="size-5" />
+      </div>
+    );
+  }
+
+  const name = basename(relativePath);
+  const info = state.kind === "file" ? state.info : null;
+  const fullPath = info?.realPath ?? relativePath;
+
+  return (
+    <Empty className="min-h-0 flex-1 overflow-y-auto">
+      <EmptyMedia variant="icon">
+        <FileIcon className="size-4.5 text-muted-foreground" />
+      </EmptyMedia>
+      <EmptyTitle className="max-w-full text-base leading-snug [overflow-wrap:anywhere]">
+        {name}
+      </EmptyTitle>
+      {info ? (
+        <p className="text-xs text-muted-foreground">
+          {formatT3patchFileSize(info.size)} ·{" "}
+          {new Date(info.mtimeMs).toLocaleString("ru-RU", {
+            dateStyle: "medium",
+            timeStyle: "short",
+          })}
+        </p>
+      ) : null}
+      <EmptyDescription className="max-w-md">
+        {info
+          ? describeT3patchUnreadable(error)
+          : "Файл не найден или лежит вне этого проекта — открыть его здесь нельзя."}
+      </EmptyDescription>
+      <code className="max-w-full rounded bg-muted/60 px-2 py-1 text-[11px] break-all text-muted-foreground select-text">
+        {fullPath}
+      </code>
+      <div className="mt-2 flex flex-wrap items-center justify-center gap-2">
+        {info?.downloadUrl ? (
+          <Button size="sm" onClick={() => startDownload(info.downloadUrl!)}>
+            <DownloadIcon />
+            Скачать
+          </Button>
+        ) : null}
+        <Button
+          size="sm"
+          variant="outline"
+          onClick={() => void copyWithToast(info?.relativePath ?? relativePath, "Путь скопирован")}
+        >
+          <LinkIcon />
+          Копировать путь
+        </Button>
+        {info ? (
+          <Button
+            size="sm"
+            variant="outline"
+            onClick={() => void copyWithToast(info.realPath, "Полный путь скопирован")}
+          >
+            <LinkIcon />
+            Копировать полный путь
+          </Button>
+        ) : null}
+        {info ? (
+          <Button
+            size="sm"
+            variant="outline"
+            onClick={() =>
+              void t3patchOpenFolder(
+                threadRef,
+                cwd,
+                parentOf(info.relativePath),
+                `file:${relativePath}`,
+              )
+            }
+          >
+            <FolderOpenIcon />
+            Показать в проводнике
+          </Button>
+        ) : null}
+      </div>
+      {state.kind === "missing" ? (
+        <p className="mt-1 text-[11px] text-muted-foreground/70">{state.reason}</p>
+      ) : null}
+    </Empty>
+  );
+}
