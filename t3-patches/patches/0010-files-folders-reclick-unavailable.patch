+import { scopeThreadRef } from "@t3tools/client-runtime/environment";
+import { type EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { selectThreadRightPanelState, useRightPanelStore } from "~/rightPanelStore";
+
+import { t3patchOpenFolder, t3patchRevealInTree } from "./explorerReveal";
+import { describeT3patchUnreadable, formatT3patchFileSize } from "./FileUnavailableCard";
+import { t3patchRowPathFromEvent } from "./reopenOnClick";
+
+describe("карточка файла, который T3 не показывает", () => {
+  it("размер по-русски", () => {
+    expect(formatT3patchFileSize(512)).toBe("512 Б");
+    expect(formatT3patchFileSize(1536)).toBe("1,5 КБ");
+    expect(formatT3patchFileSize(93_615_903)).toBe("89 МБ");
+  });
+
+  it("причина — по тексту ошибки чтения", () => {
+    expect(describeT3patchUnreadable("… is binary and cannot be previewed as text.")).toMatch(
+      /двоичный/,
+    );
+    expect(describeT3patchUnreadable("Failed to read workspace file 'a.apk'")).toMatch(/скачать/);
+  });
+});
+
+describe("строка дерева по событию", () => {
+  const eventWith = (...nodes: unknown[]) => ({ composedPath: () => nodes }) as unknown as Event;
+  const row = (path: string) => ({
+    getAttribute: (name: string) => (name === "data-item-path" ? path : null),
+  });
+
+  it("путь файла и папки (слеш в конце снимается)", () => {
+    expect(t3patchRowPathFromEvent(eventWith({}, row("docs/a.md"), {}))).toBe("docs/a.md");
+    expect(t3patchRowPathFromEvent(eventWith(row("docs/")))).toBe("docs");
+  });
+
+  it("клик мимо строк — null", () => {
+    expect(t3patchRowPathFromEvent(eventWith({}, { getAttribute: () => null }))).toBeNull();
+  });
+});
+
+describe("переход к папке в дереве", () => {
+  function fakeTree(paths: string[]) {
+    const expanded: string[] = [];
+    const selected = new Set<string>(["old.md"]);
+    let scrolled: string | null = null;
+    const item = (path: string) => ({
+      expand: () => expanded.push(path),
+      select: () => selected.add(path),
+      deselect: () => selected.delete(path),
+    });
+    return {
+      expanded,
+      selected,
+      scrolled: () => scrolled,
+      model: {
+        getItem: (path: string) => (paths.includes(path) ? item(path) : null),
+        getSelectedPaths: () => [...selected],
+        scrollToPath: (path: string) => {
+          scrolled = path;
+        },
+        closeSearch: () => {},
+      },
+    };
+  }
+
+  it("подгружает предков по очереди, раскрывает, выделяет и прокручивает", async () => {
+    const loaded: string[] = [];
+    const tree = fakeTree(["old.md", "a/", "a/b/", "a/b/c/"]);
+    await t3patchRevealInTree(tree.model, async (path) => void loaded.push(path), "a/b/c");
+    expect(loaded).toEqual(["", "a", "a/b", "a/b/c"]);
+    expect(tree.expanded).toEqual(["a/", "a/b/", "a/b/c/"]);
+    expect([...tree.selected]).toEqual(["a/b/c/"]);
+    expect(tree.scrolled()).toBe("a/b/c/");
+  });
+});
+
+describe("открыть папку из ссылки", () => {
+  const ref = scopeThreadRef("env-1" as EnvironmentId, ThreadId.make("thread-folder"));
+  const panel = () => selectThreadRightPanelState(useRightPanelStore.getState().byThreadKey, ref);
+
+  it("вкладка-«файл» папки закрывается, открывается проводник", async () => {
+    useRightPanelStore.getState().openFile(ref, "docs/");
+    await t3patchOpenFolder(ref, "/root/p", "docs/", "file:docs/");
+    const state = panel();
+    expect(state.surfaces.some((surface) => surface.id === "file:docs/")).toBe(false);
+    expect(state.activeSurfaceId).toBe("files");
+  });
+});
