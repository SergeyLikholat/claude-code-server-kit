+/**
+ * Обратное к resolveBindMounts: абсолютный путь снаружи проекта → путь через окно внутри
+ * проекта. Для `/root/Obsidian/a.xlsx` и кабинета, где `/root/Obsidian` смонтирован в
+ * `<root>/!Obsidian`, вернёт `<root>/!Obsidian/a.xlsx`. Если окна нет — null.
+ * Так ссылка из чата на файл базы открывается в любом кабинете.
+ */
+export function mapIntoWorkspace(
+  absolutePath: string,
+  workspaceRoot: string,
+  mounts: readonly MountEntry[],
+): string | null {
+  const windows = mounts
+    .filter((mount) => mount.root !== "/" && isWithin(workspaceRoot, mount.mountPoint))
+    .map((mount) => {
+      const whole = mounts.find((entry) => entry.device === mount.device && entry.root === "/");
+      return whole
+        ? { mountPoint: mount.mountPoint, source: NodePath.join(whole.mountPoint, mount.root) }
+        : null;
+    })
+    .filter((entry): entry is { mountPoint: string; source: string } => entry !== null)
+    .filter((entry) => isWithin(entry.source, absolutePath))
+    // самое глубокое совпадение источника — самое точное окно
+    .toSorted((left, right) => right.source.length - left.source.length);
+  const window = windows[0];
+  return window
+    ? NodePath.join(window.mountPoint, NodePath.relative(window.source, absolutePath))
+    : null;
+}
