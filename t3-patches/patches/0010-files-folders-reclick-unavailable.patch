index 0000000000..2d5aae40e8
--- /dev/null
+++ b/apps/web/src/components/sergey/explorerReveal.ts
@@ -0,0 +1,150 @@
+/**
+ * t3-patch: открыть папку в проводнике (дерево раскрыто до неё, строка выделена).
+ *
+ * Штатно ссылка на папку из чата и «папка» в панели файла открываются как файл —
+ * вкладка пытается прочитать папку и падает с ошибкой. Здесь папка открывается в
+ * проводнике: предки подгружаются и раскрываются, строка прокручивается в видимую
+ * часть. Запрос живёт в модуле, потому что проводник может смонтироваться позже,
+ * чем пришла команда (вкладка «Проводник» открывается тем же действием).
+ */
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { useEffect, useRef } from "react";
+
+import { toastManager } from "~/components/ui/toast";
+import { useRightPanelStore } from "~/rightPanelStore";
+import { fetchT3PatchFileInfo } from "./fileActions";
+
+interface RevealRequest {
+  readonly cwd: string;
+  readonly path: string;
+  readonly id: number;
+  readonly at: number;
+}
+
+/** Запрос старше этого срока проводник уже не выполняет — чтобы не прыгнуть к папке спустя час. */
+const REQUEST_TTL_MS = 15_000;
+const ITEM_WAIT_STEPS = 40;
+const ITEM_WAIT_STEP_MS = 50;
+
+let latest: RevealRequest | null = null;
+let nextId = 1;
+const listeners = new Set<(request: RevealRequest) => void>();
+
+const trimSlashes = (path: string) => path.replace(/\/+$/, "");
+
+export function t3patchRevealInExplorer(cwd: string, path: string): void {
+  const request = { cwd: trimSlashes(cwd), path: trimSlashes(path), id: nextId++, at: Date.now() };
+  latest = request;
+  for (const listener of listeners) listener(request);
+}
+
+/** Относительный путь папки внутри проекта; абсолютный снаружи — через окно (сервер). */
+async function workspaceRelative(cwd: string, path: string): Promise<string> {
+  const trimmed = trimSlashes(path);
+  if (!trimmed.startsWith("/")) return trimmed;
+  const root = trimSlashes(cwd);
+  if (trimmed === root) return "";
+  if (trimmed.startsWith(`${root}/`)) return trimmed.slice(root.length + 1);
+  return (await fetchT3PatchFileInfo(cwd, trimmed)).relativePath;
+}
+
+/**
+ * Закрыть вкладку «файла»-папки (если есть), открыть проводник и перейти к папке.
+ * `path` — как пришёл: относительный, абсолютный, со слешем в конце или без.
+ */
+export async function t3patchOpenFolder(
+  threadRef: ScopedThreadRef,
+  cwd: string,
+  path: string,
+  closeSurfaceId?: `file:${string}`,
+): Promise<void> {
+  let relative: string;
+  try {
+    relative = await workspaceRelative(cwd, path);
+  } catch (error) {
+    toastManager.add({
+      type: "error",
+      title: "Папка не открылась",
+      description: error instanceof Error ? error.message : String(error),
+    });
+    return;
+  }
+  const store = useRightPanelStore.getState();
+  if (closeSurfaceId) store.closeSurface(threadRef, closeSurfaceId);
+  store.open(threadRef, "files");
+  t3patchRevealInExplorer(cwd, relative);
+}
+
+/** То, что хук использует у модели дерева @pierre/trees. */
+interface TreeItem {
+  expand?: () => void;
+  select?: () => void;
+  deselect?: () => void;
+}
+interface TreeModel {
+  getItem(path: string): TreeItem | null | undefined;
+  getSelectedPaths(): readonly string[];
+  scrollToPath(path: string, options?: { focus?: boolean; offset?: "center" }): void;
+  closeSearch(): void;
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function waitForItem(model: TreeModel, path: string): Promise<TreeItem | null> {
+  for (let step = 0; step < ITEM_WAIT_STEPS; step++) {
+    const item = model.getItem(`${path}/`) ?? model.getItem(path);
+    if (item) return item;
+    await sleep(ITEM_WAIT_STEP_MS);
+  }
+  return null;
+}
+
+export async function t3patchRevealInTree(
+  model: TreeModel,
+  load: (path: string) => Promise<unknown>,
+  path: string,
+): Promise<void> {
+  const segments = path.split("/").filter(Boolean);
+  model.closeSearch();
+  // Предков и саму папку — по очереди: дерево подгружает содержимое лениво.
+  for (let index = 0; index <= segments.length; index++) {
+    await load(segments.slice(0, index).join("/"));
+  }
+  if (segments.length === 0) return;
+  for (let index = 1; index <= segments.length; index++) {
+    const current = segments.slice(0, index).join("/");
+    const item = await waitForItem(model, current);
+    item?.expand?.();
+  }
+  const target = model.getItem(`${path}/`) ?? model.getItem(path);
+  if (!target) return;
+  for (const selected of model.getSelectedPaths()) model.getItem(selected)?.deselect?.();
+  target.select?.();
+  model.scrollToPath(model.getItem(`${path}/`) ? `${path}/` : path, {
+    focus: true,
+    offset: "center",
+  });
+}
+
+/** Проводник выполняет запросы перехода к папке для своего проекта. */
+export function useT3patchExplorerReveal(
+  cwd: string,
+  model: TreeModel,
+  load: (path: string) => Promise<unknown>,
+): void {
+  const handledRef = useRef(0);
+  useEffect(() => {
+    const root = trimSlashes(cwd);
+    const run = (request: RevealRequest | null) => {
+      if (!request || request.cwd !== root || request.id <= handledRef.current) return;
+      if (Date.now() - request.at > REQUEST_TTL_MS) return;
+      handledRef.current = request.id;
+      void t3patchRevealInTree(model, load, request.path);
+    };
+    run(latest);
+    listeners.add(run);
+    return () => {
+      listeners.delete(run);
+    };
+  }, [cwd, load, model]);
+}
