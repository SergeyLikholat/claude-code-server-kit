diff --git a/apps/server/src/sergey/officeAssets.ts b/apps/server/src/sergey/officeAssets.ts
index 680a706cdc..0eddcc2c18 100644
--- a/apps/server/src/sergey/officeAssets.ts
+++ b/apps/server/src/sergey/officeAssets.ts
@@ -22,3 +22,13 @@ export function isT3patchOfficeAssetPath(relativePath: string): boolean {
   const dot = relativePath.lastIndexOf(".");
   return dot >= 0 && OFFICE_ASSET_EXTENSIONS.has(relativePath.slice(dot).toLowerCase());
 }
+
+/**
+ * Любой обычный файл проекта по точной ссылке — чтобы Android-приложение могло скачать то,
+ * что не умеет показать (apk, zip, dwg…). Скрытые файлы и папки (`.env`, `.git/…`) не выдаются,
+ * как и в штатной выдаче ссылок. Ссылка ведёт ровно на этот файл, без соседних.
+ */
+export function isT3patchExactAssetPath(relativePath: string): boolean {
+  const segments = relativePath.split(/[\\/]/).filter(Boolean);
+  return segments.length > 0 && segments.every((segment) => !segment.startsWith("."));
+}
