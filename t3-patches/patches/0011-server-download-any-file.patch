+import { isT3patchExactAssetPath, isT3patchOfficeAssetPath } from "./officeAssets.ts";
 
 describe("isT3patchOfficeAssetPath", () => {
   it("пускает офисные форматы в любом регистре", () => {
@@ -25,3 +25,17 @@ describe("isT3patchOfficeAssetPath", () => {
