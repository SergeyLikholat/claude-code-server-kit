+describe("показать файл в проводнике", () => {
+  it("раскрывает папки и прокручивает к файлу, не выделяя его (выделение открыло бы файл)", async () => {
+    const expanded: string[] = [];
+    const selected: string[] = [];
+    let scrolled: string | null = null;
+    const paths = ["a/", "a/b/", "a/b/report.docx"];
+    const model = {
+      getItem: (path: string) =>
+        paths.includes(path)
+          ? {
+              expand: () => expanded.push(path),
+              select: () => selected.push(path),
+              deselect: () => {},
+            }
+          : null,
+      getSelectedPaths: () => [],
+      scrollToPath: (path: string) => {
+        scrolled = path;
+      },
+      closeSearch: () => {},
+    };
+    await t3patchRevealInTree(model, async () => {}, "a/b", "report.docx");
+    expect(expanded).toEqual(["a/", "a/b/"]);
+    expect(scrolled).toBe("a/b/report.docx");
+    expect(selected).toEqual([]);
+  });
+});
