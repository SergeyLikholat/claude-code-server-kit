 }
@@ -32,8 +34,14 @@ const listeners = new Set<(request: RevealRequest) => void>();
 
 const trimSlashes = (path: string) => path.replace(/\/+$/, "");
 
-export function t3patchRevealInExplorer(cwd: string, path: string): void {
-  const request = { cwd: trimSlashes(cwd), path: trimSlashes(path), id: nextId++, at: Date.now() };
+export function t3patchRevealInExplorer(cwd: string, path: string, focusName?: string): void {
+  const request = {
+    cwd: trimSlashes(cwd),
+    path: trimSlashes(path),
+    ...(focusName ? { focusName } : {}),
+    id: nextId++,
+    at: Date.now(),
+  };
   latest = request;
   for (const listener of listeners) listener(request);
 }
@@ -75,6 +83,34 @@ export async function t3patchOpenFolder(
   t3patchRevealInExplorer(cwd, relative);
 }
 
+/**
+ * «Показать в проводнике» для ссылки на файл: открыть проводник на папке файла и прокрутить
+ * к нему. Сам файл не открывается — нужно увидеть, где он лежит.
+ */
+export async function t3patchRevealFile(
+  threadRef: ScopedThreadRef,
+  cwd: string,
+  filePath: string,
+): Promise<void> {
+  const trimmed = trimSlashes(filePath);
+  const slash = trimmed.lastIndexOf("/");
+  const name = slash >= 0 ? trimmed.slice(slash + 1) : trimmed;
+  const folder = slash > 0 ? trimmed.slice(0, slash) : slash === 0 ? "/" : "";
+  let relative: string;
+  try {
+    relative = await workspaceRelative(cwd, folder);
+  } catch (error) {
+    toastManager.add({
+      type: "error",
+      title: "Не удалось показать файл в проводнике",
+      description: error instanceof Error ? error.message : String(error),
+    });
+    return;
+  }
+  useRightPanelStore.getState().open(threadRef, "files");
+  t3patchRevealInExplorer(cwd, relative, name);
+}
+
 /** То, что хук использует у модели дерева @pierre/trees. */
 interface TreeItem {
   expand?: () => void;
@@ -103,6 +139,7 @@ export async function t3patchRevealInTree(
   model: TreeModel,
   load: (path: string) => Promise<unknown>,
   path: string,
+  focusName?: string,
 ): Promise<void> {
   const segments = path.split("/").filter(Boolean);
   model.closeSearch();
@@ -110,12 +147,20 @@ export async function t3patchRevealInTree(
   for (let index = 0; index <= segments.length; index++) {
     await load(segments.slice(0, index).join("/"));
   }
-  if (segments.length === 0) return;
   for (let index = 1; index <= segments.length; index++) {
     const current = segments.slice(0, index).join("/");
     const item = await waitForItem(model, current);
     item?.expand?.();
   }
+  if (focusName) {
+    // Выделение файла в дереве его открывает, поэтому только прокрутка и фокус на строке.
+    const filePath = segments.length > 0 ? `${segments.join("/")}/${focusName}` : focusName;
+    if (await waitForItem(model, filePath)) {
+      model.scrollToPath(filePath, { focus: true, offset: "center" });
+    }
+    return;
+  }
+  if (segments.length === 0) return;
   const target = model.getItem(`${path}/`) ?? model.getItem(path);
   if (!target) return;
   for (const selected of model.getSelectedPaths()) model.getItem(selected)?.deselect?.();
@@ -139,7 +184,7 @@ export function useT3patchExplorerReveal(
       if (!request || request.cwd !== root || request.id <= handledRef.current) return;
       if (Date.now() - request.at > REQUEST_TTL_MS) return;
       handledRef.current = request.id;
-      void t3patchRevealInTree(model, load, request.path);
+      void t3patchRevealInTree(model, load, request.path, request.focusName);
     };
     run(latest);
     listeners.add(run);
