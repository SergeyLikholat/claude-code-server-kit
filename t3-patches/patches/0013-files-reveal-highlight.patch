@@ -0,0 +1,81 @@
+/**
+ * t3-patch: заметная подсветка строки дерева после «Показать в проводнике».
+ *
+ * Выделять файл в дереве нельзя — выделение его открывает. Поэтому строка получает свою метку
+ * `data-t3patch-flash`: пару раз мигает янтарным и остаётся окрашенной, пока пользователь не
+ * кликнет в дереве (или 20 секунд). Строки лежат в открытом shadow DOM дерева @pierre/trees и
+ * пересоздаются при прокрутке (дерево виртуальное), поэтому метка ставится заново, пока
+ * подсветка активна, а стиль один раз добавляется в shadow root.
+ */
+const STYLE_ID = "t3patch-flash-style";
+const HIGHLIGHT_MS = 20_000;
+const REAPPLY_MS = 150;
+
+const FLASH_CSS = `
+@keyframes t3patch-flash {
+  from { background-color: rgb(245 158 11 / 0.55); }
+  to { background-color: rgb(245 158 11 / 0.18); }
+}
+[data-t3patch-flash] {
+  background-color: rgb(245 158 11 / 0.22) !important;
+  box-shadow: inset 3px 0 0 rgb(245 158 11);
+  border-radius: 4px;
+  animation: t3patch-flash 0.45s ease-in-out 6 alternate;
+}
+`;
+
+/** Все открытые shadow root внутри панели — дерево может быть вложено глубже одного уровня. */
+function shadowRoots(root: ParentNode): ShadowRoot[] {
+  const found: ShadowRoot[] = [];
+  for (const element of Array.from(root.querySelectorAll("*"))) {
+    if (element.shadowRoot) {
+      found.push(element.shadowRoot, ...shadowRoots(element.shadowRoot));
+    }
+  }
+  return found;
+}
+
+function ensureStyle(shadow: ShadowRoot): void {
+  if (shadow.getElementById(STYLE_ID)) return;
+  const style = document.createElement("style");
+  style.id = STYLE_ID;
+  style.textContent = FLASH_CSS;
+  shadow.append(style);
+}
+
+let stopCurrent: (() => void) | null = null;
+
+/** Подсветить строку `path` в дереве внутри `panel`. Новая подсветка снимает прежнюю. */
+export function t3patchHighlightTreeRow(panel: HTMLElement, path: string): void {
+  stopCurrent?.();
+  const selector = `[data-item-path="${CSS.escape(path)}"]`;
+  const apply = () => {
+    for (const shadow of shadowRoots(panel)) {
+      const row = shadow.querySelector(selector);
+      if (!row) continue;
+      ensureStyle(shadow);
+      if (!row.hasAttribute("data-t3patch-flash")) row.setAttribute("data-t3patch-flash", "");
+    }
+  };
+  const clear = () => {
+    for (const shadow of shadowRoots(panel)) {
+      for (const row of Array.from(shadow.querySelectorAll("[data-t3patch-flash]"))) {
+        row.removeAttribute("data-t3patch-flash");
+      }
+    }
+  };
+  apply();
+  const interval = setInterval(apply, REAPPLY_MS);
+  const timeout = setTimeout(() => stop(), HIGHLIGHT_MS);
+  // Любой клик в дереве — пользователь увидел файл, подсветка больше не нужна.
+  const onPointerDown = () => stop();
+  panel.addEventListener("pointerdown", onPointerDown, true);
+  function stop() {
+    clearInterval(interval);
+    clearTimeout(timeout);
+    panel.removeEventListener("pointerdown", onPointerDown, true);
+    clear();
+    if (stopCurrent === stop) stopCurrent = null;
+  }
+  stopCurrent = stop;
+}
