Длинное имя дерево сокращает посередине и делит на две половины. Если
граница приходилась на пробел, он оказывался на краю блока и пропадал:
«Отверстия в блоке» → «Отверстияв блоке». white-space: pre сохраняет
пробелы; перенос строки по-прежнему не нужен — имя в одну строку.
---
 apps/web/src/pierre-tree-theme.ts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/apps/web/src/pierre-tree-theme.ts b/apps/web/src/pierre-tree-theme.ts
index 1c7bd7f2d5..af537c56c7 100644
--- a/apps/web/src/pierre-tree-theme.ts
+++ b/apps/web/src/pierre-tree-theme.ts
@@ -11,6 +11,11 @@ export const PIERRE_TREE_UNSAFE_CSS = `
     --trees-font-size-override: 12px;
   }
   button[data-type='item'] { border-radius: 5px; }
+  /* t3-patch: длинное имя дерево сокращает посередине и режет на две половины; пробел на стыке
+     браузер съедал («Отверстияв блоке»). pre сохраняет пробелы, строка по-прежнему не переносится. */
+  [data-truncate-content] {
+    white-space: pre;
+  }
 `;
 
 /** Host styles that keep a Pierre tree on the active color scheme and foreground. */
