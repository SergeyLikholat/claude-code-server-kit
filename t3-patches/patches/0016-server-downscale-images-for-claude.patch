+// @effect-diagnostics nodeBuiltinImport:off
+// @effect-diagnostics globalTimers:off
+/**
+ * t3-patch: уменьшение картинок перед отправкой в Claude.
+ *
+ * Каждый ход модель получает всю переписку треда вместе с картинками. Пока картинок в
+ * запросе не больше 20, каждая может быть до 8000 px; когда их больше, предел — 2000×2000.
+ * Скриншот телефона (1440×3200) выше 2000 px, поэтому с 21-й картинки в треде Claude
+ * отвергал их: «an image in the conversation could not be processed and was removed».
+ *
+ * Здесь длинная сторона ужимается до 1568 px — до этого размера Claude всё равно сам
+ * сжимает картинки перед чтением, так что видимое модели качество не теряется, а лимит
+ * в 2000 px соблюдается с запасом. То же решение в Telegram-роутере (attachments.js).
+ * Файл на диске не трогаем: в интерфейсе остаётся оригинал. При любой ошибке уходит оригинал.
+ */
+import { spawn } from "node:child_process";
+
+import { readImageDimensions } from "@t3tools/shared/imageDimensions";
+
+export const T3PATCH_IMAGE_MAX_DIM = 1568;
+const FFMPEG_TIMEOUT_MS = 20_000;
+
+/** Кодировщик ffmpeg под тот же формат — media_type в запросе к Claude остаётся прежним. */
+const ENCODERS: Record<string, readonly string[]> = {
+  "image/jpeg": ["-c:v", "mjpeg", "-q:v", "3"],
+  "image/png": ["-c:v", "png"],
+  "image/webp": ["-c:v", "libwebp", "-quality", "85"],
+};
+
+/** Новые размеры с сохранением пропорций или null, если уменьшать не нужно. */
+export function t3patchTargetSize(
+  width: number,
+  height: number,
+  maxDim = T3PATCH_IMAGE_MAX_DIM,
+): { readonly width: number; readonly height: number } | null {
+  const longest = Math.max(width, height);
+  if (longest <= maxDim) return null;
+  const scale = maxDim / longest;
+  // Чётные размеры — mjpeg с цветовой субдискретизацией не любит нечётные.
+  const even = (value: number) => Math.max(2, Math.round((value * scale) / 2) * 2);
+  return { width: even(width), height: even(height) };
+}
+
+function runFfmpeg(input: Uint8Array, args: readonly string[]): Promise<Uint8Array | null> {
+  return new Promise((resolve) => {
+    const child = spawn("ffmpeg", ["-hide_banner", "-loglevel", "error", ...args], {
+      stdio: ["pipe", "pipe", "ignore"],
+    });
+    const chunks: Buffer[] = [];
+    const timer = setTimeout(() => {
+      child.kill("SIGKILL");
+      resolve(null);
+    }, FFMPEG_TIMEOUT_MS);
+    child.stdout.on("data", (chunk: Buffer) => chunks.push(chunk));
+    child.on("error", () => {
+      clearTimeout(timer);
+      resolve(null);
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      resolve(code === 0 && chunks.length > 0 ? new Uint8Array(Buffer.concat(chunks)) : null);
+    });
+    child.stdin.on("error", () => {
+      // ffmpeg закрыл вход раньше времени — результат решит код выхода
+    });
+    child.stdin.end(Buffer.from(input));
+  });
+}
+
+/** Уменьшенная копия картинки для Claude; исходные байты, если уменьшать не нужно или нельзя. */
+export async function t3patchDownscaleImage(
+  bytes: Uint8Array,
+  mimeType: string,
+): Promise<Uint8Array> {
+  const encoder = ENCODERS[mimeType];
+  if (!encoder) return bytes; // gif (анимация) и прочее — как есть
+  const dimensions = readImageDimensions(bytes);
+  if (!dimensions) return bytes;
+  const target = t3patchTargetSize(dimensions.width, dimensions.height);
+  if (!target) return bytes;
+  const resized = await runFfmpeg(bytes, [
+    "-i",
+    "pipe:0",
+    "-vf",
+    `scale=${target.width}:${target.height}:flags=lanczos`,
+    "-frames:v",
+    "1",
+    ...encoder,
+    "-f",
+    "image2pipe",
+    "pipe:1",
+  ]);
+  return resized ?? bytes;
+}
