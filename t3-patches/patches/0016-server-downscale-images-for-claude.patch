+// @effect-diagnostics nodeBuiltinImport:off
+import { readFileSync } from "node:fs";
+
+import { readImageDimensions } from "@t3tools/shared/imageDimensions";
+import { describe, expect, it } from "vite-plus/test";
+
+import { t3patchDownscaleImage, t3patchTargetSize } from "./imageDownscale.ts";
+
+describe("уменьшение картинок перед отправкой в Claude", () => {
+  it("длинная сторона до 1568, пропорции и чётность сохраняются", () => {
+    expect(t3patchTargetSize(1440, 3200)).toEqual({ width: 706, height: 1568 });
+    expect(t3patchTargetSize(3200, 1440)).toEqual({ width: 1568, height: 706 });
+    expect(t3patchTargetSize(1568, 900)).toBeNull();
+    expect(t3patchTargetSize(456, 58)).toBeNull();
+  });
+
+  it("скриншот телефона 1440×3200 уходит в Claude как JPEG 706×1568", async () => {
+    // Сгенерированный ffmpeg кадр нужного размера — тот же путь, что у настоящего скриншота.
+    const { spawnSync } = await import("node:child_process");
+    const made = spawnSync(
+      "ffmpeg",
+      [
+        "-loglevel",
+        "error",
+        "-f",
+        "lavfi",
+        "-i",
+        "testsrc=size=1440x3200",
+        "-frames:v",
+        "1",
+        "-f",
+        "image2pipe",
+        "-c:v",
+        "mjpeg",
+        "pipe:1",
+      ],
+      { maxBuffer: 50 * 1024 * 1024 },
+    );
+    const original = new Uint8Array(made.stdout);
+    expect(readImageDimensions(original)).toEqual({ width: 1440, height: 3200 });
+    const sent = await t3patchDownscaleImage(original, "image/jpeg");
+    expect(readImageDimensions(sent)).toEqual({ width: 706, height: 1568 });
+    expect(sent[0]).toBe(0xff); // по-прежнему JPEG
+    expect(sent[1]).toBe(0xd8);
+  });
+
+  it("маленькие картинки, gif и мусор — без изменений", async () => {
+    const png = new Uint8Array(
+      readFileSync(new URL("../../../web/public/favicon-32x32.png", import.meta.url)),
+    );
+    expect(await t3patchDownscaleImage(png, "image/png")).toBe(png);
+    const junk = new Uint8Array([1, 2, 3]);
+    expect(await t3patchDownscaleImage(junk, "image/jpeg")).toBe(junk);
+    expect(await t3patchDownscaleImage(junk, "image/gif")).toBe(junk);
+  });
+});
