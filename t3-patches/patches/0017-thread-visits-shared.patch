+    expect(
+      t3patchLocalChanges({
+        previous: { "env:a": T1, "env:b": T1 },
+        next: { "env:a": T2, "env:b": T2, "other:z": T2 },
+        environmentId: "env",
+        known: { b: T2 },
+      }),
+    ).toEqual([["a", T2]]);
+  });
+});
+
+describe("недошедшие отметки", () => {
+  it("отправляются снова, пока в браузере то же значение, и не затираются сервером", () => {
+    const retry = t3patchUnsentToRetry({
+      unsent: { a: T2, b: T2 },
+      local: { "env:a": T2, "env:b": T1 },
+      environmentId: "env",
+    });
+    expect(retry).toEqual([["a", T2]]);
+    const server = t3patchWithoutThreads({ a: T1, c: T1 }, retry);
+    expect(server).toEqual({ c: T1 });
