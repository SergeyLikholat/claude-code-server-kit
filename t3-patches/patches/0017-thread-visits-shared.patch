diff --git a/apps/web/src/components/sergey/ThreadVisitsSync.tsx b/apps/web/src/components/sergey/ThreadVisitsSync.tsx
new file mode 100644
index 0000000000..e7653ed1e9
--- /dev/null
+++ b/apps/web/src/components/sergey/ThreadVisitsSync.tsx
@@ -0,0 +1,94 @@
+/**
+ * t3-patch: держит время открытия тредов браузера в согласии с сервером, чтобы «Завершено»
+ * гасло везде, где тред прочитали (в браузере, в приложении, на другом компьютере).
+ * Логика слияния — threadVisitsSyncLogic.ts. Сервер без патча 0017 подписку не знает:
+ * подписка падает, отметки остаются только в этом браузере — как было штатно.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { useCallback, useEffect, useRef } from "react";
+
+import { useEnvironments } from "../../state/environments";
+import { useEnvironmentQuery } from "../../state/query";
+import { serverEnvironment } from "../../state/server";
+import { useAtomCommand } from "../../state/use-atom-command";
+import { useUiStateStore } from "../../uiStateStore";
+import {
+  t3patchLocalChanges,
+  t3patchMergeServerVisits,
+  t3patchUnsentToRetry,
+  t3patchWithoutThreads,
+} from "./threadVisitsSyncLogic";
+
+function EnvironmentThreadVisitsSync(props: { readonly environmentId: EnvironmentId }) {
+  const { environmentId } = props;
+  const serverVisits = useEnvironmentQuery(
+    serverEnvironment.t3patchThreadVisits({ environmentId, input: {} }),
+  ).data;
+  const mark = useAtomCommand(serverEnvironment.t3patchMarkThreadVisited, {
+    reportFailure: false,
+    reportDefect: false,
+  });
+  // Что сервер уже знает: чтобы не отправлять ему его же значения обратно.
+  const known = useRef<Record<string, string>>({});
+  // Отметки, которые не дошли (нет связи): отправляются снова со следующим снимком сервера.
+  const unsent = useRef<Record<string, string>>({});
+  const synced = useRef(false);
+
+  const push = useCallback(
+    (threadId: string, visitedAt: string) => {
+      known.current[threadId] = visitedAt;
+      void mark({ environmentId, input: { threadId, visitedAt } }).then((result) => {
+        if (result._tag === "Success") {
+          if (unsent.current[threadId] === visitedAt) delete unsent.current[threadId];
+        } else {
+          unsent.current[threadId] = visitedAt;
+        }
+      });
+    },
+    [environmentId, mark],
+  );
+
+  useEffect(() => {
+    if (serverVisits === null) return;
+    const firstSnapshot = !synced.current;
+    synced.current = true;
+    const local = useUiStateStore.getState().threadLastVisitedAtById;
+    const retry = t3patchUnsentToRetry({ unsent: unsent.current, local, environmentId });
+    const server = t3patchWithoutThreads(serverVisits, retry);
+    known.current = { ...server };
+    const merge = t3patchMergeServerVisits({ local, environmentId, server, firstSnapshot });
+    if (merge.local !== null) useUiStateStore.setState({ threadLastVisitedAtById: merge.local });
+    for (const [threadId, visitedAt] of [...merge.push, ...retry]) push(threadId, visitedAt);
+  }, [environmentId, push, serverVisits]);
+
+  useEffect(
+    () =>
+      useUiStateStore.subscribe((state, previous) => {
+        if (!synced.current) return; // до первого снимка всё отправит слияние
+        const changes = t3patchLocalChanges({
+          next: state.threadLastVisitedAtById,
+          previous: previous.threadLastVisitedAtById,
+          environmentId,
+          known: known.current,
+        });
+        for (const [threadId, visitedAt] of changes) push(threadId, visitedAt);
+      }),
+    [environmentId, push],
+  );
+
+  return null;
+}
+
+export function T3patchThreadVisitsSync() {
+  const { environments } = useEnvironments();
+  return (
+    <>
+      {environments.map((environment) => (
+        <EnvironmentThreadVisitsSync
+          key={environment.environmentId}
+          environmentId={environment.environmentId}
+        />
+      ))}
+    </>
+  );
+}
diff --git a/apps/web/src/components/sergey/threadVisitsSync.test.ts b/apps/web/src/components/sergey/threadVisitsSync.test.ts
new file mode 100644
index 0000000000..426dd93d50
--- /dev/null
+++ b/apps/web/src/components/sergey/threadVisitsSync.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  t3patchLocalChanges,
+  t3patchMergeServerVisits,
+  t3patchUnsentToRetry,
+  t3patchWithoutThreads,
+} from "./threadVisitsSyncLogic";
+
+const T1 = "2026-09-27T10:00:00.000Z";
+const T2 = "2026-09-27T11:00:00.000Z";
+
+describe("синхронизация времени открытия тредов", () => {
+  it("первый снимок: побеждает более позднее, неизвестное серверу уходит на сервер", () => {
+    const result = t3patchMergeServerVisits({
+      local: { "env:a": T2, "env:b": T1, "env:c": T1, "other:z": T1 },
+      environmentId: "env",
+      server: { a: T1, b: T2 },
+      firstSnapshot: true,
+    });
+    expect(result.local).toEqual({ "env:a": T2, "env:b": T2, "env:c": T1, "other:z": T1 });
+    expect(result.push).toEqual([
+      ["a", T2],
+      ["c", T1],
+    ]);
+  });
+
+  it("дальше сервер — источник правды, даже если время раньше (непрочитано)", () => {
+    const result = t3patchMergeServerVisits({
+      local: { "env:a": T2 },
+      environmentId: "env",
+      server: { a: T1 },
+      firstSnapshot: false,
+    });
+    expect(result.local).toEqual({ "env:a": T1 });
+    expect(result.push).toEqual([]);
+  });
+
+  it("совпадение — без изменений", () => {
+    const result = t3patchMergeServerVisits({
+      local: { "env:a": T1 },
+      environmentId: "env",
+      server: { a: T1 },
+      firstSnapshot: false,
