+      t3patchMergeServerVisits({
+        local: { "env:a": T2 },
+        environmentId: "env",
+        server,
+        firstSnapshot: false,
+      }).local,
+    ).toEqual({ "env:a": T2, "env:c": T1 });
+  });
+});
