new file mode 100644
index 0000000000..5560d42df9
--- /dev/null
+++ b/apps/web/src/components/sergey/threadVisitsSyncLogic.ts
@@ -0,0 +1,102 @@
+/**
+ * t3-patch: слияние времени открытия тредов браузера с серверным (сервер: sergey/threadVisits.ts).
+ *
+ * Браузер держит отметки в uiStateStore под ключом `<environmentId>:<threadId>`, сервер — по
+ * threadId внутри своего окружения. Правила:
+ * - первый снимок с сервера: побеждает более позднее время, а то, что браузер знал раньше
+ *   сервера, отправляется на сервер — так не теряются отметки, сделанные до патча;
+ * - дальше сервер — источник правды: его значение ставится как есть, даже если оно раньше
+ *   (так до браузера доходит «пометить непрочитанным» с другого устройства);
+ * - изменение в браузере, которого сервер ещё не знает, отправляется на сервер.
+ * Чистые функции — их проверяют тесты.
+ */
+export type T3patchVisitMap = Readonly<Record<string, string>>;
+
+export const t3patchVisitKey = (environmentId: string, threadId: string) =>
+  `${environmentId}:${threadId}`;
+
+const ms = (value: string | undefined) => (value === undefined ? NaN : Date.parse(value));
+
+export interface T3patchServerMerge {
+  /** Новые отметки браузера или null, если менять нечего. */
+  readonly local: Record<string, string> | null;
+  /** Что отправить на сервер: [threadId, visitedAt]. */
+  readonly push: ReadonlyArray<readonly [string, string]>;
+}
+
+export function t3patchMergeServerVisits(input: {
+  readonly local: T3patchVisitMap;
+  readonly environmentId: string;
+  readonly server: T3patchVisitMap;
+  readonly firstSnapshot: boolean;
+}): T3patchServerMerge {
+  const { local, environmentId, server, firstSnapshot } = input;
+  const prefix = `${environmentId}:`;
+  let next: Record<string, string> | null = null;
+  const push: Array<readonly [string, string]> = [];
+  for (const [threadId, serverValue] of Object.entries(server)) {
+    const key = t3patchVisitKey(environmentId, threadId);
+    const localValue = local[key];
+    if (localValue === serverValue) continue;
+    if (firstSnapshot && ms(localValue) > ms(serverValue)) {
+      push.push([threadId, localValue!]);
+      continue;
+    }
+    next ??= { ...local };
+    next[key] = serverValue;
+  }
+  if (firstSnapshot) {
+    for (const [key, localValue] of Object.entries(local)) {
+      if (!key.startsWith(prefix)) continue;
+      const threadId = key.slice(prefix.length);
+      if (!(threadId in server) && Number.isFinite(ms(localValue)))
+        push.push([threadId, localValue]);
+    }
+  }
+  return { local: next, push };
+}
+
+/** Отметки окружения, изменившиеся в браузере и ещё не известные серверу. */
+export function t3patchLocalChanges(input: {
+  readonly next: T3patchVisitMap;
+  readonly previous: T3patchVisitMap;
+  readonly environmentId: string;
+  readonly known: T3patchVisitMap;
+}): Array<readonly [string, string]> {
+  const { next, previous, environmentId, known } = input;
+  if (next === previous) return [];
+  const prefix = `${environmentId}:`;
+  const changes: Array<readonly [string, string]> = [];
+  for (const [key, value] of Object.entries(next)) {
+    if (!key.startsWith(prefix) || previous[key] === value) continue;
+    const threadId = key.slice(prefix.length);
+    if (known[threadId] === value) continue;
+    changes.push([threadId, value]);
+  }
+  return changes;
+}
+
+/**
+ * Недошедшие отметки, которые всё ещё актуальны (в браузере то же значение): их отправить
+ * снова, а серверное значение для них не применять — сервер о них ещё не знает.
+ */
+export function t3patchUnsentToRetry(input: {
+  readonly unsent: T3patchVisitMap;
+  readonly local: T3patchVisitMap;
+  readonly environmentId: string;
+}): Array<readonly [string, string]> {
+  return Object.entries(input.unsent).filter(
+    ([threadId, value]) => input.local[t3patchVisitKey(input.environmentId, threadId)] === value,
+  );
+}
+
+/** Карта сервера без указанных тредов. */
+export function t3patchWithoutThreads(
+  server: T3patchVisitMap,
+  threads: ReadonlyArray<readonly [string, string]>,
+): T3patchVisitMap {
+  if (threads.length === 0) return server;
+  const next: Record<string, string> = { ...server };
+  for (const [threadId] of threads) delete next[threadId];
+  return next;
+}
