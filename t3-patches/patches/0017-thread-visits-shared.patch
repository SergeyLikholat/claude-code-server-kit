@@ -0,0 +1,89 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import { mkdtemp, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, describe, expect, it } from "vite-plus/test";
+
+import {
+  t3patchApplyThreadVisit,
+  t3patchGetThreadVisits,
+  t3patchMarkThreadVisited,
+  t3patchOnThreadVisits,
+  t3patchParseThreadVisits,
+  t3patchResetThreadVisitsForTest,
+  t3patchSubscribeThreadVisits,
+} from "./threadVisits.ts";
+
+afterEach(() => t3patchResetThreadVisitsForTest());
+
+describe("время открытия тредов на сервере", () => {
+  it("разбирает файл и отбрасывает мусор", () => {
+    expect(t3patchParseThreadVisits('{"a":"2026-09-27T10:00:00.000Z","b":"вчера","c":5}')).toEqual({
+      a: "2026-09-27T10:00:00.000Z",
+    });
+    expect(t3patchParseThreadVisits("не json")).toEqual({});
+    expect(t3patchParseThreadVisits("[]")).toEqual({});
+  });
+
+  it("последняя запись побеждает, даже если время раньше (пометить непрочитанным)", () => {
+    const later = t3patchApplyThreadVisit({}, "t", "2026-09-27T10:05:00.000Z");
+    expect(t3patchApplyThreadVisit(later, "t", "2026-09-27T10:04:59.999Z")).toEqual({
+      t: "2026-09-27T10:04:59.999Z",
+    });
+  });
+
+  it("при переполнении оставляет самые свежие", () => {
+    let map = {};
+    for (let i = 0; i < 5; i++) {
+      map = t3patchApplyThreadVisit(map, `t${i}`, `2026-09-2${i}T00:00:00.000Z`, 3);
+    }
+    expect(Object.keys(map).toSorted()).toEqual(["t2", "t3", "t4"]);
+  });
+
+  it("сохраняет в файл, переживает перезапуск и оповещает подписчиков", async () => {
+    const dir = await mkdtemp(join(tmpdir(), "t3patch-visits-"));
+    const seen: Array<Record<string, string>> = [];
+    const off = t3patchOnThreadVisits((visits) => seen.push({ ...visits }));
+    await t3patchMarkThreadVisited(dir, "thread-1", "2026-09-27T10:00:00.000Z");
+    await t3patchMarkThreadVisited(dir, "thread-1", "не время");
+    off();
+    expect(seen).toEqual([{ "thread-1": "2026-09-27T10:00:00.000Z" }]);
+    const file = JSON.parse(await readFile(join(dir, "t3patch-thread-visits.json"), "utf8"));
+    expect(file).toEqual({ "thread-1": "2026-09-27T10:00:00.000Z" });
+    t3patchResetThreadVisitsForTest();
+    expect(await t3patchGetThreadVisits(dir)).toEqual({ "thread-1": "2026-09-27T10:00:00.000Z" });
+  });
+});
+
+describe("время открытия тредов: гонки", () => {
+  it("две отметки сразу после запуска сервера не теряют друг друга", async () => {
+    const dir = await mkdtemp(join(tmpdir(), "t3patch-visits-"));
+    await Promise.all([
+      t3patchMarkThreadVisited(dir, "a", "2026-09-27T10:00:00.000Z"),
+      t3patchMarkThreadVisited(dir, "b", "2026-09-27T10:01:00.000Z"),
+    ]);
+    expect(await t3patchGetThreadVisits(dir)).toEqual({
+      a: "2026-09-27T10:00:00.000Z",
+      b: "2026-09-27T10:01:00.000Z",
+    });
+    t3patchResetThreadVisitsForTest();
+    expect(await t3patchGetThreadVisits(dir)).toEqual({
+      a: "2026-09-27T10:00:00.000Z",
+      b: "2026-09-27T10:01:00.000Z",
+    });
+  });
+
+  it("подписка отдаёт снимок первым, затем изменения по порядку", async () => {
+    const dir = await mkdtemp(join(tmpdir(), "t3patch-visits-"));
+    await t3patchMarkThreadVisited(dir, "a", "2026-09-27T10:00:00.000Z");
+    const seen: Array<Record<string, string>> = [];
+    const pending = t3patchSubscribeThreadVisits(dir, (visits) => seen.push({ ...visits }));
+    const marking = t3patchMarkThreadVisited(dir, "a", "2026-09-27T11:00:00.000Z");
+    const off = await pending;
+    await marking;
+    off();
+    expect(seen.at(-1)).toEqual({ a: "2026-09-27T11:00:00.000Z" });
+    expect(seen[0]).toEqual({ a: "2026-09-27T10:00:00.000Z" });
+  });
+});
diff --git a/apps/server/src/sergey/threadVisits.ts b/apps/server/src/sergey/threadVisits.ts
new file mode 100644
index 0000000000..4048f57c53
--- /dev/null
+++ b/apps/server/src/sergey/threadVisits.ts
@@ -0,0 +1,138 @@
+// @effect-diagnostics nodeBuiltinImport:off
+// @effect-diagnostics globalConsole:off
+/**
+ * t3-patch: время последнего открытия тредов — общее для всех клиентов.
+ *
+ * Штатно «тред открывали тогда-то» хранит каждый клиент у себя (браузер — в localStorage,
+ * приложение — на телефоне), поэтому статус «Завершено/Готово» расходился: открыл тред в
+ * браузере, а в приложении он всё ещё «Готово». Здесь одна карта threadId → ISO-время на весь
+ * сервер, в файле `<stateDir>/t3patch-thread-visits.json`, и рассылка изменений подписчикам.
+ *
+ * Запись — «последняя побеждает»: «пометить непрочитанным» ставит время чуть раньше завершения
+ * хода и должно перекрыть более позднюю отметку. Карта ограничена MAX_ENTRIES самыми свежими.
+ */
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+export type T3patchThreadVisits = Readonly<Record<string, string>>;
+
+const FILE_NAME = "t3patch-thread-visits.json";
+export const T3PATCH_THREAD_VISITS_MAX_ENTRIES = 2000;
+
+let visits: Record<string, string> | null = null;
+let loadedFrom: string | null = null;
+let writeChain: Promise<void> = Promise.resolve();
+const listeners = new Set<(visits: T3patchThreadVisits) => void>();
+
+/** Разобрать содержимое файла: только пары строка → корректное время. */
+export function t3patchParseThreadVisits(text: string): Record<string, string> {
+  try {
+    const parsed: unknown = JSON.parse(text);
+    if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) return {};
+    const result: Record<string, string> = {};
+    for (const [threadId, value] of Object.entries(parsed)) {
+      if (typeof value === "string" && Number.isFinite(Date.parse(value))) result[threadId] = value;
+    }
+    return result;
+  } catch {
+    return {};
+  }
+}
+
+/** Новая карта с отметкой; при переполнении отбрасываются самые старые. */
+export function t3patchApplyThreadVisit(
+  current: T3patchThreadVisits,
+  threadId: string,
+  visitedAt: string,
+  maxEntries = T3PATCH_THREAD_VISITS_MAX_ENTRIES,
+): Record<string, string> {
+  const next: Record<string, string> = { ...current, [threadId]: visitedAt };
+  const ids = Object.keys(next);
+  if (ids.length <= maxEntries) return next;
+  const newest = ids
+    .toSorted((a, b) => Date.parse(next[b]!) - Date.parse(next[a]!))
+    .slice(0, maxEntries);
+  return Object.fromEntries(newest.map((id) => [id, next[id]!]));
+}
+
+let loading: Promise<Record<string, string>> | null = null;
+
+/** Загрузить карту один раз; параллельные вызовы ждут одну и ту же загрузку. */
+function load(stateDir: string): Promise<Record<string, string>> {
+  if (visits !== null && loadedFrom === stateDir) return Promise.resolve(visits);
+  if (loading !== null && loadedFrom === stateDir) return loading;
+  loadedFrom = stateDir;
+  loading = readFile(join(stateDir, FILE_NAME), "utf8")
+    .catch(() => "{}") // файла ещё нет — начинаем с пустой карты
+    .then((text) => {
+      visits = t3patchParseThreadVisits(text);
+      loading = null;
+      return visits;
+    });
+  return loading;
+}
+
+function persist(stateDir: string, snapshot: T3patchThreadVisits): Promise<void> {
+  const path = join(stateDir, FILE_NAME);
+  writeChain = writeChain
+    .then(async () => {
+      await mkdir(stateDir, { recursive: true });
+      const tmp = `${path}.${process.pid}.tmp`;
+      await writeFile(tmp, `${JSON.stringify(snapshot)}\n`, "utf8");
+      await rename(tmp, path);
+    })
+    .catch((error: unknown) => {
+      console.warn("t3patch: не удалось сохранить время открытия тредов", error);
+    });
+  return writeChain;
+}
+
+export async function t3patchGetThreadVisits(stateDir: string): Promise<T3patchThreadVisits> {
+  return load(stateDir);
+}
+
+/**
+ * Подписаться и сразу получить текущую карту — синхронно, одним шагом, чтобы между снимком
+ * и подпиской не проскочило изменение (иначе клиент получил бы старый снимок после нового).
+ */
+export async function t3patchSubscribeThreadVisits(
+  stateDir: string,
+  listener: (visits: T3patchThreadVisits) => void,
+): Promise<() => void> {
+  await load(stateDir);
+  listeners.add(listener);
+  listener(visits ?? {});
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export async function t3patchMarkThreadVisited(
+  stateDir: string,
+  threadId: string,
+  visitedAt: string,
+): Promise<void> {
+  if (!threadId || !Number.isFinite(Date.parse(visitedAt))) return;
+  // После await читаем карту заново: её могла обновить параллельная отметка.
+  await load(stateDir);
+  const current = visits ?? {};
+  if (current[threadId] === visitedAt) return;
+  visits = t3patchApplyThreadVisit(current, threadId, visitedAt);
+  const snapshot = visits;
+  for (const listener of listeners) listener(snapshot);
+  await persist(stateDir, snapshot);
+}
+
+export function t3patchOnThreadVisits(listener: (visits: T3patchThreadVisits) => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/** Только для тестов: забыть загруженную карту. */
+export function t3patchResetThreadVisitsForTest(): void {
+  visits = null;
+  loadedFrom = null;
+  loading = null;
+}
