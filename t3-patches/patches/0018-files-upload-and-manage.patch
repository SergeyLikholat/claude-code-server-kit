+// @effect-diagnostics nodeBuiltinImport:off
+// @effect-diagnostics globalDate:off
+import { mkdir, mkdtemp, readFile, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  t3patchAppendChunk,
+  t3patchCreateUpload,
+  t3patchFreeName,
+  t3patchListTrash,
+  t3patchMkdir,
+  t3patchMove,
+  t3patchParseMountInfo,
+  t3patchRealPath,
+  t3patchResolveInside,
+  t3patchRestore,
+  t3patchTrash,
+  t3patchUploadOffset,
+  t3patchVerifyUpload,
+} from "./workspaceOps.ts";
+
+async function* chunks(...parts: string[]) {
+  for (const part of parts) yield new TextEncoder().encode(part);
+}
+
+async function setup() {
+  const base = await mkdtemp(join(tmpdir(), "t3patch-ops-"));
+  const cwd = join(base, "project");
+  const stateDir = join(base, "state");
+  await mkdir(join(cwd, "docs"), { recursive: true });
+  return { cwd, stateDir };
+}
+
+describe("загрузка файлов в папку проекта", () => {
+  it("кусками, с обрывом и продолжением с места обрыва", async () => {
+    const { cwd, stateDir } = await setup();
+    const { token } = await t3patchCreateUpload({
+      stateDir,
+      cwd,
+      directory: "docs",
+      name: "Смета.txt",
+      size: 10,
+    });
+    const claims = (await t3patchVerifyUpload(stateDir, token))!;
+    const first = await t3patchAppendChunk({ stateDir, claims, offset: 0, body: chunks("01234") });
+    expect(first).toEqual({ done: false, offset: 5 });
+    // обрыв: клиент спрашивает, сколько дошло
+    expect(await t3patchUploadOffset(stateDir, claims)).toBe(5);
+    // повтор со старым смещением — отказ с текущим смещением
+    await expect(
+      t3patchAppendChunk({ stateDir, claims, offset: 0, body: chunks("x") }),
+    ).rejects.toMatchObject({ status: 409, offset: 5 });
+    const last = await t3patchAppendChunk({ stateDir, claims, offset: 5, body: chunks("56789") });
+    expect(last).toEqual({ done: true, offset: 10, relativePath: "docs/Смета.txt" });
+    expect(await readFile(join(cwd, "docs/Смета.txt"), "utf8")).toBe("0123456789");
+  });
+
+  it("занятое имя — «Имя (2).ext», замена — только явным выбором", async () => {
+    const { cwd, stateDir } = await setup();
+    await writeFile(join(cwd, "docs/a.txt"), "old");
+    const upload = async (conflict?: "replace") => {
+      const { token } = await t3patchCreateUpload({
+        stateDir,
+        cwd,
+        directory: "docs",
+        name: "a.txt",
+        size: 3,
+        ...(conflict ? { conflict } : {}),
+      });
+      const claims = (await t3patchVerifyUpload(stateDir, token))!;
+      return t3patchAppendChunk({ stateDir, claims, offset: 0, body: chunks("new") });
+    };
+    expect(await upload()).toMatchObject({ relativePath: "docs/a (2).txt" });
+    expect(await readFile(join(cwd, "docs/a.txt"), "utf8")).toBe("old");
+    expect(await upload("replace")).toMatchObject({ relativePath: "docs/a.txt" });
+    expect(await readFile(join(cwd, "docs/a.txt"), "utf8")).toBe("new");
+  });
+
+  it("не выходит за пределы проекта и не принимает подделанную ссылку", async () => {
+    const { cwd, stateDir } = await setup();
+    expect(() => t3patchResolveInside(cwd, "../etc")).toThrow("за пределы");
+    await expect(
+      t3patchCreateUpload({ stateDir, cwd, directory: "docs", name: "../x", size: 1 }),
+    ).rejects.toThrow("Недопустимое имя");
+    const { token } = await t3patchCreateUpload({
+      stateDir,
+      cwd,
+      directory: "docs",
+      name: "a",
+      size: 1,
+    });
+    const forged = `${Buffer.from(JSON.stringify({ id: "x", cwd: "/", directory: "etc", name: "passwd", size: 1, conflict: "replace", exp: 9e15 })).toString("base64url")}.${token.split(".")[1]}`;
+    expect(await t3patchVerifyUpload(stateDir, forged)).toBeNull();
+    expect(await t3patchVerifyUpload(stateDir, token, Date.now() + 49 * 3600_000)).toBeNull();
+  });
+
+  it("папка целиком: недостающие вложенные папки создаются", async () => {
+    const { cwd, stateDir } = await setup();
+    const { token } = await t3patchCreateUpload({
+      stateDir,
+      cwd,
+      directory: "docs/Новая/Акты",
+      name: "a.txt",
+      size: 1,
+    });
+    const claims = (await t3patchVerifyUpload(stateDir, token))!;
+    expect(
+      await t3patchAppendChunk({ stateDir, claims, offset: 0, body: chunks("1") }),
+    ).toMatchObject({
+      relativePath: "docs/Новая/Акты/a.txt",
+    });
+  });
+
+  it("лишние данные сверх размера — отказ", async () => {
+    const { cwd, stateDir } = await setup();
+    const { token } = await t3patchCreateUpload({
+      stateDir,
+      cwd,
+      directory: "",
+      name: "b",
+      size: 2,
+    });
+    const claims = (await t3patchVerifyUpload(stateDir, token))!;
+    await expect(
+      t3patchAppendChunk({ stateDir, claims, offset: 0, body: chunks("abc") }),
+    ).rejects.toMatchObject({ status: 413 });
+  });
+});
+
+describe("папки, переименование, корзина", () => {
+  it("новая папка, переименование без затирания, перемещение", async () => {
+    const { cwd } = await setup();
+    expect(await t3patchMkdir(cwd, "docs/Акты")).toBe("docs/Акты");
+    await writeFile(join(cwd, "docs/1.txt"), "1");
+    await writeFile(join(cwd, "docs/2.txt"), "2");
+    await expect(t3patchMove(cwd, "docs/1.txt", "docs/2.txt")).rejects.toMatchObject({
+      status: 409,
+    });
+    expect(await t3patchMove(cwd, "docs/1.txt", "docs/Акты/1.txt")).toBe("docs/Акты/1.txt");
+    await expect(t3patchMove(cwd, "docs", "docs/Акты/docs")).rejects.toThrow("внутрь");
+  });
+
+  it("удаление в корзину и восстановление на прежнее место", async () => {
+    const { cwd, stateDir } = await setup();
+    await writeFile(join(cwd, "docs/план.md"), "текст");
+    const item = await t3patchTrash(stateDir, cwd, "docs/план.md");
+    expect(await stat(join(cwd, "docs/план.md")).catch(() => null)).toBeNull();
+    expect((await t3patchListTrash(stateDir, cwd)).map((entry) => entry.id)).toEqual([item.id]);
+    expect(await t3patchRestore(stateDir, item.id)).toBe("docs/план.md");
+    expect(await readFile(join(cwd, "docs/план.md"), "utf8")).toBe("текст");
+    expect(await t3patchListTrash(stateDir, cwd)).toEqual([]);
+  });
+
+  it("свободное имя подбирается по номеру", async () => {
+    const { cwd } = await setup();
+    await writeFile(join(cwd, "docs/x.pdf"), "");
+    await writeFile(join(cwd, "docs/x (2).pdf"), "");
+    expect(await t3patchFreeName(join(cwd, "docs"), "x.pdf")).toBe("x (3).pdf");
+    expect(await t3patchFreeName(join(cwd, "docs"), "y.pdf")).toBe("y.pdf");
+  });
+});
+
+describe("запись через окно-монтирование (!Obsidian)", () => {
+  const mountinfo = [
+    "25 1 252:1 / / rw,relatime shared:1 - ext4 /dev/vda1 rw",
+    "613 25 252:1 /root/Obsidian /root/projects/tk-vector/!Obsidian ro,relatime shared:1 - ext4 /dev/vda1 rw",
+  ].join("\n");
+  const mounts = t3patchParseMountInfo(mountinfo);
+
+  it("путь в окне только для чтения переводится в настоящую папку базы", () => {
+    expect(t3patchRealPath("/root/projects/tk-vector/!Obsidian/ОБМЕН/a.pdf", mounts)).toBe(
+      "/root/Obsidian/ОБМЕН/a.pdf",
+    );
+  });
+
+  it("обычный путь проекта не меняется", () => {
+    expect(t3patchRealPath("/root/projects/tk-vector/docs/a.pdf", mounts)).toBe(
+      "/root/projects/tk-vector/docs/a.pdf",
+    );
+  });
+});
