diff --git a/apps/server/src/sergey/uploadRoute.ts b/apps/server/src/sergey/uploadRoute.ts
new file mode 100644
index 0000000000..8624114f88
--- /dev/null
+++ b/apps/server/src/sergey/uploadRoute.ts
@@ -0,0 +1,91 @@
+/**
+ * t3-patch: HTTP-маршрут загрузки файла в папку проекта кусками (логика — workspaceOps.ts).
+ *
+ *   GET  /api/t3patch/upload/<ссылка>            → { offset, size }  — сколько уже получено
+ *   POST /api/t3patch/upload/<ссылка>?offset=N    → тело: следующий кусок
+ *        → { offset, done: false } или { offset, done: true, relativePath }
+ *        → 409 { offset } — смещение разошлось, продолжить с offset
+ *
+ * Авторизация — подписанная ссылка из запроса t3patch.workspaceCreateUpload (как у вложений чата):
+ * так файл может грузить и фоновый загрузчик Android без заголовков сессии.
+ */
+import { T3PATCH_WORKSPACE_UPLOAD_ROUTE } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Stream from "effect/Stream";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/unstable/http";
+
+import * as ServerConfig from "../config.ts";
+import * as WorkspaceEntries from "../workspace/WorkspaceEntries.ts";
+import {
+  T3patchOpError,
+  t3patchAppendChunk,
+  t3patchUploadOffset,
+  t3patchVerifyUpload,
+} from "./workspaceOps.ts";
+
+const json = (body: unknown, status = 200) =>
+  HttpServerResponse.jsonUnsafe(body, { status, headers: { "Cache-Control": "no-store" } });
+
+const claimsFromRequest = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest;
+  const url = HttpServerRequest.toURL(request);
+  if (Option.isNone(url)) return null;
+  const token = url.value.pathname.slice(`${T3PATCH_WORKSPACE_UPLOAD_ROUTE}/`.length);
+  const config = yield* ServerConfig.ServerConfig;
+  const claims = yield* Effect.promise(() => t3patchVerifyUpload(config.stateDir, token));
+  return claims ? { claims, url: url.value, stateDir: config.stateDir, request } : null;
+});
+
+export const t3patchUploadStatusRouteLayer = HttpRouter.add(
+  "GET",
+  `${T3PATCH_WORKSPACE_UPLOAD_ROUTE}/*`,
+  Effect.gen(function* () {
+    const found = yield* claimsFromRequest;
+    if (!found) return json({ error: "Ссылка загрузки недействительна или устарела." }, 404);
+    const offset = yield* Effect.promise(() => t3patchUploadOffset(found.stateDir, found.claims));
+    if (offset === null) return json({ error: "Загрузка не найдена — начните заново." }, 404);
+    return json({ offset, size: found.claims.size });
+  }),
+);
+
+export const t3patchUploadChunkRouteLayer = HttpRouter.add(
+  "POST",
+  `${T3PATCH_WORKSPACE_UPLOAD_ROUTE}/*`,
+  Effect.gen(function* () {
+    const found = yield* claimsFromRequest;
+    if (!found) return json({ error: "Ссылка загрузки недействительна или устарела." }, 404);
+    const offset = Number(found.url.searchParams.get("offset") ?? "0");
+    if (!Number.isSafeInteger(offset) || offset < 0)
+      return json({ error: "Неверное смещение." }, 400);
+    const body = yield* Stream.toAsyncIterableEffect(found.request.stream);
+    const result = yield* Effect.promise(async () => {
+      try {
+        return {
+          ok: true as const,
+          value: await t3patchAppendChunk({
+            stateDir: found.stateDir,
+            claims: found.claims,
+            offset,
+            body,
+          }),
+        };
+      } catch (error) {
+        return { ok: false as const, error };
+      }
+    });
+    if (!result.ok) {
+      const error = result.error as T3patchOpError & { offset?: number };
+      const status = error instanceof T3patchOpError ? error.status : 500;
+      return json(
+        { error: error instanceof Error ? error.message : String(error), offset: error.offset },
+        status,
+      );
+    }
+    if (result.value.done) {
+      const entries = yield* WorkspaceEntries.WorkspaceEntries;
+      yield* entries.refresh(found.claims.cwd);
+    }
+    return json(result.value);
+  }),
+);
