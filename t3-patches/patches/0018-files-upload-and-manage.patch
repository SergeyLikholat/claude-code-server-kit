diff --git a/apps/web/src/components/sergey/uploads.tsx b/apps/web/src/components/sergey/uploads.tsx
new file mode 100644
index 0000000000..366f181d1f
--- /dev/null
+++ b/apps/web/src/components/sergey/uploads.tsx
@@ -0,0 +1,234 @@
+/**
+ * t3-patch: очередь загрузок в проводнике и панель прогресса.
+ *
+ * Файлы грузятся по одному (связь на объекте слабая — параллель только мешает), каждый кусками
+ * с докачкой (workspaceClient.ts). Панель внизу слева: имя, прогресс, итог; закрывается сама,
+ * когда всё загрузилось без ошибок.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { useEffect, useSyncExternalStore } from "react";
+
+import { t3patchSendFile, t3patchWorkspace } from "./workspaceClient";
+
+export interface T3patchUploadFile {
+  readonly file: File;
+  /** Подпапка внутри папки назначения (при загрузке папки целиком), "" — сама папка. */
+  readonly subdirectory: string;
+}
+
+interface UploadItem {
+  readonly id: number;
+  readonly name: string;
+  readonly size: number;
+  sent: number;
+  status: "waiting" | "uploading" | "done" | "error";
+  error?: string;
+  relativePath?: string;
+}
+
+let items: UploadItem[] = [];
+let nextId = 1;
+let running = false;
+const listeners = new Set<() => void>();
+const queue: Array<() => Promise<void>> = [];
+
+function emit() {
+  items = [...items];
+  for (const listener of listeners) listener();
+}
+
+async function drain() {
+  if (running) return;
+  running = true;
+  while (queue.length > 0) await queue.shift()!();
+  running = false;
+}
+
+const joinPath = (...parts: string[]) => parts.filter(Boolean).join("/");
+
+/** Поставить файлы в очередь. `onUploaded` — после каждого файла (обновить дерево). */
+export function t3patchEnqueueUploads(input: {
+  readonly environmentId: EnvironmentId;
+  readonly cwd: string;
+  readonly directory: string;
+  readonly files: ReadonlyArray<T3patchUploadFile>;
+  readonly onUploaded: () => void;
+}): void {
+  for (const { file, subdirectory } of input.files) {
+    const item: UploadItem = {
+      id: nextId++,
+      name: joinPath(subdirectory, file.name),
+      size: file.size,
+      sent: 0,
+      status: "waiting",
+    };
+    items.push(item);
+    queue.push(async () => {
+      item.status = "uploading";
+      emit();
+      try {
+        const upload = await t3patchWorkspace.createUpload(input.environmentId, {
+          cwd: input.cwd,
+          directory: joinPath(input.directory, subdirectory),
+          name: file.name,
+          sizeBytes: file.size,
+        });
+        item.relativePath = await t3patchSendFile({
+          relativeUrl: upload.relativeUrl,
+          file,
+          onProgress: (sent) => {
+            item.sent = sent;
+            emit();
+          },
+        });
+        item.sent = item.size;
+        item.status = "done";
+        input.onUploaded();
+      } catch (error) {
+        item.status = "error";
+        item.error = error instanceof Error ? error.message : String(error);
+      }
+      emit();
+    });
+  }
+  emit();
+  void drain();
+}
+
+/** Файлы из перетаскивания: папки обходятся целиком, с сохранением вложенности. */
+export async function t3patchFilesFromDrop(
+  dataTransfer: DataTransfer,
+): Promise<T3patchUploadFile[]> {
+  const entries = Array.from(dataTransfer.items)
+    .map((item) => (item.kind === "file" ? item.webkitGetAsEntry?.() : null))
+    .filter((entry): entry is FileSystemEntry => Boolean(entry));
+  if (entries.length === 0) {
+    return Array.from(dataTransfer.files).map((file) => ({ file, subdirectory: "" }));
+  }
+  const result: T3patchUploadFile[] = [];
+  const walk = async (entry: FileSystemEntry, parent: string): Promise<void> => {
+    if (entry.isFile) {
+      const file = await new Promise<File>((resolve, reject) =>
+        (entry as FileSystemFileEntry).file(resolve, reject),
+      );
+      result.push({ file, subdirectory: parent });
+      return;
+    }
+    const reader = (entry as FileSystemDirectoryEntry).createReader();
+    const folder = joinPath(parent, entry.name);
+    for (;;) {
+      const batch = await new Promise<FileSystemEntry[]>((resolve, reject) =>
+        reader.readEntries(resolve, reject),
+      );
+      if (batch.length === 0) break;
+      for (const child of batch) await walk(child, folder);
+    }
+  };
+  for (const entry of entries) await walk(entry, "");
+  return result;
+}
+
+/** Выбор файлов в системном окне. */
+export function t3patchPickFiles(): Promise<File[]> {
+  return new Promise((resolve) => {
+    const input = document.createElement("input");
+    input.type = "file";
+    input.multiple = true;
+    input.addEventListener("change", () => resolve(Array.from(input.files ?? [])));
+    input.addEventListener("cancel", () => resolve([]));
+    input.click();
+  });
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+const formatBytes = (bytes: number) =>
+  bytes >= 1024 ** 3
+    ? `${(bytes / 1024 ** 3).toFixed(1)} ГБ`
+    : bytes >= 1024 ** 2
+      ? `${(bytes / 1024 ** 2).toFixed(1)} МБ`
+      : `${Math.max(1, Math.round(bytes / 1024))} КБ`;
+
+export function T3patchUploadPanel() {
+  const current = useSyncExternalStore(subscribe, () => items);
+  const active = current.some((item) => item.status === "waiting" || item.status === "uploading");
+  const failed = current.some((item) => item.status === "error");
+
+  useEffect(() => {
+    if (current.length === 0 || active || failed) return;
+    const timer = window.setTimeout(() => {
+      items = [];
+      emit();
+    }, 6_000);
+    return () => window.clearTimeout(timer);
+  }, [active, current.length, failed]);
+
+  if (current.length === 0) return null;
+  const done = current.filter((item) => item.status === "done").length;
+  return (
+    <div className="fixed bottom-4 left-4 z-50 w-80 overflow-hidden rounded-xl border border-border bg-popover shadow-lg">
+      <div className="flex items-center justify-between border-b border-border px-3 py-2">
+        <span className="text-sm font-medium">
+          {active
+            ? `Загрузка: ${done} из ${current.length}`
+            : failed
+              ? "Загрузка с ошибками"
+              : "Загружено"}
+        </span>
+        {active ? null : (
+          <button
+            type="button"
+            className="rounded px-1.5 text-muted-foreground hover:bg-accent hover:text-foreground"
+            aria-label="Закрыть"
+            onClick={() => {
+              items = [];
+              emit();
+            }}
+          >
+            ✕
+          </button>
+        )}
+      </div>
+      <ul className="max-h-64 overflow-y-auto">
+        {current.map((item) => {
+          const percent = item.size > 0 ? Math.floor((item.sent / item.size) * 100) : 100;
+          return (
+            <li key={item.id} className="px-3 py-2 text-xs">
+              <div className="flex justify-between gap-2">
+                <span className="truncate" title={item.name}>
+                  {item.name}
+                </span>
+                <span className="shrink-0 text-muted-foreground">
+                  {item.status === "done"
+                    ? "готово"
+                    : item.status === "error"
+                      ? "ошибка"
+                      : item.status === "waiting"
+                        ? "в очереди"
+                        : `${percent}% из ${formatBytes(item.size)}`}
+                </span>
+              </div>
+              {item.status === "error" ? (
+                <div className="mt-1 text-destructive">{item.error}</div>
+              ) : (
+                <div className="mt-1 h-1 overflow-hidden rounded bg-muted">
+                  <div
+                    className={
+                      item.status === "done" ? "h-full bg-emerald-500" : "h-full bg-primary"
+                    }
+                    style={{ width: `${percent}%` }}
+                  />
+                </div>
+              )}
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
