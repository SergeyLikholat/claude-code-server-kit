+++ b/apps/server/src/sergey/workspaceOps.ts
@@ -0,0 +1,482 @@
+// @effect-diagnostics nodeBuiltinImport:off
+// @effect-diagnostics globalDate:off
+/**
+ * t3-patch: файловые операции проводника — загрузка файлов в папку проекта (кусками, с докачкой),
+ * новая папка, переименование/перемещение, удаление в корзину с восстановлением.
+ *
+ * Штатно проводник T3 только читает: записать можно лишь текст из редактора (projects.writeFile).
+ * Загрузка устроена как у вложений чата: клиент по авторизованному соединению получает подписанную
+ * ссылку (HMAC), по ней шлёт файл кусками с указанием смещения. Недокачанный файл лежит в
+ * `<stateDir>/t3patch-uploads/`, при обрыве клиент спрашивает, сколько дошло, и продолжает.
+ * Готовый файл переносится в папку; занятое имя — «Имя (2).ext», замена — только явным выбором.
+ * Удалённое уходит в `<stateDir>/t3patch-trash/` и хранится 30 дней.
+ */
+import { createHmac, randomBytes, randomUUID, timingSafeEqual } from "node:crypto";
+import {
+  copyFile,
+  mkdir,
+  open,
+  readdir,
+  readFile,
+  rename,
+  rm,
+  stat,
+  unlink,
+  writeFile,
+} from "node:fs/promises";
+import * as NodePath from "node:path";
+
+export const T3PATCH_UPLOAD_MAX_BYTES = 4 * 1024 ** 3; // 4 ГБ на файл
+const UPLOAD_TTL_MS = 48 * 60 * 60 * 1000;
+const TRASH_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+
+export type T3patchConflict = "rename" | "replace";
+
+export class T3patchOpError extends Error {
+  readonly status: number;
+  constructor(message: string, status = 400) {
+    super(message);
+    this.status = status;
+  }
+}
+
+// ---------- пути ----------
+
+/** Имя файла или папки без путей и служебных значений. */
+export function t3patchValidName(name: string): string {
+  const trimmed = name.trim();
+  if (
+    !trimmed ||
+    trimmed === "." ||
+    trimmed === ".." ||
+    /[/\\\0]/.test(trimmed) ||
+    trimmed.length > 255
+  ) {
+    throw new T3patchOpError(`Недопустимое имя: «${name}».`);
+  }
+  return trimmed;
+}
+
+/** Абсолютный путь внутри корня проекта; выход наружу — ошибка. */
+export function t3patchResolveInside(root: string, relativePath: string): string {
+  const base = NodePath.resolve(root);
+  const target = NodePath.resolve(base, relativePath || ".");
+  if (target !== base && !target.startsWith(base + NodePath.sep)) {
+    throw new T3patchOpError("Путь выходит за пределы проекта.", 403);
+  }
+  return target;
+}
+
+const exists = (path: string) =>
+  stat(path).then(
+    () => true,
+    () => false,
+  );
+
+/** Свободное имя в папке: «Смета.xlsx» → «Смета (2).xlsx», «Смета (3).xlsx»… */
+export async function t3patchFreeName(directory: string, name: string): Promise<string> {
+  if (!(await exists(NodePath.join(directory, name)))) return name;
+  const ext = NodePath.extname(name);
+  const stem = ext && ext !== name ? name.slice(0, -ext.length) : name;
+  for (let index = 2; index < 10_000; index += 1) {
+    const candidate = `${stem} (${index})${ext}`;
+    if (!(await exists(NodePath.join(directory, candidate)))) return candidate;
+  }
+  throw new T3patchOpError("Не удалось подобрать свободное имя.", 409);
+}
+
+function explainFsError(error: unknown): T3patchOpError {
+  const code = (error as { code?: string }).code;
+  if (code === "EROFS" || code === "EACCES" || code === "EPERM") {
+    return new T3patchOpError("Папка только для чтения — записать сюда нельзя.", 403);
+  }
+  if (code === "ENOSPC") return new T3patchOpError("На сервере закончилось место.", 507);
+  if (code === "ENOENT") return new T3patchOpError("Файл или папка не найдены.", 404);
+  if (code === "EEXIST" || code === "ENOTEMPTY") {
+    return new T3patchOpError("Файл или папка с таким именем уже есть.", 409);
+  }
+  return new T3patchOpError(
+    `Ошибка файловой системы: ${String((error as Error).message ?? error)}`,
+    500,
+  );
+}
+
+async function moveAcrossDevices(from: string, to: string): Promise<void> {
+  try {
+    await rename(from, to);
+  } catch (error) {
+    if ((error as { code?: string }).code !== "EXDEV") throw error;
+    await copyFile(from, to);
+    await unlink(from);
+  }
+}
+
+// ---------- окна-монтирования (например, !Obsidian) ----------
+
+interface MountEntry {
+  readonly device: string;
+  readonly root: string;
+  readonly mountPoint: string;
+}
+
+const unescapeMountField = (value: string) =>
+  value.replace(/\\([0-7]{3})/g, (_, octal: string) =>
+    String.fromCharCode(Number.parseInt(octal, 8)),
+  );
+
+export function t3patchParseMountInfo(text: string): MountEntry[] {
+  return text
+    .split("\n")
+    .map((line) => line.split(" "))
+    .filter((fields) => fields.length > 4)
+    .map((fields) => ({
+      device: fields[2]!,
+      root: unescapeMountField(fields[3]!),
+      mountPoint: unescapeMountField(fields[4]!),
+    }));
+}
+
+const within = (parent: string, child: string) =>
+  child === parent || child.startsWith(parent.endsWith("/") ? parent : `${parent}/`);
+
+/**
+ * Окно на другую папку (bind-монтирование, например `<проект>/!Obsidian` → `/root/Obsidian`)
+ * смонтировано только для чтения — чтобы `rm -rf` проекта не задел базу. Запись через проводник —
+ * явное действие человека, поэтому она идёт в настоящую папку, а не в окно.
+ */
+export function t3patchRealPath(absolutePath: string, mounts: readonly MountEntry[]): string {
+  const owner = mounts
+    .filter((mount) => within(mount.mountPoint, absolutePath))
+    .toSorted((left, right) => right.mountPoint.length - left.mountPoint.length)[0];
+  if (!owner || owner.root === "/") return absolutePath;
+  const whole = mounts.find((mount) => mount.device === owner.device && mount.root === "/");
+  if (!whole) return absolutePath;
+  return NodePath.join(
+    whole.mountPoint,
+    owner.root,
+    NodePath.relative(owner.mountPoint, absolutePath),
+  );
+}
+
+async function writable(absolutePath: string): Promise<string> {
+  try {
+    const mounts = t3patchParseMountInfo(await readFile("/proc/self/mountinfo", "utf8"));
+    return t3patchRealPath(absolutePath, mounts);
+  } catch {
+    return absolutePath;
+  }
+}
+
+// ---------- подпись ссылок загрузки ----------
+
+let secretCache: { stateDir: string; secret: Buffer } | null = null;
+
+async function uploadSecret(stateDir: string): Promise<Buffer> {
+  if (secretCache?.stateDir === stateDir) return secretCache.secret;
+  const path = NodePath.join(stateDir, "t3patch-upload-secret");
+  let secret: Buffer;
+  try {
+    secret = await readFile(path);
+    if (secret.length < 32) throw new Error("short");
+  } catch {
+    secret = randomBytes(32);
+    await mkdir(stateDir, { recursive: true });
+    await writeFile(path, secret, { mode: 0o600 });
+  }
+  secretCache = { stateDir, secret };
+  return secret;
+}
+
+export interface T3patchUploadClaims {
+  readonly id: string;
+  readonly cwd: string;
+  readonly directory: string;
+  readonly name: string;
+  readonly size: number;
+  readonly conflict: T3patchConflict;
+  readonly exp: number;
+}
+
+export async function t3patchSignUpload(
+  stateDir: string,
+  claims: T3patchUploadClaims,
+): Promise<string> {
+  const payload = Buffer.from(JSON.stringify(claims)).toString("base64url");
+  const sig = createHmac("sha256", await uploadSecret(stateDir))
+    .update(payload)
+    .digest("base64url");
+  return `${payload}.${sig}`;
+}
+
+export async function t3patchVerifyUpload(
+  stateDir: string,
+  token: string,
+  now = Date.now(),
+): Promise<T3patchUploadClaims | null> {
+  const [payload, sig] = token.split(".");
+  if (!payload || !sig) return null;
+  const expected = createHmac("sha256", await uploadSecret(stateDir))
+    .update(payload)
+    .digest();
+  const given = Buffer.from(sig, "base64url");
+  if (given.length !== expected.length || !timingSafeEqual(given, expected)) return null;
+  try {
+    const claims = JSON.parse(Buffer.from(payload, "base64url").toString()) as T3patchUploadClaims;
+    return claims.exp > now ? claims : null;
+  } catch {
+    return null;
+  }
+}
+
+// ---------- загрузка ----------
+
+const uploadsDir = (stateDir: string) => NodePath.join(stateDir, "t3patch-uploads");
+const partPath = (stateDir: string, id: string) =>
+  NodePath.join(uploadsDir(stateDir), `${id}.part`);
+
+async function sweep(directory: string, ttlMs: number, now: number): Promise<void> {
+  const names = await readdir(directory).catch(() => [] as string[]);
+  for (const name of names) {
+    const path = NodePath.join(directory, name);
+    const info = await stat(path).catch(() => null);
+    if (info && now - info.mtimeMs > ttlMs) await rm(path, { recursive: true, force: true });
+  }
+}
+
+export async function t3patchCreateUpload(input: {
+  readonly stateDir: string;
+  readonly cwd: string;
+  readonly directory: string;
+  readonly name: string;
+  readonly size: number;
+  readonly conflict?: T3patchConflict;
+  readonly now?: number;
+}): Promise<{ readonly token: string; readonly expiresAt: number }> {
+  const now = input.now ?? Date.now();
+  const name = t3patchValidName(input.name);
+  if (!Number.isSafeInteger(input.size) || input.size < 0) {
+    throw new T3patchOpError("Неверный размер файла.");
+  }
+  if (input.size > T3PATCH_UPLOAD_MAX_BYTES) {
+    throw new T3patchOpError("Файл больше 4 ГБ — такой не загрузить.", 413);
+  }
+  const root = await stat(input.cwd).catch(() => null);
+  if (!root?.isDirectory()) throw new T3patchOpError("Папка проекта не найдена.", 404);
+  // Недостающие вложенные папки (загрузка папки целиком) создаются при завершении загрузки.
+  const target = t3patchResolveInside(input.cwd, input.directory);
+  const info = await stat(target).catch(() => null);
+  if (info && !info.isDirectory()) {
+    throw new T3patchOpError("На месте папки назначения лежит файл.", 409);
+  }
+  await mkdir(uploadsDir(input.stateDir), { recursive: true });
+  await sweep(uploadsDir(input.stateDir), UPLOAD_TTL_MS, now);
+  const claims: T3patchUploadClaims = {
+    id: randomUUID(),
+    cwd: NodePath.resolve(input.cwd),
+    directory: input.directory,
+    name,
+    size: input.size,
+    conflict: input.conflict ?? "rename",
+    exp: now + UPLOAD_TTL_MS,
+  };
+  await writeFile(partPath(input.stateDir, claims.id), new Uint8Array());
+  return { token: await t3patchSignUpload(input.stateDir, claims), expiresAt: claims.exp };
+}
+
+/** Сколько байт уже получено (для докачки). */
+export async function t3patchUploadOffset(
+  stateDir: string,
+  claims: T3patchUploadClaims,
+): Promise<number | null> {
+  const info = await stat(partPath(stateDir, claims.id)).catch(() => null);
+  return info ? info.size : null;
+}
+
+export type T3patchChunkResult =
+  | { readonly done: false; readonly offset: number }
+  | { readonly done: true; readonly offset: number; readonly relativePath: string };
+
+/**
+ * Дописать кусок начиная с `offset`. Смещение должно совпадать с уже полученным — иначе 409 с
+ * текущим смещением (клиент продолжит с него). Файл целиком — перенос в папку проекта.
+ */
+export async function t3patchAppendChunk(input: {
+  readonly stateDir: string;
+  readonly claims: T3patchUploadClaims;
+  readonly offset: number;
+  readonly body: AsyncIterable<Uint8Array>;
+}): Promise<T3patchChunkResult> {
+  const { stateDir, claims } = input;
+  const current = await t3patchUploadOffset(stateDir, claims);
+  if (current === null) {
+    throw new T3patchOpError("Загрузка не найдена или уже завершена — начните заново.", 404);
+  }
+  if (input.offset !== current) {
+    throw Object.assign(new T3patchOpError(`Ожидалось смещение ${current}.`, 409), {
+      offset: current,
+    });
+  }
+  const handle = await open(partPath(stateDir, claims.id), "r+");
+  let written = current;
+  try {
+    for await (const chunk of input.body) {
+      if (written + chunk.byteLength > claims.size) {
+        throw new T3patchOpError("Получено больше данных, чем размер файла.", 413);
+      }
+      await handle.write(chunk, 0, chunk.byteLength, written);
+      written += chunk.byteLength;
+    }
+  } finally {
+    await handle.close();
+  }
+  if (written < claims.size) return { done: false, offset: written };
+  return { done: true, offset: written, relativePath: await finishUpload(stateDir, claims) };
+}
+
+async function finishUpload(stateDir: string, claims: T3patchUploadClaims): Promise<string> {
+  const directory = t3patchResolveInside(claims.cwd, claims.directory);
+  const realDirectory = await writable(directory);
+  try {
+    await mkdir(realDirectory, { recursive: true });
+    const name =
+      claims.conflict === "replace"
+        ? claims.name
+        : await t3patchFreeName(realDirectory, claims.name);
+    await moveAcrossDevices(partPath(stateDir, claims.id), NodePath.join(realDirectory, name));
+    // клиенту — путь как в дереве (через окно), чтобы проводник нашёл файл
+    return NodePath.relative(claims.cwd, NodePath.join(directory, name));
+  } catch (error) {
+    throw error instanceof T3patchOpError ? error : explainFsError(error);
+  }
+}
+
+// ---------- папки, переименование, корзина ----------
+
+export async function t3patchMkdir(cwd: string, relativePath: string): Promise<string> {
+  const parent = t3patchResolveInside(cwd, NodePath.dirname(relativePath));
+  const name = t3patchValidName(NodePath.basename(relativePath));
+  const target = NodePath.join(parent, name);
+  try {
+    await mkdir(await writable(target));
+  } catch (error) {
+    throw explainFsError(error);
+  }
+  return NodePath.relative(NodePath.resolve(cwd), target);
+}
+
+/** Переименовать или переместить внутри проекта. Занятое имя — ошибка (не затираем). */
+export async function t3patchMove(cwd: string, from: string, to: string): Promise<string> {
+  const source = t3patchResolveInside(cwd, from);
+  if (source === NodePath.resolve(cwd)) throw new T3patchOpError("Корень проекта не перемещается.");
+  const parent = t3patchResolveInside(cwd, NodePath.dirname(to));
+  const target = NodePath.join(parent, t3patchValidName(NodePath.basename(to)));
+  if (target === source) return NodePath.relative(NodePath.resolve(cwd), target);
+  if (target.startsWith(source + NodePath.sep)) {
+    throw new T3patchOpError("Нельзя переместить папку внутрь неё самой.");
+  }
+  if (await exists(target))
+    throw new T3patchOpError("Файл или папка с таким именем уже есть.", 409);
+  try {
+    await moveTree(await writable(source), await writable(target));
+  } catch (error) {
+    throw explainFsError(error);
+  }
+  return NodePath.relative(NodePath.resolve(cwd), target);
+}
+
+export interface T3patchTrashItem {
+  readonly id: string;
+  readonly cwd: string;
+  readonly relativePath: string;
+  readonly deletedAt: number;
+  readonly isDirectory: boolean;
+}
+
+const trashDir = (stateDir: string) => NodePath.join(stateDir, "t3patch-trash");
+
+export async function t3patchTrash(
+  stateDir: string,
+  cwd: string,
+  relativePath: string,
+  now = Date.now(),
+): Promise<T3patchTrashItem> {
+  const source = t3patchResolveInside(cwd, relativePath);
+  if (source === NodePath.resolve(cwd)) throw new T3patchOpError("Корень проекта не удаляется.");
+  const info = await stat(source).catch(() => null);
+  if (!info) throw new T3patchOpError("Файл или папка не найдены.", 404);
+  await mkdir(trashDir(stateDir), { recursive: true });
+  await sweep(trashDir(stateDir), TRASH_TTL_MS, now);
+  const item: T3patchTrashItem = {
+    id: randomUUID(),
+    cwd: NodePath.resolve(cwd),
+    relativePath: NodePath.relative(NodePath.resolve(cwd), source),
+    deletedAt: now,
+    isDirectory: info.isDirectory(),
+  };
+  const slot = NodePath.join(trashDir(stateDir), item.id);
+  await mkdir(slot);
+  try {
+    await moveTree(await writable(source), NodePath.join(slot, NodePath.basename(source)));
+  } catch (error) {
+    await rm(slot, { recursive: true, force: true });
+    throw explainFsError(error);
+  }
+  await writeFile(NodePath.join(slot, "item.json"), JSON.stringify(item));
+  return item;
+}
+
+async function moveTree(from: string, to: string): Promise<void> {
+  try {
+    await rename(from, to);
+  } catch (error) {
+    if ((error as { code?: string }).code !== "EXDEV") throw error;
+    const { cp } = await import("node:fs/promises");
+    await cp(from, to, { recursive: true });
+    await rm(from, { recursive: true, force: true });
+  }
+}
+
+export async function t3patchListTrash(
+  stateDir: string,
+  cwd?: string,
+): Promise<T3patchTrashItem[]> {
+  const ids = await readdir(trashDir(stateDir)).catch(() => [] as string[]);
+  const items: T3patchTrashItem[] = [];
+  for (const id of ids) {
+    try {
+      const item = JSON.parse(
+        await readFile(NodePath.join(trashDir(stateDir), id, "item.json"), "utf8"),
+      ) as T3patchTrashItem;
+      if (!cwd || item.cwd === NodePath.resolve(cwd)) items.push(item);
+    } catch {
+      // незавершённое удаление — пропускаем
+    }
+  }
+  return items.toSorted((a, b) => b.deletedAt - a.deletedAt);
+}
+
+/** Вернуть из корзины на прежнее место; занято — рядом с номером. */
+export async function t3patchRestore(stateDir: string, id: string): Promise<string> {
+  if (!/^[0-9a-f-]{36}$/.test(id)) throw new T3patchOpError("Неверный идентификатор.");
+  const slot = NodePath.join(trashDir(stateDir), id);
+  let item: T3patchTrashItem;
+  try {
+    item = JSON.parse(await readFile(NodePath.join(slot, "item.json"), "utf8")) as T3patchTrashItem;
+  } catch {
+    throw new T3patchOpError("В корзине такого нет.", 404);
+  }
+  const parent = t3patchResolveInside(item.cwd, NodePath.dirname(item.relativePath));
+  const realParent = await writable(parent);
+  await mkdir(realParent, { recursive: true });
+  const name = await t3patchFreeName(realParent, NodePath.basename(item.relativePath));
+  try {
+    await moveTree(
+      NodePath.join(slot, NodePath.basename(item.relativePath)),
+      NodePath.join(realParent, name),
+    );
+  } catch (error) {
+    throw explainFsError(error);
+  }
+  await rm(slot, { recursive: true, force: true });
+  return NodePath.relative(item.cwd, NodePath.join(parent, name));
+}
