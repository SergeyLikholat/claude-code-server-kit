@@ -0,0 +1,120 @@
+/**
+ * t3-patch: вызовы файловых операций проводника (сервер: apps/server/src/sergey/workspaceOps.ts)
+ * и загрузка файла кусками с докачкой. Ошибка приходит понятным текстом с сервера.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import {
+  type AtomCommand,
+  runAtomCommand,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+
+import { resolvePrimaryEnvironmentHttpUrl } from "~/environments/primary/target";
+import { appAtomRegistry } from "~/rpc/atomRegistry";
+import { serverEnvironment } from "~/state/server";
+
+function failureMessage(error: unknown): string {
+  if (error && typeof error === "object" && "message" in error) return String(error.message);
+  return String(error);
+}
+
+async function call<I, A>(
+  command: AtomCommand<{ environmentId: EnvironmentId; input: I }, A, unknown>,
+  environmentId: EnvironmentId,
+  input: I,
+): Promise<A> {
+  const result = await runAtomCommand(
+    appAtomRegistry,
+    command,
+    { environmentId, input },
+    {
+      reportFailure: false,
+      reportDefect: false,
+    },
+  );
+  if (result._tag === "Success") return result.value;
+  throw new Error(failureMessage(squashAtomCommandFailure(result)));
+}
+
+export const t3patchWorkspace = {
+  mkdir: (environmentId: EnvironmentId, cwd: string, relativePath: string) =>
+    call(serverEnvironment.t3patchWorkspaceMkdir, environmentId, { cwd, relativePath }),
+  move: (environmentId: EnvironmentId, cwd: string, from: string, to: string) =>
+    call(serverEnvironment.t3patchWorkspaceMove, environmentId, { cwd, from, to }),
+  trash: (environmentId: EnvironmentId, cwd: string, relativePath: string) =>
+    call(serverEnvironment.t3patchWorkspaceTrash, environmentId, { cwd, relativePath }),
+  restore: (environmentId: EnvironmentId, id: string) =>
+    call(serverEnvironment.t3patchWorkspaceRestore, environmentId, { id }),
+  createUpload: (
+    environmentId: EnvironmentId,
+    input: {
+      cwd: string;
+      directory: string;
+      name: string;
+      sizeBytes: number;
+      conflict?: "rename" | "replace";
+    },
+  ) => call(serverEnvironment.t3patchWorkspaceCreateUpload, environmentId, input),
+};
+
+export const T3PATCH_UPLOAD_CHUNK_BYTES = 8 * 1024 * 1024;
+const RETRY_DELAYS_MS = [1_000, 2_000, 5_000, 10_000, 20_000, 30_000];
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/**
+ * Отправить файл по ссылке загрузки кусками. Обрыв связи — пауза и вопрос серверу «сколько
+ * дошло», продолжение с этого места. `onProgress` — отправлено байт.
+ */
+export async function t3patchSendFile(input: {
+  readonly relativeUrl: string;
+  readonly file: Blob;
+  readonly onProgress: (sent: number) => void;
+  readonly signal?: AbortSignal;
+}): Promise<string> {
+  const url = resolvePrimaryEnvironmentHttpUrl(input.relativeUrl);
+  let offset = 0;
+  let failures = 0;
+  for (;;) {
+    input.signal?.throwIfAborted();
+    try {
+      const end = Math.min(offset + T3PATCH_UPLOAD_CHUNK_BYTES, input.file.size);
+      const response = await fetch(`${url}?offset=${offset}`, {
+        method: "POST",
+        body: input.file.slice(offset, end),
+        signal: input.signal ?? null,
+      });
+      const body = (await response.json().catch(() => ({}))) as {
+        offset?: number;
+        done?: boolean;
+        relativePath?: string;
+        error?: string;
+      };
+      if (response.status === 409 && typeof body.offset === "number") {
+        offset = body.offset;
+        continue;
+      }
+      if (!response.ok)
+        throw Object.assign(new Error(body.error ?? `Сервер ответил ${response.status}`), {
+          fatal: response.status < 500,
+        });
+      failures = 0;
+      offset = body.offset ?? end;
+      input.onProgress(offset);
+      if (body.done) return body.relativePath ?? "";
+    } catch (error) {
+      if (input.signal?.aborted || (error as { fatal?: boolean }).fatal) throw error;
+      // обрыв связи: подождать и спросить у сервера, сколько дошло
+      const delay = RETRY_DELAYS_MS[Math.min(failures, RETRY_DELAYS_MS.length - 1)]!;
+      failures += 1;
+      await sleep(delay);
+      const status = await fetch(url, { signal: input.signal ?? null })
+        .then((response) => (response.ok ? response.json() : null))
+        .catch(() => null);
+      if (status && typeof status.offset === "number") {
+        offset = status.offset;
+        input.onProgress(offset);
+      }
+    }
+  }
+}
