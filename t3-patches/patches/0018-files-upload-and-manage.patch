diff --git a/packages/contracts/src/t3patchWorkspace.ts b/packages/contracts/src/t3patchWorkspace.ts
new file mode 100644
index 0000000000..6f150badfb
--- /dev/null
+++ b/packages/contracts/src/t3patchWorkspace.ts
@@ -0,0 +1,81 @@
+/**
+ * t3-patch: запросы файловых операций проводника — загрузка в папку, новая папка,
+ * переименование/перемещение, корзина. Сервер: apps/server/src/sergey/workspaceOps.ts.
+ */
+import * as Rpc from "effect/unstable/rpc/Rpc";
+import * as Schema from "effect/Schema";
+
+import { EnvironmentAuthorizationError } from "./auth.ts";
+
+export class T3patchWorkspaceError extends Schema.TaggedError<T3patchWorkspaceError>()(
+  "T3patchWorkspaceError",
+  { message: Schema.String },
+) {}
+
+const errors = Schema.Union([T3patchWorkspaceError, EnvironmentAuthorizationError]);
+const PathResult = Schema.Struct({ relativePath: Schema.String });
+
+export const T3PATCH_WORKSPACE_METHODS = {
+  createUpload: "t3patch.workspaceCreateUpload",
+  mkdir: "t3patch.workspaceMkdir",
+  move: "t3patch.workspaceMove",
+  trash: "t3patch.workspaceTrash",
+  listTrash: "t3patch.workspaceListTrash",
+  restore: "t3patch.workspaceRestore",
+} as const;
+
+export const T3patchTrashItem = Schema.Struct({
+  id: Schema.String,
+  cwd: Schema.String,
+  relativePath: Schema.String,
+  deletedAt: Schema.Number,
+  isDirectory: Schema.Boolean,
+});
+export type T3patchTrashItem = typeof T3patchTrashItem.Type;
+
+export const WsT3patchWorkspaceCreateUploadRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.createUpload, {
+  payload: Schema.Struct({
+    cwd: Schema.String,
+    /** Папка назначения относительно корня проекта ("" — корень). */
+    directory: Schema.String,
+    name: Schema.String,
+    sizeBytes: Schema.Number,
+    /** rename (по умолчанию) — «Имя (2).ext»; replace — заменить существующий. */
+    conflict: Schema.optional(Schema.Literals(["rename", "replace"])),
+  }),
+  success: Schema.Struct({ relativeUrl: Schema.String, expiresAt: Schema.Number }),
+  error: errors,
+});
+
+export const WsT3patchWorkspaceMkdirRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.mkdir, {
+  payload: Schema.Struct({ cwd: Schema.String, relativePath: Schema.String }),
+  success: PathResult,
+  error: errors,
+});
+
+export const WsT3patchWorkspaceMoveRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.move, {
+  payload: Schema.Struct({ cwd: Schema.String, from: Schema.String, to: Schema.String }),
+  success: PathResult,
+  error: errors,
+});
+
+export const WsT3patchWorkspaceTrashRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.trash, {
+  payload: Schema.Struct({ cwd: Schema.String, relativePath: Schema.String }),
+  success: T3patchTrashItem,
+  error: errors,
+});
+
+export const WsT3patchWorkspaceListTrashRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.listTrash, {
+  payload: Schema.Struct({ cwd: Schema.String }),
+  success: Schema.Array(T3patchTrashItem),
+  error: errors,
+});
+
+export const WsT3patchWorkspaceRestoreRpc = Rpc.make(T3PATCH_WORKSPACE_METHODS.restore, {
+  payload: Schema.Struct({ id: Schema.String }),
+  success: PathResult,
+  error: errors,
+});
+
+/** Адрес загрузки кусками: GET — сколько получено, POST ?offset=N — дописать кусок. */
+export const T3PATCH_WORKSPACE_UPLOAD_ROUTE = "/api/t3patch/upload";
