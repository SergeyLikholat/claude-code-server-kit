new file mode 100644
index 0000000000..8e88e1cae4
--- /dev/null
+++ b/apps/web/src/components/sergey/useT3patchExplorerDrop.ts
@@ -0,0 +1,81 @@
+/**
+ * t3-patch: перетаскивание файлов и папок с компьютера в проводник.
+ *
+ * Отпустил на папку — файлы попадут в неё, на файл — в его папку, на пустое место — в корень
+ * проекта. Строки дерева лежат в открытом shadow DOM (@pierre/trees), поэтому цель ищется по
+ * `composedPath()` и атрибуту `data-item-path`. Внутреннее перетаскивание строк дерева в чат не
+ * трогаем: реагируем, только если тащат файлы из системы.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { type RefObject, useEffect } from "react";
+
+import { t3patchEnqueueUploads, t3patchFilesFromDrop } from "./uploads";
+
+const DROP_ATTRIBUTE = "data-t3patch-drop";
+
+function dropDirectory(event: DragEvent): string {
+  for (const node of event.composedPath()) {
+    if (!(node instanceof HTMLElement)) continue;
+    const path = node.getAttribute("data-item-path");
+    if (path === null) continue;
+    if (path.endsWith("/")) return path.replace(/\/+$/, "");
+    return path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "";
+  }
+  return "";
+}
+
+const carriesFiles = (event: DragEvent) =>
+  Array.from(event.dataTransfer?.types ?? []).includes("Files");
+
+export function useT3patchExplorerDrop(
+  panelRef: RefObject<HTMLElement | null>,
+  input: {
+    readonly environmentId: EnvironmentId;
+    readonly cwd: string;
+    readonly refresh: () => void;
+  },
+): void {
+  const { environmentId, cwd, refresh } = input;
+  useEffect(() => {
+    const panel = panelRef.current;
+    if (!panel) return;
+    let depth = 0;
+    const onEnter = (event: DragEvent) => {
+      if (!carriesFiles(event)) return;
+      depth += 1;
+      panel.setAttribute(DROP_ATTRIBUTE, "");
+    };
+    const onLeave = (event: DragEvent) => {
+      if (!carriesFiles(event)) return;
+      depth = Math.max(0, depth - 1);
+      if (depth === 0) panel.removeAttribute(DROP_ATTRIBUTE);
+    };
+    const onOver = (event: DragEvent) => {
+      if (!carriesFiles(event)) return;
+      event.preventDefault();
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
+    };
+    const onDrop = (event: DragEvent) => {
+      if (!carriesFiles(event) || !event.dataTransfer) return;
+      event.preventDefault();
+      event.stopPropagation();
+      depth = 0;
+      panel.removeAttribute(DROP_ATTRIBUTE);
+      const directory = dropDirectory(event);
+      void t3patchFilesFromDrop(event.dataTransfer).then((files) => {
+        if (files.length === 0) return;
+        t3patchEnqueueUploads({ environmentId, cwd, directory, files, onUploaded: refresh });
+      });
+    };
+    panel.addEventListener("dragenter", onEnter, true);
+    panel.addEventListener("dragleave", onLeave, true);
+    panel.addEventListener("dragover", onOver, true);
+    panel.addEventListener("drop", onDrop, true);
+    return () => {
+      panel.removeEventListener("dragenter", onEnter, true);
+      panel.removeEventListener("dragleave", onLeave, true);
+      panel.removeEventListener("dragover", onOver, true);
+      panel.removeEventListener("drop", onDrop, true);
+    };
+  }, [cwd, environmentId, panelRef, refresh]);
+}
