+/**
+ * Запрос к серверу с ожиданием соединения. На телефоне после системного окна выбора файла
+ * страница несколько секунд заново подключается к серверу, и запрос сразу получал
+ * «… is not connected».
+ */
+async function call<I, A>(
+  command: AtomCommand<{ environmentId: EnvironmentId; input: I }, A, unknown>,
+  environmentId: EnvironmentId,
+  input: I,
+): Promise<A> {
+  const deadline = Date.now() + CONNECT_WAIT_MS;
+  for (;;) {
+    try {
+      return await callOnce(command, environmentId, input);
+    } catch (error) {
+      if (!NOT_CONNECTED.test(failureMessage(error))) throw error;
+      if (Date.now() > deadline) {
+        throw new Error("Нет соединения с сервером — дождитесь подключения и повторите.", {
+          cause: error,
+        });
+      }
+      await sleep(1_500);
+    }
+  }
+}
