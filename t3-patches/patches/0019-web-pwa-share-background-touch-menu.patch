diff --git a/apps/web/src/components/sergey/useT3patchTouchMenu.ts b/apps/web/src/components/sergey/useT3patchTouchMenu.ts
new file mode 100644
index 0000000000..542800a116
--- /dev/null
+++ b/apps/web/src/components/sergey/useT3patchTouchMenu.ts
@@ -0,0 +1,108 @@
+/**
+ * t3-patch: долгое нажатие на строку дерева на телефоне (PWA, мобильный браузер) открывает меню.
+ *
+ * Меню дерева открывается правой кнопкой мыши. На телефоне её нет, а долгое нажатие на строку
+ * запускало перетаскивание (строки можно тащить в чат) — меню не появлялось. Здесь: удержание
+ * 500 мс без сдвига → то же событие contextmenu на строке, что и от правой кнопки, плюс
+ * отмена перетаскивания и следующего «клика» (иначе после меню открылся бы файл).
+ */
+import { type RefObject, useEffect } from "react";
+
+const HOLD_MS = 500;
+const MOVE_TOLERANCE_PX = 10;
+
+function rowFromEvent(event: Event): HTMLElement | null {
+  for (const node of event.composedPath()) {
+    if (node instanceof HTMLElement && node.hasAttribute("data-item-path")) return node;
+  }
+  return null;
+}
+
+export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): void {
+  useEffect(() => {
+    const panel = panelRef.current;
+    if (!panel) return;
+    let timer: ReturnType<typeof setTimeout> | null = null;
+    let start: { x: number; y: number } | null = null;
+    let fired = false;
+
+    const cancel = () => {
+      if (timer !== null) clearTimeout(timer);
+      timer = null;
+      start = null;
+    };
+    const onTouchStart = (event: TouchEvent) => {
+      fired = false;
+      if (event.touches.length !== 1) return cancel();
+      const row = rowFromEvent(event);
+      if (!row) return;
+      const touch = event.touches[0]!;
+      start = { x: touch.clientX, y: touch.clientY };
+      timer = setTimeout(() => {
+        timer = null;
+        fired = true;
+        navigator.vibrate?.(10);
+        row.dispatchEvent(
+          new MouseEvent("contextmenu", {
+            bubbles: true,
+            cancelable: true,
+            composed: true,
+            clientX: start?.x ?? 0,
+            clientY: start?.y ?? 0,
+            button: 2,
+          }),
+        );
+      }, HOLD_MS);
+    };
+    const onTouchMove = (event: TouchEvent) => {
+      if (!start || timer === null) return;
+      const touch = event.touches[0];
+      if (!touch) return cancel();
+      if (
+        Math.abs(touch.clientX - start.x) > MOVE_TOLERANCE_PX ||
+        Math.abs(touch.clientY - start.y) > MOVE_TOLERANCE_PX
+      ) {
+        cancel();
+      }
+    };
+    const onTouchEnd = (event: TouchEvent) => {
+      cancel();
+      if (fired) event.preventDefault(); // не превращать удержание в клик по строке
+    };
+    const swallowAfterMenu = (event: Event) => {
+      if (!fired) return;
+      event.preventDefault();
+      event.stopPropagation();
+      if (event.type === "click") fired = false;
+    };
+    const blockDragWhileHolding = (event: DragEvent) => {
+      if (timer !== null || fired) event.preventDefault();
+    };
+    // Удержание пальца браузер сам превращает в contextmenu — после нашего. Окно меню
+    // (contextMenuFallback) ловит contextmenu на document и закрывается от «щелчка мимо»:
+    // меню мелькало и пропадало. Гасим браузерное событие на window, раньше document.
+    const blockNativeMenu = (event: Event) => {
+      if (!event.isTrusted || (timer === null && !fired)) return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+    };
+
+    panel.addEventListener("touchstart", onTouchStart, { capture: true, passive: true });
+    panel.addEventListener("touchmove", onTouchMove, { capture: true, passive: true });
+    panel.addEventListener("touchend", onTouchEnd, { capture: true });
+    panel.addEventListener("touchcancel", cancel, { capture: true });
+    panel.addEventListener("click", swallowAfterMenu, true);
+    panel.addEventListener("dragstart", blockDragWhileHolding, true);
+    window.addEventListener("contextmenu", blockNativeMenu, true);
+    return () => {
+      cancel();
+      panel.removeEventListener("touchstart", onTouchStart, { capture: true });
+      panel.removeEventListener("touchmove", onTouchMove, { capture: true });
+      panel.removeEventListener("touchend", onTouchEnd, { capture: true });
+      panel.removeEventListener("touchcancel", cancel, { capture: true });
+      panel.removeEventListener("click", swallowAfterMenu, true);
+      panel.removeEventListener("dragstart", blockDragWhileHolding, true);
+      window.removeEventListener("contextmenu", blockNativeMenu, true);
+    };
+  }, [panelRef]);
+}
