diff --git a/apps/web/src/components/sergey/pwaShare.ts b/apps/web/src/components/sergey/pwaShare.ts
new file mode 100644
index 0000000000..a061da9ddf
--- /dev/null
+++ b/apps/web/src/components/sergey/pwaShare.ts
@@ -0,0 +1,102 @@
+/**
+ * t3-patch: PWA — фоновый скрипт (public/t3patch-sw.js) и файлы из «Поделиться».
+ *
+ * «Поделиться → T3 Code» на телефоне: скрипт кладёт файлы в IndexedDB «t3patch-share» и
+ * открывает T3. Здесь они читаются, в проводнике на папке появляется «Загрузить сюда
+ * полученные (N)».
+ *
+ * Background Fetch для загрузки на сервер не годится: Chrome отправляет запрос с пустым телом
+ * (content-length: 0), сервер получал 0 байт, а страница считала файл загруженным.
+ */
+import { useSyncExternalStore } from "react";
+
+const DB_NAME = "t3patch-share";
+const STORE = "files";
+
+let sharedCount = 0;
+const listeners = new Set<() => void>();
+const emit = () => {
+  for (const listener of listeners) listener();
+};
+
+function openDb(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () =>
+      request.result.createObjectStore(STORE, { autoIncrement: true });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+async function countShared(): Promise<number> {
+  if (typeof indexedDB === "undefined") return 0;
+  const db = await openDb();
+  const count = await new Promise<number>((resolve, reject) => {
+    const request = db.transaction(STORE).objectStore(STORE).count();
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+  db.close();
+  return count;
+}
+
+/** Забрать полученные файлы (хранилище очищается). */
+export async function t3patchTakeSharedFiles(): Promise<File[]> {
+  const db = await openDb();
+  const records = await new Promise<Array<{ name: string; type: string; blob: Blob }>>(
+    (resolve, reject) => {
+      const tx = db.transaction(STORE, "readwrite");
+      const request = tx.objectStore(STORE).getAll();
+      request.onsuccess = () => {
+        tx.objectStore(STORE).clear();
+        resolve(request.result as Array<{ name: string; type: string; blob: Blob }>);
+      };
+      request.onerror = () => reject(request.error);
+    },
+  );
+  db.close();
+  sharedCount = 0;
+  emit();
+  return records.map((record) => new File([record.blob], record.name, { type: record.type }));
+}
+
+export function t3patchSharedFileCount(): number {
+  return sharedCount;
+}
+
+export function useT3patchSharedFileCount(): number {
+  return useSyncExternalStore(
+    (listener) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    () => sharedCount,
+  );
+}
+
+let started = false;
+
+/** Зарегистрировать фоновый скрипт и подхватить файлы из «Поделиться». Один раз за сеанс. */
+export function t3patchStartPwa(onShared: (count: number) => void): void {
+  if (started || typeof window === "undefined") return;
+  started = true;
+  if ("serviceWorker" in navigator && window.isSecureContext) {
+    void navigator.serviceWorker.register("/t3patch-sw.js").catch(() => undefined);
+  }
+  void countShared()
+    .then((count) => {
+      sharedCount = count;
+      emit();
+      if (count > 0) onShared(count);
+    })
+    .catch(() => undefined);
+  const params = new URLSearchParams(window.location.search);
+  if (params.has("t3patch-share")) {
+    params.delete("t3patch-share");
+    const query = params.toString();
+    window.history.replaceState(null, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
+  }
+}
