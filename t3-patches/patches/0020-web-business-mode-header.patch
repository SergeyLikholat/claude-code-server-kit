diff --git a/apps/web/src/components/sergey/businessMode.tsx b/apps/web/src/components/sergey/businessMode.tsx
new file mode 100644
index 0000000000..68988b87ee
--- /dev/null
+++ b/apps/web/src/components/sergey/businessMode.tsx
@@ -0,0 +1,109 @@
+/**
+ * t3-patch: T3 для бизнеса — инструменты разработчика убраны с глаз.
+ *
+ * По умолчанию шапка треда показывает только то, что нужно в работе с документами: проект и
+ * тред, «Новый тред», проводник (правая панель) и меню «⋯». Git (ветки, коммит, PR), «Открыть
+ * в VS Code», скрипты проекта, переключатель терминала и выбор ветки под полем ввода скрыты.
+ * В «⋯» — терминал и переключатель «Режим разработчика», который возвращает штатную шапку.
+ * Режим хранится на устройстве (localStorage), горячие клавиши работают в обоих режимах.
+ */
+import { EllipsisIcon, PlusIcon } from "lucide-react";
+import { useSyncExternalStore } from "react";
+
+import { Button } from "../ui/button";
+import { Menu, MenuCheckboxItem, MenuPopup, MenuSeparator, MenuTrigger } from "../ui/menu";
+
+const STORAGE_KEY = "t3patch.devMode";
+const listeners = new Set<() => void>();
+
+function readDevMode(): boolean {
+  try {
+    return window.localStorage.getItem(STORAGE_KEY) === "1";
+  } catch {
+    return false;
+  }
+}
+
+export function t3patchSetDevMode(enabled: boolean): void {
+  try {
+    if (enabled) window.localStorage.setItem(STORAGE_KEY, "1");
+    else window.localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    // приватный режим браузера: режим просто не запомнится
+  }
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  const onStorage = (event: StorageEvent) => {
+    if (event.key === STORAGE_KEY) listener();
+  };
+  window.addEventListener("storage", onStorage);
+  return () => {
+    listeners.delete(listener);
+    window.removeEventListener("storage", onStorage);
+  };
+}
+
+/** Включён ли «Режим разработчика» (штатная шапка с Git, VS Code, терминалом). */
+export function useT3patchDevMode(): boolean {
+  return useSyncExternalStore(subscribe, readDevMode, () => false);
+}
+
+/** Кнопки шапки треда: «Новый тред» и меню «⋯» (терминал, режим разработчика). */
+export function T3patchBusinessHeaderActions(props: {
+  readonly onNewThread: (() => void) | null;
+  readonly terminalAvailable: boolean;
+  readonly terminalOpen: boolean;
+  readonly onToggleTerminal: () => void;
+}) {
+  const devMode = useT3patchDevMode();
+  return (
+    <>
+      {props.onNewThread ? (
+        <Button
+          variant="outline"
+          size="xs"
+          className="gap-1"
+          aria-label="Новый тред"
+          onClick={props.onNewThread}
+        >
+          <PlusIcon className="size-3.5" />
+          <span className="hidden @xl/header-actions:inline">Новый тред</span>
+        </Button>
+      ) : null}
+      <Menu>
+        <MenuTrigger
+          render={<Button variant="ghost" size="icon-xs" aria-label="Ещё" />}
+          className="text-muted-foreground hover:text-foreground"
+        >
+          <EllipsisIcon className="size-4" />
+        </MenuTrigger>
+        <MenuPopup align="end" className="w-72">
+          <MenuCheckboxItem
+            variant="switch"
+            checked={props.terminalOpen}
+            disabled={!props.terminalAvailable}
+            onCheckedChange={() => props.onToggleTerminal()}
+          >
+            Терминал
+          </MenuCheckboxItem>
+          <MenuSeparator />
+          <MenuCheckboxItem
+            variant="switch"
+            checked={devMode}
+            onCheckedChange={(checked) => t3patchSetDevMode(checked)}
+          >
+            <span className="flex flex-col gap-0.5">
+              <span>Режим разработчика</span>
+              <span className="text-xs text-muted-foreground">
+                Git и ветки, VS Code, скрипты, терминал в шапке
+              </span>
+            </span>
+          </MenuCheckboxItem>
+        </MenuPopup>
+      </Menu>
+    </>
+  );
+}
