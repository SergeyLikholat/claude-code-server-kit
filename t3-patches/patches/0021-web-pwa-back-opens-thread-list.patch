+/**
+ * t3-patch: жест «назад» в PWA на телефоне открывает список тредов, как в приложении (APK).
+ *
+ * Штатно «назад» в PWA — это «назад» браузера: возврат на прошлую открытую страницу, то есть
+ * на предыдущий тред, и казалось, что открылась какая-то другая сессия. Теперь в треде (или
+ * в черновике нового) «назад» перехватывается и открывает боковое меню со списком. Если меню
+ * уже открыто — «назад» работает как обычно.
+ *
+ * Только установленная PWA на узком экране: в обычной вкладке браузера «назад» не трогаем.
+ */
+import { useBlocker } from "@tanstack/react-router";
+import { useEffect, useState } from "react";
+
+import { useSidebar } from "../ui/sidebar";
+
+const THREAD_ROUTE_IDS = new Set(["/_chat/$environmentId/$threadId", "/_chat/draft/$draftId"]);
+
+function useStandalonePwa(): boolean {
+  const [standalone, setStandalone] = useState(
+    () => window.matchMedia?.("(display-mode: standalone)").matches === true,
+  );
+  useEffect(() => {
+    const query = window.matchMedia?.("(display-mode: standalone)");
+    if (!query) return;
+    const onChange = () => setStandalone(query.matches);
+    query.addEventListener("change", onChange);
+    return () => query.removeEventListener("change", onChange);
+  }, []);
+  return standalone;
+}
+
+export function T3patchBackToMenu(): null {
+  const { isMobile, openMobile, setOpenMobile } = useSidebar();
+  const standalone = useStandalonePwa();
+  useBlocker({
+    disabled: !standalone || !isMobile || openMobile,
+    enableBeforeUnload: false,
+    shouldBlockFn: ({ current, action }) => {
+      if (action !== "BACK" || !THREAD_ROUTE_IDS.has(String(current.routeId))) return false;
+      setOpenMobile(true);
+      return true;
+    },
+  });
+  return null;
+}
