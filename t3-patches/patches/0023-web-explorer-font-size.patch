index 0000000000..3f55838624
--- /dev/null
+++ b/apps/web/src/components/sergey/explorerFontSize.ts
@@ -0,0 +1,56 @@
+/**
+ * t3-patch: размер шрифта в проводнике. Штатно 12 px без настройки — на телефоне мелко.
+ *
+ * Настройка — «Настройки → Внешний вид → Типографика → Шрифт проводника» (SettingsPanels),
+ * рядом со шрифтами интерфейса, кода и терминала. Хранится на устройстве (localStorage).
+ * Высота строки дерева растёт вместе со шрифтом (2 × размер), иначе крупный текст обрезался бы.
+ * Дерево берёт высоту строки только при создании, поэтому проводник при смене размера
+ * пересоздаётся (FilePreviewPanel: key) — раскрытые папки сворачиваются.
+ */
+import { useSyncExternalStore } from "react";
+
+export const T3PATCH_EXPLORER_FONT_MIN = 11;
+export const T3PATCH_EXPLORER_FONT_MAX = 20;
+export const T3PATCH_EXPLORER_FONT_DEFAULT = 12;
+
+const STORAGE_KEY = "t3patch.explorerFontPx";
+const listeners = new Set<() => void>();
+
+function read(): number {
+  try {
+    const value = Number(window.localStorage.getItem(STORAGE_KEY));
+    if (
+      Number.isInteger(value) &&
+      value >= T3PATCH_EXPLORER_FONT_MIN &&
+      value <= T3PATCH_EXPLORER_FONT_MAX
+    ) {
+      return value;
+    }
+  } catch {
+    // нет доступа к localStorage — размер по умолчанию
+  }
+  return T3PATCH_EXPLORER_FONT_DEFAULT;
+}
+
+export function t3patchSetExplorerFontPx(px: number): void {
+  try {
+    if (px === T3PATCH_EXPLORER_FONT_DEFAULT) window.localStorage.removeItem(STORAGE_KEY);
+    else window.localStorage.setItem(STORAGE_KEY, String(px));
+  } catch {
+    // приватный режим браузера: выбор не запомнится
+  }
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/** Размер шрифта проводника и соответствующая высота строки дерева. */
+export function useT3patchExplorerFontSize(): { readonly fontPx: number; readonly itemHeight: number } {
+  const fontPx = useSyncExternalStore(subscribe, read, () => T3PATCH_EXPLORER_FONT_DEFAULT);
+  return { fontPx, itemHeight: fontPx * 2 };
+}
