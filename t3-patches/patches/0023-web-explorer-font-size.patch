+/**
+ * t3-patch: размер шрифта проводника (sergey/explorerFontSize.ts). Только размер — семейство
+ * берётся из шрифта интерфейса.
+ */
+function T3patchExplorerFontRow() {
+  const { fontPx } = useT3patchExplorerFontSize();
+  const sizes = Array.from(
+    { length: T3PATCH_EXPLORER_FONT_MAX - T3PATCH_EXPLORER_FONT_MIN + 1 },
+    (_, index) => T3PATCH_EXPLORER_FONT_MIN + index,
+  );
+  return (
+    <SettingsRow
+      title="Шрифт проводника"
+      description="Имена файлов и папок в проводнике. Высота строк меняется вместе со шрифтом."
+      resetAction={
+        fontPx !== T3PATCH_EXPLORER_FONT_DEFAULT ? (
+          <SettingResetButton
+            label="шрифт проводника"
+            onClick={() => t3patchSetExplorerFontPx(T3PATCH_EXPLORER_FONT_DEFAULT)}
+          />
+        ) : null
+      }
+      control={
+        <Select
+          value={String(fontPx)}
+          onValueChange={(next) => {
+            if (typeof next === "string") t3patchSetExplorerFontPx(Number(next));
+          }}
+        >
+          <SelectTrigger size="sm" className="w-22 shrink-0" aria-label="Размер шрифта проводника">
+            <SelectValue>{fontPx} px</SelectValue>
+          </SelectTrigger>
+          <SelectPopup align="end" alignItemWithTrigger={false}>
+            {sizes.map((px) => (
+              <SelectItem hideIndicator key={px} value={String(px)}>
+                {px} px
+              </SelectItem>
+            ))}
+          </SelectPopup>
+        </Select>
+      }
+    />
+  );
+}
