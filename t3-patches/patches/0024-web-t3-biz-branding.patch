---
 apps/web/index.html                  | 6 +++---
 apps/web/public/manifest.webmanifest | 2 ++
 apps/web/src/branding.ts             | 5 +++--
 3 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/apps/web/index.html b/apps/web/index.html
index c2d1647424..72ca49fce0 100644
--- a/apps/web/index.html
+++ b/apps/web/index.html
@@ -477,13 +477,13 @@
         cursor: pointer;
       }
     </style>
-    <title>T3 Code (Alpha)</title>
+    <title>T3 Biz</title>
   </head>
   <body>
     <div id="root">
       <div id="boot-shell">
-        <div id="boot-shell-card" aria-label="T3 Code splash screen">
-          <img id="boot-shell-logo" src="/apple-touch-icon.png" alt="T3 Code" />
+        <div id="boot-shell-card" aria-label="T3 Biz">
+          <img id="boot-shell-logo" src="/apple-touch-icon.png" alt="T3 Biz" />
         </div>
       </div>
     </div>
diff --git a/apps/web/public/manifest.webmanifest b/apps/web/public/manifest.webmanifest
index 92443e15f8..f32eb04e84 100644
--- a/apps/web/public/manifest.webmanifest
+++ b/apps/web/public/manifest.webmanifest
@@ -1,5 +1,7 @@
 {
   "id": "/",
+  "name": "T3 Biz",
+  "short_name": "T3 Biz",
   "start_url": "/",
   "scope": "/",
   "display": "standalone",
diff --git a/apps/web/src/branding.ts b/apps/web/src/branding.ts
index 7fc57cf0d0..dc011ee7ad 100644
--- a/apps/web/src/branding.ts
+++ b/apps/web/src/branding.ts
@@ -16,11 +16,12 @@ export const HOSTED_APP_CHANNEL =
   hostedAppChannel === "latest" || hostedAppChannel === "nightly" ? hostedAppChannel : null;
 export const HOSTED_APP_CHANNEL_LABEL =
   HOSTED_APP_CHANNEL === "nightly" ? "Nightly" : HOSTED_APP_CHANNEL === "latest" ? "Latest" : null;
-export const APP_BASE_NAME = injectedDesktopAppBranding?.baseName ?? "T3 Code";
+// t3-patch: своя редакция — T3 Biz (рабочее место для бизнес-задач, не для кода)
+export const APP_BASE_NAME = injectedDesktopAppBranding?.baseName ?? "T3 Biz";
 export const APP_STAGE_LABEL =
   injectedDesktopAppBranding?.stageLabel ??
   HOSTED_APP_CHANNEL_LABEL ??
-  (import.meta.env.DEV ? "Dev" : "Alpha");
+  (import.meta.env.DEV ? "Dev" : "Latest"); // t3-patch: без «(Alpha)» в названии
 export const APP_DISPLAY_NAME =
   injectedDesktopAppBranding?.displayName ??
   formatAppDisplayName({ baseName: APP_BASE_NAME, stageLabel: APP_STAGE_LABEL });
