@@ -0,0 +1,55 @@
+/**
+ * t3-patch: меню проводника на пустом месте дерева — для корня проекта.
+ *
+ * Меню «Загрузить сюда», «Новая папка» открывалось только на строке папки. В пустом проекте
+ * строк нет, и загрузить первый файл было нельзя. Теперь правая кнопка (или долгое нажатие на
+ * телефоне — useT3patchTouchMenu шлёт тот же contextmenu) на свободном месте дерева открывает
+ * меню корня: загрузка, новая папка, полученные через «Поделиться».
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { type RefObject, useEffect, useRef } from "react";
+
+import { readLocalApi } from "~/localApi";
+import { handleT3PatchFileMenu, t3patchRootMenuItems } from "./fileActions";
+
+const TREE_TAG = "file-tree-container";
+
+function isEmptyTreeArea(event: Event): boolean {
+  let insideTree = false;
+  for (const node of event.composedPath()) {
+    if (!(node instanceof HTMLElement)) continue;
+    if (node.hasAttribute("data-item-path")) return false; // строка — у неё своё меню
+    if (node.tagName.toLowerCase() === TREE_TAG) insideTree = true;
+  }
+  return insideTree;
+}
+
+export function useT3patchRootMenu(
+  panelRef: RefObject<HTMLElement | null>,
+  input: {
+    readonly environmentId: EnvironmentId;
+    readonly cwd: string;
+    readonly refresh: () => void;
+  },
+): void {
+  const inputRef = useRef(input);
+  inputRef.current = input;
+  useEffect(() => {
+    const panel = panelRef.current;
+    if (!panel) return;
+    const onContextMenu = (event: MouseEvent) => {
+      if (event.defaultPrevented || !isEmptyTreeArea(event)) return;
+      const api = readLocalApi();
+      if (!api) return;
+      event.preventDefault();
+      const { environmentId, cwd, refresh } = inputRef.current;
+      void api.contextMenu
+        .show(t3patchRootMenuItems(), { x: event.clientX, y: event.clientY })
+        .then((clicked) =>
+          handleT3PatchFileMenu(clicked, { cwd, relativePath: "", environmentId, refresh }),
+        );
+    };
+    panel.addEventListener("contextmenu", onContextMenu);
+    return () => panel.removeEventListener("contextmenu", onContextMenu);
+  }, [panelRef]);
+}
