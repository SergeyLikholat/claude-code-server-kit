diff --git a/apps/server/src/textGeneration/TextGenerationPrompts.ts b/apps/server/src/textGeneration/TextGenerationPrompts.ts
index bf572a4bdb..8d573a52c3 100644
--- a/apps/server/src/textGeneration/TextGenerationPrompts.ts
+++ b/apps/server/src/textGeneration/TextGenerationPrompts.ts
@@ -311,6 +311,19 @@ function threadTitlePromptSuffix(input: ThreadTitlePromptInput): string {
   return suffix;
 }
 
+// t3-patch: названия тредов по-русски. Раньше это дописывала обёртка над claude
+// (providers.claudeAgent.binaryPath), но с ней T3 не узнаёт способ установки CLI и не даёт
+// обновить его из настроек. Правило теперь в самом запросе — для любого провайдера.
+const T3PATCH_RUSSIAN_TITLE_RULES = `
+
+Additional instructions:
+- Write the title in Russian. Every editorial rule above still applies, including the length limit.
+- 3-7 Russian words, fewer than 40 characters.
+- Use sentence case: capitalize only the first word and proper nouns. Never use English Title Case.
+- Keep file paths, commands, identifiers and proper names in their original form (t3, Multica, n8n, КС-2, openpyxl).
+- Do not transliterate English technical terms that have a settled Russian equivalent; use the Russian one.
+- No trailing punctuation.`;
+
 export function buildThreadTitlePrompt(input: ThreadTitlePromptInput) {
   let prompt: string;
   if (input.previousTitle === undefined) {
@@ -320,6 +333,7 @@ export function buildThreadTitlePrompt(input: ThreadTitlePromptInput) {
     const message = preserveMessageEnd(input.message);
     prompt = `${regenerateThreadTitlePrompt(input.previousTitle)}\n\nThread contents:\n${message}${threadTitlePromptSuffix(input)}`;
   }
+  prompt += T3PATCH_RUSSIAN_TITLE_RULES; // t3-patch
   const outputSchema = Schema.Struct({
     title: Schema.String,
     needsRefinement: Schema.Boolean.pipe(Schema.withDecodingDefault(Effect.succeed(false))),
