diff --git a/apps/web/src/components/sergey/reasoningRu.ts b/apps/web/src/components/sergey/reasoningRu.ts
new file mode 100644
index 0000000000..ead8508532
--- /dev/null
+++ b/apps/web/src/components/sergey/reasoningRu.ts
@@ -0,0 +1,114 @@
+/**
+ * t3-patch: «рассуждения» модели в ленте — по-русски.
+ *
+ * С T3 0.0.45 лента показывает пересказ рассуждений модели; он приходит по-английски. Здесь
+ * тексты собираются в пачку (короткая пауза, чтобы не дёргать сервер на каждую строку),
+ * уходят на сервер (`t3patch.translateReasoning`, sergey/reasoningTranslate.ts) и кэшируются
+ * на странице. Пока перевода нет — показывается оригинал; пишущееся рассуждение не переводится.
+ */
+import type { EnvironmentId } from "@t3tools/contracts";
+import { runAtomCommand, squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import { type ReactNode, useEffect, useSyncExternalStore } from "react";
+
+import { appAtomRegistry } from "~/rpc/atomRegistry";
+import { serverEnvironment } from "~/state/server";
+
+const BATCH_DELAY_MS = 250;
+const RETRY_AFTER_MS = 60_000;
+
+const translations = new Map<string, string>();
+const failedAt = new Map<string, number>();
+const inFlight = new Set<string>();
+const queued = new Map<EnvironmentId, Set<string>>();
+let timer: ReturnType<typeof setTimeout> | null = null;
+let version = 0;
+const listeners = new Set<() => void>();
+
+const notify = () => {
+  version += 1;
+  for (const listener of listeners) listener();
+};
+
+/** Уже русский текст: кириллицы не меньше латиницы (код и пути не считаются). */
+export function t3patchLooksRussian(text: string): boolean {
+  const prose = text.replace(/`[^`]*`/g, " ").replace(/\S*[./\\]\S*/g, " ");
+  const cyr = (prose.match(/[а-яё]/gi) ?? []).length;
+  const lat = (prose.match(/[a-z]/gi) ?? []).length;
+  return cyr >= lat;
+}
+
+async function flush(): Promise<void> {
+  timer = null;
+  const batches = [...queued.entries()];
+  queued.clear();
+  for (const [environmentId, set] of batches) {
+    const texts = [...set];
+    texts.forEach((text) => inFlight.add(text));
+    try {
+      const result = await runAtomCommand(
+        appAtomRegistry,
+        serverEnvironment.t3patchTranslateReasoning,
+        { environmentId, input: { texts } },
+        { reportFailure: false, reportDefect: false },
+      );
+      if (result._tag !== "Success") throw squashAtomCommandFailure(result);
+      texts.forEach((text, index) => {
+        const translated = result.value.translations[index];
+        if (translated) translations.set(text, translated);
+      });
+    } catch {
+      const now = Date.now();
+      texts.forEach((text) => failedAt.set(text, now));
+    } finally {
+      texts.forEach((text) => inFlight.delete(text));
+      notify();
+    }
+  }
+}
+
+function request(environmentId: EnvironmentId, text: string): void {
+  if (translations.has(text) || inFlight.has(text)) return;
+  const failed = failedAt.get(text);
+  if (failed !== undefined && Date.now() - failed < RETRY_AFTER_MS) return;
+  let set = queued.get(environmentId);
+  if (!set) queued.set(environmentId, (set = new Set()));
+  set.add(text);
+  timer ??= setTimeout(() => void flush(), BATCH_DELAY_MS);
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/**
+ * Русский вариант текста рассуждения: перевод, если он уже есть, иначе оригинал (перевод
+ * запрашивается в фоне). `enabled: false` — пока текст ещё пишется.
+ */
+export function useT3patchReasoningRu(
+  environmentId: EnvironmentId | null | undefined,
+  text: string | undefined,
+  enabled = true,
+): string | undefined {
+  useSyncExternalStore(subscribe, () => version);
+  const needs =
+    enabled && !!environmentId && !!text && text.trim().length > 0 && !t3patchLooksRussian(text);
+  useEffect(() => {
+    if (needs && environmentId && text) request(environmentId, text);
+  }, [needs, environmentId, text]);
+  if (!text || !needs) return text;
+  return translations.get(text) ?? text;
+}
+
+/** Обёртка для мест, где текст рисуется в цикле: отдаёт русский вариант в render-функцию. */
+export function T3patchReasoningText(props: {
+  readonly environmentId: EnvironmentId | null | undefined;
+  readonly text: string;
+  readonly enabled?: boolean;
+  readonly children: (text: string) => ReactNode;
+}): ReactNode {
+  const text = useT3patchReasoningRu(props.environmentId, props.text, props.enabled ?? true);
+  return props.children(text ?? props.text);
+}
