+// @effect-diagnostics nodeBuiltinImport:off
+import { mkdtemp } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  t3patchIsRussian,
+  t3patchParseTranslation,
+  t3patchTranslatePrompt,
+  t3patchTranslateReasoning,
+} from "./reasoningTranslate.ts";
+
+describe("перевод рассуждений", () => {
+  it("русский текст узнаётся, английский — нет", () => {
+    expect(t3patchIsRussian("Проверю логи перед перезапуском")).toBe(true);
+    expect(t3patchIsRussian("I should check the logs first")).toBe(false);
+    expect(t3patchIsRussian("Смотрю файл `src/ws.ts` и ws.rpc")).toBe(true);
+  });
+
+  it("ответ модели разбирается только как массив строк нужной длины", () => {
+    expect(t3patchParseTranslation('Вот: ["а", "б"]', 2)).toEqual(["а", "б"]);
+    expect(t3patchParseTranslation('["а"]', 2)).toBeNull();
+    expect(t3patchParseTranslation("не json", 1)).toBeNull();
+    expect(t3patchParseTranslation("[1, 2]", 2)).toBeNull();
+  });
+
+  it("запрос содержит тексты и число ожидаемых строк", () => {
+    const prompt = t3patchTranslatePrompt(["one", "two"]);
+    expect(prompt).toContain('["one","two"]');
+    expect(prompt).toContain("JSON array of 2 strings");
+  });
+
+  it("русские и пустые тексты возвращаются без вызова модели", async () => {
+    const stateDir = await mkdtemp(join(tmpdir(), "t3patch-translate-"));
+    await expect(t3patchTranslateReasoning(stateDir, ["Уже по-русски", "  "])).resolves.toEqual([
+      "Уже по-русски",
+      "  ",
+    ]);
+  });
+});
diff --git a/apps/server/src/sergey/reasoningTranslate.ts b/apps/server/src/sergey/reasoningTranslate.ts
new file mode 100644
index 0000000000..f618fa9c1b
--- /dev/null
+++ b/apps/server/src/sergey/reasoningTranslate.ts
@@ -0,0 +1,152 @@
+/**
+ * t3-patch: перевод «рассуждений» модели на русский (показ в ленте с T3 0.0.45).
+ *
+ * Пересказ рассуждений приходит от модели по-английски. Клиент присылает тексты пачкой, сервер
+ * отдаёт русский перевод. Уже русский текст возвращается как есть. Переводит claude (быстрая
+ * модель) без пользовательских настроек — иначе хуки памяти подмешивались бы в каждый перевод.
+ * Переводы хранятся в `<stateDir>/t3patch-reasoning-ru.json`, ключ — хэш текста: повторно один и
+ * тот же текст не переводится, после перезапуска кэш на месте.
+ */
+// @effect-diagnostics nodeBuiltinImport:off
+// @effect-diagnostics globalTimers:off
+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFile, rename, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const CACHE_FILE = "t3patch-reasoning-ru.json";
+const CACHE_LIMIT = 5_000;
+const BATCH_LIMIT = 12;
+const CALL_TIMEOUT_MS = 90_000;
+const MODEL = process.env.T3PATCH_TRANSLATE_MODEL || "claude-haiku-4-5";
+
+/** Текст уже русский: кириллицы больше, чем латиницы. */
+export function t3patchIsRussian(text: string): boolean {
+  // код в `…` и пути/имена с точкой или слешем не считаются: их не переводят
+  const prose = text.replace(/`[^`]*`/g, " ").replace(/\S*[./\\]\S*/g, " ");
+  const cyr = (prose.match(/[а-яё]/gi) ?? []).length;
+  const lat = (prose.match(/[a-z]/gi) ?? []).length;
+  return cyr >= lat;
+}
+
+const keyOf = (text: string) => createHash("sha256").update(text).digest("hex").slice(0, 32);
+
+let cache: Map<string, string> | null = null;
+let cacheLoad: Promise<Map<string, string>> | null = null;
+
+async function loadCache(stateDir: string): Promise<Map<string, string>> {
+  if (cache) return cache;
+  cacheLoad ??= readFile(join(stateDir, CACHE_FILE), "utf8")
+    .then((raw) => new Map(Object.entries(JSON.parse(raw) as Record<string, string>)))
+    .catch(() => new Map<string, string>());
+  cache = await cacheLoad;
+  return cache;
+}
+
+async function saveCache(stateDir: string, map: Map<string, string>): Promise<void> {
+  while (map.size > CACHE_LIMIT) {
+    const oldest = map.keys().next().value;
+    if (oldest === undefined) break;
+    map.delete(oldest);
+  }
+  const target = join(stateDir, CACHE_FILE);
+  const temp = `${target}.tmp`;
+  await writeFile(temp, JSON.stringify(Object.fromEntries(map)), "utf8");
+  await rename(temp, target);
+}
+
+export function t3patchTranslatePrompt(texts: ReadonlyArray<string>): string {
+  return [
+    "Translate each item of the JSON array below into Russian.",
+    "These are short notes describing an assistant's work in progress.",
+    "Keep code, commands, file paths, identifiers, product names and quoted Russian text unchanged.",
+    "Keep markdown formatting. Do not add, explain or omit anything.",
+    `Return ONLY a JSON array of ${texts.length} strings, in the same order, nothing else.`,
+    "",
+    JSON.stringify(texts),
+  ].join("\n");
+}
+
+/** Разобрать ответ модели: JSON-массив строк нужной длины, иначе null. */
+export function t3patchParseTranslation(output: string, expected: number): string[] | null {
+  const start = output.indexOf("[");
+  const end = output.lastIndexOf("]");
+  if (start < 0 || end <= start) return null;
+  try {
+    const parsed: unknown = JSON.parse(output.slice(start, end + 1));
+    if (!Array.isArray(parsed) || parsed.length !== expected) return null;
+    return parsed.every((item) => typeof item === "string") ? (parsed as string[]) : null;
+  } catch {
+    return null;
+  }
+}
+
+function runClaude(prompt: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(
+      "claude",
+      [
+        "-p",
+        "--model",
+        MODEL,
+        "--setting-sources",
+        "project",
+        "--no-session-persistence",
+        "--disable-slash-commands",
+      ],
+      { cwd: tmpdir(), env: process.env, stdio: ["pipe", "pipe", "pipe"] },
+    );
+    let stdout = "";
+    let stderr = "";
+    const timer = setTimeout(() => child.kill("SIGTERM"), CALL_TIMEOUT_MS);
+    child.stdout.on("data", (chunk) => (stdout += String(chunk)));
+    child.stderr.on("data", (chunk) => (stderr += String(chunk)));
+    child.on("error", (error) => {
+      clearTimeout(timer);
+      reject(error);
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      if (code === 0) resolve(stdout);
+      else reject(new Error(`перевод не удался (код ${code}): ${stderr.trim().slice(-300)}`));
+    });
+    child.stdin.end(prompt);
+  });
+}
+
+// Один вызов модели за раз: перевод — фоновая мелочь, не должен съедать лимит пачкой вызовов.
+let queue: Promise<unknown> = Promise.resolve();
+const serial = <A>(task: () => Promise<A>): Promise<A> => {
+  const next = queue.then(task, task);
+  queue = next.catch(() => undefined);
+  return next;
+};
+
+/** Перевести тексты на русский. Русские и уже переведённые — без вызова модели. */
+export async function t3patchTranslateReasoning(
+  stateDir: string,
+  texts: ReadonlyArray<string>,
+): Promise<string[]> {
+  const map = await loadCache(stateDir);
+  const result = texts.map((text) =>
+    text.trim().length === 0 || t3patchIsRussian(text) ? text : (map.get(keyOf(text)) ?? null),
+  );
+  const missing = [...new Set(texts.filter((_, index) => result[index] === null))];
+  for (let offset = 0; offset < missing.length; offset += BATCH_LIMIT) {
+    const batch = missing.slice(offset, offset + BATCH_LIMIT);
+    await serial(async () => {
+      // за время ожидания очереди тот же текст мог перевести другой запрос
+      const still = batch.filter((text) => !map.has(keyOf(text)));
+      if (still.length === 0) return;
+      const parsed = t3patchParseTranslation(
+        await runClaude(t3patchTranslatePrompt(still)),
+        still.length,
+      );
+      if (!parsed) throw new Error("перевод не удался: модель вернула не тот формат");
+      still.forEach((text, index) => map.set(keyOf(text), parsed[index]!));
+      await saveCache(stateDir, map);
+    });
+  }
+  return texts.map((text, index) => result[index] ?? map.get(keyOf(text)) ?? text);
+}
