+/**
+ * t3-patch: перевод «рассуждений» модели на русский (сервер: apps/server/src/sergey/reasoningTranslate.ts).
+ */
+import * as Rpc from "effect/unstable/rpc/Rpc";
+import * as Schema from "effect/Schema";
+
+import { EnvironmentAuthorizationError } from "./auth.ts";
+
+export class T3patchTranslateError extends Schema.TaggedError<T3patchTranslateError>()(
+  "T3patchTranslateError",
+  { message: Schema.String },
+) {}
+
+export const T3PATCH_TRANSLATE_METHODS = {
+  translateReasoning: "t3patch.translateReasoning",
+} as const;
+
+export const WsT3patchTranslateReasoningRpc = Rpc.make(
+  T3PATCH_TRANSLATE_METHODS.translateReasoning,
+  {
+    payload: Schema.Struct({ texts: Schema.Array(Schema.String) }),
+    success: Schema.Struct({ translations: Schema.Array(Schema.String) }),
+    error: Schema.Union([T3patchTranslateError, EnvironmentAuthorizationError]),
+  },
+);
