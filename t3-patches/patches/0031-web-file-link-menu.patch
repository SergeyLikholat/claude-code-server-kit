@@ -0,0 +1,64 @@
+/**
+ * t3-patch: меню правой кнопки у ссылки на файл в ответе модели — те же действия, что в
+ * приложении: открыть, показать в проводнике, вставить в сообщение, скачать, скопировать путь.
+ *
+ * Файл из базы (`/root/Obsidian/...`) лежит вне папки проекта; сервер (патч 0011, file-info)
+ * переводит такой путь в путь внутри проекта через окно `!Obsidian` и даёт ссылку на скачивание.
+ */
+import { serializeComposerFileLink } from "@t3tools/shared/composerTrigger";
+
+import type { ComposerHandleRef } from "~/composerHandleContext";
+import { toastManager } from "~/components/ui/toast";
+import { fetchT3PatchFileInfo, startDownload } from "./fileActions";
+
+export const T3PATCH_LINK_OPEN = "t3patch-link-open";
+export const T3PATCH_LINK_INSERT = "t3patch-link-insert";
+export const T3PATCH_LINK_DOWNLOAD = "t3patch-link-download";
+
+function reportError(title: string, error: unknown) {
+  toastManager.add({
+    type: "error",
+    title,
+    description: error instanceof Error ? error.message : String(error),
+  });
+}
+
+/** Путь внутри проекта: относительный — как есть, абсолютный — спросить у сервера. */
+async function workspacePath(cwd: string, path: string): Promise<string> {
+  const root = cwd.replace(/\/+$/, "");
+  if (!path.startsWith("/")) return path;
+  if (path.startsWith(`${root}/`)) return path.slice(root.length + 1);
+  return (await fetchT3PatchFileInfo(cwd, path)).relativePath;
+}
+
+export async function t3patchDownloadLinkedFile(cwd: string, path: string): Promise<void> {
+  try {
+    const info = await fetchT3PatchFileInfo(cwd, await workspacePath(cwd, path));
+    if (!info.downloadUrl) throw new Error("Сервер не дал ссылку на файл.");
+    startDownload(info.downloadUrl);
+    toastManager.add({ type: "success", title: "Скачивание началось", description: info.realPath });
+  } catch (error) {
+    reportError("Не удалось скачать", error);
+  }
+}
+
+export async function t3patchInsertLinkedFile(
+  composerRef: ComposerHandleRef | null | undefined,
+  cwd: string,
+  path: string,
+): Promise<void> {
+  const composer = composerRef?.current;
+  if (!composer) {
+    reportError("Не удалось вставить", "Откройте тред этого проекта и повторите.");
+    return;
+  }
+  try {
+    const relative = await workspacePath(cwd, path);
+    const mention = serializeComposerFileLink(relative);
+    if (!composer.insertTextAtEnd(`${mention} `, { ensureLeadingBoundary: true })) {
+      reportError("Не удалось вставить", "Поле ввода сейчас не готово.");
+    }
+  } catch (error) {
+    reportError("Не удалось вставить", error);
+  }
+}
