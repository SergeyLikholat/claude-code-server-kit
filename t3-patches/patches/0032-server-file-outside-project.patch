+/**
+ * Куда ещё смотреть, если файла нет по пути внутри проекта.
+ *
+ * Модель часто даёт путь не от корня проекта, а от папки выше: в проекте `…/katrine/style-work`
+ * ссылка `style-work/a.zip` значит `…/katrine/style-work/a.zip`. Поэтому относительный путь пробуется
+ * от корня проекта и от его родительских папок — вверх до домашней папки пользователя (не выше).
+ * Абсолютный путь — как есть: файл вне проекта, но доступный этому T3, отдаётся (агент того же T3
+ * читает его и так; скачать может только вошедший пользователь).
+ */
+export function t3patchFileCandidates(root: string, requested: string, home: string): string[] {
+  if (NodePath.isAbsolute(requested)) return [NodePath.normalize(requested)];
+  const clean = requested.replace(/^\.\/+/, "");
+  const candidates = [NodePath.join(root, clean)];
+  let dir = root;
+  while (isWithin(home, dir) && dir !== home) {
+    dir = NodePath.dirname(dir);
+    candidates.push(NodePath.join(dir, clean));
+  }
+  return [...new Set(candidates)];
+}
+
+async function describeFile(absolutePath: string, root: string) {
+  const realTarget = await realpath(absolutePath);
+  const stats = await stat(realTarget);
+  const mounts = await readMounts();
+  const realRoot = await realpath(root).catch(() => root);
+  return {
+    absolutePath,
+    realPath: resolveBindMounts(realTarget, mounts),
+    relativePath: isWithin(realRoot, realTarget)
+      ? NodePath.relative(realRoot, realTarget)
+      : absolutePath,
+    isDirectory: stats.isDirectory(),
+    size: stats.size,
+    mtimeMs: stats.mtimeMs,
+    downloadUrl: stats.isFile()
+      ? `${T3PATCH_FILE_ROUTE_PREFIX}/${issueFileToken(realTarget)}/${encodeURIComponent(
+          NodePath.basename(realTarget),
+        )}`
+      : null,
+    convertUrl:
+      stats.isFile() && isConvertibleToDocx(realTarget)
+        ? `${T3PATCH_CONVERT_ROUTE_PREFIX}/${issueFileToken(realTarget)}/${encodeURIComponent(
+            `${NodePath.parse(realTarget).name}.docx`,
+          )}`
+        : null,
+  };
+}
+
 const json = (body: unknown, status = 200) =>
   HttpServerResponse.jsonUnsafe(body, { status, headers: { "Cache-Control": "no-store" } });
 
