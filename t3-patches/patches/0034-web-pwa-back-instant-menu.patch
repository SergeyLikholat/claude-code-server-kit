---
 apps/web/src/components/sergey/backToMenu.tsx | 7 +++++++
 apps/web/src/index.css                        | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index 0701015d15..9f235866aa 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -13,6 +13,9 @@ import { useEffect, useState } from "react";
 
 import { useSidebar } from "../ui/sidebar";
 
+/** Сколько держится режим «без анимации»: дольше выезда меню (200 мс), с запасом. */
+const INSTANT_SHEET_MS = 600;
+
 const THREAD_ROUTE_IDS = new Set(["/_chat/$environmentId/$threadId", "/_chat/draft/$draftId"]);
 
 function useStandalonePwa(): boolean {
@@ -37,6 +40,10 @@ export function T3patchBackToMenu(): null {
     enableBeforeUnload: false,
     shouldBlockFn: ({ current, action }) => {
       if (action !== "BACK" || !THREAD_ROUTE_IDS.has(String(current.routeId))) return false;
+      // Жест «назад» на iPhone уже проиграл свою анимацию — меню появляется сразу, без второй.
+      const root = document.documentElement;
+      root.dataset.t3patchInstantSheet = "true";
+      window.setTimeout(() => root.removeAttribute("data-t3patch-instant-sheet"), INSTANT_SHEET_MS);
       setOpenMobile(true);
       return true;
     },
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index d1ca0f4cf6..bec27a9b87 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2235,3 +2235,9 @@ code {
 .composer-tiptap li[data-checked] > div > p {
   margin: 0;
 }
+
+/* t3-patch: меню после жеста «назад» в PWA — без своей анимации (см. sergey/backToMenu.tsx) */
+html[data-t3patch-instant-sheet="true"] [data-slot="sidebar"][data-mobile="true"],
+html[data-t3patch-instant-sheet="true"] [data-slot="sheet-backdrop"] {
+  transition: none !important;
+}
