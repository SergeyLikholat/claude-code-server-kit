diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index 9f235866aa..441e8f1281 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -3,8 +3,12 @@
  *
  * Штатно «назад» в PWA — это «назад» браузера: возврат на прошлую открытую страницу, то есть
  * на предыдущий тред, и казалось, что открылась какая-то другая сессия. Теперь в треде (или
- * в черновике нового) «назад» перехватывается и открывает боковое меню со списком. Если меню
- * уже открыто — «назад» работает как обычно.
+ * в черновике нового) «назад» открывает боковое меню со списком. Если меню уже открыто —
+ * «назад» работает как обычно.
+ *
+ * Переход назад не отменяем: отмена в роутере — это history.go(1), и iPhone анимирует этот шаг
+ * вперёд вторым быстрым проездом. Пусть «назад» проходит, а меню сразу открывается поверх
+ * прошлой страницы: во время свайпа iPhone и так показывает её снимок с открытым меню.
  *
  * Только установленная PWA на узком экране: в обычной вкладке браузера «назад» не трогаем.
  */
@@ -45,7 +49,7 @@ export function T3patchBackToMenu(): null {
       root.dataset.t3patchInstantSheet = "true";
       window.setTimeout(() => root.removeAttribute("data-t3patch-instant-sheet"), INSTANT_SHEET_MS);
       setOpenMobile(true);
-      return true;
+      return false;
     },
   });
   return null;
