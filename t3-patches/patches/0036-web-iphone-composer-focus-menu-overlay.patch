---
 apps/web/src/components/chat/ChatComposer.tsx |  7 +++++--
 apps/web/src/index.css                        | 14 ++++++++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/components/chat/ChatComposer.tsx b/apps/web/src/components/chat/ChatComposer.tsx
index f0383dbaf1..af9530394b 100644
--- a/apps/web/src/components/chat/ChatComposer.tsx
+++ b/apps/web/src/components/chat/ChatComposer.tsx
@@ -3903,10 +3903,13 @@ export const ChatComposer = memo(function ChatComposer(props: ChatComposerProps)
       window.cancelAnimationFrame(mobileComposerExpandReleaseFrameRef.current);
     }
     mobileComposerExpandInFlightRef.current = true;
-    setIsComposerFocused(true);
+    // t3-patch: фокус — прямо в обработчике касания. iPhone открывает клавиатуру только на
+    // focus() внутри жеста; через requestAnimationFrame фокус молча игнорировался, и поле
+    // приходилось нажимать второй раз. flushSync раскрывает редактор до вызова focus().
+    flushSync(() => setIsComposerFocused(true));
+    composerEditorRef.current?.focusAtEnd();
     mobileComposerExpandFrameRef.current = window.requestAnimationFrame(() => {
       mobileComposerExpandFrameRef.current = null;
-      composerEditorRef.current?.focusAtEnd();
       mobileComposerExpandReleaseFrameRef.current = window.requestAnimationFrame(() => {
         mobileComposerExpandReleaseFrameRef.current = null;
         mobileComposerExpandInFlightRef.current = false;
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index bec27a9b87..d66bbae1a8 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2241,3 +2241,17 @@ html[data-t3patch-instant-sheet="true"] [data-slot="sidebar"][data-mobile="true"
 html[data-t3patch-instant-sheet="true"] [data-slot="sheet-backdrop"] {
   transition: none !important;
 }
+
+/* t3-patch: пока мобильное меню открыто (оно во весь экран), плавающие кнопки страницы поверх него
+   не показываем — иначе кнопка меню двоится со своей кнопкой в шапке меню, а папка висит сверху.
+   Подложку меню без размытия: под меню во весь экран её не видно, а backdrop-filter в Safari на
+   iPhone даёт короткие чёрные кадры. */
+html:has([data-slot="sidebar"][data-mobile="true"][data-open])
+  :is([data-sidebar-control], [data-workspace-titlebar-controls]) {
+  visibility: hidden;
+}
+html:has([data-slot="sidebar"][data-mobile="true"]) [data-slot="sheet-backdrop"] {
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  background: transparent;
+}
-- 
