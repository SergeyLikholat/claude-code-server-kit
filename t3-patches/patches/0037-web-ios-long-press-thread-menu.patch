diff --git a/apps/web/src/components/sergey/iosLongPressMenu.tsx b/apps/web/src/components/sergey/iosLongPressMenu.tsx
new file mode 100644
index 0000000000..5d9ee48320
--- /dev/null
+++ b/apps/web/src/components/sergey/iosLongPressMenu.tsx
@@ -0,0 +1,95 @@
+/**
+ * t3-patch: долгое нажатие на тред в списке на iPhone открывает меню треда.
+ *
+ * Меню строки открывается событием contextmenu (правая кнопка мыши). Android при удержании
+ * пальца сам присылает contextmenu, а Safari на iPhone — нет: удержание просто начинало
+ * прокрутку списка. Здесь: удержание 500 мс без сдвига внутри бокового меню → contextmenu на
+ * той строке, что под пальцем, плюс отмена следующего «клика» (иначе после меню открылся бы тред).
+ *
+ * Только iPhone/iPad: на Android своё событие уже есть, и меню открылось бы дважды.
+ */
+import { useEffect } from "react";
+
+const HOLD_MS = 500;
+const MOVE_TOLERANCE_PX = 10;
+const SIDEBAR_SELECTOR = '[data-slot="sidebar"]';
+
+function isIosTouchDevice(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
+export function T3patchIosLongPressMenu(): null {
+  useEffect(() => {
+    if (!isIosTouchDevice()) return;
+    let timer: ReturnType<typeof setTimeout> | null = null;
+    let start: { x: number; y: number } | null = null;
+    let fired = false;
+
+    const cancel = () => {
+      if (timer !== null) clearTimeout(timer);
+      timer = null;
+      start = null;
+    };
+    const onTouchStart = (event: TouchEvent) => {
+      fired = false;
+      cancel();
+      if (event.touches.length !== 1) return;
+      const target = event.target;
+      if (!(target instanceof Element) || !target.closest(SIDEBAR_SELECTOR)) return;
+      const touch = event.touches[0]!;
+      const point = { x: touch.clientX, y: touch.clientY };
+      start = point;
+      timer = setTimeout(() => {
+        timer = null;
+        fired = true;
+        target.dispatchEvent(
+          new MouseEvent("contextmenu", {
+            bubbles: true,
+            cancelable: true,
+            composed: true,
+            clientX: point.x,
+            clientY: point.y,
+            button: 2,
+          }),
+        );
+      }, HOLD_MS);
+    };
+    const onTouchMove = (event: TouchEvent) => {
+      if (!start || timer === null) return;
+      const touch = event.touches[0];
+      if (!touch) return cancel();
+      if (
+        Math.abs(touch.clientX - start.x) > MOVE_TOLERANCE_PX ||
+        Math.abs(touch.clientY - start.y) > MOVE_TOLERANCE_PX
+      ) {
+        cancel();
+      }
+    };
+    const onTouchEnd = (event: TouchEvent) => {
+      cancel();
+      if (fired) event.preventDefault(); // не превращать удержание в нажатие на тред
+    };
+    const swallowClickAfterMenu = (event: MouseEvent) => {
+      if (!fired) return;
+      fired = false;
+      event.preventDefault();
+      event.stopPropagation();
+    };
+
+    document.addEventListener("touchstart", onTouchStart, { capture: true, passive: true });
+    document.addEventListener("touchmove", onTouchMove, { capture: true, passive: true });
+    document.addEventListener("touchend", onTouchEnd, { capture: true });
+    document.addEventListener("touchcancel", cancel, { capture: true });
+    document.addEventListener("click", swallowClickAfterMenu, true);
+    return () => {
+      cancel();
+      document.removeEventListener("touchstart", onTouchStart, { capture: true });
+      document.removeEventListener("touchmove", onTouchMove, { capture: true });
+      document.removeEventListener("touchend", onTouchEnd, { capture: true });
+      document.removeEventListener("touchcancel", cancel, { capture: true });
+      document.removeEventListener("click", swallowClickAfterMenu, true);
+    };
+  }, []);
+  return null;
+}
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index d66bbae1a8..c31b3534e9 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2255,3 +2255,15 @@ html:has([data-slot="sidebar"][data-mobile="true"]) [data-slot="sheet-backdrop"]
   -webkit-backdrop-filter: none;
   background: transparent;
 }
+
+/* t3-patch: на iPhone удержание пальца на треде — наше меню (sergey/iosLongPressMenu.tsx),
+   а не выделение текста и системная лупа. */
+[data-slot="sidebar"][data-mobile="true"] {
+  -webkit-touch-callout: none;
+  -webkit-user-select: none;
+  user-select: none;
+}
+[data-slot="sidebar"][data-mobile="true"] :is(input, textarea, [contenteditable="true"]) {
+  -webkit-user-select: text;
+  user-select: text;
+}
