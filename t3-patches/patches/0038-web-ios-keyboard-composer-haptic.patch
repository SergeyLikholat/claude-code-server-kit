diff --git a/apps/web/src/components/sergey/iosKeyboardViewport.tsx b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
new file mode 100644
index 0000000000..a76cd569fe
--- /dev/null
+++ b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
@@ -0,0 +1,57 @@
+/**
+ * t3-patch: на iPhone клавиатура не закрывает поле ввода.
+ *
+ * Android Chrome при появлении клавиатуры сам ужимает страницу (interactive-widget=resizes-content
+ * в meta viewport). Safari на iPhone эту настройку не знает: клавиатура ложится поверх страницы,
+ * и поле ввода внизу оказывается под ней. Здесь: высота видимой части (visualViewport) → CSS-
+ * переменная --t3patch-vvh, приложение ужимается до неё (index.css), поле встаёт над клавиатурой.
+ *
+ * Только iPhone/iPad.
+ */
+import { useEffect } from "react";
+
+/** Разница высот больше этого — значит, открыта клавиатура, а не мелькнула панель Safari. */
+const KEYBOARD_MIN_PX = 80;
+
+function isIosTouchDevice(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
+export function T3patchIosKeyboardViewport(): null {
+  useEffect(() => {
+    const viewport = window.visualViewport;
+    if (!viewport || !isIosTouchDevice()) return;
+    const root = document.documentElement;
+    let frame: number | null = null;
+
+    const apply = () => {
+      frame = null;
+      const keyboardOpen = window.innerHeight - viewport.height > KEYBOARD_MIN_PX;
+      if (!keyboardOpen) {
+        root.removeAttribute("data-t3patch-kb");
+        root.style.removeProperty("--t3patch-vvh");
+        return;
+      }
+      root.style.setProperty("--t3patch-vvh", `${Math.round(viewport.height)}px`);
+      root.setAttribute("data-t3patch-kb", "true");
+      // Safari сдвигает страницу вверх, чтобы показать поле; приложение уже ужато — сдвиг не нужен.
+      if (window.scrollY !== 0) window.scrollTo(0, 0);
+    };
+    const schedule = () => {
+      if (frame === null) frame = window.requestAnimationFrame(apply);
+    };
+
+    viewport.addEventListener("resize", schedule);
+    viewport.addEventListener("scroll", schedule);
+    apply();
+    return () => {
+      if (frame !== null) window.cancelAnimationFrame(frame);
+      viewport.removeEventListener("resize", schedule);
+      viewport.removeEventListener("scroll", schedule);
+      root.removeAttribute("data-t3patch-kb");
+      root.style.removeProperty("--t3patch-vvh");
+    };
+  }, []);
+  return null;
+}
diff --git a/apps/web/src/components/sergey/iosLongPressMenu.tsx b/apps/web/src/components/sergey/iosLongPressMenu.tsx
