--- /dev/null
+++ b/apps/web/src/components/sergey/backFlashDiag.tsx
@@ -0,0 +1,135 @@
+/**
+ * t3-patch, ВРЕМЕННО: замер «чёрного моргания» при свайпе назад в PWA на iPhone.
+ *
+ * После перехода назад 2 секунды пишет шкалу событий (мс от начала): смена адреса, открытие
+ * меню, изменения размеров окна и видимой части, уход страницы в фон и возврат, смена
+ * theme-color, долгие кадры (> LONG_FRAME_MS — на таком кадре и может мелькать фон). Итог
+ * держится строкой вверху экрана 10 с, чтобы Сергей успел сделать скриншот.
+ *
+ * Только iPhone/iPad. Убрать после разбора (вместе со строкой в AppSidebarLayout).
+ */
+import { useEffect } from "react";
+
+const RECORD_MS = 2000;
+const SHOW_MS = 10_000;
+const LONG_FRAME_MS = 34;
+
+function isIosTouchDevice(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
+export function T3patchBackFlashDiag(): null {
+  useEffect(() => {
+    if (!isIosTouchDevice()) return;
+    const viewport = window.visualViewport;
+    let t0 = 0;
+    let recording = false;
+    let events: string[] = [];
+    let strip: HTMLDivElement | null = null;
+    let hideTimer: ReturnType<typeof setTimeout> | null = null;
+    let lastPath = location.pathname;
+    // eslint-disable-next-line prefer-const -- задаётся ниже, после обработчиков
+    let observer: MutationObserver;
+
+    const log = (name: string) => {
+      if (!recording) return;
+      events.push(`${Math.round(performance.now() - t0)}${name}`);
+    };
+    const show = () => {
+      if (!strip) {
+        strip = document.createElement("div");
+        strip.style.cssText =
+          "position:fixed;left:0;right:0;top:env(safe-area-inset-top);z-index:2147483647;" +
+          "font:10px/1.3 ui-monospace,monospace;background:#000d;color:#0f0;padding:2px 6px;" +
+          "pointer-events:none;white-space:normal;word-break:break-all";
+        document.body.appendChild(strip);
+      }
+      strip.textContent = `back: ${events.join(" ")}`;
+      if (hideTimer !== null) clearTimeout(hideTimer);
+      hideTimer = setTimeout(() => {
+        strip?.remove();
+        strip = null;
+      }, SHOW_MS);
+    };
+    const watchFrames = () => {
+      let previous = performance.now();
+      const tick = (now: number) => {
+        if (!recording) return;
+        const gap = now - previous;
+        if (gap > LONG_FRAME_MS) log(`·кадр${Math.round(gap)}`);
+        previous = now;
+        requestAnimationFrame(tick);
+      };
+      requestAnimationFrame(tick);
+    };
+    const start = () => {
+      t0 = performance.now();
+      recording = true;
+      events = [`0·назад(${document.visibilityState})`];
+      lastPath = location.pathname;
+      observer.observe(document.body, {
+        childList: true,
+        subtree: true,
+        attributes: true,
+        attributeFilter: ["data-open"],
+      });
+      watchFrames();
+      setTimeout(() => {
+        recording = false;
+        observer.disconnect();
+        show();
+      }, RECORD_MS);
+    };
+
+    const onPopState = () => start();
+    const onResize = () => log(`·окно${window.innerHeight}`);
+    const onViewport = () => log(`·вид${Math.round(viewport?.height ?? 0)}`);
+    const onPageShow = (event: PageTransitionEvent) =>
+      log(`·pageshow${event.persisted ? "(bf)" : ""}`);
+    const onPageHide = (event: PageTransitionEvent) =>
+      log(`·pagehide${event.persisted ? "(bf)" : ""}`);
+    const onVisibility = () => log(`·vis:${document.visibilityState}`);
+
+    observer = new MutationObserver(() => {
+      if (!recording) return;
+      if (location.pathname !== lastPath) {
+        lastPath = location.pathname;
+        log(`·адрес`);
+      }
+      const menuOpen = Boolean(
+        document.querySelector('[data-slot="sidebar"][data-mobile="true"][data-open]'),
+      );
+      const marker = menuOpen ? "меню+" : "меню-";
+      if (!events.some((entry) => entry.endsWith(marker))) log(`·${marker}`);
+    });
+    const themeObserver = new MutationObserver(() => {
+      const color = document.querySelector('meta[name="theme-color"]')?.getAttribute("content");
+      log(`·цвет${color ?? ""}`);
+    });
+
+    window.addEventListener("popstate", onPopState);
+    window.addEventListener("resize", onResize);
+    viewport?.addEventListener("resize", onViewport);
+    window.addEventListener("pageshow", onPageShow);
+    window.addEventListener("pagehide", onPageHide);
+    document.addEventListener("visibilitychange", onVisibility);
+    for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
+      themeObserver.observe(meta, { attributes: true, attributeFilter: ["content"] });
+    }
+    return () => {
+      recording = false;
+      if (hideTimer !== null) clearTimeout(hideTimer);
+      strip?.remove();
+      observer.disconnect();
+      themeObserver.disconnect();
+      window.removeEventListener("popstate", onPopState);
+      window.removeEventListener("resize", onResize);
+      viewport?.removeEventListener("resize", onViewport);
+      window.removeEventListener("pageshow", onPageShow);
+      window.removeEventListener("pagehide", onPageHide);
+      document.removeEventListener("visibilitychange", onVisibility);
+    };
+  }, []);
+  return null;
+}
