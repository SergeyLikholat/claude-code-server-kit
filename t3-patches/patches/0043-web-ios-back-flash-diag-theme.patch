diff --git a/apps/web/src/components/sergey/backFlashDiag.tsx b/apps/web/src/components/sergey/backFlashDiag.tsx
index f9249434db..895d8123c2 100644
--- a/apps/web/src/components/sergey/backFlashDiag.tsx
+++ b/apps/web/src/components/sergey/backFlashDiag.tsx
@@ -66,7 +66,7 @@ export function T3patchBackFlashDiag(): null {
     const start = () => {
       t0 = performance.now();
       recording = true;
-      events = [`0·назад(${document.visibilityState})`];
+      events = [`s44 0·назад(${document.visibilityState})`];
       lastPath = location.pathname;
       observer.observe(document.body, {
         childList: true,
@@ -103,10 +103,36 @@ export function T3patchBackFlashDiag(): null {
       const marker = menuOpen ? "меню+" : "меню-";
       if (!events.some((entry) => entry.endsWith(marker))) log(`·${marker}`);
     });
-    const themeObserver = new MutationObserver(() => {
-      const color = document.querySelector('meta[name="theme-color"]')?.getAttribute("content");
-      log(`·цвет${color ?? ""}`);
+    const themeObserver = new MutationObserver((records) => {
+      const metas = document.querySelectorAll('meta[name="theme-color"]').length;
+      for (const record of records) {
+        const now = (record.target as Element).getAttribute("content");
+        log(
+          `·цвет[${metas}]${record.oldValue ?? "∅"}→${now ?? ""}${lastThemeWriter ? `@${lastThemeWriter}` : ""}`,
+        );
+      }
     });
+    // Кто пишет theme-color: имя функции из стека записи (на iPhone видно в строке).
+    let lastThemeWriter = "";
+    const originalSetAttribute = Element.prototype.setAttribute;
+    Element.prototype.setAttribute = function (this: Element, name: string, value: string) {
+      if (
+        this.tagName === "META" &&
+        name === "content" &&
+        this.getAttribute("name") === "theme-color"
+      ) {
+        const frame = (new Error().stack ?? "").split("\n")[1] ?? "";
+        // Safari: «имя@https://…/assets/файл.js:1:12345» → «имя@файл.js:12345».
+        const name =
+          frame
+            .replace(/^\s*at\s+/, "")
+            .split("@")[0]
+            ?.slice(0, 12) ?? "";
+        const where = /([^/]+\.js):\d+:(\d+)/.exec(frame);
+        lastThemeWriter = `${name}@${where ? `${where[1]}:${where[2]}` : "?"}`;
+      }
+      return originalSetAttribute.call(this, name, value);
+    };
 
     window.addEventListener("popstate", onPopState);
     window.addEventListener("resize", onResize);
@@ -115,7 +141,11 @@ export function T3patchBackFlashDiag(): null {
     window.addEventListener("pagehide", onPageHide);
     document.addEventListener("visibilitychange", onVisibility);
     for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
-      themeObserver.observe(meta, { attributes: true, attributeFilter: ["content"] });
+      themeObserver.observe(meta, {
+        attributes: true,
+        attributeFilter: ["content"],
+        attributeOldValue: true,
+      });
     }
     return () => {
       recording = false;
@@ -123,6 +153,7 @@ export function T3patchBackFlashDiag(): null {
       strip?.remove();
       observer.disconnect();
       themeObserver.disconnect();
+      Element.prototype.setAttribute = originalSetAttribute;
       window.removeEventListener("popstate", onPopState);
       window.removeEventListener("resize", onResize);
       viewport?.removeEventListener("resize", onViewport);
