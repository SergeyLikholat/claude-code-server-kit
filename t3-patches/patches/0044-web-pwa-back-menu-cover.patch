   transform: scale(0.96);
   background-color: color-mix(in oklab, var(--foreground) 9%, transparent);
 }
+
+/* t3-patch: после жеста «назад» в PWA прошлая страница скрыта, пока не откроется меню
+   (sergey/backToMenu.tsx) — иначе мелькала её долгая отрисовка. */
+html[data-t3patch-back-menu="true"] [data-slot="sidebar-inset"] {
+  visibility: hidden;
+}
