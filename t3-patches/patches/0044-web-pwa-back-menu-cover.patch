diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index 441e8f1281..93715d5da9 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -14,6 +14,7 @@
  */
 import { useBlocker } from "@tanstack/react-router";
 import { useEffect, useState } from "react";
+import { flushSync } from "react-dom";
 
 import { useSidebar } from "../ui/sidebar";
 
@@ -36,6 +37,33 @@ function useStandalonePwa(): boolean {
   return standalone;
 }
 
+const MENU_OPEN_SELECTOR = '[data-slot="sidebar"][data-mobile="true"][data-open]';
+/** Дольше этого прошлую страницу не прячем, даже если меню так и не открылось. */
+const BACK_COVER_MAX_MS = 1500;
+/** Когда проверить, что меню открыто, и при необходимости открыть снова. */
+const MENU_RETRY_MS = [50, 300, 800];
+
+function waitForMenu(reopen: () => void): void {
+  const root = document.documentElement;
+  const started = performance.now();
+  const timers = MENU_RETRY_MS.map((delay) =>
+    window.setTimeout(() => {
+      if (!document.querySelector(MENU_OPEN_SELECTOR)) reopen();
+    }, delay),
+  );
+  const check = () => {
+    const open = document.querySelector(MENU_OPEN_SELECTOR) !== null;
+    if (open || performance.now() - started > BACK_COVER_MAX_MS) {
+      // Ещё кадр, чтобы меню успело нарисоваться, — потом показываем страницу под ним.
+      requestAnimationFrame(() => root.removeAttribute("data-t3patch-back-menu"));
+      if (!open) for (const timer of timers) window.clearTimeout(timer);
+      return;
+    }
+    requestAnimationFrame(check);
+  };
+  requestAnimationFrame(check);
+}
+
 export function T3patchBackToMenu(): null {
   const { isMobile, openMobile, setOpenMobile } = useSidebar();
   const standalone = useStandalonePwa();
@@ -48,7 +76,13 @@ export function T3patchBackToMenu(): null {
       const root = document.documentElement;
       root.dataset.t3patchInstantSheet = "true";
       window.setTimeout(() => root.removeAttribute("data-t3patch-instant-sheet"), INSTANT_SHEET_MS);
-      setOpenMobile(true);
+      // Замер 2026-10-30: иногда меню открывалось только через ~850 мс, а до того была видна
+      // сама прошлая страница с долгой отрисовкой (кадр 142 мс) — это и было «моргание».
+      // Поэтому: меню — синхронно, до отрисовки прошлой страницы; страница под меню скрыта,
+      // пока меню не открылось; если меню закрылось или опоздало — открыть ещё раз.
+      root.dataset.t3patchBackMenu = "true";
+      flushSync(() => setOpenMobile(true));
+      waitForMenu(() => setOpenMobile(true));
       return false;
     },
   });
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
