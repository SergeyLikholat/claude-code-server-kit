---
 apps/web/src/components/sergey/backFlashDiag.tsx | 2 +-
 apps/web/src/components/sergey/backToMenu.tsx    | 9 ++++++++-
 apps/web/src/index.css                           | 7 ++++---
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/apps/web/src/components/sergey/backFlashDiag.tsx b/apps/web/src/components/sergey/backFlashDiag.tsx
index 4de4f6761e..954d0f7f31 100644
--- a/apps/web/src/components/sergey/backFlashDiag.tsx
+++ b/apps/web/src/components/sergey/backFlashDiag.tsx
@@ -75,7 +75,7 @@ export function T3patchBackFlashDiag(): null {
     const start = () => {
       t0 = performance.now();
       recording = true;
-      events = [`s47 0·назад(${document.visibilityState})`];
+      events = [`s48 0·назад(${document.visibilityState})`];
       lastPath = location.pathname;
       observer.observe(document.body, {
         childList: true,
diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index d937c3e36b..35a48d22a9 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -13,7 +13,7 @@
  * Только установленная PWA на узком экране: в обычной вкладке браузера «назад» не трогаем.
  */
 import { useBlocker } from "@tanstack/react-router";
-import { useEffect, useState } from "react";
+import { useEffect, useLayoutEffect, useState } from "react";
 import { flushSync } from "react-dom";
 
 import { useSidebar } from "../ui/sidebar";
@@ -86,6 +86,13 @@ function waitForMenu(reopen: () => void): void {
 export function T3patchBackToMenu(): null {
   const { isMobile, openMobile, setOpenMobile } = useSidebar();
   const standalone = useStandalonePwa();
+  // Метка «мобильное меню открыто» на <html> для правил в index.css (вместо html:has(...),
+  // который Safari перепроверяет при любом изменении страницы — замер: долгая задача ~в 2 раза дольше).
+  useLayoutEffect(() => {
+    const root = document.documentElement;
+    if (isMobile && openMobile) root.setAttribute("data-t3patch-menu-open", "true");
+    else root.removeAttribute("data-t3patch-menu-open");
+  }, [isMobile, openMobile]);
   useEffect(() => {
     if (!standalone || !isMobile) return;
     document.addEventListener("scroll", rememberMenuScroll, { capture: true, passive: true });
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 047d9dc519..538e8a60be 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2243,14 +2243,15 @@ html[data-t3patch-instant-sheet="true"] [data-slot="sheet-backdrop"] {
 }
 
 /* t3-patch: пока мобильное меню открыто (оно во весь экран), плавающие кнопки страницы поверх него
-   не показываем — иначе кнопка меню двоится со своей кнопкой в шапке меню, а папка висит сверху.
+   не показываем (метка data-t3patch-menu-open ставится в sergey/backToMenu.tsx: html:has(...)
+   заставлял Safari перепроверять селектор при любой правке страницы — долгие кадры) — иначе кнопка меню двоится со своей кнопкой в шапке меню, а папка висит сверху.
    Подложку меню без размытия: под меню во весь экран её не видно, а backdrop-filter в Safari на
    iPhone даёт короткие чёрные кадры. */
-html:has([data-slot="sidebar"][data-mobile="true"][data-open])
+html[data-t3patch-menu-open="true"]
   :is([data-sidebar-control], [data-workspace-titlebar-controls]) {
   visibility: hidden;
 }
-html:has([data-slot="sidebar"][data-mobile="true"]) [data-slot="sheet-backdrop"] {
+html[data-t3patch-menu-open="true"] [data-slot="sheet-backdrop"] {
   backdrop-filter: none;
   -webkit-backdrop-filter: none;
   background: transparent;
-- 
2.43.0

