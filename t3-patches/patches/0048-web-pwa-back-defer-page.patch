diff --git a/apps/web/src/components/sergey/backFlashDiag.tsx b/apps/web/src/components/sergey/backFlashDiag.tsx
index 954d0f7f31..6056ba1cd6 100644
--- a/apps/web/src/components/sergey/backFlashDiag.tsx
+++ b/apps/web/src/components/sergey/backFlashDiag.tsx
@@ -75,7 +75,7 @@ export function T3patchBackFlashDiag(): null {
     const start = () => {
       t0 = performance.now();
       recording = true;
-      events = [`s48 0·назад(${document.visibilityState})`];
+      events = [`s49 0·назад(${document.visibilityState})`];
       lastPath = location.pathname;
       observer.observe(document.body, {
         childList: true,
diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index 35a48d22a9..dc744642af 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -38,6 +38,8 @@ function useStandalonePwa(): boolean {
 }
 
 const MENU_OPEN_SELECTOR = '[data-slot="sidebar"][data-mobile="true"][data-open]';
+/** На сколько отложить отрисовку прошлой страницы после жеста «назад» (меню уже на экране). */
+const DEFER_PAGE_RENDER_MS = 350;
 /** Дольше этого прошлую страницу не прячем, даже если меню так и не открылось. */
 const BACK_COVER_MAX_MS = 1500;
 /** Когда проверить, что меню открыто, и при необходимости открыть снова. */
@@ -115,7 +117,12 @@ export function T3patchBackToMenu(): null {
       flushSync(() => setOpenMobile(true));
       restoreMenuScroll();
       waitForMenu(() => setOpenMobile(true));
-      return false;
+      // Замер 2026-10-31: прошлая страница отрисовывается ~230 мс, и эта пауза приходилась ровно
+      // на конец анимации свайпа — рывок. Роутер ждёт ответа: сначала показываем меню (оно
+      // готово, keepMounted), а прошлую страницу он рисует позже, когда на экране всё неподвижно.
+      return new Promise<boolean>((resolve) => {
+        window.setTimeout(() => resolve(false), DEFER_PAGE_RENDER_MS);
+      });
     },
   });
   return null;
