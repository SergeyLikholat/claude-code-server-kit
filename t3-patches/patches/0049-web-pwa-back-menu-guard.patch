diff --git a/apps/web/src/components/sergey/backFlashDiag.tsx b/apps/web/src/components/sergey/backFlashDiag.tsx
index 6056ba1cd6..cfc7cc74c7 100644
--- a/apps/web/src/components/sergey/backFlashDiag.tsx
+++ b/apps/web/src/components/sergey/backFlashDiag.tsx
@@ -75,7 +75,7 @@ export function T3patchBackFlashDiag(): null {
     const start = () => {
       t0 = performance.now();
       recording = true;
-      events = [`s49 0·назад(${document.visibilityState})`];
+      events = [`s50 0·назад(${document.visibilityState})`];
       lastPath = location.pathname;
       observer.observe(document.body, {
         childList: true,
@@ -92,6 +92,8 @@ export function T3patchBackFlashDiag(): null {
     };
 
     const onPopState = () => start();
+    // Запись из других модулей (например, причина закрытия меню в ui/sidebar.tsx).
+    (window as { __t3patchBackLog?: (entry: string) => void }).__t3patchBackLog = log;
     const onResize = () => log(`·окно${window.innerHeight}`);
     const onViewport = () => log(`·вид${Math.round(viewport?.height ?? 0)}`);
     const onPageShow = (event: PageTransitionEvent) =>
diff --git a/apps/web/src/components/sergey/backToMenu.tsx b/apps/web/src/components/sergey/backToMenu.tsx
index dc744642af..b4803f4393 100644
--- a/apps/web/src/components/sergey/backToMenu.tsx
+++ b/apps/web/src/components/sergey/backToMenu.tsx
@@ -38,8 +38,8 @@ function useStandalonePwa(): boolean {
 }
 
 const MENU_OPEN_SELECTOR = '[data-slot="sidebar"][data-mobile="true"][data-open]';
-/** На сколько отложить отрисовку прошлой страницы после жеста «назад» (меню уже на экране). */
-const DEFER_PAGE_RENDER_MS = 350;
+/** Сколько после жеста «назад» меню защищено от служебного закрытия (см. ui/sidebar.tsx). */
+const BACK_GUARD_MS = 1500;
 /** Дольше этого прошлую страницу не прячем, даже если меню так и не открылось. */
 const BACK_COVER_MAX_MS = 1500;
 /** Когда проверить, что меню открыто, и при необходимости открыть снова. */
@@ -117,12 +117,11 @@ export function T3patchBackToMenu(): null {
       flushSync(() => setOpenMobile(true));
       restoreMenuScroll();
       waitForMenu(() => setOpenMobile(true));
-      // Замер 2026-10-31: прошлая страница отрисовывается ~230 мс, и эта пауза приходилась ровно
-      // на конец анимации свайпа — рывок. Роутер ждёт ответа: сначала показываем меню (оно
-      // готово, keepMounted), а прошлую страницу он рисует позже, когда на экране всё неподвижно.
-      return new Promise<boolean>((resolve) => {
-        window.setTimeout(() => resolve(false), DEFER_PAGE_RENDER_MS);
-      });
+      // Запись экрана 2026-10-31: через ~0,3 с после свайпа меню закрывалось на 3 кадра (пустой
+      // экран). Пока стоит метка, меню не закрывается «служебно» (см. ui/sidebar.tsx).
+      root.setAttribute("data-t3patch-back-guard", "true");
+      window.setTimeout(() => root.removeAttribute("data-t3patch-back-guard"), BACK_GUARD_MS);
+      return false;
     },
   });
   return null;
diff --git a/apps/web/src/components/ui/sidebar.tsx b/apps/web/src/components/ui/sidebar.tsx
index a60b28442b..64455ee227 100644
--- a/apps/web/src/components/ui/sidebar.tsx
+++ b/apps/web/src/components/ui/sidebar.tsx
@@ -233,7 +233,25 @@ function Sidebar({
   if (isMobile) {
     return (
       <SidebarInstanceContext value={instanceContextValue}>
-        <Sheet onOpenChange={setOpenMobile} open={openMobile}>
+        <Sheet
+          // t3-patch: после жеста «назад» в PWA (sergey/backToMenu.tsx ставит метку на <html>)
+          // меню нельзя закрыть «служебно» — потерей фокуса (прошлая страница ставит фокус в
+          // своё поле), нажатием мимо, программно. Иначе меню пропадало на 3 кадра и экран был
+          // пустым (запись экрана 2026-10-31). Кнопка, Escape, выбор треда работают как обычно.
+          onOpenChange={(nextOpen, details) => {
+            const reason = (details as { reason?: string } | undefined)?.reason ?? "";
+            const guarded =
+              !nextOpen &&
+              document.documentElement.hasAttribute("data-t3patch-back-guard") &&
+              !["close-press", "escape-key", "trigger-press"].includes(reason);
+            (window as { __t3patchBackLog?: (entry: string) => void }).__t3patchBackLog?.(
+              `·закрыто:${reason || "?"}${guarded ? "(нет)" : ""}`,
+            );
+            if (guarded) return;
+            setOpenMobile(nextOpen);
+          }}
+          open={openMobile}
+        >
           <SheetPopup
             // t3-patch: меню не удаляется при закрытии, а скрывается. Иначе каждое открытие
             // (в том числе после свайпа «назад» на iPhone) заново строило весь список тредов —
