diff --git a/apps/web/src/components/AppSidebarLayout.tsx b/apps/web/src/components/AppSidebarLayout.tsx
index 8e426f34e2..2cc2d52aa0 100644
--- a/apps/web/src/components/AppSidebarLayout.tsx
+++ b/apps/web/src/components/AppSidebarLayout.tsx
@@ -57,7 +57,6 @@ import { Tooltip, TooltipPopup, TooltipTrigger } from "./ui/tooltip";
 import { T3patchBackToMenu } from "./sergey/backToMenu"; // t3-patch: «назад» в PWA → список тредов
 import { T3patchIosLongPressMenu } from "./sergey/iosLongPressMenu"; // t3-patch: удержание на iPhone → меню треда
 import { T3patchIosKeyboardViewport } from "./sergey/iosKeyboardViewport"; // t3-patch: поле ввода над клавиатурой iPhone
-import { T3patchBackFlashDiag } from "./sergey/backFlashDiag"; // t3-patch ВРЕМЕННО: замер моргания при свайпе назад
 
 const MACOS_TRAFFIC_LIGHTS_LEFT_INSET = "var(--desktop-window-controls-inset, 90px)";
 
@@ -339,7 +338,6 @@ export function AppSidebarLayout({ children }: { children: ReactNode }) {
         <T3patchBackToMenu />
         <T3patchIosLongPressMenu />
         <T3patchIosKeyboardViewport />
-        <T3patchBackFlashDiag />
       </SidebarProvider>
     </PanelAnimationSuppressionProvider>
   );
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 538e8a60be..811ffa8ad2 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2241,6 +2241,15 @@ html[data-t3patch-instant-sheet="true"] [data-slot="sidebar"][data-mobile="true"
 html[data-t3patch-instant-sheet="true"] [data-slot="sheet-backdrop"] {
   transition: none !important;
 }
+/* Запись экрана 2026-10-31: в первом кадре открытия у Base UI стоит data-starting-style —
+   прозрачность 0 и сдвиг влево (точка старта анимации). Без анимации этот кадр оставался
+   пустым, и если на него приходилась подмена снимка iPhone живой страницей — 1–2 пустых кадра. */
+html[data-t3patch-instant-sheet="true"]
+  [data-slot="sidebar"][data-mobile="true"][data-starting-style],
+html[data-t3patch-instant-sheet="true"] [data-slot="sheet-backdrop"][data-starting-style] {
+  opacity: 1 !important;
+  translate: none !important;
+}
 
