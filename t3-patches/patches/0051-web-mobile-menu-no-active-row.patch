diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 811ffa8ad2..565da4b331 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2303,3 +2303,15 @@ html[data-t3patch-kb="true"] [data-slot="sidebar-inset"] {
 html[data-t3patch-back-menu="true"] [data-slot="sidebar-inset"] {
   visibility: hidden;
 }
+
+/* t3-patch: в мобильном меню текущий тред не подсвечивается. На снимке, который iPhone показывает
+   во время свайпа «назад», подсветки нет, и в момент подмены живой страницей она «выскакивала»
+   (запись экрана 2026-10-31) — выглядело как мусорное моргание строки. */
+[data-slot="sidebar"][data-mobile="true"] [data-testid^="sidebar-row"][aria-current="page"] {
+  background-color: transparent;
+}
+[data-slot="sidebar"][data-mobile="true"]
+  [data-testid^="sidebar-row"][aria-current="page"]
+  .text-foreground {
+  color: var(--color-secondary-label);
+}
