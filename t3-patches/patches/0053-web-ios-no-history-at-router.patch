diff --git a/apps/web/src/components/sergey/iosEdgeSwipe.tsx b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
index 318f567654..af93d760e0 100644
--- a/apps/web/src/components/sergey/iosEdgeSwipe.tsx
+++ b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
@@ -5,14 +5,14 @@
  * страницей. Пять записей экрана (2026-10-31): в момент подмены на 1–3 кадра пусто (сплошной
  * серый/чёрный) — это поведение iOS, правками внутри T3 оно не убиралось. Поэтому:
  *
- *  1. Переходы между тредами не копятся в истории (push → replace): возвращаться iPhone некуда,
- *     и его свайп «назад» со снимками не включается.
+ *  1. Переходы между тредами не копятся в истории (push → replace, t3patchIosNoHistoryStack из
+ *     router.ts): возвращаться iPhone некуда, и его свайп «назад» со снимками не включается.
  *  2. Свайп от левого края двигает меню вслед за пальцем, как в Telegram. Отпустили дальше трети
  *     экрана или резким движением — меню открылось; иначе уехало обратно.
  *
  * Только установленная PWA на iPhone/iPad и узкий экран; Android, браузер и компьютер не трогаем.
  */
-import { useRouter } from "@tanstack/react-router";
+import type { RouterHistory } from "@tanstack/react-router";
 import { useEffect, useRef, useState } from "react";
 import { flushSync } from "react-dom";
 
@@ -35,35 +35,34 @@ function isIosTouchDevice(): boolean {
   return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
 }
 
-function useIosStandalone(): boolean {
-  const [value] = useState(
-    () =>
-      isIosTouchDevice() &&
-      (window.matchMedia?.("(display-mode: standalone)").matches === true ||
-        (navigator as { standalone?: boolean }).standalone === true),
+function isIosStandalone(): boolean {
+  return (
+    isIosTouchDevice() &&
+    (window.matchMedia?.("(display-mode: standalone)").matches === true ||
+      (navigator as { standalone?: boolean }).standalone === true)
   );
+}
+
+function useIosStandalone(): boolean {
+  const [value] = useState(isIosStandalone);
   return value;
 }
 
-/** Переходы не копятся в истории — у iPhone нет «назад», системный свайп не включается. */
-function useNoHistoryStack(enabled: boolean): void {
-  const router = useRouter();
-  useEffect(() => {
-    if (!enabled) return;
-    const history = router.history;
-    const originalPush = history.push;
-    history.push = (...args: Parameters<typeof history.replace>) => history.replace(...args);
-    return () => {
-      history.push = originalPush;
-    };
-  }, [enabled, router]);
+/**
+ * Переходы не копятся в истории — у iPhone нет «назад», системный свайп не включается.
+ * Вызывается при создании роутера (router.ts), до первой навигации: если включать позже,
+ * первый переход при запуске (главная → черновик) успевал попасть в историю, и у iPhone
+ * появлялось куда вернуться (запись экрана 2026-10-31).
+ */
+export function t3patchIosNoHistoryStack(history: RouterHistory): void {
+  if (typeof window === "undefined" || !isIosStandalone()) return;
+  history.push = (...args: Parameters<typeof history.replace>) => history.replace(...args);
 }
 
 export function T3patchIosEdgeSwipe(): null {
   const { isMobile, openMobile, setOpenMobile } = useSidebar();
   const standalone = useIosStandalone();
   const enabled = standalone && isMobile;
-  useNoHistoryStack(enabled);
 
   const openRef = useRef(openMobile);
   openRef.current = openMobile;
diff --git a/apps/web/src/router.ts b/apps/web/src/router.ts
index 4362dd3d70..f70c4ec7c9 100644
--- a/apps/web/src/router.ts
+++ b/apps/web/src/router.ts
@@ -1,8 +1,10 @@
 import { createRouter, RouterHistory } from "@tanstack/react-router";
 
 import { routeTree } from "./routeTree.gen";
+import { t3patchIosNoHistoryStack } from "./components/sergey/iosEdgeSwipe"; // t3-patch
 
 export function getRouter(history: RouterHistory) {
+  t3patchIosNoHistoryStack(history); // t3-patch: iPhone PWA — без истории переходов (свой свайп меню)
   return createRouter({
     routeTree,
     history,
