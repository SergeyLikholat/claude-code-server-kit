---
 .../src/components/sergey/iosEdgeSwipe.tsx    | 30 +++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/apps/web/src/components/sergey/iosEdgeSwipe.tsx b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
index af93d760e0..aadfda2854 100644
--- a/apps/web/src/components/sergey/iosEdgeSwipe.tsx
+++ b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
@@ -28,6 +28,8 @@ const OPEN_FRACTION = 0.33;
 const OPEN_VELOCITY = 0.45;
 const SETTLE_MS = 220;
 const SETTLE_EASING = "cubic-bezier(0.2, 0.8, 0.2, 1)";
+/** Через сколько после закрытия меню снять с него сдвиг (оно к этому времени уже скрыто). */
+const CLEANUP_AFTER_CLOSE_MS = 150;
 const MENU_SELECTOR = '[data-slot="sidebar"][data-mobile="true"]';
 
 function isIosTouchDevice(): boolean {
@@ -85,13 +87,31 @@ export function T3patchIosEdgeSwipe(): null {
       menu.style.transform = `translateX(${offset}px)`;
     };
     const finish = (menu: HTMLElement, open: boolean, width: number) => {
-      menu.style.transition = `transform ${SETTLE_MS}ms ${SETTLE_EASING}`;
+      // Доезд — с !important: на время жеста стоит data-t3patch-instant-sheet, а его правило в
+      // index.css (transition: none !important) иначе гасило анимацию, и меню прыгало скачком
+      // (запись экрана 2026-10-31: недотянутый свайп — меню пропадало «промаргиванием»).
+      menu.style.setProperty(
+        "transition",
+        `transform ${SETTLE_MS}ms ${SETTLE_EASING}`,
+        "important",
+      );
       placeMenu(menu, open ? 0 : -width);
       window.setTimeout(() => {
-        menu.style.transition = "";
-        menu.style.transform = "";
-        if (!open) flushSync(() => setOpenMobile(false));
-        root.removeAttribute("data-t3patch-instant-sheet");
+        if (open) {
+          menu.style.removeProperty("transition");
+          menu.style.transform = "";
+          root.removeAttribute("data-t3patch-instant-sheet");
+          return;
+        }
+        // Отмена: меню уже за краем — сначала закрыть, и только потом снимать сдвиг, иначе
+        // на кадр оно вставало на место целиком.
+        menu.style.removeProperty("transition");
+        flushSync(() => setOpenMobile(false));
+        window.setTimeout(() => {
+          if (gesture?.dragging) return; // уже начат новый свайп — он сам ведёт меню
+          menu.style.transform = "";
+          root.removeAttribute("data-t3patch-instant-sheet");
+        }, CLEANUP_AFTER_CLOSE_MS);
       }, SETTLE_MS + 20);
     };
 
