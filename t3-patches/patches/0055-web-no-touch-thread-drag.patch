---
 apps/web/src/components/Sidebar.pointer.ts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/apps/web/src/components/Sidebar.pointer.ts b/apps/web/src/components/Sidebar.pointer.ts
index f79bc06c64..3ecfa235cb 100644
--- a/apps/web/src/components/Sidebar.pointer.ts
+++ b/apps/web/src/components/Sidebar.pointer.ts
@@ -20,8 +20,11 @@ export class SidebarPointerSensor {
   static activators = [
     {
       eventName: "onPointerDown" as const,
+      // t3-patch: пальцем треды не перетаскиваются. Перетаскивание начиналось со сдвига на 6 px
+      // без удержания, и обычное листание списка на телефоне «брало» строку и бросало её в
+      // «Закреплённые» (2026-11-01). Закрепить на телефоне — через меню треда (удержание).
       handler: ({ nativeEvent }: ReactPointerEvent) =>
-        nativeEvent.isPrimary && nativeEvent.button === 0,
+        nativeEvent.isPrimary && nativeEvent.button === 0 && nativeEvent.pointerType !== "touch",
     },
   ];
   autoScrollEnabled = true;
