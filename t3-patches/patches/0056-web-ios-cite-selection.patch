diff --git a/apps/web/src/components/chat/AssistantSelectionToolbar.tsx b/apps/web/src/components/chat/AssistantSelectionToolbar.tsx
index ff03524cfe..51aac64513 100644
--- a/apps/web/src/components/chat/AssistantSelectionToolbar.tsx
+++ b/apps/web/src/components/chat/AssistantSelectionToolbar.tsx
@@ -18,6 +18,16 @@ import {
 } from "~/lib/selectionActions";
 import { Button } from "../ui/button";
 
+/** t3-patch: сколько выделение на iPhone должно не меняться, чтобы показать кнопку цитаты. */
+const T3PATCH_IOS_SETTLE_MS = 300;
+/** t3-patch: отступ кнопки вниз от последней строки выделения — ниже ручки выделения iOS. */
+const T3PATCH_IOS_BELOW_HANDLE_PX = 28;
+
+function t3patchIsIosTouch(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
 export function AssistantSelectionToolbar({
   viewport,
   threadRef,
@@ -77,6 +87,32 @@ export function AssistantSelectionToolbar({
         }),
       });
     };
+    // t3-patch: на iPhone кнопка цитаты по самому выделению. Штатно она открывается на mouseup, а
+    // при долгом нажатии iOS отменяет касание (pointercancel) и забирает выделение себе — кнопка не
+    // появлялась никогда. Здесь: выделение не менялось T3PATCH_IOS_SETTLE_MS — показать кнопку под
+    // нижней ручкой (сверху выделения системное меню iPhone «Скопировать…»).
+    if (t3patchIsIosTouch()) {
+      let settleTimer: number | null = null;
+      const onSelectionChange = () => {
+        if (settleTimer !== null) window.clearTimeout(settleTimer);
+        settleTimer = window.setTimeout(() => {
+          settleTimer = null;
+          const nativeSelection = window.getSelection();
+          if (!nativeSelection || nativeSelection.isCollapsed || nativeSelection.rangeCount === 0) {
+            clear();
+            return;
+          }
+          const rects = nativeSelection.getRangeAt(0).getClientRects();
+          const last = rects.item(rects.length - 1);
+          update(last ? { x: last.left, y: last.bottom + T3PATCH_IOS_BELOW_HANDLE_PX } : null);
+        }, T3PATCH_IOS_SETTLE_MS);
+      };
+      document.addEventListener("selectionchange", onSelectionChange);
+      return () => {
+        if (settleTimer !== null) window.clearTimeout(settleTimer);
+        document.removeEventListener("selectionchange", onSelectionChange);
+      };
+    }
     const actions = observeSelectionActions({
       element: viewport,
       getActionElement: () => toolbarRef.current,
