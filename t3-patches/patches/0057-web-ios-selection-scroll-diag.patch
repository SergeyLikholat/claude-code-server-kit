--- /dev/null
+++ b/apps/web/src/components/sergey/selectionScrollDiag.tsx
@@ -0,0 +1,157 @@
+/**
+ * t3-patch, ВРЕМЕННО: замер «лента уезжает во время выделения текста» — PWA на iPhone.
+ *
+ * Записи экрана 2026-11-01: при выделении текста в ответе лента плавно сдвигалась на ~45 px,
+ * выделение срывалось. В эмуляторе не повторяется. Здесь: после начала выделения 4 с пишутся
+ * прокрутки ленты (сдвиг, время) и кто их вызвал — код (scrollTop/scrollTo, файл:колонка из стека)
+ * или нет (тогда это сам iOS); изменения высоты сообщений; сброс выделения. Итог — строка вверху.
+ *
+ * Только iPhone/iPad. Убрать после разбора (вместе со строкой в AppSidebarLayout).
+ */
+import { useEffect } from "react";
+
+const RECORD_MS = 4000;
+const SHOW_MS = 12_000;
+
+function isIosTouchDevice(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
+function findTimelineViewport(): HTMLElement | null {
+  const candidates = [...document.querySelectorAll<HTMLElement>("main *")].filter(
+    (element) =>
+      element.scrollHeight > element.clientHeight + 50 &&
+      /auto|scroll/.test(getComputedStyle(element).overflowY),
+  );
+  candidates.sort((a, b) => b.clientHeight - a.clientHeight);
+  return candidates[0] ?? null;
+}
+
+function callerOf(stack: string | undefined): string {
+  const frames = (stack ?? "").split("\n").slice(2, 6);
+  for (const frame of frames) {
+    const match = /([^/]+\.js):\d+:(\d+)/.exec(frame);
+    if (match && !match[1]!.startsWith("selectionScrollDiag")) return `${match[1]}:${match[2]}`;
+  }
+  return "?";
+}
+
+export function T3patchSelectionScrollDiag(): null {
+  useEffect(() => {
+    if (!isIosTouchDevice()) return;
+    let recording = false;
+    let t0 = 0;
+    let events: string[] = [];
+    let strip: HTMLDivElement | null = null;
+    let hideTimer: ReturnType<typeof setTimeout> | null = null;
+    let undo: (() => void) | null = null;
+    let lastCode = { at: 0, who: "" };
+
+    const log = (entry: string) => {
+      if (recording) events.push(`${Math.round(performance.now() - t0)}${entry}`);
+    };
+    const show = () => {
+      if (!strip) {
+        strip = document.createElement("div");
+        strip.style.cssText =
+          "position:fixed;left:0;right:0;top:env(safe-area-inset-top);z-index:2147483647;" +
+          "font:10px/1.3 ui-monospace,monospace;background:#000d;color:#0f0;padding:2px 6px;" +
+          "pointer-events:none;white-space:normal;word-break:break-all";
+        document.body.appendChild(strip);
+      }
+      strip.textContent = `sel: ${events.join(" ").slice(0, 600)}`;
+      if (hideTimer !== null) clearTimeout(hideTimer);
+      hideTimer = setTimeout(() => {
+        strip?.remove();
+        strip = null;
+      }, SHOW_MS);
+    };
+
+    const start = () => {
+      const viewport = findTimelineViewport();
+      if (!viewport) return;
+      recording = true;
+      t0 = performance.now();
+      events = [`0·выд(${viewport.scrollTop | 0})`];
+      let lastTop = viewport.scrollTop;
+      const onScroll = () => {
+        const top = viewport.scrollTop;
+        const byCode = performance.now() - lastCode.at < 50 ? `@${lastCode.who}` : "@ios?";
+        log(`·прокр${Math.round(top - lastTop)}${byCode}`);
+        lastTop = top;
+      };
+      viewport.addEventListener("scroll", onScroll, { passive: true });
+
+      // Кто прокручивает кодом: перехват scrollTop/scrollTo/scrollBy именно у ленты.
+      const proto = Object.getPrototypeOf(viewport) as HTMLElement;
+      const topDescriptor = Object.getOwnPropertyDescriptor(Element.prototype, "scrollTop")!;
+      Object.defineProperty(viewport, "scrollTop", {
+        configurable: true,
+        get() {
+          return topDescriptor.get!.call(this);
+        },
+        set(value: number) {
+          lastCode = { at: performance.now(), who: `top:${callerOf(new Error().stack)}` };
+          topDescriptor.set!.call(this, value);
+        },
+      });
+      const wrap = (name: "scrollTo" | "scrollBy") => {
+        const original = proto[name];
+        (viewport as unknown as Record<string, unknown>)[name] = function (
+          this: HTMLElement,
+          ...args: unknown[]
+        ) {
+          lastCode = { at: performance.now(), who: `${name}:${callerOf(new Error().stack)}` };
+          return (original as (...a: unknown[]) => void).apply(this, args);
+        };
+      };
+      wrap("scrollTo");
+      wrap("scrollBy");
+
+      // Высота сообщений над экраном: её рост сдвигает текст без всякой прокрутки.
+      const resize = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          const box = entry.target.getBoundingClientRect();
+          if (box.bottom < viewport.getBoundingClientRect().top + 40) {
+            log(`·выше${Math.round(entry.contentRect.height)}`);
+          }
+        }
+      });
+      for (const child of viewport.querySelectorAll(":scope > * > *, :scope > * > * > *")) {
+        resize.observe(child);
+      }
+
+      undo = () => {
+        viewport.removeEventListener("scroll", onScroll);
+        delete (viewport as unknown as Record<string, unknown>).scrollTop;
+        delete (viewport as unknown as Record<string, unknown>).scrollTo;
+        delete (viewport as unknown as Record<string, unknown>).scrollBy;
+        resize.disconnect();
+      };
+      setTimeout(() => {
+        recording = false;
+        undo?.();
+        undo = null;
+        show();
+      }, RECORD_MS);
+    };
+
+    let wasSelected = false;
+    const onSelectionChange = () => {
+      const selection = window.getSelection();
+      const selected = !!selection && !selection.isCollapsed;
+      if (selected && !recording) start();
+      if (!selected && wasSelected) log("·сброс");
+      wasSelected = selected;
+    };
+    document.addEventListener("selectionchange", onSelectionChange);
+    return () => {
+      document.removeEventListener("selectionchange", onSelectionChange);
+      undo?.();
+      if (hideTimer !== null) clearTimeout(hideTimer);
+      strip?.remove();
+    };
+  }, []);
+  return null;
+}
