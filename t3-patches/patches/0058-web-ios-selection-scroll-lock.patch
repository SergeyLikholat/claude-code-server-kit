diff --git a/apps/web/src/components/sergey/iosSelectionScrollLock.tsx b/apps/web/src/components/sergey/iosSelectionScrollLock.tsx
new file mode 100644
index 0000000000..dacde63915
--- /dev/null
+++ b/apps/web/src/components/sergey/iosSelectionScrollLock.tsx
@@ -0,0 +1,95 @@
+/**
+ * t3-patch: лента не уезжает, пока на iPhone выделяют текст.
+ *
+ * Замер 2026-11-01 (selectionScrollDiag): пока тянешь ручку выделения, iOS сам подкручивает
+ * ленту по 1–3 px за кадр (автопрокрутка выделения внутри прокручиваемой области) — кода T3 в
+ * этом нет. Текст уезжает из-под пальца, выделение срывается; особенно с левой ручкой.
+ *
+ * Здесь: пока есть выделение, прокрутка ленты, сделанная не пальцем по странице, откатывается.
+ * Ручку выделения iPhone рисует сам, её касания до страницы не доходят — так их и отличаем.
+ * Листание пальцем (и инерция после него) работает как обычно.
+ *
+ * Только iPhone/iPad.
+ */
+import { useEffect } from "react";
+
+/** Сколько после касания страницы прокрутка ещё считается пальцевой (инерция после взмаха). */
+const FINGER_SCROLL_GRACE_MS = 1200;
+
+function isIosTouchDevice(): boolean {
+  const ua = navigator.userAgent;
+  return /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
+}
+
+function scrollableAncestor(node: Node | null): HTMLElement | null {
+  let element: HTMLElement | null =
+    node instanceof HTMLElement ? node : (node?.parentElement ?? null);
+  while (element && element !== document.body) {
+    const overflowY = getComputedStyle(element).overflowY;
+    if (/auto|scroll/.test(overflowY) && element.scrollHeight > element.clientHeight)
+      return element;
+    element = element.parentElement;
+  }
+  return null;
+}
+
+export function T3patchIosSelectionScrollLock(): null {
+  useEffect(() => {
+    if (!isIosTouchDevice()) return;
+    let fingerDown = false;
+    let moved = false;
+    /** До какого момента прокрутка — инерция после взмаха пальцем. */
+    let momentumUntil = 0;
+    let locked: { element: HTMLElement; top: number } | null = null;
+
+    const onTouchStart = () => {
+      fingerDown = true;
+      moved = false;
+    };
+    const onTouchMove = () => {
+      moved = true;
+    };
+    const onTouchEnd = () => {
+      fingerDown = false;
+      // Долгое нажатие (им и создаётся выделение) кончается без движения — инерции нет.
+      momentumUntil = moved ? performance.now() + FINGER_SCROLL_GRACE_MS : 0;
+    };
+
+    const onScroll = (event: Event) => {
+      if (!locked || event.target !== locked.element) return;
+      const byFinger = (fingerDown && moved) || performance.now() < momentumUntil;
+      if (byFinger) {
+        locked.top = locked.element.scrollTop;
+        return;
+      }
+      if (locked.element.scrollTop !== locked.top) locked.element.scrollTop = locked.top;
+    };
+
+    const onSelectionChange = () => {
+      const selection = window.getSelection();
+      if (!selection || selection.isCollapsed || selection.rangeCount === 0) {
+        locked = null;
+        return;
+      }
+      if (locked) return;
+      const element = scrollableAncestor(selection.anchorNode);
+      if (element) locked = { element, top: element.scrollTop };
+    };
+
+    document.addEventListener("touchstart", onTouchStart, { capture: true, passive: true });
+    document.addEventListener("touchmove", onTouchMove, { capture: true, passive: true });
+    document.addEventListener("touchend", onTouchEnd, { capture: true, passive: true });
+    document.addEventListener("touchcancel", onTouchEnd, { capture: true, passive: true });
+    document.addEventListener("scroll", onScroll, { capture: true, passive: true });
+    document.addEventListener("selectionchange", onSelectionChange);
+    return () => {
+      document.removeEventListener("touchstart", onTouchStart, { capture: true });
+      document.removeEventListener("touchmove", onTouchMove, { capture: true });
+      document.removeEventListener("touchend", onTouchEnd, { capture: true });
+      document.removeEventListener("touchcancel", onTouchEnd, { capture: true });
+      document.removeEventListener("scroll", onScroll, { capture: true });
+      document.removeEventListener("selectionchange", onSelectionChange);
+    };
+  }, []);
+  return null;
+}
