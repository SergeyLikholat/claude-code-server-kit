diff --git a/apps/web/src/components/AppSidebarLayout.tsx b/apps/web/src/components/AppSidebarLayout.tsx
index b50bc34f48..f46485abc5 100644
--- a/apps/web/src/components/AppSidebarLayout.tsx
+++ b/apps/web/src/components/AppSidebarLayout.tsx
@@ -57,7 +57,6 @@ import { Tooltip, TooltipPopup, TooltipTrigger } from "./ui/tooltip";
 import { T3patchBackToMenu } from "./sergey/backToMenu"; // t3-patch: «назад» в PWA → список тредов
 import { T3patchIosLongPressMenu } from "./sergey/iosLongPressMenu"; // t3-patch: удержание на iPhone → меню треда
 import { T3patchIosEdgeSwipe } from "./sergey/iosEdgeSwipe"; // t3-patch: свой свайп меню вместо системного «назад» на iPhone
-import { T3patchSelectionScrollDiag } from "./sergey/selectionScrollDiag"; // t3-patch ВРЕМЕННО: замер сдвига ленты при выделении
 import { T3patchIosSelectionScrollLock } from "./sergey/iosSelectionScrollLock"; // t3-patch: лента стоит, пока на iPhone выделяют текст
 import { T3patchIosKeyboardViewport } from "./sergey/iosKeyboardViewport"; // t3-patch: поле ввода над клавиатурой iPhone
 
@@ -341,7 +340,6 @@ export function AppSidebarLayout({ children }: { children: ReactNode }) {
         <T3patchBackToMenu />
         <T3patchIosLongPressMenu />
         <T3patchIosEdgeSwipe />
-        <T3patchSelectionScrollDiag />
         <T3patchIosSelectionScrollLock />
         <T3patchIosKeyboardViewport />
       </SidebarProvider>
diff --git a/apps/web/src/components/sergey/iosEdgeSwipe.tsx b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
index aadfda2854..70762b16bb 100644
--- a/apps/web/src/components/sergey/iosEdgeSwipe.tsx
+++ b/apps/web/src/components/sergey/iosEdgeSwipe.tsx
@@ -118,6 +118,10 @@ export function T3patchIosEdgeSwipe(): null {
     const onTouchStart = (event: TouchEvent) => {
       gesture = null;
       if (openRef.current || event.touches.length !== 1) return;
+      // Пока выделен текст, у края экрана лежит левая ручка выделения (строки начинаются у края) —
+      // её касание приходит и сюда и принималось за свайп меню (запись экрана 2026-11-01).
+      const selection = window.getSelection();
+      if (selection && !selection.isCollapsed) return;
       const touch = event.touches[0]!;
       if (touch.clientX > EDGE_PX) return;
       gesture = {
