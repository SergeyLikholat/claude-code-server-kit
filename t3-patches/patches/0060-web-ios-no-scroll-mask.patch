---
 apps/web/src/index.css | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 565da4b331..ecec740cdf 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2315,3 +2315,15 @@ html[data-t3patch-back-menu="true"] [data-slot="sidebar-inset"] {
   .text-foreground {
   color: var(--color-secondary-label);
 }
+
+/* t3-patch: на iPhone/iPad у ленты и прокручиваемых групп внутри неё нет маски-затухания у краёв.
+   Маска (mask-image) на прокручиваемой области ломает в Safari iOS захват левой ручки выделения:
+   её нельзя потянуть влево/вверх. Найдено пошагово на проверочных страницах 2026-11-01 (виновата
+   только маска). @supports (-webkit-touch-callout) — это свойство понимает только Safari на iOS. */
+@supports (-webkit-touch-callout: none) {
+  .topbar-scroll-fade,
+  .virtualized-scroll-fade {
+    -webkit-mask-image: none !important;
+    mask-image: none !important;
+  }
+}
