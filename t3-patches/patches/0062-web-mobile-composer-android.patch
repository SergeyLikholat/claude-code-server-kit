@@ -0,0 +1,84 @@
+/**
+ * t3-patch: поле ввода на телефоне в браузере — как в Android-приложении.
+ *
+ * Свёрнутое поле — одна строка: «+» (вложения) слева, подсказка, справа «отправить» или «стоп».
+ * Строки «модель / глубина / режим» под полем нет. В развёрнутом поле снизу «+» слева, справа выбор
+ * модели и кнопка. Глубина рассуждения и режим переехали в меню выбора модели (разделы ниже списка
+ * моделей) — там стоят штатные переключатели T3, логика не дублируется.
+ *
+ * Узкий экран — useIsMobile() (< 768px). Компьютер не меняется.
+ */
+import { PlusIcon } from "lucide-react";
+import type { ReactNode } from "react";
+
+/** Подсказка в поле ввода на телефоне, как в Android-приложении. */
+export const T3PATCH_MOBILE_COMPOSER_PLACEHOLDER = "Задача агенту или команда…";
+
+/** «+» слева в поле ввода: открывает выбор файлов (то же, что скрепка на компьютере). */
+export function T3patchComposerPlusButton(props: {
+  readonly onClick: () => void;
+  readonly disabled?: boolean;
+}) {
+  return (
+    <button
+      type="button"
+      data-t3patch-composer-plus="true"
+      className="-ms-1 flex size-8 shrink-0 items-center justify-center rounded-full text-foreground/80 transition-colors hover:bg-accent active:bg-accent disabled:opacity-50"
+      aria-label="Прикрепить файлы"
+      disabled={props.disabled}
+      // Не забирать фокус у редактора: иначе развёрнутое поле свернётся до открытия выбора файлов.
+      onPointerDown={(event) => event.preventDefault()}
+      onClick={(event) => {
+        event.stopPropagation();
+        props.onClick();
+      }}
+    >
+      <PlusIcon className="size-5" />
+    </button>
+  );
+}
+
+/** «Стоп» в свёрнутом поле, пока агент работает, — как в Android. */
+export function T3patchCollapsedStopButton(props: { readonly onInterrupt: () => void }) {
+  return (
+    <button
+      type="button"
+      data-chat-composer-transition-actions="true"
+      className="flex size-8 shrink-0 items-center justify-center rounded-full bg-destructive/90 text-white hover:bg-destructive"
+      aria-label="Stop generation"
+      onPointerDown={(event) => event.preventDefault()}
+      onClick={(event) => {
+        event.stopPropagation();
+        props.onInterrupt();
+      }}
+    >
+      <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
+        <rect x="2" y="2" width="8" height="8" rx="1.5" />
+      </svg>
+    </button>
+  );
+}
+
+/** Разделы «Глубина рассуждения» и «Режим» внизу меню выбора модели. */
+export function T3patchModelPickerExtras(props: {
+  readonly effort: ReactNode;
+  readonly mode: ReactNode;
+}) {
+  return (
+    <div
+      data-t3patch-model-picker-extras="true"
+      className="flex flex-col gap-1 border-t border-border/60 px-3 py-2"
+    >
+      {props.effort ? (
+        <div className="flex min-h-9 items-center justify-between gap-3">
+          <span className="text-xs font-medium text-muted-foreground">Глубина рассуждения</span>
+          <div className="flex min-w-0 items-center justify-end">{props.effort}</div>
+        </div>
+      ) : null}
+      <div className="flex min-h-9 items-center justify-between gap-3">
+        <span className="text-xs font-medium text-muted-foreground">Режим</span>
+        <div className="flex min-w-0 items-center justify-end gap-1">{props.mode}</div>
+      </div>
+    </div>
+  );
+}
-- 
