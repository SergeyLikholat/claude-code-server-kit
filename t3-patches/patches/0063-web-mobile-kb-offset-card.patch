---
 .../components/sergey/iosKeyboardViewport.tsx  |  9 +++++++++
 apps/web/src/index.css                         | 18 ++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/apps/web/src/components/sergey/iosKeyboardViewport.tsx b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
index 0c2d80ed87..fee1efe47d 100644
--- a/apps/web/src/components/sergey/iosKeyboardViewport.tsx
+++ b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
@@ -74,9 +74,17 @@ export function T3patchIosKeyboardViewport(): null {
       if (!keyboardOpen) {
         root.removeAttribute("data-t3patch-kb");
         root.style.removeProperty("--t3patch-vvh");
+        root.style.removeProperty("--t3patch-vvtop");
         return;
       }
       root.style.setProperty("--t3patch-vvh", `${Math.round(viewport.height)}px`);
+      // iPhone при фокусе ещё и сдвигает видимую область вниз по странице (offsetTop): без
+      // поправки шапка уезжала за край, а поле вставало над клавиатурой с зазором в эту величину
+      // (скриншот 2026-11-01). Рамку приложения двигаем вслед за видимой областью (index.css).
+      root.style.setProperty(
+        "--t3patch-vvtop",
+        `${Math.round(Math.max(0, viewport.offsetTop + window.scrollY))}px`,
+      );
       root.setAttribute("data-t3patch-kb", "true");
       // Safari сдвигает страницу вверх, чтобы показать поле; приложение уже ужато — сдвиг не нужен.
       if (window.scrollY !== 0) window.scrollTo(0, 0);
@@ -104,6 +112,7 @@ export function T3patchIosKeyboardViewport(): null {
       showDebug(null);
       root.removeAttribute("data-t3patch-kb");
       root.style.removeProperty("--t3patch-vvh");
+      root.style.removeProperty("--t3patch-vvtop");
     };
   }, []);
   return null;
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index ecec740cdf..a879150ae7 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2279,6 +2279,10 @@ html[data-t3patch-menu-open="true"] [data-slot="sheet-backdrop"] {
 }
 
 /* t3-patch: клавиатура iPhone — приложение по высоте видимой части (sergey/iosKeyboardViewport.tsx). */
+html[data-t3patch-kb="true"] [data-slot="sidebar-wrapper"] {
+  /* видимая область сдвинута iPhone на offsetTop — рамка едет вместе с ней */
+  transform: translateY(var(--t3patch-vvtop, 0px));
+}
 html[data-t3patch-kb="true"] [data-slot="sidebar-wrapper"],
 html[data-t3patch-kb="true"] [data-slot="sidebar-inset"] {
   height: var(--t3patch-vvh) !important;
@@ -2327,3 +2331,17 @@ html[data-t3patch-back-menu="true"] [data-slot="sidebar-inset"] {
     mask-image: none !important;
   }
 }
+
+/* t3-patch: телефон — как в Android-приложении: шапка треда на тонированном фоне (цвет меню),
+   область сообщений под ней — светлая карточка со скруглёнными верхними углами. */
+@media (max-width: 767px) {
+  [data-chat-column-maximized-away] {
+    background-color: var(--sidebar);
+  }
+  [data-chat-workspace-drop-target] {
+    background-color: var(--background);
+    border-top-left-radius: 1.5rem;
+    border-top-right-radius: 1.5rem;
+    overflow: hidden;
+  }
+}
