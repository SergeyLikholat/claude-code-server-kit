diff --git a/apps/web/src/components/chat/ChatHeader.tsx b/apps/web/src/components/chat/ChatHeader.tsx
index dfdcc71f73..c568a3a1e6 100644
--- a/apps/web/src/components/chat/ChatHeader.tsx
+++ b/apps/web/src/components/chat/ChatHeader.tsx
@@ -128,6 +128,17 @@ export function shouldShowOpenInPicker(input: {
   return input.remoteOpenMode !== "local-exec";
 }
 
+/**
+ * t3-patch: короткое имя сервера для подписи на телефоне, как в Android: «1234.hosted-by.example.io»
+ * → «koara» (часть адреса перед доменной зоной). Не адрес — оставляем как есть.
+ */
+function t3patchShortServerName(label: string | null): string | null {
+  if (!label) return null;
+  const parts = label.split(".").filter(Boolean);
+  if (parts.length < 2 || /\s/.test(label)) return label;
+  return parts[parts.length - 2] ?? label;
+}
+
 export const ChatHeader = memo(function ChatHeader({
   activeThreadEnvironmentId,
   activeThreadId,
@@ -208,10 +219,11 @@ export const ChatHeader = memo(function ChatHeader({
   // t3-patch: под заголовком на телефоне «проект · сервер», как в Android («ТК · Вектор · koara»).
   // Имя сервера — его собственная метка (hostname), иначе метка подключения; нет — только проект.
   const t3patchEnvironment = useEnvironment(activeThreadEnvironmentId);
-  const t3patchServerLabel =
+  const t3patchServerLabel = t3patchShortServerName(
     t3patchEnvironment?.serverConfig?.environment.label?.trim() ||
-    t3patchEnvironment?.label?.trim() ||
-    null;
+      t3patchEnvironment?.label?.trim() ||
+      null,
+  );
   const activeProjectCwd = activeProject?.workspaceRoot ?? null;
   const fileScripts = useT3ProjectFileScripts(
     activeThreadEnvironmentId,
