From 77091c9dd17b17f65b8bbe7578e805461a3551ed Mon Sep 17 00:00:00 2001
From: t3-patch <t3-patch@local>
Date: Mon, 2 Nov 2026 06:56:40 +0300
Subject: [PATCH] =?UTF-8?q?t3patch:=20web=20mobile=20=E2=80=94=20tinted=20?=
 =?UTF-8?q?header=20+16px,=20effort=20always=20visible,=20no=20autofocus,?=
 =?UTF-8?q?=20kb=20offset=20fix?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 apps/web/src/components/ChatView.tsx          |  7 ++++--
 .../components/sergey/iosKeyboardViewport.tsx |  9 ++++++--
 apps/web/src/index.css                        | 23 +++++++++++++++++++
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/apps/web/src/components/ChatView.tsx b/apps/web/src/components/ChatView.tsx
index 25b17d0e9f..2473dcb4ea 100644
--- a/apps/web/src/components/ChatView.tsx
+++ b/apps/web/src/components/ChatView.tsx
@@ -5744,14 +5744,17 @@ export default function ChatView(props: ChatViewProps) {
   }, [activeThread?.id, routeThreadKey]);
 
   useEffect(() => {
-    if (!activeThread?.id || terminalUiState.terminalOpen) return;
+    // t3-patch: на телефоне курсор в поле при входе в тред не ставим. iPhone на такой фокус
+    // клавиатуру не поднимает, а поле считало себя активным и открывалось развёрнутым, пока в
+    // него не тапнули (скриншот 2026-11-02). В Android-приложении поле при входе свёрнуто.
+    if (!activeThread?.id || terminalUiState.terminalOpen || isMobileViewport) return;
     const frame = window.requestAnimationFrame(() => {
       focusComposer();
     });
     return () => {
       window.cancelAnimationFrame(frame);
     };
-  }, [activeThread?.id, focusComposer, terminalUiState.terminalOpen]);
+  }, [activeThread?.id, focusComposer, isMobileViewport, terminalUiState.terminalOpen]);
 
   // Tabbing back into the app lands focus wherever it last was, often the right panel or the
   // body. Put it in the composer unless something that takes typing already holds it. The
diff --git a/apps/web/src/components/sergey/iosKeyboardViewport.tsx b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
index fee1efe47d..9933cc27dd 100644
--- a/apps/web/src/components/sergey/iosKeyboardViewport.tsx
+++ b/apps/web/src/components/sergey/iosKeyboardViewport.tsx
@@ -77,6 +77,11 @@ export function T3patchIosKeyboardViewport(): null {
         root.style.removeProperty("--t3patch-vvtop");
         return;
       }
+      // Safari сдвигает страницу вверх, чтобы показать поле; приложение уже ужато — сдвиг не нужен.
+      // Сначала вернуть страницу, потом мерить: раньше сдвиг запоминался до возврата, и всё
+      // приложение уезжало вниз на его величину, поле пряталось под клавиатуру (скриншот
+      // 2026-11-02, после вложения).
+      if (window.scrollY !== 0) window.scrollTo(0, 0);
       root.style.setProperty("--t3patch-vvh", `${Math.round(viewport.height)}px`);
       // iPhone при фокусе ещё и сдвигает видимую область вниз по странице (offsetTop): без
       // поправки шапка уезжала за край, а поле вставало над клавиатурой с зазором в эту величину
@@ -86,8 +91,6 @@ export function T3patchIosKeyboardViewport(): null {
         `${Math.round(Math.max(0, viewport.offsetTop + window.scrollY))}px`,
       );
       root.setAttribute("data-t3patch-kb", "true");
-      // Safari сдвигает страницу вверх, чтобы показать поле; приложение уже ужато — сдвиг не нужен.
-      if (window.scrollY !== 0) window.scrollTo(0, 0);
     };
     const schedule = () => {
       if (frame === null) frame = window.requestAnimationFrame(apply);
@@ -100,6 +103,7 @@ export function T3patchIosKeyboardViewport(): null {
 
     viewport.addEventListener("resize", schedule);
     viewport.addEventListener("scroll", schedule);
+    window.addEventListener("scroll", schedule, { passive: true });
     document.addEventListener("focusin", scheduleBurst, true);
     document.addEventListener("focusout", scheduleBurst, true);
     apply();
@@ -107,6 +111,7 @@ export function T3patchIosKeyboardViewport(): null {
       if (frame !== null) window.cancelAnimationFrame(frame);
       viewport.removeEventListener("resize", schedule);
       viewport.removeEventListener("scroll", schedule);
+      window.removeEventListener("scroll", schedule);
       document.removeEventListener("focusin", scheduleBurst, true);
       document.removeEventListener("focusout", scheduleBurst, true);
       showDebug(null);
diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 28dd371b3e..c30189b87d 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2351,3 +2351,26 @@ html[data-t3patch-back-menu="true"] [data-slot="sidebar-inset"] {
 html[data-t3patch-kb="true"] [data-t3patch-composer-spacer] {
   height: 0.5rem !important;
 }
+
+/* t3-patch: телефон — шапка и полоса над ней целиком на тонированном фоне, как в Android
+   (скриншот 2026-11-02: тонированными были только уголки над карточкой, шапка — белая).
+   Цвет sidebar-inset берёт и theme-color (useTheme), поэтому полоса со временем тоже в тон. */
+@media (max-width: 767px) {
+  main[data-slot="sidebar-inset"],
+  [data-chat-header] {
+    background-color: var(--sidebar) !important;
+  }
+  /* Отступ между подписью «проект · сервер» и карточкой ленты — 16 px, как в Android (было 8). */
+  [data-chat-header] {
+    height: calc(var(--workspace-topbar-height) + 0.5rem);
+    min-height: calc(var(--workspace-topbar-height) + 0.5rem);
+    padding-bottom: 0.5rem;
+  }
+}
+
+/* t3-patch: меню модели на телефоне — разделы «Глубина рассуждения» и «Режим» всегда видны.
+   При открытой клавиатуре меню ниже, и список моделей выталкивал их под обрез (скриншот
+   2026-11-02). Список ужимается на высоту разделов, сами разделы не прокручиваются. */
+[data-slot="popover-viewport"]:has([data-t3patch-model-picker-extras]) [data-model-picker-content] {
+  max-height: min(21.625rem, calc(var(--available-height, 100vh) - 6.5rem));
+}
-- 
2.43.0

