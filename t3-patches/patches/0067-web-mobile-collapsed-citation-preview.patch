 } from "../sergey/mobileAndroidComposer"; // t3-patch: поле ввода на телефоне как в Android
 import { usePanelAnimationSettings } from "../../panelAnimations";
 import { useAtomCommand } from "../../state/use-atom-command";
@@ -6477,7 +6478,7 @@ export const ChatComposer = memo(function ChatComposer(props: ChatComposerProps)
                       ? "Choose an option above"
                       : activePendingProgress.customAnswer ||
