+++ b/apps/web/src/components/sergey/mobileAndroidComposer.tsx
@@ -8,7 +8,8 @@
  *
  * Узкий экран — useIsMobile() (< 768px). Компьютер не меняется.
  */
-import { PlusIcon } from "lucide-react";
+import { collectAssistantCitations } from "@t3tools/shared/assistantCitations";
+import { PlusIcon, QuoteIcon } from "lucide-react";
 import type { ReactNode } from "react";
 
 /** Подсказка в поле ввода на телефоне, как в Android-приложении. */
@@ -82,3 +83,29 @@ export function T3patchModelPickerExtras(props: {
     </div>
   );
 }
+
+/**
+ * Текст свёрнутого поля: цитаты из ответа — значком кавычек и самим текстом (или комментарием),
+ * а не служебной ссылкой «[Assistant quote](t3-citation://…)» (скриншот iPhone 2026-11-02).
+ */
+export function T3patchCollapsedPromptPreview(props: { readonly prompt: string }) {
+  const matches = collectAssistantCitations(props.prompt);
+  if (matches.length === 0) return <>{props.prompt}</>;
+  const parts: ReactNode[] = [];
+  let cursor = 0;
+  matches.forEach((match, index) => {
+    const before = props.prompt.slice(cursor, match.start).trim();
+    if (before) parts.push(<span key={`t${index}`}>{before} </span>);
+    const label = (match.citation.comment?.trim() || match.citation.text).replace(/\s+/g, " ");
+    parts.push(
+      <span key={`q${index}`} className="text-muted-foreground">
+        <QuoteIcon aria-hidden="true" className="me-1 inline size-3.5 align-[-2px]" />
+        {label}{" "}
+      </span>,
+    );
+    cursor = match.end;
+  });
+  const rest = props.prompt.slice(cursor).trim();
+  if (rest) parts.push(<span key="rest">{rest}</span>);
+  return <>{parts}</>;
+}
