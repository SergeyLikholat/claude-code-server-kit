---
 apps/web/src/index.css | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index c30189b87d..6e05df9651 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -2374,3 +2374,12 @@ html[data-t3patch-kb="true"] [data-t3patch-composer-spacer] {
 [data-slot="popover-viewport"]:has([data-t3patch-model-picker-extras]) [data-model-picker-content] {
   max-height: min(21.625rem, calc(var(--available-height, 100vh) - 6.5rem));
 }
+
+/* t3-patch: телефон — полоса под часами и островком (отступ #root сверху) в цвет шапки, чтобы
+   шапка шла сплошной плашкой до верхнего края, как в Android (скриншот iPhone 2026-11-02:
+   полоса была белой — её красил фон страницы, а не шапка). */
+@media (max-width: 767px) {
+  #root {
+    background-color: var(--sidebar);
+  }
+}
