 // Строка дерева, а если палец на пустом месте дерева — само дерево (меню корня проекта,
 // useT3patchRootMenu).
@@ -30,6 +32,8 @@ export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): vo
     let timer: ReturnType<typeof setTimeout> | null = null;
     let start: { x: number; y: number } | null = null;
     let fired = false;
+    /** До какого момента гасить нажатия после меню (см. swallowGhost). */
+    let guardUntil = 0;
 
     const cancel = () => {
       if (timer !== null) clearTimeout(timer);
@@ -38,6 +42,7 @@ export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): vo
     };
     const onTouchStart = (event: TouchEvent) => {
       fired = false;
+      guardUntil = 0;
       if (event.touches.length !== 1) return cancel();
       const row = rowFromEvent(event);
       if (!row) return;
@@ -46,6 +51,7 @@ export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): vo
       timer = setTimeout(() => {
         timer = null;
         fired = true;
+        guardUntil = Number.POSITIVE_INFINITY; // до отпускания пальца
         navigator.vibrate?.(10);
         row.dispatchEvent(
           new MouseEvent("contextmenu", {
@@ -70,9 +76,21 @@ export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): vo
         cancel();
       }
     };
+    // Меню открывается под пальцем, первый пункт («Скопировать упоминание») оказывается прямо под
+    // ним. На iPhone отпускание пальца засчитывалось нажатием на этот пункт (скриншот 2026-11-02:
+    // «Упоминание скопировано» без выбора). Меню — вне панели, поэтому гасим нажатия по всему
+    // документу до отпускания пальца и ещё GHOST_CLICK_MS после.
+    const swallowGhost = (event: Event) => {
+      if (performance.now() > guardUntil) return;
+      event.preventDefault();
+      event.stopPropagation();
+    };
     const onTouchEnd = (event: TouchEvent) => {
       cancel();
-      if (fired) event.preventDefault(); // не превращать удержание в клик по строке
+      if (fired) {
+        event.preventDefault(); // не превращать удержание в клик по строке
+        guardUntil = performance.now() + GHOST_CLICK_MS;
+      }
     };
     const swallowAfterMenu = (event: Event) => {
       if (!fired) return;
@@ -95,16 +113,22 @@ export function useT3patchTouchMenu(panelRef: RefObject<HTMLElement | null>): vo
     panel.addEventListener("touchstart", onTouchStart, { capture: true, passive: true });
     panel.addEventListener("touchmove", onTouchMove, { capture: true, passive: true });
     panel.addEventListener("touchend", onTouchEnd, { capture: true });
-    panel.addEventListener("touchcancel", cancel, { capture: true });
+    panel.addEventListener("touchcancel", onTouchEnd, { capture: true });
     panel.addEventListener("click", swallowAfterMenu, true);
     panel.addEventListener("dragstart", blockDragWhileHolding, true);
     window.addEventListener("contextmenu", blockNativeMenu, true);
+    for (const type of ["click", "mouseup", "pointerup"]) {
+      window.addEventListener(type, swallowGhost, true);
+    }
     return () => {
+      for (const type of ["click", "mouseup", "pointerup"]) {
+        window.removeEventListener(type, swallowGhost, true);
+      }
       cancel();
       panel.removeEventListener("touchstart", onTouchStart, { capture: true });
       panel.removeEventListener("touchmove", onTouchMove, { capture: true });
       panel.removeEventListener("touchend", onTouchEnd, { capture: true });
-      panel.removeEventListener("touchcancel", cancel, { capture: true });
+      panel.removeEventListener("touchcancel", onTouchEnd, { capture: true });
       panel.removeEventListener("click", swallowAfterMenu, true);
       panel.removeEventListener("dragstart", blockDragWhileHolding, true);
       window.removeEventListener("contextmenu", blockNativeMenu, true);
